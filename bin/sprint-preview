#!/usr/bin/env python3
"""Start, verify, and stop an ownership-tracked Sprint preview server.

The preview port is namespaced by the board project root, then reserved in a
machine-wide registry.  `start` retries if any exact-address or wildcard
listener already owns the candidate.  `stop` uses the recorded process start
identity; it never kills whichever process happens to be listening on a port.

Examples:
  sprint-preview start 42 --worktree "$PWD" -- npm run dev -- --host {host} --port {port}
  sprint-preview verify 42 --url http://100.x.x.x:23142/
  sprint-preview stop 42

SPRINT_PREVIEW_HOST and SPRINT_PREVIEW_PORT are also set for the child.
"""

import argparse
import contextlib
import fcntl
import hashlib
import http.client
import json
import os
import pathlib
import select
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid


PORT_MIN = 20000
PORT_SLOTS = 300
PORTS_PER_SLOT = 100
STARTING_TTL = 60
OWNERSHIP_LOOKUP_TIMEOUT = 15.0


class PreviewError(RuntimeError):
    pass


class DetachedCleanupError(PreviewError):
    def __init__(self, message, escaped=None):
        super().__init__(message)
        self.escaped = escaped


class EscapedListenerCleaned(PreviewError):
    pass


@contextlib.contextmanager
def startup_signal_guard():
    """Block terminal signals across launch/publication/cleanup as one unit."""
    previous = {}
    state = {"committed": False}
    guarded = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}

    def interrupted(signum, _frame):
        # Publication commits startup: from here the durable record is the
        # caller contract, so terminal signals cannot turn success into a
        # failed exit while leaving that registered server behind.
        if state["committed"]:
            return
        raise PreviewError("preview startup interrupted by signal %d" % signum)

    for signum in guarded:
        previous[signum] = signal.signal(signum, interrupted)
    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, guarded)
    state["child_signal_mask"] = old_mask
    try:
        yield state
    finally:
        # Consume anything that arrived while the exact child/group was in a
        # transitional state. Before publication this becomes a clean failure;
        # after publication it is an ignored request against durable success.
        pending = signal.sigpending().intersection(guarded)
        while pending:
            signal.sigwait(pending)
            pending = signal.sigpending().intersection(guarded)
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def raise_if_startup_interrupted():
    pending = signal.sigpending().intersection(
        {signal.SIGINT, signal.SIGTERM, signal.SIGHUP})
    if pending:
        raise PreviewError("preview startup interrupted by signal %d" % min(pending))


def parse_args(argv):
    command = []
    if "--" in argv:
        separator = argv.index("--")
        command = argv[separator + 1:]
        argv = argv[:separator]
    parser = argparse.ArgumentParser(prog="sprint-preview")
    parser.add_argument("--registry", default=os.environ.get("SPRINT_PREVIEW_REGISTRY"),
                        help="machine-wide preview registry (tests/advanced use)")
    sub = parser.add_subparsers(dest="action", required=True)

    def common(cmd):
        cmd.add_argument("card", type=int, help="card number (batch members resolve to their batch id)")
        cmd.add_argument("--project-root", help="board project root; normally read from SPRINT_SERVER")
        cmd.add_argument("--server", default=os.environ.get("SPRINT_SERVER"))
        cmd.add_argument("--token", default=os.environ.get("SPRINT_TOKEN"))

    start = sub.add_parser("start", help="reserve a port and start the preview")
    common(start)
    start.add_argument("--worktree", required=True, help="working directory for the preview command")
    start.add_argument("--host", help="advertised bind host; defaults to tailnet IPv4, then loopback")
    start.add_argument("--path", default="/", help="URL path used for readiness and live_url")
    start.add_argument("--timeout", type=float, default=30.0)
    start.add_argument("--log", help="preview log path (default: board .sprint/previews/<unit>.log)")

    verify = sub.add_parser("verify", help="prove the recorded preview still owns its live URL")
    common(verify)
    verify.add_argument("--url", help="require this exact live URL")

    stop = sub.add_parser("stop", help="stop only the recorded owning process")
    common(stop)
    stop.add_argument("--timeout", type=float, default=5.0)
    args = parser.parse_args(argv)
    args.command = command
    return args


def registry_path(override=None):
    if override:
        return os.path.realpath(override)
    board_registry = os.environ.get("SPRINT_REGISTRY")
    if board_registry:
        return os.path.join(os.path.dirname(os.path.realpath(board_registry)),
                            "preview-registry.json")
    return os.path.realpath(os.path.expanduser("~/.sprint/preview-registry.json"))


@contextlib.contextmanager
def locked_registry(path):
    pathlib.Path(path).parent.mkdir(parents=True, exist_ok=True)
    lock_path = path + ".lock"
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            try:
                with open(path, "r", encoding="utf-8") as src:
                    data = json.load(src)
                if not isinstance(data, dict):
                    data = {}
            except (FileNotFoundError, json.JSONDecodeError, OSError):
                data = {}
            yield data
            tmp = "%s.%s.tmp" % (path, os.getpid())
            with open(tmp, "w", encoding="utf-8") as dst:
                json.dump(data, dst, indent=2, sort_keys=True)
                dst.write("\n")
            os.chmod(tmp, 0o600)
            os.replace(tmp, path)
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def get_json(url, token=None, timeout=3):
    headers = {"Authorization": "Bearer " + token} if token else {}
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.load(resp)
    except (urllib.error.URLError, urllib.error.HTTPError, ValueError) as exc:
        raise PreviewError("could not read %s: %s" % (url, exc)) from exc


def resolve_project_root(explicit, server):
    if explicit:
        return os.path.realpath(explicit)
    env_root = os.environ.get("SPRINT_PROJECT_ROOT")
    if env_root:
        return os.path.realpath(env_root)
    if server:
        health = get_json(server.rstrip("/") + "/healthz")
        root = health.get("project_root")
        if root:
            return os.path.realpath(root)
    raise PreviewError("project root is unknown; pass --project-root or set SPRINT_SERVER")


def resolve_unit(card, server, token):
    if server and token:
        payload = get_json("%s/api/cards/%d" % (server.rstrip("/"), card), token)
        info = payload.get("card") or {}
        batch = info.get("batch_id")
        if batch is not None:
            return "batch-%s" % batch, int(batch)
    return "card-%d" % card, card


def default_host():
    try:
        proc = subprocess.run(["tailscale", "ip", "-4"], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=3, check=False)
        host = proc.stdout.strip().splitlines()[0] if proc.stdout.strip() else ""
        if host:
            socket.inet_aton(host)
            return host
    except (OSError, subprocess.TimeoutExpired, IndexError):
        pass
    return "127.0.0.1"


def preferred_port(project_root, unit_number):
    digest = hashlib.sha256(os.path.realpath(project_root).encode("utf-8")).digest()
    slot = int.from_bytes(digest[:4], "big") % PORT_SLOTS
    return PORT_MIN + slot * PORTS_PER_SLOT + (unit_number % PORTS_PER_SLOT)


def candidate_ports(project_root, unit_number):
    first = preferred_port(project_root, unit_number)
    first_slot = (first - PORT_MIN) // PORTS_PER_SLOT
    suffix = unit_number % PORTS_PER_SLOT
    for offset in range(PORT_SLOTS):
        slot = (first_slot + offset) % PORT_SLOTS
        yield PORT_MIN + slot * PORTS_PER_SLOT + suffix


def port_is_clear(port):
    """Conservatively reject any IPv4/IPv6 exact or wildcard listener."""
    sockets = []
    specs = [(socket.AF_INET, ("0.0.0.0", port))]
    if socket.has_ipv6:
        specs.append((socket.AF_INET6, ("::", port)))
    try:
        for family, address in specs:
            sock = socket.socket(family, socket.SOCK_STREAM)
            sockets.append(sock)
            if family == socket.AF_INET6:
                with contextlib.suppress(OSError):
                    sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            sock.bind(address)
        return True
    except OSError:
        return False
    finally:
        for sock in sockets:
            sock.close()


def pid_identity(pid):
    try:
        proc = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def pid_exists(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def pid_command(pid):
    try:
        # `command=` can rewrite from "node /path/npm ..." to "npm ..."
        # after startup. `comm=` is the stable executable identity.
        proc = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def pid_executable(pid):
    try:
        proc = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "txt", "-Fn"],
                              text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL,
                              timeout=OWNERSHIP_LOOKUP_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in proc.stdout.splitlines():
        if line.startswith("n/"):
            return os.path.realpath(line[1:])
    return ""


def descendants(root_pid):
    try:
        proc = subprocess.run(["ps", "-axo", "pid=,ppid="], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise PreviewError("ps is required to verify preview descendants")
    if proc.returncode != 0:
        raise PreviewError("ps could not verify preview descendants")
    children = {}
    for line in proc.stdout.splitlines():
        fields = line.split()
        if len(fields) == 2 and all(field.isdigit() for field in fields):
            pid, ppid = map(int, fields)
            children.setdefault(ppid, set()).add(pid)
    found = {root_pid}
    stack = [root_pid]
    while stack:
        parent = stack.pop()
        for child in children.get(parent, ()):
            if child not in found:
                found.add(child)
                stack.append(child)
    return found


def listener_rows(port):
    try:
        proc = subprocess.run(
            ["lsof", "-nP", "-a", "-iTCP:%d" % port, "-sTCP:LISTEN", "-Fpn"],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            # lsof can take several seconds on a busy macOS host. Fifteen
            # seconds is bounded but leaves useful headroom over the observed
            # nine-second lookup without weakening the ownership predicate.
            timeout=float(os.environ.get(
                "SPRINT_PREVIEW_OWNERSHIP_TIMEOUT", OWNERSHIP_LOOKUP_TIMEOUT)),
            check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise PreviewError("lsof is required to verify preview ownership: %s" % exc) from exc
    if proc.returncode == 1 and not proc.stdout.strip():
        return []
    if proc.returncode != 0:
        raise PreviewError("lsof could not verify preview ownership")
    rows = []
    current_pid = None
    for line in proc.stdout.splitlines():
        if line.startswith("p") and line[1:].isdigit():
            current_pid = int(line[1:])
        elif line.startswith("n") and current_pid is not None:
            rows.append((current_pid, line[1:]))
    return rows


def address_matches(name, host, port):
    endpoint = name.rsplit("->", 1)[0]
    if not endpoint.endswith(":" + str(port)):
        return False
    bound = endpoint[:-(len(str(port)) + 1)].strip("[]")
    return bound in (host, "*", "0.0.0.0", "::", "::0")


def listener_owned(record):
    owned = descendants(int(record["pid"]))
    matching = [(pid, name) for pid, name in listener_rows(int(record["port"]))
                if address_matches(name, record["host"], int(record["port"]))]
    return bool(matching) and all(pid in owned for pid, _ in matching)


def matching_listener_pids(record):
    return {pid for pid, name in listener_rows(int(record["port"]))
            if address_matches(name, record["host"], int(record["port"]))}


def capture_listener_proofs(record):
    pids = matching_listener_pids(record)
    if not pids:
        raise PreviewError("could not capture exact preview listener ownership")
    escaped = {"listener_pid": min(pids), "stage": "listener_observed"}
    persist_escaped_cleanup_state(record, escaped)
    proofs = []
    try:
        owned = descendants(int(record["pid"]))
        for pid in sorted(pids):
            escaped = {"listener_pid": pid, "stage": "identity_pending"}
            persist_escaped_cleanup_state(record, escaped)
            identity = pid_identity(pid)
            if not identity:
                raise PreviewError("could not capture preview listener identity")
            escaped.update({"listener_identity": identity, "stage": "pgid_pending"})
            persist_escaped_cleanup_state(record, escaped)
            listener_pgid = os.getpgid(pid)
            escaped.update({"pgid": listener_pgid, "stage": "proof_pending"})
            persist_escaped_cleanup_state(record, escaped)
            expected_pgid = int(record.get("pgid") or record["pid"])
            if listener_pgid != expected_pgid:
                if pid not in owned:
                    raise PreviewError(
                        "refusing cleanup of an unrelated detached listener")
                cleanup_detached_listener(record, pid, listener_pgid, identity, owned)
                raise EscapedListenerCleaned(
                    "preview listener escaped the owned process group")
            if pid not in owned:
                raise PreviewError("could not capture exact preview listener ownership")
            listener_executable = pid_executable(pid)
            if not listener_executable:
                raise PreviewError("could not capture preview listener executable")
            proofs.append({"pid": pid, "pid_identity": identity,
                           "pid_executable": listener_executable,
                           "pgid": listener_pgid})
    except Exception as exc:
        if isinstance(exc, EscapedListenerCleaned):
            raise
        if isinstance(exc, DetachedCleanupError) and exc.escaped:
            escaped = exc.escaped
        raise DetachedCleanupError(
            "escaped preview cleanup proof failed: %s" % exc, escaped) from exc
    record["status"] = "running"
    record.pop("escaped_group", None)
    write_record(record["record_path"], record, delay_hook=False)
    publish_lease(record["registry"], record)
    return proofs


def process_group_member_pids(pgid):
    count_file = os.environ.get("SPRINT_PREVIEW_TEST_GROUP_MEMBER_COUNT")
    count = 0
    if count_file:
        try:
            count = int(pathlib.Path(count_file).read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, ValueError):
            count = 0
        count += 1
        pathlib.Path(count_file).write_text(str(count), encoding="utf-8")
    try:
        proc = subprocess.run(["ps", "-axo", "pid=,pgid=,stat="], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise PreviewError("could not prove detached group membership") from exc
    if proc.returncode != 0:
        raise PreviewError("could not prove detached group membership")
    members = {int(fields[0]) for line in proc.stdout.splitlines()
            if len(fields := line.split()) >= 3 and fields[0].isdigit()
            and fields[1].isdigit() and int(fields[1]) == pgid
            and not fields[2].startswith("Z")}
    flip_after = int(os.environ.get("SPRINT_PREVIEW_TEST_GROUP_MEMBER_FLIP_AFTER", "0"))
    if flip_after and count > flip_after:
        members.add(99999)
    return members


def detached_group_still_matches(record, listener_pid, pgid, proofs):
    members = process_group_member_pids(pgid)
    if not members or not members.issubset(proofs) or pgid not in members:
        return False
    if listener_pid not in members or listener_pid not in matching_listener_pids(record):
        return False
    current_owned = descendants(int(record["pid"]))
    if not members.issubset(current_owned):
        return False
    for member in members:
        proof = proofs[member]
        if (not pid_exists(member) or pid_identity(member) != proof["pid_identity"]
                or pid_executable(member) != proof["pid_executable"]
                or os.getpgid(member) != pgid):
            return False
    return os.getpgid(pgid) == pgid


def persist_escaped_cleanup_state(record, escaped):
    """Durably retain authority as soon as an escaped listener is observed."""
    record["status"] = "cleanup_required"
    record["escaped_group"] = escaped
    write_record(record["record_path"], record, delay_hook=False)
    publish_lease(record["registry"], record)
    pathlib.Path(record["supervisor_commit"]).touch(mode=0o600, exist_ok=True)


def cleanup_detached_listener(record, pid, pgid, identity, owned):
    """Clean a fully proven escaped group containing the owned listener."""
    members = process_group_member_pids(pgid)
    if not members or pgid not in members or pid not in members or not members.issubset(owned):
        raise DetachedCleanupError("refusing cleanup of detached preview listener")
    proofs = {}
    for member in members:
        member_identity = pid_identity(member)
        member_executable = pid_executable(member)
        if not member_identity or not member_executable:
            raise DetachedCleanupError("refusing cleanup of detached preview listener")
        proofs[member] = {"pid_identity": member_identity,
                          "pid_executable": member_executable}
    if proofs[pid]["pid_identity"] != identity or not detached_group_still_matches(
            record, pid, pgid, proofs):
        raise DetachedCleanupError("refusing cleanup of detached preview listener",
                                   {"listener_pid": pid, "pgid": pgid,
                                    "listener_identity": identity, "proofs": proofs})
    if not detached_group_still_matches(record, pid, pgid, proofs):
        raise DetachedCleanupError("refusing cleanup of detached preview listener",
                                   {"listener_pid": pid, "pgid": pgid,
                                    "listener_identity": identity, "proofs": proofs})
    os.killpg(pgid, signal.SIGTERM)
    deadline = time.monotonic() + 1
    while pid_exists(pid) and time.monotonic() < deadline:
        time.sleep(0.05)
    if not process_group_alive(pgid):
        return
    if not detached_group_still_matches(record, pid, pgid, proofs):
        raise DetachedCleanupError("refusing detached escalation: group proof changed",
                                   {"listener_pid": pid, "pgid": pgid,
                                    "listener_identity": identity, "proofs": proofs})
    os.killpg(pgid, signal.SIGKILL)


def resume_escaped_cleanup(record, escaped):
    pid = int(escaped["listener_pid"])
    if pid not in matching_listener_pids(record):
        raise DetachedCleanupError("escaped listener is no longer exactly observable",
                                   escaped)
    identity = pid_identity(pid)
    if not identity:
        raise DetachedCleanupError("escaped listener identity is unavailable", escaped)
    try:
        pgid = os.getpgid(pid)
    except ProcessLookupError as exc:
        raise DetachedCleanupError("escaped listener disappeared during proof", escaped) from exc
    if pgid == int(record.get("pgid") or record["pid"]):
        return
    complete = {"listener_pid": pid, "listener_identity": identity,
                "pgid": pgid, "stage": "proof_pending"}
    persist_escaped_cleanup_state(record, complete)
    cleanup_detached_listener(record, pid, pgid, identity,
                              descendants(int(record["pid"])))


def recorded_listeners_still_own_group(record, pgid):
    proofs = {int(item["pid"]): item for item in record.get("listener_proofs") or []}
    current = matching_listener_pids(record)
    if not current or not current.issubset(proofs):
        return False
    for pid in current:
        proof = proofs[pid]
        if (not pid_exists(pid) or pid_identity(pid) != proof.get("pid_identity")
                or os.getpgid(pid) != int(proof.get("pgid") or 0)
                or int(proof.get("pgid") or 0) != pgid
                or not proof.get("pid_executable")
                or pid_executable(pid) != proof.get("pid_executable")):
            return False
    return True


def http_reachable(host, port, path, timeout=1):
    try:
        conn = http.client.HTTPConnection(host, port, timeout=timeout)
        conn.request("GET", path or "/")
        response = conn.getresponse()
        response.read(1)
        conn.close()
        return True
    except (OSError, http.client.HTTPException):
        return False


def record_state(record, require_http=False):
    pid = int(record.get("pid") or 0)
    identity = record.get("pid_identity") or ""
    if not pid or not identity:
        return "dead"
    pgid = int(record.get("pgid") or pid)
    if not pid_exists(pid):
        # A session leader may exit while its recorded listener descendant
        # remains.  Preserve that durable cleanup authority; an empty lsof
        # sample is not proof that the process group is gone.
        try:
            if recorded_listeners_still_own_group(record, pgid):
                if require_http and not http_reachable(
                        record["host"], int(record["port"]),
                        record.get("path") or "/"):
                    return "unknown"
                return "live"
        except (PreviewError, OSError):
            return "unknown"
        if process_group_alive(pgid):
            return "unknown"
        return "dead"
    observed_identity = pid_identity(pid)
    if not observed_identity:
        return "unknown"
    if observed_identity != identity:
        return "dead"
    try:
        if not listener_owned(record):
            if recorded_listeners_still_own_group(record, pgid):
                if require_http and not http_reachable(
                        record["host"], int(record["port"]),
                        record.get("path") or "/"):
                    return "unknown"
                return "live"
            # lsof can transiently return rc=1/no rows for a healthy socket.
            # The still-matching leader proves this record is not stale, but
            # absence of one listener sample cannot prove it live either.
            return "unknown"
    except PreviewError:
        return "unknown"
    if require_http and not http_reachable(
            record["host"], int(record["port"]), record.get("path") or "/"):
        return "unknown"
    return "live"


def record_alive(record, require_http=False):
    return record_state(record, require_http) == "live"


def record_path(project_root, unit):
    return os.path.join(project_root, ".sprint", "previews", unit + ".json")


def read_record(path):
    try:
        with open(path, "r", encoding="utf-8") as src:
            value = json.load(src)
        return value if isinstance(value, dict) else None
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None


def write_record(path, record, delay_hook=True):
    pathlib.Path(path).parent.mkdir(parents=True, exist_ok=True)
    tmp = "%s.%s.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as dst:
        json.dump(record, dst, indent=2, sort_keys=True)
        dst.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    test_delay = (float(os.environ.get("SPRINT_PREVIEW_TEST_POST_REPLACE_DELAY", "0"))
                  if delay_hook and ".supervisor" not in path else 0)
    if test_delay > 0:
        time.sleep(test_delay)


def remove_record_for_lease(path, lease):
    current = read_record(path)
    if current and current.get("lease") == lease.get("lease"):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)


def public_record(record, reused=False):
    return {
        "project_root": record["project_root"],
        "unit": record["unit"],
        "host": record["host"],
        "port": record["port"],
        "live_url": record["live_url"],
        "pid": record["pid"],
        "record": record["record_path"],
        "reused": reused,
    }


def prune_registry(data):
    now = time.time()
    for key, entry in list(data.items()):
        if not isinstance(entry, dict):
            data.pop(key, None)
            continue
        if entry.get("status") == "starting":
            if now - float(entry.get("reserved_at") or 0) > STARTING_TTL:
                data.pop(key, None)
        else:
            state = record_state(entry)
            if state == "dead":
                data.pop(key, None)
            elif state == "unknown":
                raise PreviewError(
                    "could not prove whether an existing preview is alive; preserving its lease")


def reserve(registry, project_root, unit, unit_number, host):
    key = project_root + "\0" + unit
    with locked_registry(registry) as data:
        prune_registry(data)
        existing = data.get(key)
        if existing and existing.get("status") == "running":
            state = record_state(existing, True)
            if state == "live":
                return existing, True
            if state == "unknown":
                raise PreviewError(
                    "could not verify the existing preview; preserving its lease")
        used = {int(entry.get("port")) for entry in data.values()
                if isinstance(entry, dict) and entry.get("port")}
        for port in candidate_ports(project_root, unit_number):
            if port in used or not port_is_clear(port):
                continue
            lease = {
                "lease": uuid.uuid4().hex,
                "project_root": project_root,
                "unit": unit,
                "host": host,
                "port": port,
                "status": "starting",
                "reserved_at": time.time(),
            }
            data[key] = lease
            return lease, False
    raise PreviewError("no collision-free preview port is available")


def release_lease(registry, record):
    key = record["project_root"] + "\0" + record["unit"]
    with locked_registry(registry) as data:
        current = data.get(key)
        if isinstance(current, dict) and current.get("lease") == record.get("lease"):
            data.pop(key, None)


def publish_lease(registry, record):
    key = record["project_root"] + "\0" + record["unit"]
    with locked_registry(registry) as data:
        current = data.get(key)
        if not isinstance(current, dict) or current.get("lease") != record.get("lease"):
            raise PreviewError("preview reservation was lost before the server became ready")
        data[key] = record


def process_group_alive(pgid):
    if os.environ.get("SPRINT_PREVIEW_TEST_FORCE_GROUP_ALIVE") == "1":
        return True
    try:
        proc = subprocess.run(["ps", "-axo", "pgid=,stat="], text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        # Failure to prove the group empty must remain fail-closed.
        return True
    if proc.returncode != 0:
        return True
    for line in proc.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0].isdigit() and int(fields[0]) == pgid:
            if not fields[1].startswith("Z"):
                return True
    return False


def terminate_record(record, timeout=5, child=None):
    pid = int(record.get("pid") or 0)
    recorded_pgid = int(record.get("pgid") or pid)
    if not pid or recorded_pgid != pid:
        raise PreviewError("refusing cleanup: recorded preview no longer leads its process group")
    leader_alive = pid_exists(pid)
    if leader_alive:
        current_identity = pid_identity(pid)
        if not current_identity:
            raise PreviewError(
                "refusing cleanup: could not prove the recorded preview PID identity")
        if current_identity != record.get("pid_identity"):
            raise PreviewError("refusing cleanup: recorded preview PID identity no longer matches")
        if os.getpgid(pid) != recorded_pgid:
            raise PreviewError("refusing cleanup: recorded preview process group changed")
        executable = pid_executable(pid)
        if not executable or executable != record.get("pid_executable"):
            raise PreviewError("refusing cleanup: recorded preview command no longer matches")
    if not leader_alive and not recorded_listeners_still_own_group(record, recorded_pgid):
        raise PreviewError("refusing cleanup: recorded listener identity no longer matches")
    if leader_alive:
        if (pid_identity(pid) != record.get("pid_identity")
                or os.getpgid(pid) != recorded_pgid
                or pid_executable(pid) != record.get("pid_executable")):
            raise PreviewError("refusing cleanup: preview identity changed during verification")
    os.killpg(recorded_pgid, signal.SIGTERM)
    test_delay = float(os.environ.get("SPRINT_PREVIEW_TEST_POST_STOP_TERM_DELAY", "0"))
    if test_delay > 0:
        time.sleep(test_delay)
    deadline = time.time() + timeout
    while time.time() < deadline:
        if child is not None:
            child.poll()
        if not process_group_alive(recorded_pgid):
            if child is not None:
                child.wait(timeout=1)
            return
        time.sleep(0.05)
    if process_group_alive(recorded_pgid):
        if not pid_exists(pid):
            # A SIGKILLed supervisor can leave a proven listener member. Its
            # live PID prevents PGID reuse, but every durable predicate must
            # be rechecked immediately before escalation.
            if not recorded_listeners_still_own_group(record, recorded_pgid):
                raise PreviewError(
                    "refusing escalation: supervisor is gone and listener proof changed")
            if not recorded_listeners_still_own_group(record, recorded_pgid):
                raise PreviewError(
                    "refusing escalation: listener identity changed before SIGKILL")
            os.killpg(recorded_pgid, signal.SIGKILL)
            kill_deadline = time.time() + 2
            while time.time() < kill_deadline and process_group_alive(recorded_pgid):
                time.sleep(0.05)
            if process_group_alive(recorded_pgid):
                raise PreviewError("preview process group survived SIGKILL")
            return
        try:
            escalation_pgid = os.getpgid(pid)
        except ProcessLookupError:
            return
        if (pid_identity(pid) != record.get("pid_identity")
                or escalation_pgid != recorded_pgid
                or pid_executable(pid) != record.get("pid_executable")):
            raise PreviewError(
                "refusing escalation: preview identity changed after SIGTERM")
        os.killpg(recorded_pgid, signal.SIGKILL)
        kill_deadline = time.time() + 2
        while time.time() < kill_deadline and process_group_alive(recorded_pgid):
            time.sleep(0.05)
        if process_group_alive(recorded_pgid):
            raise PreviewError("preview process group survived SIGKILL")
    if child is not None:
        child.wait(timeout=1)


def terminate_launched_group(child, pgid, timeout=1, control=None):
    """Reap the exact session created by our still-owned Popen handle.

    Unlike record cleanup, this path deliberately does not depend on ps: the
    parent proves the new session's PGID directly from the kernel immediately
    after Popen, before any ownership lookup can fail or be interrupted.
    """
    if pgid != child.pid:
        raise PreviewError("refusing startup cleanup: child did not lead its process group")
    if child.poll() is None:
        try:
            if os.getpgid(child.pid) != pgid:
                raise PreviewError("refusing startup cleanup: child process group changed")
        except ProcessLookupError:
            child.poll()
    else:
        child.wait(timeout=1)
        proof = read_record(control) if control else None
        command_pid = int((proof or {}).get("command_pid") or 0)
        command_identity = (proof or {}).get("command_identity")
        command_pgid = int((proof or {}).get("command_pgid") or 0)
        settle_deadline = time.monotonic() + timeout
        while process_group_alive(pgid) and time.monotonic() < settle_deadline:
            time.sleep(0.05)
        if not process_group_alive(pgid):
            return
        if (not command_pid or command_pgid != pgid or not pid_exists(command_pid)
                or pid_identity(command_pid) != command_identity
                or os.getpgid(command_pid) != pgid):
            raise PreviewError(
                "refusing startup cleanup: supervisor died without a live exact group proof")
    with contextlib.suppress(ProcessLookupError):
        os.killpg(pgid, signal.SIGTERM)
    deadline = time.time() + timeout
    while time.time() < deadline:
        child.poll()
        if not process_group_alive(pgid):
            break
        time.sleep(0.05)
    if process_group_alive(pgid):
        if child.poll() is not None:
            # A reaped persistent supervisor proves no owned peer remains.
            return
        proof = read_record(control) if control else None
        try:
            escalation_pgid = os.getpgid(child.pid)
        except ProcessLookupError:
            return
        if (not proof or int(proof.get("supervisor_pid") or 0) != child.pid
                or int(proof.get("supervisor_pgid") or 0) != pgid
                or _system_pid_identity(child.pid) != proof.get("supervisor_identity")
                or pid_executable(child.pid) != proof.get("supervisor_executable")
                or escalation_pgid != pgid):
            raise PreviewError(
                "refusing startup escalation: supervisor identity changed after SIGTERM")
        with contextlib.suppress(ProcessLookupError):
            os.killpg(pgid, signal.SIGKILL)
    try:
        child.wait(timeout=2)
    except subprocess.TimeoutExpired as exc:
        raise PreviewError("could not reap the launched preview process") from exc


def child_command(command, host, port, live_url):
    if not command:
        raise PreviewError("start requires a command after --")
    replacements = {"{host}": host, "{port}": str(port), "{url}": live_url}
    return [replacements.get(part, part) for part in command]


def _supervisor_parent_alive(pid, identity):
    if not pid_exists(pid):
        return False
    try:
        proc = subprocess.run(["/bin/ps", "-o", "lstart=", "-p", str(pid)],
                              text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return True
    return proc.returncode == 0 and proc.stdout.strip() == identity


def _system_pid_identity(pid):
    try:
        proc = subprocess.run(["/bin/ps", "-o", "lstart=", "-p", str(pid)],
                              text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


def run_supervisor(spec_path, parent_fd):
    """Own the preview session until publication or exact group teardown.

    The supervisor is the permanent session leader. It never exits before its
    command group, so numeric PGID reuse cannot authorize a later signal. If
    the launching helper dies before creating the commit marker, the
    supervisor tears down its own group and releases only its exact lease.
    """
    with open(spec_path, encoding="utf-8") as src:
        spec = json.load(src)
    shutdown = {"requested": False}

    def request_shutdown(_signum, _frame):
        shutdown["requested"] = True

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, request_shutdown)
    spec.update({"supervisor_pid": os.getpid(), "supervisor_pgid": os.getpgrp(),
                 "supervisor_identity": _system_pid_identity(os.getpid()),
                 "supervisor_executable": os.path.realpath(sys.executable)})
    write_record(spec_path, spec)
    pre_command_delay = float(os.environ.get(
        "SPRINT_PREVIEW_TEST_SUPERVISOR_PRE_COMMAND_DELAY", "0"))
    if pre_command_delay:
        time.sleep(pre_command_delay)
    gate_read, gate_write = os.pipe()
    with open(spec["log"], "ab", buffering=0) as log:
        try:
            command = subprocess.Popen(
                [sys.executable, os.path.realpath(__file__), "--gated-exec",
                 str(gate_read), json.dumps(spec["command"])],
                cwd=spec["worktree"], env=os.environ.copy(),
                stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                pass_fds=(gate_read,))
        except OSError as exc:
            pathlib.Path(spec["ready"]).write_text(
                json.dumps({"error": str(exc)}), encoding="utf-8")
            return 127
        finally:
            os.close(gate_read)
    spec.update({"command_pid": command.pid,
                 "command_pgid": os.getpgid(command.pid),
                 "command_identity": _system_pid_identity(command.pid)})
    write_record(spec_path, spec)
    pre_ready_delay = float(os.environ.get(
        "SPRINT_PREVIEW_TEST_SUPERVISOR_PRE_READY_DELAY", "0"))
    if pre_ready_delay:
        time.sleep(pre_ready_delay)
    os.write(gate_write, b"1")
    os.close(gate_write)
    post_command_delay = float(os.environ.get(
        "SPRINT_PREVIEW_TEST_SUPERVISOR_POST_COMMAND_DELAY", "0"))
    if post_command_delay:
        time.sleep(post_command_delay)
    pathlib.Path(spec["ready"]).write_text(
        json.dumps({"command_pid": command.pid,
                    "command_identity": spec["command_identity"]}), encoding="utf-8")
    parent_lost = False
    inspection_failed_at = None

    def remove_owned_state():
        release_lease(spec["registry"], spec["lease"])
        remove_record_for_lease(spec["record_path"], spec["lease"])
        for artifact in (spec_path, spec["ready"], spec["commit"]):
            with contextlib.suppress(FileNotFoundError):
                os.unlink(artifact)

    while True:
        committed = os.path.exists(spec["commit"])
        parent_pipe_closed = bool(select.select([parent_fd], [], [], 0)[0])
        if parent_pipe_closed:
            try:
                parent_pipe_closed = os.read(parent_fd, 1) == b""
            except OSError:
                parent_pipe_closed = True
        launch_expired = time.monotonic() >= float(spec["launch_deadline"])
        if not committed and (parent_pipe_closed or launch_expired):
            parent_lost = True
            shutdown["requested"] = True
        if shutdown["requested"]:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(os.getpgrp(), signal.SIGTERM)
            deadline = time.monotonic() + 1
            while command.poll() is None and time.monotonic() < deadline:
                time.sleep(0.05)
            if parent_lost:
                remove_owned_state()
                # The supervisor is still the live group leader at this exact
                # signal. SIGKILL is delivered to the whole owned session.
                os.killpg(os.getpgrp(), signal.SIGKILL)
            if command.poll() is not None:
                state = _supervisor_group_state()
                if state == "empty":
                    remove_owned_state()
                    return command.returncode or 0
        elif command.poll() is not None:
            state = _supervisor_group_state()
            if state == "empty":
                remove_owned_state()
                return command.returncode or 0
            if state == "unknown":
                inspection_failed_at = inspection_failed_at or time.monotonic()
                if time.monotonic() - inspection_failed_at >= 2:
                    # The still-live supervisor proves exact group ownership.
                    # Bound tool failure by removing only our lease then
                    # atomically killing the entire owned session.
                    remove_owned_state()
                    os.killpg(os.getpgrp(), signal.SIGKILL)
            else:
                inspection_failed_at = None
        time.sleep(0.05)


def _supervisor_group_state():
    """Return live/empty/unknown for peers in this owned supervisor group."""
    test_mode = os.environ.get("SPRINT_PREVIEW_TEST_GROUP_INSPECTION")
    if test_mode == "fail":
        return "unknown"
    if test_mode == "timeout":
        time.sleep(2.1)
        return "unknown"
    try:
        proc = subprocess.Popen(["/bin/ps", "-axo", "pid=,pgid=,stat="], text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        inspector_pid = proc.pid
        stdout, _ = proc.communicate(timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        with contextlib.suppress(NameError, ProcessLookupError):
            proc.kill()
            proc.wait(timeout=1)
        return "unknown"
    if proc.returncode != 0:
        return "unknown"
    own_pid, own_pgid = os.getpid(), os.getpgrp()
    for line in stdout.splitlines():
        fields = line.split()
        if (len(fields) >= 3 and fields[0].isdigit() and fields[1].isdigit()
                and int(fields[0]) not in (own_pid, inspector_pid)
                and int(fields[1]) == own_pgid
                and not fields[2].startswith("Z")):
            return "live"
    return "empty"


def run_gated_exec(gate_fd, command_json):
    """Exec only after the supervisor durably records this exact child."""
    try:
        released = os.read(gate_fd, 1)
    finally:
        os.close(gate_fd)
    if released != b"1":
        return 125
    command = json.loads(command_json)
    os.execvpe(command[0], command, os.environ.copy())


def command_start(args, project_root, unit, unit_number, registry):
    worktree = os.path.realpath(args.worktree)
    if not os.path.isdir(worktree):
        raise PreviewError("worktree is not a directory: %s" % worktree)
    host = args.host or default_host()
    path = args.path if args.path.startswith("/") else "/" + args.path
    attempts = 0
    while attempts < PORT_SLOTS:
        attempts += 1
        with startup_signal_guard() as signal_state:
            lease = None
            child = None
            pgid = None
            control = None
            ready_path = None
            commit_path = None
            parent_write_fd = None
            record = None
            keep_running = False
            record_file = record_path(project_root, unit)
            try:
                lease, reused = reserve(registry, project_root, unit, unit_number, host)
                if reused:
                    # The preview was already durable before this invocation.
                    signal_state["committed"] = True
                    print(json.dumps(public_record(lease, reused=True), sort_keys=True))
                    sys.stdout.flush()
                    keep_running = True
                    return 0
                raise_if_startup_interrupted()
                port = int(lease["port"])
                live_url = "http://%s:%d%s" % (host, port, path)
                log_path = os.path.realpath(args.log or os.path.join(
                    project_root, ".sprint", "previews", unit + ".log"))
                pathlib.Path(log_path).parent.mkdir(parents=True, exist_ok=True)
                command = child_command(args.command, host, port, live_url)
                env = os.environ.copy()
                env.update({"SPRINT_PREVIEW_HOST": host,
                            "SPRINT_PREVIEW_PORT": str(port),
                            "SPRINT_PREVIEW_URL": live_url})
                control = "%s.%s.supervisor" % (record_file, lease["lease"])
                ready_path = control + ".ready"
                commit_path = control + ".commit"
                supervisor_spec = {
                    "command": command, "worktree": worktree,
                    "log": log_path, "ready": ready_path, "commit": commit_path,
                    "parent_pid": os.getpid(),
                    "parent_identity": pid_identity(os.getpid()),
                    "launch_deadline": time.monotonic() + 60,
                    "registry": registry, "lease": lease,
                    "record_path": record_file,
                }
                write_record(control, supervisor_spec)
                parent_read_fd, parent_write_fd = os.pipe()
                try:
                    child = subprocess.Popen(
                        [sys.executable, os.path.realpath(__file__),
                         "--supervise", control, str(parent_read_fd)],
                        cwd=worktree, env=env,
                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, start_new_session=True,
                        pass_fds=(parent_read_fd,),
                        preexec_fn=lambda: signal.pthread_sigmask(
                            signal.SIG_SETMASK, signal_state["child_signal_mask"]))
                except OSError as exc:
                    raise PreviewError("could not launch preview supervisor: %s" % exc) from exc
                finally:
                    os.close(parent_read_fd)
                # start_new_session=True establishes this contract in the
                # child before exec. Capture the candidate synchronously from
                # our Popen handle so cleanup remains possible even when a
                # fast wrapper forks the listener and exits before getpgid.
                pgid = child.pid
                post_popen_delay = float(os.environ.get(
                    "SPRINT_PREVIEW_TEST_POST_POPEN_DELAY", "0"))
                if post_popen_delay > 0:
                    time.sleep(post_popen_delay)
                try:
                    observed_pgid = os.getpgid(child.pid)
                except ProcessLookupError:
                    observed_pgid = None
                if observed_pgid is not None and observed_pgid != pgid:
                    raise PreviewError("preview child did not establish its own process group")
                raise_if_startup_interrupted()
                supervisor_deadline = time.monotonic() + 5
                while not os.path.exists(ready_path) and time.monotonic() < supervisor_deadline:
                    if child.poll() is not None:
                        break
                    time.sleep(0.02)
                supervisor_ready = read_record(ready_path)
                if not supervisor_ready or supervisor_ready.get("error"):
                    raise PreviewError("preview supervisor could not launch the command")
                identity = pid_identity(child.pid)
                if not identity:
                    raise PreviewError("could not record the preview process identity")
                launched_command = pid_command(child.pid)
                if not launched_command:
                    raise PreviewError("could not record the preview process command")
                launched_executable = pid_executable(child.pid)
                if not launched_executable:
                    raise PreviewError("could not record the preview process executable")
                raise_if_startup_interrupted()
                record = dict(lease)
                record.update({
                    "status": "running",
                    "pid": child.pid,
                    "pgid": pgid,
                    "pid_identity": identity,
                    "pid_command": launched_command,
                    "pid_executable": launched_executable,
                    "worktree": worktree,
                    "command": command,
                    "command_pid": supervisor_ready.get("command_pid"),
                    "supervisor_control": control,
                    "supervisor_commit": commit_path,
                    "path": path,
                    "live_url": live_url,
                    "log": log_path,
                    "record_path": record_file,
                    "registry": registry,
                    "started_at": time.time(),
                })
                deadline = time.time() + args.timeout
                ready = False
                while time.time() < deadline:
                    if child.poll() is not None:
                        break
                    if listener_owned(record) and http_reachable(host, port, path):
                        ready = True
                        break
                    raise_if_startup_interrupted()
                    time.sleep(0.1)
                if ready:
                    raise_if_startup_interrupted()
                    stable_deadline = time.monotonic() + 10
                    previous_proofs = None
                    stable_proofs = None
                    while time.monotonic() < stable_deadline:
                        try:
                            observed_proofs = capture_listener_proofs(record)
                        except PreviewError as exc:
                            if "could not capture exact preview listener ownership" not in str(exc):
                                raise
                            observed_proofs = None
                        if (observed_proofs and observed_proofs == previous_proofs
                                and http_reachable(host, port, path)):
                            stable_proofs = observed_proofs
                            break
                        previous_proofs = observed_proofs
                        raise_if_startup_interrupted()
                        time.sleep(0.2)
                    if not stable_proofs:
                        raise PreviewError("preview listener was not stable before publication")
                    record["listener_proofs"] = stable_proofs
                    record["published"] = True
                    write_record(record_file, record)
                    raise_if_startup_interrupted()
                    publish_lease(registry, record)
                    if record_state(record, require_http=True) != "live":
                        raise PreviewError("preview ownership was not immediately readable")
                    pathlib.Path(commit_path).touch(mode=0o600, exist_ok=True)
                    os.close(parent_write_fd)
                    parent_write_fd = None
                    signal_state["committed"] = True
                    post_publish_delay = float(os.environ.get(
                        "SPRINT_PREVIEW_TEST_POST_PUBLISH_DELAY", "0"))
                    if post_publish_delay > 0:
                        time.sleep(post_publish_delay)
                    print(json.dumps(public_record(record), sort_keys=True))
                    sys.stdout.flush()
                    keep_running = True
                    return 0
            except DetachedCleanupError as exc:
                if record is not None and exc.escaped:
                    record["status"] = "cleanup_required"
                    record["escaped_group"] = exc.escaped
                    write_record(record_file, record)
                    publish_lease(registry, record)
                    pathlib.Path(commit_path).touch(mode=0o600, exist_ok=True)
                    if parent_write_fd is not None:
                        os.close(parent_write_fd)
                        parent_write_fd = None
                    keep_running = True
                raise
            finally:
                if not keep_running:
                    if parent_write_fd is not None:
                        with contextlib.suppress(OSError):
                            os.close(parent_write_fd)
                    if child is not None:
                        terminate_launched_group(child, pgid, timeout=1,
                                                 control=control)
                    if lease is not None:
                        release_lease(registry, lease)
                        remove_record_for_lease(record_file, lease)
                    for cleanup_path in (control, ready_path, commit_path):
                        if cleanup_path:
                            with contextlib.suppress(FileNotFoundError):
                                os.unlink(cleanup_path)
        # A listener race or a child bind failure is recoverable on another
        # reserved port. Other startup failures are surfaced after a few tries.
        if attempts >= 3:
            raise PreviewError("preview did not become an owned HTTP listener; see %s" % log_path)
    raise PreviewError("preview could not start on any reserved port")


def command_verify(args, project_root, unit, registry):
    path = record_path(project_root, unit)
    record = read_record(path)
    if not record:
        raise PreviewError("no preview ownership record for %s" % unit)
    key = project_root + "\0" + unit
    with locked_registry(registry) as data:
        current = data.get(key)
        if not isinstance(current, dict) or current.get("lease") != record.get("lease"):
            raise PreviewError("preview is not the machine registry owner")
    if args.url and args.url.rstrip("/") != record.get("live_url", "").rstrip("/"):
        raise PreviewError("live_url does not match the owned preview: %s" % record.get("live_url"))
    if not record_alive(record, require_http=True):
        raise PreviewError("preview URL is not served by its recorded process")
    print(json.dumps(public_record(record, reused=True), sort_keys=True))
    return 0


def command_stop(args, project_root, unit, registry):
    with startup_signal_guard() as signal_state:
        path = record_path(project_root, unit)
        record = read_record(path)
        if not record:
            signal_state["committed"] = True
            print(json.dumps({"project_root": project_root, "unit": unit,
                              "stopped": False, "reason": "not running"}, sort_keys=True))
            return 0
        key = project_root + "\0" + unit
        with locked_registry(registry) as data:
            current = data.get(key)
            if not isinstance(current, dict) or current.get("lease") != record.get("lease"):
                raise PreviewError("refusing cleanup: board no longer owns this preview lease")
        escaped = record.get("escaped_group")
        if escaped:
            resume_escaped_cleanup(record, escaped)
        terminate_record(record, timeout=args.timeout)
        release_lease(registry, record)
        remove_record_for_lease(path, record)
        for cleanup_path in (record.get("supervisor_control"),
                             (record.get("supervisor_control") or "") + ".ready",
                             record.get("supervisor_commit")):
            if cleanup_path:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(cleanup_path)
        signal_state["committed"] = True
        print(json.dumps({"project_root": project_root, "unit": unit,
                          "port": record.get("port"), "pid": record.get("pid"),
                          "stopped": True}, sort_keys=True))
        sys.stdout.flush()
        return 0


def main(argv):
    if len(argv) == 3 and argv[0] == "--supervise":
        return run_supervisor(argv[1], int(argv[2]))
    if len(argv) == 3 and argv[0] == "--gated-exec":
        return run_gated_exec(int(argv[1]), argv[2])
    args = parse_args(argv)
    try:
        project_root = resolve_project_root(args.project_root, args.server)
        unit, unit_number = resolve_unit(args.card, args.server, args.token)
        registry = registry_path(args.registry)
        if args.action == "start":
            return command_start(args, project_root, unit, unit_number, registry)
        if args.action == "verify":
            return command_verify(args, project_root, unit, registry)
        return command_stop(args, project_root, unit, registry)
    except PreviewError as exc:
        print("sprint-preview: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
