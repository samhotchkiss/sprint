#!/usr/bin/env python3
"""sprint-ready — submit an evidence packet to flip a card to ready.

Usage:
  sprint-ready <num> <packet.json> [--server URL] [--token TOKEN]

The packet file must be a JSON object:
  {
    "claim": "one sentence describing what shipped",
    "diffstat": "3 files changed, 42 insertions(+), 5 deletions(-)",
    "branch": "sprint-card-42",
    "test_cmd": "go test ./...",
    "test_result": "12 pass, 0 fail",
    "validate": ["Run `go run ./cmd/foo --dry-run`", "Confirm it prints \"ok\" not \"error\""],
    "ui_change": false,
    "screenshots": ["/absolute/path/light.png", "/absolute/path/dark.png"],
    "reports": ["/absolute/path/findings.md"],
    "live_url": "http://100.x.x.x:8402/...",
    "per_card": [{"card_num": 42, "claim": "...", "screenshots": [...]}]
  }

claim, diffstat, branch, test_cmd, test_result, validate, and ui_change
are always required for ordinary (code) work.

Non-code work sets "work_kind": "ops" and proves itself differently: a
mailbox reprocess has no diff, no branch and no preview, so the required
set becomes claim, validate and readback -- the log excerpt or command
output you actually observed. test_cmd/test_result stay optional (and
still need real counts if you give them), and diffstat/branch/ui_change/
screenshots are not required at all. Pass readback as a string or an
array of strings; the board renders it preformatted, verbatim.

Prime rule (user, verbatim): "we need to make sure there's a way for
the human to easily validate the fix without having to read the code.
so, either before/after screenshots or a link to a staging url for the
branch." Every ready card must be validatable with zero code reading.

A packet is ONE of the two things an agent can hand over, and the other
one is not this command. User's rule, verbatim: "needs you is where we
talk through things. review means the session genuinely thinks the card
is 100% complete. needs you is that the card is waiting for my input
before it can keep moving forward."

  evidence packet   sprint-ready   "I believe this is done."       → ready
  decision request  sprint-ask     "I need you to choose/answer
                                    before I continue."            → needs_you

So mockups to pick between, a design call, a "which of these three":
those go through `sprint-ask` with `--options/--url/--attach/--notes`,
never through the gate. This command prints an advisory notice on stderr
(never a refusal) when a packet looks like a question in disguise.

- test_result must report BOTH a pass count and a fail count (e.g.
  "12 pass, 0 fail" — "passed"/"passing"/"ok" and "failed"/"failing"/
  "error" also count as the respective word), never prose like "tests
  pass" with no numbers.
- validate is 1-3 plain-English steps a human follows to confirm the
  fix WITHOUT reading code — an exact observable check (a command whose
  before/after output differs, a URL to hit, a behavior to try), never
  "read the diff". Pass it as a JSON array of 1-3 strings, or a single
  non-empty string.
- screenshots and live_url are required when ui_change is true — capture
  before/after, light AND dark, from YOUR OWN worktree's preview, never
  a shared dev server. Start it with `bin/sprint-preview` and copy the exact
  live_url from that helper's JSON output. This command verifies that the URL
  is reachable through its advertised host and that the listener belongs to
  the process recorded for this board/card. Leave it running until the verdict
  lands — the card's "See it live" button links there.
- reports is OPTIONAL: absolute paths to documents your work produced (a
  findings write-up, a comparison table). Prefer .md — markdown renders
  with the board's own typography; .html is supported for documents that
  arrive already-HTML, but renders sandboxed and unstyled. They ride the
  same path screenshots do — the board reads them off disk, renders them,
  and shows each one in the packet behind a skim line, as well as in the
  sprint's Reports library. Evidence a human can read is evidence; a
  report is never a substitute for `validate`.
- For batches, set per_card to one entry per member card; every entry
  needs card_num and claim.

This validates the packet CLIENT-SIDE first (same rules the server's 422
gate enforces) so you get one clear, named failing field instead of a
round-trip. On a 422 from the server, fix the named field(s) and retry.

Stdlib only (urllib). No third-party deps.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

REQUIRED_STR_FIELDS = ("claim", "diffstat", "branch", "test_cmd", "test_result")
# Fields that belong to a DECISION REQUEST (sprint-ask), never to a packet. A
# packet that carries one is a question wearing a packet's clothes.
DECISION_FIELDS = ("options", "question", "artifacts", "choices")
# A `validate` step (or a claim) that reads as a question rather than as a check
# the user performs. "Confirm the header does not overlap?" never happens by
# accident; "Which of these three do you want?" does.
ASK_OPENERS = re.compile(
    r"^\s*(which|should|would|could|do you|did you|are you|is this|is that|what|"
    r"who|pick|choose|prefer|shall|can you|let me know|tell me|thoughts)\b",
    re.IGNORECASE)
# Mirrors bin/sprintd's WORK_KINDS.
WORK_KINDS = ("code", "ops")
# Mirrors bin/sprintd's PASS_RE / FAIL_RE exactly — both must match.
PASS_RE = re.compile(r"(\d+)\s*(?:pass|passed|passing|ok)\b", re.IGNORECASE)
FAIL_RE = re.compile(r"(\d+)\s*(?:fail|failed|failing|error)", re.IGNORECASE)


def fail(field, detail=""):
    msg = f"sprint-ready: missing required field: {field}"
    if detail:
        msg += f" ({detail})"
    print(msg, file=sys.stderr)
    sys.exit(2)


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="sprint-ready",
        description="Submit an evidence packet to flip a card to ready.",
    )
    p.add_argument("num", nargs="?", help="card number (batch: any one member card)")
    p.add_argument("packet", nargs="?", help="path to packet.json")
    p.add_argument("--server", default=os.environ.get("SPRINT_SERVER"),
                    help="server base URL, e.g. http://100.x.x.x:8377 (or SPRINT_SERVER env)")
    p.add_argument("--token", default=os.environ.get("SPRINT_TOKEN"),
                    help="bearer token (or SPRINT_TOKEN env)")
    return p.parse_args(argv)


def readback_text(packet):
    """The observed evidence as one blob. Mirrors sprintd's App.readback_text."""
    val = packet.get("readback")
    if isinstance(val, str):
        return val.strip()
    if isinstance(val, list):
        lines = [s for s in val if isinstance(s, str)]
        if len(lines) != len(val):
            return ""
        return "\n".join(lines).strip()
    return ""


def validate_packet(packet):
    if not isinstance(packet, dict):
        fail("packet", "top-level JSON must be an object")

    work_kind = packet.get("work_kind") or "code"
    if not isinstance(work_kind, str) or work_kind.strip().lower() not in WORK_KINDS:
        fail("work_kind", 'must be "code" (the default) or "ops"')
    work_kind = work_kind.strip().lower()
    ops = work_kind == "ops"

    if ops:
        # Ops work swaps the required set rather than relaxing it: what it can
        # show is what actually came back, so that is what it owes.
        claim = packet.get("claim")
        if not isinstance(claim, str) or not claim.strip():
            fail("claim", "must be a non-empty string")
        if not readback_text(packet):
            fail("readback", "required for ops work — the log excerpt or command "
                             "output you observed, as a string or array of strings")
    else:
        for field in REQUIRED_STR_FIELDS:
            value = packet.get(field)
            if not isinstance(value, str) or not value.strip():
                fail(field, "must be a non-empty string")

        if " " in packet["branch"] or "\n" in packet["branch"]:
            fail("branch", "not a valid git branch name (contains whitespace)")

    test_result = packet.get("test_result")
    if isinstance(test_result, str) and test_result.strip():
        if not (PASS_RE.search(test_result) and FAIL_RE.search(test_result)):
            fail("test_result", 'must report a pass count AND a fail count, e.g. "12 pass, 0 fail" — not prose like "tests pass"')
    elif not ops:
        fail("test_result", "must be a non-empty string")

    if "ui_change" in packet and not isinstance(packet.get("ui_change"), bool):
        fail("ui_change", "must be true or false")
    if not ops and not isinstance(packet.get("ui_change"), bool):
        fail("ui_change", "required — must be true or false")
    ui_change = bool(packet.get("ui_change"))

    if "validate" not in packet:
        fail("validate", "required — 1-3 plain-English steps a human follows to confirm the fix without reading code")
    validate_steps = packet["validate"]
    if isinstance(validate_steps, str):
        if not validate_steps.strip():
            fail("validate", "must not be empty")
    elif isinstance(validate_steps, list):
        if not (1 <= len(validate_steps) <= 3):
            fail("validate", "must have 1-3 steps")
        if not all(isinstance(s, str) and s.strip() for s in validate_steps):
            fail("validate", "each step must be a non-empty string")
    else:
        fail("validate", "must be a non-empty string or a JSON array of 1-3 non-empty strings")

    screenshots = packet.get("screenshots")
    if screenshots is not None and not (isinstance(screenshots, list) and all(isinstance(s, str) for s in screenshots)):
        fail("screenshots", "must be a JSON array of attachment path/ref strings")

    if ui_change and not screenshots:
        fail("screenshots", "required when ui_change is true — capture light AND dark from your own worktree's preview")

    # Optional documents. Checked here the same way screenshots are — a shape
    # error should name itself at the command line, not come back as a 422.
    reports = packet.get("reports")
    if reports is not None:
        if not (isinstance(reports, list) and all(isinstance(s, str) for s in reports)):
            fail("reports", "must be a JSON array of .md/.html path/ref strings")
        for ref in reports:
            if not ref.strip():
                fail("reports", "a report entry is empty")
            if not ref.lower().endswith((".md", ".markdown", ".mdown", ".html", ".htm")):
                fail("reports", f"a report must be .md or .html — got {ref!r}")
            if ref.lower().endswith((".html", ".htm")):
                # Supported, not preferred. Say so once; don't block the packet.
                print(f"sprint-ready: {os.path.basename(ref)} is HTML — it renders "
                      "sandboxed and unstyled. Prefer .md: markdown renders with the "
                      "board's own typography. Accepting it anyway.", file=sys.stderr)

    live_url = packet.get("live_url")
    if live_url is not None and not isinstance(live_url, str):
        fail("live_url", "must be a string")
    if ui_change and not (isinstance(live_url, str) and live_url.strip()):
        fail("live_url", "required when ui_change is true — use sprint-preview so the URL has a verified owner")

    per_card = packet.get("per_card")
    if per_card is not None:
        if not isinstance(per_card, list) or not per_card:
            fail("per_card", "must be a non-empty JSON array (one entry per member card) when present")
        for i, entry in enumerate(per_card):
            if not isinstance(entry, dict):
                fail(f"per_card[{i}]", "must be an object")
            if "card_num" not in entry or not isinstance(entry["card_num"], int):
                fail(f"per_card[{i}].card_num", "must be an integer card number")
            claim = entry.get("claim")
            if not isinstance(claim, str) or not claim.strip():
                fail(f"per_card[{i}].claim", "must be a non-empty string")
            entry_shots = entry.get("screenshots")
            if entry_shots is not None and not (isinstance(entry_shots, list) and all(isinstance(s, str) for s in entry_shots)):
                fail(f"per_card[{i}].screenshots", "must be a JSON array of attachment path/ref strings")


def warn(message):
    print("sprint-ready: " + message, file=sys.stderr)


def verify_owned_preview(num, packet, server, token):
    """A UI packet may advertise only the URL owned by this board/card."""
    if not packet.get("ui_change"):
        return
    helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sprint-preview")
    env = os.environ.copy()
    env["SPRINT_SERVER"] = server
    env["SPRINT_TOKEN"] = token
    proc = subprocess.run(
        [helper, "verify", str(num), "--url", packet["live_url"]],
        env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        timeout=15, check=False)
    if proc.returncode:
        detail = proc.stderr.strip() or "ownership check failed"
        fail("live_url", "%s; start it with sprint-preview and use the returned URL" % detail)


def decision_smells(packet):
    """Does this packet actually want to be a DECISION REQUEST?

    User's rule, verbatim: "needs you is where we talk through things. review
    means the session genuinely thinks the card is 100% complete. needs you is
    that the card is waiting for my input before it can keep moving forward."

    A packet says "I believe this is done". A question says "I need you to
    choose before I continue". They land in different columns and they mean
    different things to the person reading them, so a packet that is really a
    question is a wrong answer to a question the user asks every time he opens
    the board. Advisory ONLY — printed on stderr, never a gate: the packet has
    passed the real rules, and this is judgment, not validation.
    """
    out = []
    present = [f for f in DECISION_FIELDS if packet.get(f)]
    if present:
        out.append(
            "this packet carries %s, which a packet has no field for. Options and "
            "artifacts belong on a DECISION REQUEST: `sprint-ask <num> \"...\" "
            "--options '[...]' --url ... --attach ...` lands the card in needs_you, "
            "where the user answers it. Sending it through the gate instead asks "
            "him to sign off on work you have said is unfinished."
            % ", ".join(present))

    steps = packet.get("validate")
    if isinstance(steps, str):
        steps = [steps]
    asks = [s for s in (steps or [])
            if isinstance(s, str) and (s.strip().endswith("?") or ASK_OPENERS.match(s))]
    if asks:
        out.append(
            "a `validate` step reads like a question, not a check: %r. `validate` "
            "is what the USER does to confirm the work ('open X, the header does "
            "not overlap'). If you are actually asking him to decide something, "
            "that is `sprint-ask` (add --url/--attach so he can see what he is "
            "choosing between) and the card waits in needs_you." % asks[0].strip())

    claim = packet.get("claim")
    if isinstance(claim, str) and claim.strip().endswith("?"):
        out.append(
            "`claim` is a question. A claim is one sentence saying what SHIPPED; "
            "if you cannot write one yet, the card is not ready — ask instead.")
    return out


def main(argv):
    args = parse_args(argv)

    if not args.num:
        fail("num", "card number, e.g. sprint-ready 42 packet.json")
    try:
        num = int(args.num)
    except ValueError:
        fail("num", f"must be an integer, got {args.num!r}")

    if not args.packet:
        fail("packet", "path to a packet.json file")
    if not os.path.isfile(args.packet):
        fail("packet", f"no such file: {args.packet}")

    try:
        with open(args.packet, "r", encoding="utf-8") as f:
            packet = json.load(f)
    except json.JSONDecodeError as e:
        fail("packet", f"not valid JSON: {e}")

    validate_packet(packet)
    for line in decision_smells(packet):
        warn(line)

    if not args.server:
        fail("server", "pass --server or set SPRINT_SERVER")
    if not args.token:
        fail("token", "pass --token or set SPRINT_TOKEN")

    verify_owned_preview(num, packet, args.server.rstrip("/"), args.token)

    body = json.dumps({"packet": packet}).encode("utf-8")
    server = args.server.rstrip("/")
    url = f"{server}/api/cards/{num}/ready"
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {args.token}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            resp.read()
            print(f"sprint-ready: #{num} is now ready for review.")
            return 0
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")
        if e.code == 422:
            print(f"sprint-ready: server rejected the packet (422) — fix and retry: {detail}", file=sys.stderr)
        else:
            print(f"sprint-ready: server rejected the packet ({e.code}): {detail}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"sprint-ready: could not reach {server}: {e.reason}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
