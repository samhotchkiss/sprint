#!/usr/bin/env python3
"""sprint-post — post a progress/chat/note/error event to a sprint card.

Usage:
  sprint-post <num> <kind> <text...> [--detail TEXT | --detail-file PATH]
                                     [--long-running] [--server URL] [--token TOKEN]
  sprint-post <num> phase "<phase>" [--expect 300]

  kind must be one of: progress, chat, note, error, phase

`phase` is sugar for a progress event that says what you are DOING right now
rather than what you last finished:

  sprint-post 42 phase "reading"
  sprint-post 42 phase "testing" --expect 300
  sprint-post 42 phase "capturing evidence" --expect 4m

The card face renders it as a chip on its own clock ("testing · 2m") in place
of a status line that goes stale the moment you write it. Recommended (not
enforced) vocabulary: reading, coding, testing, capturing evidence, assembling
packet, waiting. Declare one at every stretch boundary, and pass --expect for
anything slower than two minutes: while a declared phase is inside the time it
claimed, the board holds off its five-minute silence timer — and once that time
is up with no new word, the chip goes amber and says so.

Every event is TWO things: a one-line `text` you can skim in a scrolling
timeline, and an OPTIONAL `detail` you can expand when you want to dig in
(command output, a test log, the reasoning behind the line). The board shows
the one-liner and hides the detail behind a "more" toggle.

  sprint-post 42 progress "suite green — 118 pass, 0 fail" --detail-file /tmp/test.log
  sprint-post 42 note "picked sqlite over a file lock" --detail "Three reasons: ..."

`text` is kept to one line and 140 characters. Too long is never an error: it
gets truncated with a notice on stderr, and if you didn't pass a detail of your
own the full text is moved into `detail` so nothing you wrote is lost.

Reads server URL and bearer token from --server/--token or the
SPRINT_SERVER / SPRINT_TOKEN environment variables. Validates client-side
before making any network call; on a validation failure it prints exactly
one named missing/invalid field to stderr and exits 2. Network errors
(server unreachable, non-2xx response) are reported and exit 1 — the
caller decides whether to retry.

Stdlib only (urllib). No third-party deps.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

KINDS = ("progress", "chat", "note", "error")
# `phase` is not an event kind on the wire — it is a progress event carrying
# payload.phase. One word at the command line, one concept on the board.
PHASE_KIND = "phase"
PHASE_MAX = 40
PHASE_EXPECT_MAX = 24 * 3600
RECOMMENDED_PHASES = ("reading", "coding", "testing", "capturing evidence",
                      "assembling packet", "waiting")

# The one-liner is what a human skims in a scrolling timeline; anything longer
# belongs in --detail. Big detail still gets a ceiling so a runaway log can't
# blow past the server's request cap.
ONE_LINER_MAX = 140
DETAIL_MAX = 200_000


def fail(field, why=""):
    msg = f"sprint-post: missing required field: {field}"
    if why:
        msg += f" ({why})"
    print(msg, file=sys.stderr)
    sys.exit(2)


def notice(msg):
    print(f"sprint-post: {msg}", file=sys.stderr)


def one_line(text, limit=ONE_LINER_MAX):
    s = str("" if text is None else text).strip().split("\n")[0].strip()
    return s if len(s) <= limit else s[:limit - 1].rstrip() + "…"


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="sprint-post",
        description="Post a progress/chat/note/error event to a sprint card.",
    )
    p.add_argument("num", nargs="?", help="card number")
    p.add_argument("kind", nargs="?", help="progress|chat|note|error|phase")
    p.add_argument("text", nargs="*", help="event text (quote it, or pass multiple words)")
    p.add_argument("--expect", default=None,
                    help="phase only: how long this stretch should take — seconds, "
                         "or 90s / 5m / 1h")
    p.add_argument("--detail", default=None,
                    help="optional expanded version (multi-line ok): output, reasoning, a log")
    p.add_argument("--detail-file", default=None, dest="detail_file",
                    help="read the expanded version from a file (e.g. a captured test log)")
    p.add_argument("--long-running", action="store_true", dest="long_running",
                    help="mark this as a legit long-running step (suppresses the 5-minute silence timer)")
    p.add_argument("--server", default=os.environ.get("SPRINT_SERVER"),
                    help="server base URL, e.g. http://100.x.x.x:8377 (or SPRINT_SERVER env)")
    p.add_argument("--token", default=os.environ.get("SPRINT_TOKEN"),
                    help="bearer token (or SPRINT_TOKEN env)")
    return p.parse_args(argv)


def validate(args):
    if not args.num:
        fail("num", "card number, e.g. sprint-post 42 progress \"...\"")
    try:
        num = int(args.num)
    except ValueError:
        fail("num", f"must be an integer, got {args.num!r}")
    if not args.kind:
        fail("kind", f"must be one of: {', '.join(KINDS + (PHASE_KIND,))}")
    if args.kind not in KINDS and args.kind != PHASE_KIND:
        fail("kind", f"{args.kind!r} is not one of: {', '.join(KINDS + (PHASE_KIND,))}")
    text = " ".join(args.text).strip()
    if not text:
        fail("text", "the event text is empty"
                     if args.kind != PHASE_KIND else
                     "name the phase, e.g. sprint-post %d phase \"testing\"" % num)
    if args.expect is not None and args.kind != PHASE_KIND:
        fail("expect", "--expect only means anything on a phase: "
                       "sprint-post %d phase \"testing\" --expect 300" % num)
    if not args.server:
        fail("server", "pass --server or set SPRINT_SERVER")
    if not args.token:
        fail("token", "pass --token or set SPRINT_TOKEN")
    return num, args.kind, text, read_detail(args)


UNITS = {"s": 1, "m": 60, "h": 3600}


def parse_expect(raw):
    """`--expect` → whole seconds. Plain seconds, or 90s / 5m / 1h."""
    if raw is None:
        return None
    s = str(raw).strip().lower()
    mult = 1
    if s and s[-1] in UNITS:
        mult, s = UNITS[s[-1]], s[:-1].strip()
    try:
        value = float(s)
    except ValueError:
        fail("expect", f"must be a number of seconds (or 90s / 5m / 1h), got {raw!r}")
    seconds = value * mult
    if seconds <= 0:
        fail("expect", f"must be greater than zero, got {raw!r}")
    if seconds > PHASE_EXPECT_MAX:
        fail("expect", f"must be no more than 24h, got {raw!r}")
    return int(round(seconds))


def human_duration(seconds):
    """"5m" / "90s" / "1h 30m" — how the expectation reads back to a human."""
    seconds = int(seconds)
    if seconds < 60:
        return "%ds" % seconds
    minutes, rest = divmod(seconds, 60)
    if minutes < 60:
        return "%dm" % minutes if not rest else "%dm %ds" % (minutes, rest)
    hours, mins = divmod(minutes, 60)
    return "%dh" % hours if not mins else "%dh %dm" % (hours, mins)


def phase_payload(phase, expect):
    """The progress event a `phase` post really is: a chip, a clock, and a
    one-liner that still stands on its own in the timeline."""
    phase = one_line(phase, PHASE_MAX)
    payload = {"phase": phase}
    if expect is None:
        payload["text"] = "phase: %s" % phase
    else:
        payload["expected_seconds"] = expect
        payload["text"] = "phase: %s (expect ~%s)" % (phase, human_duration(expect))
    return payload


def read_detail(args):
    """--detail / --detail-file → one string (or None). They're exclusive."""
    if args.detail is not None and args.detail_file is not None:
        fail("detail", "pass --detail or --detail-file, not both")
    detail = args.detail
    if args.detail_file is not None:
        try:
            with open(args.detail_file, "r", encoding="utf-8", errors="replace") as fh:
                detail = fh.read()
        except OSError as e:
            fail("detail-file", f"could not read {args.detail_file}: {e.strerror or e}")
    if detail is None:
        return None
    if not detail.strip():
        return None                       # empty file / empty string: nothing to expand
    if len(detail) > DETAIL_MAX:
        notice(f"detail is {len(detail)} chars — keeping the first {DETAIL_MAX}")
        detail = detail[:DETAIL_MAX].rstrip() + f"\n\n… [truncated at {DETAIL_MAX} characters]"
    return detail.rstrip()


def skim_line(text, detail):
    """Keep `text` to one skimmable line. Never rejects: it truncates, says so
    on stderr, and moves the full text into `detail` so nothing you wrote is
    lost -- the timeline stays skimmable, the words stay readable."""
    line = one_line(text)
    if line == text.strip():
        return line, detail
    notice(f"text was longer than one line / {ONE_LINER_MAX} chars — kept the first "
           "line as the one-liner and moved the full text into the expanded detail")
    full = text.strip()
    return line, full if detail is None else full + "\n\n" + detail


def main(argv):
    args = parse_args(argv)
    num, kind, text, detail = validate(args)

    if kind == PHASE_KIND:
        # Sugar, not a new event kind: the wire still sees a progress event.
        payload = phase_payload(text, parse_expect(args.expect))
        kind = "progress"
    else:
        text, detail = skim_line(text, detail)
        payload = {"text": text}
    if detail:
        payload["detail"] = detail
    if args.long_running:
        payload["long_running"] = True

    body = json.dumps({"kind": kind, "payload": payload}).encode("utf-8")
    server = args.server.rstrip("/")
    url = f"{server}/api/cards/{num}/events"
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {args.token}",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            resp.read()
            extra = f" (+{len(detail)} chars of detail)" if detail else ""
            if "phase" in payload:
                said = payload["phase"]
                if payload.get("expected_seconds"):
                    said += " (expect ~%s)" % human_duration(payload["expected_seconds"])
                print(f"sprint-post: #{num} is now {said}{extra}")
            else:
                print(f"sprint-post: posted {kind} event to #{num}{extra}")
            return 0
    except urllib.error.HTTPError as e:
        why = e.read().decode("utf-8", "replace")
        print(f"sprint-post: server rejected the event ({e.code}): {why}", file=sys.stderr)
        return 1
    except urllib.error.URLError as e:
        print(f"sprint-post: could not reach {server}: {e.reason}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
