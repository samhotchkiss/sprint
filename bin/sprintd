#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sprintd — the state server behind the `sprint` Claude Code plugin.

Single file, Python 3.9+, standard library only.

The server owns STATE only. The Claude Code session is the only brain: it
dispatches, resumes, nudges, batches, merges and escalates. sprintd never runs
agents and never makes decisions -- it validates transitions, appends to an
append-only event log, and hands the session a cursor to drain.

Subcommands: start | stop | status | tail | wait | doctor | hub
"""

from __future__ import annotations

import argparse
import base64
import binascii
import datetime
import errno
import hashlib
import http.client
import json
import mimetypes
import os
import re
import secrets
import shutil
import signal
import socket
import sqlite3
import subprocess
import sys
import threading
import time
import traceback
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# --------------------------------------------------------------------------
# Constants
# --------------------------------------------------------------------------

DEFAULT_PORT = 8377
PORT_SCAN_LIMIT = 40            # how far past a taken port to look for a free one
DEFAULT_HUB_PORT = 8300         # one hub per machine, fixed so the URL is memorable

# What this server can DO, as one number a client can compare itself against.
# The generation says WHICH process answered; this says what that process knows
# how to serve. Bump it whenever web/ starts depending on an endpoint or a field
# a running server might not have. (It used to say "and bump UI_API_VERSION in
# web/api.js in the same commit" -- there is no such constant any more; the page
# stopped comparing itself against this the day the server started restarting
# itself, and the line outlived the mechanism it described.)
#
# It used to be the trigger for a banner telling the HUMAN to run `sprintd stop`
# then `sprintd start`. It no longer is, and never will be again: a board that
# notices its own code changed restarts itself (see `check_code_update`), so the
# gap this number measures closes on its own within seconds. What is left is a
# diagnostic — the log, the hub and `/healthz` can still say which build
# answered — and never a chore handed to the user.
#   1 — the board through the hub/siblings work
#   2 — phases (/api/board carries phase, phase_since, phase_expected_seconds)
#   3 — decision requests (a question carries `artifacts`: url, attachments, notes)
#   4 — sprints carry a name (`/api/settings` name, registry rows follow it)
#   5 — conversation cards (cards carry `kind` + `conversation`; POST
#       /api/cards/<n>/seen records the read receipt the highlight is derived from)
#   6 — the switcher's square (`chat_unread` on /api/board and on every siblings
#       row; POST /api/sidebar/seen records the manager channel's read receipt)
API_VERSION = 6
DATA_DIRNAME = ".sprint"
HUB_DIRNAME = ".sprint"         # under $HOME: the machine-wide (cross-project) state
REGISTRY_FILENAME = "registry.json"
HUB_TOKEN_FILENAME = "hub-token"
HUB_JSON = "hub.json"
HUB_LOG = "hub.log"
HUB_COOKIE_NAME = "sprint_hub_token"   # NOT COOKIE_NAME: cookies ignore the port,
                                       # so sharing a name would log the boards out
DEFAULT_HUB_POLL_SECONDS = 10.0        # how often the hub re-reads every board
DEFAULT_HUB_PRUNE_SECONDS = 900.0      # unreachable + pid gone this long -> forget it
DB_FILENAME = "sprint.db"
SERVER_JSON = "server.json"
TOKEN_FILENAME = "token"       # survives `stop`; server.json does not
PORT_FILENAME = "port"         # ditto: which port this board answers on is an
                               # IDENTITY (it is in every URL anyone saved), and
                               # server.json is only a liveness record
SERVER_LOG = "server.log"
ATTACH_DIRNAME = "attachments"
COOKIE_NAME = "sprint_token"
# The session's waiter identifies itself with this header so its polling can
# count as proof-of-life. A browser polling /api/events never sends it -- a
# browser is not the session, and pretending otherwise would be fake liveness.
WAITER_HEADER = "X-Sprint-Waiter"
WAITER_CURSOR = "waiter"       # row in `cursors` holding the last waiter sighting

DEFAULT_MAX_UPLOAD = 25 * 1024 * 1024          # 25 MB, per spec
DEFAULT_SILENCE_SECONDS = 300.0                 # 5 minutes, per spec
DEFAULT_SILENCE_TICK = 5.0
DEFAULT_SWEEP_TICK = 15.0                       # how often the staleness sweep looks
DEFAULT_SESSION_OFFLINE_SECONDS = 90.0          # per spec: cursor lag that counts as "behind"
DEFAULT_WAITER_ONLINE_SECONDS = 10.0            # waiter seen this recently == attached
DEFAULT_WAITER_GONE_SECONDS = 30.0             # waiter unseen this long == really gone
DEFAULT_WAITER_PERSIST_SECONDS = 5.0           # how often the waiter mark hits disk
DEFAULT_SSE_HEARTBEAT = 15.0                    # per spec

# -- self-restart -----------------------------------------------------------
#
# A board is a long-running process serving code that gets edited under it. The
# old answer was a banner asking the human to run `sprintd stop` then
# `sprintd start`; the user's answer to that banner was "don't show me this
# notice". Picking up new code is the server's own job, so the server watches
# its own source file and re-execs itself in place when it changes.
SELFRESTART_FILENAME = "last-restart.json"      # the crash-loop stamp, beside the DB
DEFAULT_CODE_WATCH_TICK = 5.0                   # how often to look at our own source
DEFAULT_CODE_SETTLE_SECONDS = 2.0               # a file written this recently is still moving
DEFAULT_SELFRESTART_MIN_INTERVAL = 60.0         # never two self-restarts closer than this
DEFAULT_SELFRESTART_MAX_BURST = 3               # ...and never more than this many
DEFAULT_SELFRESTART_BURST_WINDOW = 600.0        # ...inside this window
DEFAULT_RESTART_DRAIN_SECONDS = 10.0            # how long to wait for in-flight requests

# `sprintd tail` -- the quiet ingress. It never exits on its own, so every
# knob here is about how loudly it fails, not whether it gives up.
TAIL_TEXT_MAX = 120            # chars of `payload.text` on a tail line
TAIL_BACKOFF_MIN = 0.25        # first reconnect delay after a drop
TAIL_BACKOFF_MAX = 5.0         # ...doubling up to here, forever
TAIL_READ_TIMEOUT = 45.0       # 3 missed 15s heartbeats == this stream is dead
TAIL_UNREACHABLE_SECONDS = 60.0  # down this long: say so ONCE, then keep trying

ACTORS = ("user", "session", "worker", "server")
# What a CLIENT may ever claim to be. `server` is the board's own voice --
# agent_silent, stuck, the state line under a submission -- and nothing on the
# wire may borrow it.
CLIENT_ACTORS = ("user", "session", "worker")
EVENT_KINDS = (
    "submitted", "state", "chat", "question", "answer", "progress",
    "evidence", "verdict", "agent_silent", "stuck", "note", "error",
    # A provider limit window opened / ended. Sprint-level (card_num NULL),
    # written only by the board itself. `limit_cleared` is the one the session
    # ACTS on: it means the model is available again and whatever was
    # downgraded for that window can go back.
    "limit_declared", "limit_cleared",
    # Dead-session autoheal (#68). All four are sprint-level and written only
    # by the board itself. `session_dead` is the diagnosis (once per death
    # episode); `revive_attempted` is one spent slot of the crash-loop budget;
    # `revive_result` is whether the message got out, which is NOT whether the
    # session woke up; `revive_gave_up` is the ending, and the one line that
    # tells a person what to physically go and do.
    "session_dead", "revive_attempted", "revive_result", "revive_gave_up",
)

# Headers page JavaScript is FORBIDDEN to set or remove on `fetch` (the fetch
# spec's forbidden-header-name list). Any request carrying one of these came
# from a browser, and a browser is the user's own hands -- it may never claim
# to be the session or a worker, whatever it puts in the body. This is the
# enforcement seam for actor attribution, and it is not fingerprinting: the
# board's own SPA cannot strip these even if it wanted to.
BROWSER_HEADERS = ("Cookie", "Origin", "Sec-Fetch-Site", "Sec-Fetch-Mode",
                   "Sec-Fetch-Dest")

# Bulk create/act cap. The live incident this exists for was 14 cards created
# against intent followed by 14 hand-written cancels; the cap is here so a
# runaway import fails loudly at the door instead of flooding the board.
BULK_MAX = 50

# Non-code work proves itself differently. A mailbox reprocess has no diff, no
# branch and no preview -- what it has is a readback: the log line or command
# output that shows the thing actually happened.
WORK_KINDS = ("code", "ops")

# --------------------------------------------------------------------------
# Card kinds -- what SHAPE of thing a card is, which is a different question
# from `work_kind` (how a finished card proves itself).
#
# User, verbatim: "we're discovering we need another card type for an ongoing
# conversation thread. I think it's a lower section in the 'needs you' column
# where the card gets highlighted if there's an unread and unseen message. once
# I see the message, the highlighting dims, and once I respond the highlight
# goes away completely. with russ, this lets me have distinct conversations on
# specific needs"
#
# A conversation is NOT work: it has no queue, no agent lifecycle, no evidence
# packet, no verdict and no merge. It sits in its own state -- `conversation` --
# for exactly that reason: every timer, sweep and gate in this file is written
# against the work states, so a state that is in none of them is excluded from
# all of them by construction rather than by a list of exceptions somebody has
# to remember to update.
CARD_KINDS = ("work", "conversation")
CONVERSATION_STATE = "conversation"

# Which events are a MESSAGE in a conversation, as opposed to telemetry. A
# progress line is an agent narrating itself; a chat/question/note/error is
# somebody talking to you, and an answer is you talking back.
CONV_MESSAGE_KINDS = ("chat", "question", "note", "error", "answer", "submitted")
# Who counts as "them" and who counts as "you" in that thread. `server` is the
# board's own voice and is neither.
CONV_THEM = ("session", "worker")
CONV_YOU = ("user",)

# --------------------------------------------------------------------------
# Settings -- .sprint/config.json
#
# Per-project policy the SESSION reads at dispatch time. The server stores and
# validates it and does nothing else with it: it still runs no agents and makes
# no decisions. Two things live here, both of them the user's call rather than
# the orchestrator's:
#
#   * which MODEL a worker should get (user, verbatim: "our standing
#     instructions should be to use the lowest feasible model (sonnet by
#     default, opus if the orchestrator deems that necessary)"), and
#   * which EXECUTOR runs it -- a Claude subagent, or a command driven in its
#     own tmux window via the tmux-send skill ("so I may want it to use grok
#     subagents via tmux, for example").
#
# It is a file, not a table: it is hand-editable, it survives `sprintd stop`
# and a DB wipe, and it diffs in a terminal.
CONFIG_FILENAME = "config.json"

MODEL_POLICIES = ("lowest_feasible", "always_opus", "always_sonnet")
EXECUTOR_KINDS = ("subagent", "tmux")

# What a policy resolves to when nothing on the card says otherwise. Per-card
# `model` always wins over the policy -- the policy is the DEFAULT, and
# "the orchestrator deems opus necessary" is expressed by stamping opus on
# that one card, never by flipping the whole board.
POLICY_MODEL = {
    "lowest_feasible": "sonnet",
    "always_sonnet": "sonnet",
    "always_opus": "opus",
}

DEFAULT_EXECUTORS = {"claude": {"kind": "subagent"}}
DEFAULT_SETTINGS = {
    "worker": {
        "model_policy": "lowest_feasible",
        "default_executor": "subagent",
        "executors": dict(DEFAULT_EXECUTORS),
        "concurrency": 3,
    },
    # What the session running this board CALLS ITSELF -- a first name, chosen
    # by the session at launch, so the sidebar reads "Chuck: I've picked up #12"
    # instead of "Session: ...". Empty means nobody has introduced themselves
    # and every label falls back to the generic one.
    #
    # This is NOT the sprint's name (that is the open sprint's title). Two
    # different things: the board is called "Billing week", the colleague
    # running it is called Chuck.
    "agent_name": "",
    # WHERE that session can be reached, as a tmux target ("russ-machine",
    # "sess:1", "%5"). The session writes this at boot when it can see it is
    # running inside tmux; empty means it is not, and dead-session autoheal
    # simply does not apply to this board (see the Autoheal note below).
    #
    # Unlike `agent_name`, LAST write wins. A name is an identity and must
    # survive a restart untouched; a window is an ADDRESS, and a session that
    # moved to a new window has to be able to say so or the hub will keep
    # typing into somebody else's terminal.
    "session_tmux_window": "",
}
# `default_executor` accepts either a named executor or the bare kind
# "subagent" -- the out-of-the-box board has no named executors worth typing.
BUILTIN_EXECUTOR = "subagent"
SETTINGS_KEYS = tuple(DEFAULT_SETTINGS["worker"].keys())
EXECUTOR_FIELDS = ("kind", "command", "session", "model", "note")
MAX_CONCURRENCY = 20

# --------------------------------------------------------------------------
# Staleness sweep
#
# `agent_silent` watches a working AGENT. This watches a PARKED CARD: a state
# somebody owes an action on and nothing is going to move it until they do.
# Three approved cards once sat at "merging" for two hours because the session
# missed their approve events -- nothing was silent, nothing was broken, the
# work was simply owed and forgotten. So the server keeps its own clock on the
# five states with an owner, and says so out loud on the same stream everything
# else rides.
#
# Each row: state, who owes it, the env var that tunes it, and the default.
# `queued` only counts when nobody has been assigned -- a queued card with an
# agent is mid-pickup, not abandoned.
STUCK_RULES = (
    ("integrating", "SPRINT_SWEEP_INTEGRATING_SECONDS", 600.0),      # 10 min
    ("queued",      "SPRINT_SWEEP_QUEUED_SECONDS",      900.0),      # 15 min
    ("blocked",     "SPRINT_SWEEP_BLOCKED_SECONDS",     1800.0),     # 30 min
    ("needs_you",   "SPRINT_SWEEP_NEEDS_YOU_SECONDS",   1800.0),     # 30 min
    ("ready",       "SPRINT_SWEEP_READY_SECONDS",       86400.0),    # 24 h
)
STUCK_STATES = tuple(r[0] for r in STUCK_RULES)

# A reminder is not a klaxon. After the opening notice the sweep backs off hard
# and then shuts up entirely: an episode is at most one notice plus these three
# repeats. Re-arms only when the card actually changes state -- which is the
# only thing that proves somebody dealt with it.
DEFAULT_SWEEP_BACKOFF = (600.0, 1800.0, 5400.0)   # 10m -> 30m -> 90m -> silence
DEFAULT_SWEEP_MAX_REMINDERS = 3

# `needs_you` is a different animal from the other four states (#67). Those
# four are parked on the SESSION or the AGENT -- something that can act on a
# repeat nag. `needs_you` is parked on the human, and a session re-reading its
# own "waiting on you" reminder every ten minutes cannot do anything with it:
# the gold square and the hub badge already carry the signal continuously, for
# as long as the question stays open. So `needs_you` gets exactly one notice
# per episode -- the normal opening delay, no repeats -- and then goes quiet
# until the episode re-arms, which happens the same way it does for every
# other state: the card leaving and re-entering `needs_you` (a new question)
# writes a new `state` event, which moves `_episode_seq` forward.
NEEDS_YOU_MAX_REMINDERS = 0

# What each state's one-liner says. Plain English, no jargon, names the owed
# action -- the session reads these straight off the tail.
STUCK_TEXT = {
    "integrating": "approved %s ago, still merging — the session owes it a /integrated",
    "queued": "queued %s with nobody on it — dispatch it or say why not",
    "blocked": "blocked %s with no word — worth re-checking the wall",
    "needs_you": "waiting on you for %s — the question is still unanswered",
    "ready": "ready for review %s — it is waiting on a verdict",
}

# ...and what it says instead when the board KNOWS what the card is waiting on.
# "dispatch it or say why not" is the wrong nag for a card whose blocker is
# named on it: nobody can dispatch it, and the answer to "why not" is already
# recorded. Naming the blocker turns the reminder into something actionable --
# go look at #N -- instead of a question the reader has to go and re-derive.
STUCK_TEXT_BLOCKED = {
    "queued": "queued %s — waiting on #%s to land, so it is not ready to dispatch",
    "blocked": "blocked %s — waiting on #%s",
    "needs_you": "waiting on you for %s — and on #%s",
}
# One line of the user's own words for why a card is waiting. Longer than this
# is a conversation, and a conversation belongs in the thread.
BLOCKED_REASON_MAX = 140
# How far the cycle check will walk a chain before it calls the data broken.
# A real chain is two or three cards deep; anything past this is a loop that
# predates the check (a hand-edited database) and must not hang the request.
BLOCKED_CHAIN_MAX = 64

# --------------------------------------------------------------------------
# Killed-agent detection
#
# Three workers were killed mid-flight when the session hit a provider usage
# limit. Nothing recovered them: their cards sat in In motion for hours until
# the user counted nine open cards and asked why. `agent_silent` had already
# fired and said its piece at five minutes -- but saying "quiet" forever is
# exactly what a dead agent looks like, and amber is not an escalation.
#
# So the sweep keeps a second, much longer clock on the same cards. Past
# `worker_gone_seconds` it says out loud that the worker is probably dead; past
# `worker_dead_seconds` it stops guessing and moves the card to `failed` with a
# machine reason, which is the one state that carries a Retry the user can hit.
# `failed` preserves the timeline, the evidence, the branch and the worktree --
# Retry re-dispatches a fresh agent with all of it as the brief.
#
# The bar for "provably gone" is deliberately high, because declaring a working
# agent dead is worse than waiting: the card must have an agent on it, must have
# no live phase claim, must not be an external agent, and its quiet stretch is
# measured per AGENT (any worker event on any of its cards counts), never per
# card.
DEFAULT_WORKER_GONE_SECONDS = 1200.0     # 20 min: say the worker may be dead
DEFAULT_WORKER_DEAD_SECONDS = 2400.0     # 40 min total: declare it failed
# A `long_running` card promised in advance that it would be quiet, so the
# clock is stretched rather than switched off -- an agent killed in the middle
# of a long test run is the exact shape of the incident this rule exists for,
# and an exemption with no end would be a hole big enough to drive it through.
DEFAULT_WORKER_LONGRUN_FACTOR = 6.0      # 2 h notice, 4 h failed
WORKER_GONE_STATES = ("triaging", "in_progress", "needs_you")

# Which model the session dispatches on unless something went wrong. Recorded
# per card at assign time so that a fallback -- "fable hit its usage limit, this
# one is running on opus" -- is a fact on the board and not a thing the user has
# to remember. The face shows the model ONLY when it differs from this, because
# a badge that is on every card says nothing.
DEFAULT_MODEL = "fable"
MODEL_MAX = 40
# Why this card is not on the default model, in the session's own words
# ("fable limited until 23:50"). Free text, one line, read by a human -- and by
# the session, which uses its presence to know which cards to restore when the
# limit window ends.
MODEL_REASON_MAX = 140

# --------------------------------------------------------------------------
# Provider limit windows
#
# The incident this exists for, verbatim from the board: three workers were
# killed at once by a provider usage limit, and the kill message SAID when it
# would end -- "You've hit your session limit · resets 11:50pm (America/Denver)".
# Nothing captured that sentence, so the cards sat open for hours until the user
# counted them himself.
#
# A limit window is that sentence, made into a fact the board holds: which model
# is unavailable and until when. Two things fall out of it -- a quiet line on
# the board while the window is open, and exactly ONE `limit_cleared` event when
# it ends, which is the session's cue to put the downgraded work back on the
# model it was supposed to be on.
#
# Activeness is COMPUTED (`cleared_at IS NULL AND resets_at > now`), never
# stored: a board that was asleep across 11:50pm must come back up knowing the
# window is over, and a cleanup job that did not run is not an excuse for
# telling the user that fable is still limited at noon the next day.
LIMIT_SOURCE_MAX = 80          # where the reset time came from ("kill message")
LIMIT_NOTE_MAX = 280
LIMIT_RECENT_MAX = 20          # how many finished windows GET /api/limits shows

# Two kinds of window, because two different things happen to the user.
#
#   "model"   — one model is unavailable and the work moves down a tier. The
#               board says so in a quiet dashed line and everything keeps
#               running. This is the original card.
#   "account" — the whole Claude account hit its weekly limit. NOTHING can run,
#               on any board, and the fix is not waiting: log out, sign in with
#               another Claude session, then press Resume. That needs a big
#               banner on every board and a button, not a quiet line.
#
# Why an account window is MACHINE-WIDE, and how:
#
# The limit belongs to the account, not to a project, so a board that did not
# declare it is just as dead as the one that did — and the board the user is
# looking at when it happens is whichever tab is in front of him. Two ways to
# get it everywhere: push the declaration to every sibling over HTTP, or write
# it to one machine-wide file every board already knows how to find. We write
# the file (`account-limit.json`, beside the registry the hub already uses),
# because push needs each sibling's bearer token — which no board holds for
# another — and because push is only as good as the moment it ran: a board
# started AFTER the declaration would never hear about it, which is exactly the
# case that happens when the user restarts a wedged project mid-limit. Reading
# a file is also the only version of this that works with NO session attached,
# which is the whole point: when the account is out, the orchestrating session
# is dead, and the only things still moving are the board server and a browser.
#
# Each board mirrors the shared state into its OWN `limits` row, so every
# guarantee already proved for model windows holds unchanged per board:
# activeness stays computed, and each board emits its own single
# `limit_cleared` — which is right, because each board has its own parked cards
# to re-dispatch when the session comes back.
LIMIT_KIND_MODEL = "model"
LIMIT_KIND_ACCOUNT = "account"
LIMIT_KINDS = (LIMIT_KIND_MODEL, LIMIT_KIND_ACCOUNT)
ACCOUNT_LIMIT_FILENAME = "account-limit.json"   # machine-wide, beside registry.json

# The banner's words, composed here so the server, the event log and the
# browser cannot drift into three different accounts of the same fact. Three
# parts, in the order a person needs them: what happened, when it lifts, and
# what to DO about it — which is not "wait", it is "swap sessions".
ACCOUNT_LIMIT_HEADLINE = "Claude account limit reached — nothing can run"
ACCOUNT_LIMIT_ACTION = ("Log out of Claude, sign in with another Claude "
                        "session, then press Resume.")
ACCOUNT_RESUME_LABEL = "Resume"

# --------------------------------------------------------------------------
# Dead-session autoheal
#
# The incident, twice in one day: a Claude session is killed at a provider
# limit. Its board server is untouched -- it keeps serving, keeps sweeping,
# keeps accepting cards -- but the brain is gone. Five cards the user had
# already approved sat in `integrating` for six hours because nobody was left
# to merge them, and the board had every fact needed to notice: its
# orchestrator cursor stopped at 11:15 and never moved again. Sam, verbatim:
# "but also, how can we help this autoheal in the future?"
#
# Three pieces, in three different places, because no single process can do it:
#
#   1. REGISTRATION (the session). At boot the session records its own tmux
#      window in settings (`session_tmux_window`). A session outside tmux
#      registers nothing and is simply not autohealable -- there is no channel
#      to wake it on, and guessing one is how you type a wake-up brief into
#      somebody else's terminal.
#   2. DETECTION (the board). The sweep already knows what the offline banner
#      knows. Past `session_dead_seconds` with no proof of life at all AND with
#      work owed to the session, it says so once, out loud, as a `session_dead`
#      event.
#   3. REVIVAL (the hub). A dead session cannot restart itself and its board
#      must not spawn processes, so the hand that reaches for the keyboard is
#      the one machine-wide process that already watches every board: the hub
#      runs `tmux-send <window> <brief>`, where the brief is built by the board
#      out of its own state.
#
# Two guards, both learned the hard way:
#
#   * The account limit owns the parked case. While a machine-wide account
#     window is on, a silent session is not dead, it is PARKED, and poking it
#     achieves nothing -- #47's Resume flow is what re-arms everything.
#   * SUBMISSION IS NOT REVIVAL. The second outage of the day had the session's
#     process alive with a `/status` dialog open in its terminal: tmux-send
#     reported "submitted and verified" and absolutely nothing happened,
#     because an undismissed modal blocks the session from processing
#     anything. So a wake-up only counts as a success if the board's cursor
#     actually MOVES inside `revive_grace_seconds`; a delivered message that
#     never stirs the session is a failed attempt, and the give-up line has to
#     say the thing the user can physically act on -- go look at the window.
DEFAULT_SESSION_DEAD_SECONDS = 1200.0    # 20 min with no proof of life at all

# Which states mean "the session owes this card an action". A board full of
# cards waiting on the USER (`needs_you`, `ready`) is not a board with a dead
# session worth waking -- nothing would happen if it woke. `blocked` and
# `failed` are excluded for the same reason from the other direction: they are
# already parked with a named reason. That leaves the three the russ outage
# actually stranded, which is the whole set this rule exists for.
SESSION_OWED_STATES = ("queued", "in_progress", "integrating")

# Crash-loop guard, mirrored from the board's own self-restart (#62): the same
# three questions (how recently, how many, inside what window) and the same
# bias -- when in doubt, do not.
DEFAULT_REVIVE_MIN_INTERVAL = 600.0      # never twice inside 10 min per board
DEFAULT_REVIVE_MAX_BURST = 3            # at most 3 wake-ups...
DEFAULT_REVIVE_BURST_WINDOW = 3600.0    # ...inside an hour, then give up
# How long a woken session gets to prove it woke, before the attempt is judged.
DEFAULT_REVIVE_GRACE_SECONDS = 180.0     # 3 min

# Where the hub's hand is. The tmux-send skill installs it here; a machine
# without it is a machine where autoheal logs one line and skips, which is the
# correct degrade -- never a crashed hub.
DEFAULT_TMUX_SEND = "~/.local/bin/tmux-send"
TMUX_WINDOW_MAX = 80
# A tmux target: session, session:window, session:window.pane, or a pane id.
# Deliberately strict -- this string is handed to a subprocess, so anything
# that could be read as a second argument or a shell fragment is refused at
# the door rather than quoted at the call site.
TMUX_WINDOW_RE = re.compile(r"^[A-Za-z0-9%][A-Za-z0-9._:@/-]{0,79}$")

STATES = (
    "held", "queued", "triaging", "in_progress", "needs_you", "blocked",
    "ready", "integrating", "completed", "rejected", "failed", "stale",
    "duplicate", "canceled",
    # A conversation card, for as long as the conversation is open. It is not a
    # step in the work lifecycle and nothing moves it along -- only the user
    # ends it, with `cancel`, meaning "this discussion is done".
    "conversation",
)

# Legal transitions. `ready` is never reachable here from a plain state POST --
# only the evidence gate writes it (see App.card_ready).
TRANSITIONS = {
    "held": {"queued", "canceled", "rejected", "duplicate"},
    "queued": {"held", "triaging", "in_progress", "blocked", "canceled",
               "rejected", "duplicate", "failed", "stale"},
    "triaging": {"in_progress", "needs_you", "blocked", "queued", "canceled",
                 "rejected", "duplicate", "failed", "stale"},
    "in_progress": {"needs_you", "blocked", "ready", "triaging", "canceled",
                    "rejected", "duplicate", "failed", "stale"},
    "needs_you": {"in_progress", "blocked", "triaging", "canceled", "rejected",
                  "duplicate", "failed", "stale"},
    "blocked": {"in_progress", "needs_you", "queued", "triaging", "canceled",
                "rejected", "duplicate", "failed", "stale"},
    # approve flips ready -> integrating; `completed` is reachable ONLY from
    # integrating, so Done means the branch actually landed.
    "ready": {"integrating", "in_progress", "rejected", "canceled", "failed"},
    "integrating": {"completed", "in_progress", "canceled", "rejected", "failed"},
    # Closed is not a grave: the `reopen` action puts a card the user closed
    # too early back in the queue. Nothing else moves out of a closed state.
    "completed": {"queued"},
    "rejected": {"queued"},
    "failed": {"queued", "in_progress", "triaging", "canceled", "rejected",
               "duplicate", "stale"},
    "stale": {"queued", "in_progress", "triaging", "canceled", "rejected",
              "duplicate", "failed"},
    "duplicate": {"queued"},
    # A canceled card reopens into the queue -- unless it is a conversation,
    # which reopens back into the conversation it always was. `transition`
    # refuses the wrong one of these per card kind, so the pair here is not a
    # hole: it is both halves of one door.
    "canceled": {"queued", "conversation"},
    # A conversation never becomes work and never merges. The ONLY way out is
    # the user closing it.
    "conversation": {"canceled"},
}

TERMINAL_STATES = {"completed", "rejected", "duplicate", "canceled"}

# Card faces show the transition reason verbatim, so these are English.
VERDICT_REASON = {"approve": "approved -- merging", "bounce": "bounced back with your notes",
                  "reject": "rejected"}

# Which board column a state renders in. `integrating` is NOT its own column:
# it sits in Ready showing "merging…" until the branch actually lands.
COLUMN_OF = {
    "held": "held", "queued": "queued", "triaging": "in_progress",
    "in_progress": "in_progress", "needs_you": "needs_you", "blocked": "blocked",
    "ready": "ready", "integrating": "ready", "completed": "done",
    "rejected": "done", "failed": "in_progress", "stale": "queued",
    "duplicate": "done", "canceled": "done",
    # Conversations live at the bottom of Needs you, in their own section --
    # they are the other shape of "this one is on me".
    "conversation": "needs_you",
}

SCHEMA = """
PRAGMA journal_mode=WAL;
PRAGMA foreign_keys=ON;

CREATE TABLE IF NOT EXISTS sprints (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  opened_at REAL NOT NULL,
  closed_at REAL,
  title TEXT,
  hold_mode INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS batches (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  sprint_id INTEGER,
  agent_name TEXT,
  worktree TEXT,
  branch TEXT,
  created_at REAL NOT NULL
);

CREATE TABLE IF NOT EXISTS cards (
  num INTEGER PRIMARY KEY AUTOINCREMENT,
  sprint_id INTEGER,
  state TEXT NOT NULL,
  title TEXT,
  body TEXT,
  batch_id INTEGER,
  agent_name TEXT,
  worktree TEXT,
  branch TEXT,
  bounce_count INTEGER NOT NULL DEFAULT 0,
  pinned INTEGER NOT NULL DEFAULT 0,
  dup_of INTEGER,
  long_running INTEGER NOT NULL DEFAULT 0,
  external_agent INTEGER NOT NULL DEFAULT 0,
  work_kind TEXT NOT NULL DEFAULT 'code',
  kind TEXT NOT NULL DEFAULT 'work',
  -- Which executor ran this card (a name from settings' worker.executors) and
  -- which model it was dispatched with. NULL means "whatever the board's
  -- defaults were" -- the card face only tags a choice that differs.
  executor TEXT,
  model TEXT,
  model_reason TEXT,
  -- Which OTHER card this one is waiting on, and why, in the user's words.
  -- NULL means nothing is in its way. This is the card-to-card link itself,
  -- not prose about one: the board can draw it, the sweep can name it, and the
  -- server clears it by itself the moment the blocker lands.
  blocked_by INTEGER,
  blocked_reason TEXT,
  created_at REAL NOT NULL,
  updated_at REAL NOT NULL
);

CREATE TABLE IF NOT EXISTS events (
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  card_num INTEGER,
  ts REAL NOT NULL,
  actor TEXT NOT NULL,
  kind TEXT NOT NULL,
  payload TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS events_card ON events(card_num, seq);

CREATE TABLE IF NOT EXISTS evidence (
  card_num INTEGER NOT NULL,
  packet TEXT NOT NULL,
  created_at REAL NOT NULL
);
CREATE INDEX IF NOT EXISTS evidence_card ON evidence(card_num, created_at);

CREATE TABLE IF NOT EXISTS cursors (
  name TEXT PRIMARY KEY,
  seq INTEGER NOT NULL,
  updated_at REAL NOT NULL
);

CREATE TABLE IF NOT EXISTS questions (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  card_num INTEGER NOT NULL,
  text TEXT NOT NULL,
  options TEXT,
  artifacts TEXT,
  answered_at REAL,
  created_at REAL NOT NULL
);
CREATE INDEX IF NOT EXISTS questions_card ON questions(card_num, id);

-- A provider usage limit with a known end. `cleared_at` is bookkeeping for the
-- one-shot `limit_cleared` event, NOT the definition of active: a window whose
-- `resets_at` has passed is over whether or not anything got round to writing
-- that down.
CREATE TABLE IF NOT EXISTS limits (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  kind TEXT NOT NULL DEFAULT 'model',
  model TEXT NOT NULL,
  resets_at REAL NOT NULL,
  declared_at REAL NOT NULL,
  cleared_at REAL,
  source TEXT,
  note TEXT
);
CREATE INDEX IF NOT EXISTS limits_open ON limits(cleared_at, resets_at);

CREATE TABLE IF NOT EXISTS idempotency (
  key TEXT PRIMARY KEY,
  method TEXT NOT NULL,
  path TEXT NOT NULL,
  status INTEGER NOT NULL,
  body TEXT NOT NULL,
  created_at REAL NOT NULL
);
"""

ATTACH_NAME_RE = re.compile(r"^([0-9a-f]{64})\.(png|jpe?g)$")
ATTACH_URL_RE = re.compile(r"^/api/attachments/([0-9a-f]{64})\.(png|jpe?g)$")

FRONTEND_HINT_RE = re.compile(
    r"(^|/)(web|frontend|ui|src/components|assets)/|\.(css|scss|html|tsx|jsx|vue|svelte)\b"
)
PASS_RE = re.compile(r"(\d+)\s*(?:pass|passed|passing|ok)\b", re.I)
FAIL_RE = re.compile(r"(\d+)\s*(?:fail|failed|failing|error)", re.I)

PLACEHOLDER_HTML = (
    "<!-- sprintd placeholder --><h1>sprint</h1>"
    "<p>web/ is not installed next to this sprintd. The API is live at /api/board.</p>"
)

# A person who clicks a link and lands on `{"error":"unauthorized"}` has been
# handed a stack trace, not an answer. Browsers navigating to a page get this
# instead; the API keeps its JSON. It never echoes a token.
SIGNIN_HTML = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TITLE__</title>
<style>
  body{margin:0;min-height:100vh;display:flex;align-items:center;
       justify-content:center;background:#0e1116;color:#e6edf3;
       font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,
            "Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
  .card{max-width:460px;padding:30px 32px;background:#161b22;
        border:1px solid #262d38;border-radius:12px;margin:20px}
  h1{margin:0 0 10px;font-size:18px;font-weight:600}
  p{margin:0 0 12px;color:#8b98a8}
  p.last{margin-bottom:0}
  code{color:#e6edf3;background:#11161d;border:1px solid #262d38;
       border-radius:5px;padding:2px 7px;font-size:13px;
       font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  a{color:#8ab4f8}
</style></head><body>
<div class="card">
  <h1>__HEADING__</h1>
  __BODY__
</div></body></html>
"""


def signin_page(heading: str, paragraphs, title: str = "sprint") -> bytes:
    body = "".join(
        '<p%s>%s</p>' % (' class="last"' if i == len(paragraphs) - 1 else "", p)
        for i, p in enumerate(paragraphs))
    return (SIGNIN_HTML.replace("__TITLE__", title)
            .replace("__HEADING__", heading)
            .replace("__BODY__", body)).encode("utf-8")


def wants_html(headers, path: str, method: str) -> bool:
    """Is this a person navigating, rather than the API being called?"""
    if method not in ("GET", "HEAD"):
        return False
    if path.startswith("/api/") or path == "/healthz":
        return False
    accept = (headers.get("Accept") or "").lower()
    if "text/html" in accept:
        return True
    # curl sends */* ; fetch() from our own page sends application/json
    return "application/json" not in accept and "text/html" not in accept \
        and accept in ("", "*/*")


def board_cookie_name(port) -> str:
    """Per-port cookie name.

    Cookies are scoped by HOST, not by port -- so two boards on the same
    machine sharing one cookie name sign each other out, and the hub's whole
    premise is several boards on one machine. The name carries the port so
    each board gets its own slot in the browser's jar.
    """
    try:
        return "%s_%d" % (COOKIE_NAME, int(port))
    except (TypeError, ValueError):
        return COOKIE_NAME


# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------


def now() -> float:
    return time.time()


def env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if not raw:
        return default
    try:
        return float(raw)
    except ValueError:
        return default


def env_int(name: str, default: int) -> int:
    return int(env_float(name, float(default)))


def human_span(seconds: float) -> str:
    """"12m" / "1h 5m" / "2d". The same compact shape the board's card faces
    use, so a sweep line reads exactly like the age text sitting next to it."""
    s = max(0, int(round(float(seconds))))
    if s < 60:
        return "%ds" % s
    m = s // 60
    if m < 60:
        return "%dm" % m
    h, rem = m // 60, m % 60
    if h < 24:
        return ("%dh %dm" % (h, rem)) if rem else "%dh" % h
    d, hrem = h // 24, h % 24
    return ("%dd %dh" % (d, hrem)) if hrem else "%dd" % d


def jdump(obj) -> str:
    return json.dumps(obj, separators=(",", ":"), sort_keys=False, default=str)


def jload(raw, default=None):
    if raw is None:
        return default
    try:
        return json.loads(raw)
    except (ValueError, TypeError):
        return default


ONE_LINER_MAX = 140


def one_line(text, limit: int = ONE_LINER_MAX) -> str:
    """First line, clipped -- the skim version of anything multi-line."""
    s = str("" if text is None else text).strip().split("\n")[0].strip()
    return s if len(s) <= limit else s[:limit - 1].rstrip() + "…"


# A phase is a short word for what is happening right now ("testing",
# "capturing evidence"). Free-form on purpose — a worker knows its own work
# better than a fixed enum does — but it renders in a chip on a card face, so
# it is one short line or it is nothing.
PHASE_MAX = 40
PHASE_EXPECT_MAX = 24 * 3600.0
RECOMMENDED_PHASES = ("reading", "coding", "testing", "capturing evidence",
                      "assembling packet", "waiting")


def clean_phase(payload: dict) -> dict:
    """Normalize `phase` / `expected_seconds` on an incoming event payload.

    Anything unusable is a 400 naming the field rather than a phase the board
    would render as an empty chip or a clock that never runs out.
    """
    if not isinstance(payload, dict) or "phase" not in payload:
        return payload
    phase = payload.get("phase")
    if not isinstance(phase, str) or not phase.strip():
        raise ApiError(400, "bad_phase", "phase must be a non-empty string",
                       field="phase")
    payload = dict(payload)
    payload["phase"] = one_line(phase, PHASE_MAX)
    exp = payload.get("expected_seconds")
    if exp is not None:
        if isinstance(exp, bool) or not isinstance(exp, (int, float)) \
                or exp <= 0 or exp > PHASE_EXPECT_MAX:
            raise ApiError(400, "bad_expected_seconds",
                           "expected_seconds must be a positive number of "
                           "seconds no greater than %d" % PHASE_EXPECT_MAX,
                           field="expected_seconds")
        payload["expected_seconds"] = float(exp)
    return payload


def find_project_root(start: str = None) -> str:
    start = os.path.realpath(start or os.getcwd())
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=10,
        )
        if out.returncode == 0:
            top = out.stdout.decode("utf-8", "replace").strip()
            if top:
                return os.path.realpath(top)
    except (OSError, subprocess.SubprocessError):
        pass
    return start


def plugin_root() -> str:
    """Root of the plugin checkout, resolved from this script's real path.

    Works when bin/ is on PATH or the script is symlinked.
    """
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def web_dir() -> str:
    return os.path.join(plugin_root(), "web")


def tailscale_ip(timeout: float = 5.0) -> str:
    exe = shutil.which("tailscale")
    if not exe:
        return ""
    try:
        out = subprocess.run([exe, "ip", "-4"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return ""
    if out.returncode != 0:
        return ""
    for line in out.stdout.decode("utf-8", "replace").splitlines():
        line = line.strip()
        if line and re.match(r"^\d+\.\d+\.\d+\.\d+$", line):
            return line
    return ""


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError as exc:
        return exc.errno == errno.EPERM
    return True


def pid_is_sprintd(pid: int) -> bool:
    """Guard against PID recycling after a power loss."""
    if not pid_alive(pid):
        return False
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    cmd = out.stdout.decode("utf-8", "replace").strip()
    return "sprintd" in cmd


# The file this process is running. `__file__` is resolved at import, before
# anything can chdir, so it stays right for the whole life of the process --
# including across a re-exec, which is the one place it has to be.
SPRINTD_PATH = os.path.realpath(os.path.abspath(__file__))


def code_digest(path: str):
    """(sha256, size, mtime) of a source file, or None if it cannot be read.

    Content, not mtime, is what decides "this is different code": `git checkout`
    of the same bytes, a touch, a rebase that lands where it started -- all move
    the mtime and none of them are a reason to restart anything.
    """
    try:
        st = os.stat(path)
        with open(path, "rb") as fh:
            blob = fh.read()
    except OSError:
        return None
    return {"sha": hashlib.sha256(blob).hexdigest(), "size": st.st_size,
            "mtime": st.st_mtime, "source": blob}


def strip_flag(argv, flag: str) -> list:
    """argv without `--flag value` / `--flag=value`."""
    out, skip = [], False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg == flag:
            skip = True
            continue
        if arg.startswith(flag + "="):
            continue
        out.append(arg)
    return out


def code_compiles(blob: bytes, path: str) -> bool:
    """Would python even load this file? Cheap, and it runs NOTHING.

    The half-written file is the whole risk in watching your own source: an
    editor's save, a `git checkout` mid-write, an scp in flight. Refusing to
    exec into something that will not compile turns the ugliest failure mode
    (a board that exits on startup and takes the sprint with it) into a wait.
    """
    try:
        compile(blob, path, "exec")
    except (SyntaxError, ValueError):
        return False
    return True


def first_line_title(text: str, limit: int = 90) -> str:
    text = (text or "").strip()
    if not text:
        return ""
    line = text.splitlines()[0].strip()
    if len(line) > limit:
        line = line[: limit - 1].rstrip() + "…"
    return line


def posted_images(body):
    """The pictures on a POST, under either name.

    `images` is what every surface has always sent and what SPEC.md documents.
    `attachments` is accepted beside it because that is what the payload the
    pictures END UP in is called, and a caller who reads a card back and posts
    the same word should not get a silent drop. Same list, same validation, same
    store either way.
    """
    if not isinstance(body, dict):
        return None
    imgs = body.get("images")
    if imgs is None:
        imgs = body.get("attachments")
    return imgs


def image_line(n: int) -> str:
    """The skim line for a message that is only pictures. Every event needs
    words -- the card face and the timeline show `text` and nothing else."""
    return "sent a screenshot" if n == 1 else "sent %d screenshots" % n


def report_line(n: int) -> str:
    return "attached a report" if n == 1 else "attached %d reports" % n


# --------------------------------------------------------------------------
# Reports: markdown/HTML documents as first-class attachments
#
# An agent's real output is often a DOCUMENT -- a findings write-up, a
# comparison table, a migration plan -- and pasting 400 lines of it into a chat
# one-liner destroys both the document and the timeline. So a report rides the
# exact same content-addressed attachment store an image does, and renders in
# the thread as a skim line (its title) that expands into the whole rendered
# page.
#
# Two document kinds, two safety stories:
#
#   .md    We render it OURSELVES, server-side, with the small renderer below.
#          Raw HTML inside a .md is ESCAPED, never passed through -- a report
#          that contains `<script>` renders the characters `<script>`, inert.
#          There is no sanitizer to get wrong because no author markup is ever
#          treated as markup.
#   .html  We do NOT render or rewrite it. It is served back under a
#          `Content-Security-Policy: sandbox` header (unique opaque origin, no
#          scripts, no same-origin access) AND displayed only inside an iframe
#          carrying a restrictive `sandbox` attribute. Belt and braces: even a
#          direct navigation to the raw URL cannot touch the board's session.
#
# Reports are TEXT. There are no magic bytes to sniff, so the check is: the
# name carries a known document extension, the bytes decode as strict UTF-8,
# and there are no NULs (that is what "a binary wearing a .md" looks like).
REPORT_KIND_BY_EXT = {
    "md": "md", "markdown": "md", "mdown": "md",
    "html": "html", "htm": "html",
}
REPORT_EXT_OF_KIND = {"md": "md", "html": "html"}
REPORT_MIME_OF_KIND = {"md": "text/markdown; charset=utf-8",
                       "html": "text/html; charset=utf-8"}
# A report is prose, not a payload. 2 MB is a very long document and still an
# order of magnitude under the request cap; past that it is not a report.
REPORT_MAX_BYTES = 2 * 1024 * 1024
REPORT_NAME_RE = re.compile(r"^([0-9a-f]{64})\.(md|html)$")
REPORT_URL_RE = re.compile(r"^/api/attachments/([0-9a-f]{64})\.(md|html)$")
# Which link targets survive rendering. Anything else (javascript:, data:,
# vbscript:) is dropped to plain text -- a link you cannot see is better than
# one that runs.
SAFE_URL_RE = re.compile(r"^(https?://|mailto:|/|#|\./|\.\./)", re.I)


def report_kind_for_name(name) -> str:
    """'md' | 'html' | None -- decided by extension alone, deliberately."""
    base = os.path.basename(str(name or "")).strip().lower()
    if "." not in base:
        return None
    return REPORT_KIND_BY_EXT.get(base.rsplit(".", 1)[1])


def esc(text) -> str:
    """The whole safety story of the markdown renderer, in one function.

    Everything an author wrote becomes text BEFORE any tag is generated, so no
    author-supplied markup ever reaches the browser as markup."""
    return (str("" if text is None else text)
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def safe_url(url) -> str:
    u = str(url or "").strip()
    if not u or not SAFE_URL_RE.match(u):
        return ""
    return esc(u)


def render_inline(text: str) -> str:
    """Inline markdown over ALREADY-ESCAPED text.

    Order matters: code spans are lifted out first (their contents are never
    re-scanned for emphasis), then links/images, then emphasis. Placeholders
    are NUL-delimited, and NUL can never appear in a stored report -- that is
    exactly what `store_document` rejects."""
    out = esc(text)
    stash = []

    def keep(html: str) -> str:
        stash.append(html)
        return "\x00%d\x00" % (len(stash) - 1)

    out = re.sub(r"`([^`]+)`", lambda m: keep("<code>%s</code>" % m.group(1)), out)
    # The URL may itself carry one level of balanced parens (`alert(1)`,
    # `Foo_(disambiguation)`). Without that the trailing `)` escapes the match
    # and a dropped link leaves a stray bracket in the prose.
    url_re = r"((?:[^()\s]|\([^()\s]*\))+)"
    out = re.sub(
        r"!\[([^\]]*)\]\(" + url_re + r"\)",
        lambda m: keep('<img src="%s" alt="%s">' % (safe_url(m.group(2)), m.group(1)))
        if safe_url(m.group(2)) else m.group(1),
        out)
    out = re.sub(
        r"\[([^\]]+)\]\(" + url_re + r"\)",
        lambda m: keep('<a href="%s" rel="noreferrer noopener nofollow" target="_blank">%s</a>'
                       % (safe_url(m.group(2)), m.group(1)))
        if safe_url(m.group(2)) else m.group(1),
        out)
    # A bare URL is a link too. Card #54, user verbatim: "make links clickable
    # and should auto open in a new tab". Everything that was ALREADY a link (or
    # inline code) is a \x00N\x00 placeholder by now, so whatever still reads as
    # http(s) here is plain prose -- there is no way to double-wrap an anchor.
    def bare_link(m):
        url = m.group(0)
        while url and url[-1] in ".,;:!?)":
            if url[-1] == ")" and url.count("(") > url.count(")"):
                break
            url = url[:-1]
        safe = safe_url(url)
        if not safe:
            return m.group(0)
        return keep('<a href="%s" rel="noreferrer noopener nofollow" target="_blank">%s</a>'
                    % (safe, url)) + m.group(0)[len(url):]

    out = re.sub(r"https?://[^\s<>\"'`\]]+", bare_link, out)
    out = re.sub(r"~~(.+?)~~", r"<del>\1</del>", out)
    out = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"__(.+?)__", r"<strong>\1</strong>", out)
    out = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", r"<em>\1</em>", out)
    out = re.sub(r"(?<![\w_])_([^_\n]+)_(?![\w_])", r"<em>\1</em>", out)
    return re.sub(r"\x00(\d+)\x00", lambda m: stash[int(m.group(1))], out)


# The line-starts that END a paragraph or a list item. One definition, used by
# both the paragraph loop and the list's lazy continuation, so they can never
# disagree about where a block stops.
_BLOCK_START_RE = re.compile(r"^\s*(#{1,6}\s|>|```|([-*+]|\d+[.)])\s|([-*_])\s*(\3\s*){2,}$)")


def _starts_block(line: str) -> bool:
    return bool(_BLOCK_START_RE.match(line))


def _table_rows(line: str) -> list:
    cells = line.strip()
    if cells.startswith("|"):
        cells = cells[1:]
    if cells.endswith("|"):
        cells = cells[:-1]
    return [c.strip() for c in cells.split("|")]


def render_markdown(text: str) -> str:
    """A small, deliberate markdown subset -- no dependencies, ever.

    Headings, fenced code, blockquotes, nested lists, tables, rules, links,
    images, emphasis, inline code. Everything else is a paragraph. Raw HTML is
    escaped, never emitted: see `esc`."""
    lines = str(text or "").replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out, i = [], 0
    # open list stack: (tag, indent, nested_in_li) -- a deeper list is opened
    # INSIDE the <li> above it, which is what makes it indent correctly.
    stack = []

    def close_lists(to_indent=-1):
        while stack and stack[-1][1] > to_indent:
            tag, _, nested = stack.pop()
            out.append("</%s>%s" % (tag, "</li>" if nested else ""))

    while i < len(lines):
        raw = lines[i]
        line = raw.rstrip()
        stripped = line.strip()

        if not stripped:
            close_lists()
            i += 1
            continue

        m = re.match(r"^(\s*)```+\s*([\w.+-]*)\s*$", line)
        if m:
            close_lists()
            lang, body, i = m.group(2), [], i + 1
            while i < len(lines) and not re.match(r"^\s*```+\s*$", lines[i]):
                body.append(lines[i])
                i += 1
            i += 1                       # the closing fence (or EOF)
            cls = ' class="lang-%s"' % esc(lang) if lang else ""
            out.append("<pre><code%s>%s</code></pre>" % (cls, esc("\n".join(body))))
            continue

        if re.match(r"^\s*([-*_])\s*(\1\s*){2,}$", line):
            close_lists()
            out.append("<hr>")
            i += 1
            continue

        m = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if m:
            close_lists()
            level = len(m.group(1))
            out.append("<h%d>%s</h%d>" % (level, render_inline(m.group(2).rstrip("#").strip()), level))
            i += 1
            continue

        if stripped.startswith(">"):
            close_lists()
            quote = []
            while i < len(lines) and lines[i].strip().startswith(">"):
                quote.append(lines[i].strip()[1:].lstrip())
                i += 1
            out.append("<blockquote>%s</blockquote>" % render_markdown("\n".join(quote)))
            continue

        # table: a header row followed by a |---|---| separator
        if "|" in stripped and i + 1 < len(lines) and \
                re.match(r"^\s*\|?[\s:|-]*-[\s:|-]*\|?\s*$", lines[i + 1]) and \
                "|" in lines[i + 1]:
            close_lists()
            head = _table_rows(stripped)
            i += 2
            body = []
            while i < len(lines) and "|" in lines[i] and lines[i].strip():
                body.append(_table_rows(lines[i]))
                i += 1
            cells = "".join("<th>%s</th>" % render_inline(c) for c in head)
            rows = "".join(
                "<tr>%s</tr>" % "".join("<td>%s</td>" % render_inline(c) for c in r)
                for r in body)
            out.append("<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>"
                       % (cells, rows))
            continue

        m = re.match(r"^(\s*)([-*+]|\d+[.)])\s+(.*)$", line)
        if m:
            indent = len(m.group(1).expandtabs(4))
            tag = "ul" if m.group(2) in ("-", "*", "+") else "ol"
            close_lists(indent)
            if not stack or stack[-1][1] < indent:
                # reopen the <li> above so the sub-list lives inside it
                nested = bool(stack) and out and out[-1].endswith("</li>")
                if nested:
                    out[-1] = out[-1][: -len("</li>")]
                stack.append((tag, indent, nested))
                out.append("<%s>" % tag)
            elif stack[-1][0] != tag:
                otag, oind, onest = stack.pop()
                out.append("</%s>" % otag)
                stack.append((tag, oind, onest))
                out.append("<%s>" % tag)
            # Lazy continuation: a list item that wraps onto the next line is
            # still that item. Without this a wrapped item closed the list and
            # the next number restarted at 1 -- which is what a real report,
            # written with wrapped prose, looks like.
            body = [m.group(3)]
            i += 1
            while i < len(lines) and lines[i].strip() and not _starts_block(lines[i]):
                body.append(lines[i].strip())
                i += 1
            out.append("<li>%s</li>" % render_inline(" ".join(body)))
            continue

        close_lists()
        # A wrapped paragraph is ONE paragraph. Joining source lines with <br>
        # bakes the author's 80-column wrap into the page, which reads as ragged
        # nonsense at 480px in the rail. A hard break is the markdown way of
        # asking for one: two trailing spaces, or a trailing backslash.
        para = []
        while i < len(lines) and lines[i].strip() and not _starts_block(lines[i]):
            raw_line = lines[i]
            hard = raw_line.endswith("  ") or raw_line.rstrip().endswith("\\")
            para.append(raw_line.strip().rstrip("\\") + ("\x01" if hard else ""))
            i += 1
        if para:
            body = render_inline(" ".join(para)).replace("\x01 ", "<br>")
            out.append("<p>%s</p>" % body.replace("\x01", ""))
        else:                              # a construct we just refused to eat
            out.append("<p>%s</p>" % render_inline(stripped))
            i += 1
    close_lists()
    return "\n".join(out)


def report_title(kind: str, text: str, name: str = None) -> str:
    """The skim line: what this document calls itself."""
    fallback = os.path.basename(str(name or "")) or "report"
    body = str(text or "")
    if kind == "html":
        m = re.search(r"<title[^>]*>(.*?)</title>", body, re.I | re.S) or \
            re.search(r"<h1[^>]*>(.*?)</h1>", body, re.I | re.S)
        if m:
            title = re.sub(r"<[^>]+>", " ", m.group(1))
            title = html_unescape_lite(" ".join(title.split()))
            if title:
                return one_line(title, 120)
        return fallback
    for raw in body.split("\n"):
        line = raw.strip()
        if not line or line.startswith("```"):
            continue
        # Strip the markers that WRAP the line, not every marker character in
        # it: "how card #33 shipped" is a title about card #33, and a blanket
        # strip renamed it "card 33".
        line = re.sub(r"^\s*>+\s*", "", line)
        m = re.match(r"^#{1,6}\s+(.*)$", line)
        if m:
            line = m.group(1).rstrip("# ")
        line = re.sub(r"[*_`]", "", line).strip()
        if line:
            return one_line(line, 120)
    return fallback


def html_unescape_lite(text: str) -> str:
    for a, b in (("&lt;", "<"), ("&gt;", ">"), ("&quot;", '"'),
                 ("&#39;", "'"), ("&amp;", "&")):
        text = text.replace(a, b)
    return text


class ApiError(Exception):
    def __init__(self, status: int, code: str, message: str = "", **extra):
        super().__init__(message or code)
        self.status = status
        self.code = code
        self.message = message or code
        self.extra = extra

    def body(self) -> dict:
        out = {"error": self.code, "message": self.message}
        out.update(self.extra)
        return out


def clean_title(value, limit: int = 90) -> str:
    """Normalize a condensed card title: one line, collapsed whitespace, capped.

    Card titles are the FACE of a card. The user's own words live in
    cards.body and the `submitted` event and are never rewritten -- this
    only ever changes what the board renders on the card face."""
    if not isinstance(value, str):
        raise ApiError(400, "bad_title", "title must be a string", field="title")
    text = " ".join(value.split())
    if not text:
        raise ApiError(400, "bad_title", "title cannot be empty", field="title")
    if len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    return text


SPRINT_NAME_MAX = 60            # it is a header, a menu row and a hub row


def clean_sprint_name(value, limit: int = SPRINT_NAME_MAX) -> str:
    """Normalize a sprint's name: one line, collapsed whitespace, capped.

    This is the thing the user reads at the top of the board, in the switcher
    and on the hub, so it is short by construction -- a name that has to be
    truncated in three places is a sentence somebody put in the wrong field.
    """
    if not isinstance(value, str):
        raise ApiError(400, "bad_name", "name must be a string", field="name")
    text = " ".join(value.split())
    if not text:
        raise ApiError(400, "bad_name", "name cannot be empty", field="name")
    if len(text) > limit:
        raise ApiError(400, "bad_name",
                       "name must be %d characters or fewer (this one is %d)"
                       % (limit, len(text)), field="name")
    return text


AGENT_NAME_MAX = 24             # a first name, not a job title


def clean_agent_name(value, limit: int = AGENT_NAME_MAX) -> str:
    """Normalize the session's own name, or "" for none.

    The session picks this for itself at launch ("Chuck"), and it is rendered
    wherever a session line is attributed -- the sidebar, a card thread, the
    rail's header. So it is a NAME: one line, no newlines, short enough to sit
    in front of a message without becoming the message. `null` and `""` both
    mean "no name", which is how you take one back.
    """
    if value is None:
        return ""
    if not isinstance(value, str):
        raise ApiError(400, "bad_agent_name", "agent_name must be a string",
                       field="agent_name")
    text = " ".join(value.split())
    if len(text) > limit:
        raise ApiError(400, "bad_agent_name",
                       "agent_name must be %d characters or fewer (this one is "
                       "%d) — it is a first name, not a description"
                       % (limit, len(text)), field="agent_name")
    return text


def clean_tmux_window(value) -> str:
    """Normalize the session's wake channel, or "" for "not reachable".

    This string is handed to a subprocess as `tmux-send <target> <brief>`, so
    it is validated as an ADDRESS and not as prose: one token, no spaces, no
    leading dash (which argparse-style tools would read as an option), and
    only the characters a real tmux target uses. `null`/`""` unregister --
    which is how a session that leaves tmux takes its channel back.
    """
    if value is None:
        return ""
    if not isinstance(value, str):
        raise ApiError(400, "bad_tmux_window",
                       "session_tmux_window must be a string",
                       field="session_tmux_window")
    text = value.strip()
    if not text:
        return ""
    if len(text) > TMUX_WINDOW_MAX:
        raise ApiError(400, "bad_tmux_window",
                       "session_tmux_window must be %d characters or fewer "
                       "(this one is %d)" % (TMUX_WINDOW_MAX, len(text)),
                       field="session_tmux_window")
    if not TMUX_WINDOW_RE.match(text):
        raise ApiError(400, "bad_tmux_window",
                       "session_tmux_window must be a tmux target — a name, "
                       "\"session:window\", or a pane id like \"%%5\" — with no "
                       "spaces (got \"%s\")" % text, field="session_tmux_window")
    return text


def clean_model(value):
    """Normalize a model name, or None. Free-form on purpose: the board records
    what the session says it dispatched on and never adjudicates the list."""
    if value is None:
        return None
    if not isinstance(value, str):
        raise ApiError(400, "bad_model", "model must be a string", field="model")
    text = " ".join(value.split())
    if not text:
        return None
    return text[:MODEL_MAX]


def clean_limit_kind(value):
    """Which kind of limit window: "model" (default) or "account".

    Closed set on purpose — unlike `model`, which the board never adjudicates,
    the kind decides whether the user sees a quiet line or a banner that says
    everything has stopped, and a typo must not silently pick the quiet one.
    """
    if value is None:
        return LIMIT_KIND_MODEL
    if not isinstance(value, str):
        raise ApiError(400, "bad_kind", "kind must be a string", field="kind")
    text = value.strip().lower()
    if not text:
        return LIMIT_KIND_MODEL
    if text not in LIMIT_KINDS:
        raise ApiError(400, "bad_kind",
                       "kind must be one of: %s" % ", ".join(LIMIT_KINDS),
                       field="kind")
    return text


def clean_model_reason(value, field: str = "model_reason"):
    """Why this card is not on the default model. One line, capped, free text.

    An EMPTY string is meaningful and is not the same as omitting the field:
    omitting leaves whatever is on the card alone, "" clears it. That is what
    the session sends when it puts a card back on its original model.
    """
    if value is None:
        return None
    if not isinstance(value, str):
        raise ApiError(400, "bad_model_reason", "%s must be a string" % field,
                       field=field)
    text = " ".join(value.split())
    if not text:
        return ""
    return text[:MODEL_REASON_MAX]


def clean_short_text(value, field: str, limit: int):
    """A free-text one-liner or None (`source`, `note` on a limit window)."""
    if value is None:
        return None
    if not isinstance(value, str):
        raise ApiError(400, "bad_" + field, "%s must be a string" % field, field=field)
    text = " ".join(value.split())
    return text[:limit] if text else None


# `11:50pm`, `11:50 PM`, `23:50`, `9pm`, and any of those with the provider's
# own parenthetical zone on the end: `11:50pm (America/Denver)`.
CLOCK_RE = re.compile(r"^(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\.?$", re.I)
CLOCK24_RE = re.compile(r"^(\d{1,2}):(\d{2})(?::(\d{2}))?$")
TZ_PAREN_RE = re.compile(r"^(.*?)\s*\(\s*([A-Za-z][A-Za-z0-9_+\-/]*)\s*\)\s*$")
EPOCH_RE = re.compile(r"^\d{9,14}(?:\.\d+)?$")
# Anything past this is milliseconds, not seconds: 1e11 seconds is the year 5138
# and 1e11 milliseconds is 1973. Nobody means the year 5138.
EPOCH_MS_CUTOFF = 1e11


def _zone(name: str):
    """A tzinfo for a provider's zone name, or a 400 that says why not."""
    try:
        from zoneinfo import ZoneInfo          # stdlib 3.9+
    except ImportError:
        raise ApiError(400, "bad_resets_at",
                       "this python has no zoneinfo — pass an ISO 8601 time "
                       "with an offset instead of a zone name",
                       field="resets_at")
    try:
        return ZoneInfo(name)
    except Exception:
        raise ApiError(400, "bad_resets_at",
                       "unknown timezone %r — pass an ISO 8601 time with an "
                       "offset instead" % name, field="resets_at")


def parse_reset_time(value, ref: float = None) -> float:
    """When a limit window ends, as epoch seconds.

    Accepts, in this order:

      * a number — epoch seconds (or milliseconds, if it is absurdly large);
      * an ISO 8601 timestamp, with or without an offset (naive = local);
      * a HUMAN CLOCK TIME — `11:50pm`, `9pm`, `23:50` — meaning the **next
        occurrence** of that time. This is the shape a provider's kill message
        actually uses, and it is the whole reason a human ever types one of
        these: at 11:52pm, "11:50pm" means tomorrow, not two minutes ago.

    Any of the string forms may carry the provider's own zone in parentheses
    (`11:50pm (America/Denver)`), so the kill message can be pasted verbatim
    instead of being converted in someone's head. Without one, local time.
    """
    ref = now() if ref is None else float(ref)
    if isinstance(value, bool):
        raise ApiError(400, "bad_resets_at", "resets_at must be a time",
                       field="resets_at")
    if isinstance(value, (int, float)):
        secs = float(value)
        return secs / 1000.0 if secs > EPOCH_MS_CUTOFF else secs
    if not isinstance(value, str):
        raise ApiError(400, "missing_field", "resets_at is required",
                       field="resets_at")
    text = value.strip()
    if not text:
        raise ApiError(400, "missing_field", "resets_at is required",
                       field="resets_at")

    tz = None
    m = TZ_PAREN_RE.match(text)
    if m and m.group(1).strip():
        text, tz = m.group(1).strip(), _zone(m.group(2))

    if EPOCH_RE.match(text):
        secs = float(text)
        return secs / 1000.0 if secs > EPOCH_MS_CUTOFF else secs

    iso = text[:-1] + "+00:00" if text.endswith(("Z", "z")) else text
    try:
        dt = datetime.datetime.fromisoformat(iso)
    except ValueError:
        dt = None
    if dt is not None:
        if dt.tzinfo is None and tz is not None:
            dt = dt.replace(tzinfo=tz)
        # A naive datetime with no zone named is local time -- `.timestamp()`
        # already means exactly that.
        return dt.timestamp()

    hour = minute = None
    m = CLOCK_RE.match(text)
    if m:
        hour, minute = int(m.group(1)), int(m.group(2) or 0)
        if not (1 <= hour <= 12) or minute > 59:
            raise ApiError(400, "bad_resets_at",
                           "%r is not a clock time" % value, field="resets_at")
        half = m.group(3).lower()
        hour = (hour % 12) + (12 if half == "p" else 0)
    else:
        m = CLOCK24_RE.match(text)
        if m:
            hour, minute = int(m.group(1)), int(m.group(2))
            if hour > 23 or minute > 59:
                raise ApiError(400, "bad_resets_at",
                               "%r is not a clock time" % value, field="resets_at")
    if hour is None:
        raise ApiError(400, "bad_resets_at",
                       "could not read %r as a time — use ISO 8601, an epoch, "
                       "or a clock time like 11:50pm" % value, field="resets_at")

    # The next occurrence, in whichever zone we were told to read it in.
    base = datetime.datetime.fromtimestamp(ref, tz) if tz is not None \
        else datetime.datetime.fromtimestamp(ref)
    target = base.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if target.timestamp() <= ref:
        target += datetime.timedelta(days=1)
    return target.timestamp()


def clock_label(ts: float) -> str:
    """`11:50pm` — a reset time in the words the board says it in. Local."""
    lt = time.localtime(ts)
    hour = lt.tm_hour % 12 or 12
    return "%d:%02d%s" % (hour, lt.tm_min, "am" if lt.tm_hour < 12 else "pm")


# --------------------------------------------------------------------------
# Settings validation
#
# Rejecting an unknown key is the whole point. A settings file is read by the
# SESSION at dispatch, hours after it was written, and a typo that is silently
# accepted ("model_polciy") reads back as "the default is fine" -- the board
# would look configured and behave like it never was. So every key is named
# here, anything else is a 400 that says which key it choked on, and the
# response never guesses what you meant.


def _bad(field: str, message: str, code: str = "bad_value"):
    return ApiError(400, code, message, field=field)


def clean_executor_name(value, field: str = "executor") -> str:
    """An executor name is a short identifier -- it names a row in `executors`."""
    if not isinstance(value, str) or not value.strip():
        raise _bad(field, "%s must be a non-empty string" % field)
    name = value.strip()
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$", name):
        raise _bad(field, "%s must be 1-40 chars of letters, digits, . _ -" % field)
    return name


def reject_reserved_executor_name(name: str, field: str = "worker.executors key"):
    """`BUILTIN_EXECUTOR` ("subagent") is the board's own word for a plain
    Claude worker -- an executor claiming that name would shadow the builtin
    everywhere a card resolves its executor (`resolve_dispatch`,
    `default_executor`'s own fallback). Same rule the settings sheet already
    enforces client-side (`RESERVED_NAMES` in web/settings.js) against the
    same already-trimmed name, so this has to match it exactly: case-
    sensitive, whitespace already stripped by `clean_executor_name`.

    `default_executor` itself is exempt on purpose -- "subagent" is its own
    valid, expected value (it means "use the builtin"). Only a *named*
    executor in `worker.executors` can collide with the builtin's name.
    """
    if name == BUILTIN_EXECUTOR:
        raise _bad(field,
                   "\"%s\" is the board's own word for a plain Claude worker "
                   "-- pick another name" % name,
                   code="reserved_name")


def clean_model_name(value, field: str = "model") -> str:
    """A model is a free-form label (`sonnet`, `opus`, `grok-4`) -- we do not
    keep a whitelist of somebody else's product names, we just keep it sane.

    The strict sibling of `clean_model`: settings and an explicit per-card
    dispatch have a human on the other end of the 400, so a blank or a number
    is refused by name rather than quietly recorded as "no model"."""
    if not isinstance(value, str) or not value.strip():
        raise _bad(field, "%s must be a non-empty string" % field)
    model = " ".join(value.split())
    if len(model) > 60:
        raise _bad(field, "%s is too long (60 chars max)" % field)
    return model


def validate_executor(name: str, spec) -> dict:
    field = "worker.executors.%s" % name
    if not isinstance(spec, dict):
        raise _bad(field, "%s must be an object" % field)
    for key in spec:
        if key not in EXECUTOR_FIELDS:
            raise ApiError(400, "unknown_key",
                           "%s.%s is not a known executor field (allowed: %s)"
                           % (field, key, ", ".join(EXECUTOR_FIELDS)),
                           field="%s.%s" % (field, key))
    kind = spec.get("kind")
    if kind not in EXECUTOR_KINDS:
        raise _bad("%s.kind" % field,
                   "kind must be one of %s" % ", ".join(EXECUTOR_KINDS))
    out = {"kind": kind}
    if kind == "tmux":
        # Without a command there is nothing to start in the window, and the
        # session would have to guess -- which is exactly how a "configured"
        # tmux executor silently becomes a subagent.
        if not isinstance(spec.get("command"), str) or not spec["command"].strip():
            raise _bad("%s.command" % field,
                       "a tmux executor needs a command to run (e.g. \"grok\")",
                       code="missing_field")
        out["command"] = spec["command"].strip()
        session = spec.get("session", "sprint-workers")
        if not isinstance(session, str) or not session.strip():
            raise _bad("%s.session" % field, "session must be a non-empty string")
        out["session"] = session.strip()
    elif spec.get("command") or spec.get("session"):
        raise _bad("%s.command" % field,
                   "command/session only apply to a tmux executor")
    if spec.get("model") is not None:
        out["model"] = clean_model_name(spec["model"], "%s.model" % field)
    if spec.get("note") is not None:
        if not isinstance(spec["note"], str):
            raise _bad("%s.note" % field, "note must be a string")
        out["note"] = " ".join(spec["note"].split())[:200]
    return out


def validate_settings(patch, base=None) -> dict:
    """Merge a patch onto `base` (or the defaults) and hand back whole settings.

    Per-key merge, EXCEPT `worker.executors`: a patch that carries it replaces
    the map wholesale, because that is what an editor sends and there is no
    honest way to express "delete this executor" in a merge.
    """
    if patch is None:
        patch = {}
    if not isinstance(patch, dict):
        raise _bad("settings", "settings must be an object")
    current = normalize_settings(base)
    for key in patch:
        if key not in ("worker", "agent_name", "session_tmux_window"):
            raise ApiError(400, "unknown_key",
                           "%s is not a setting (\"worker\", \"agent_name\" and "
                           "\"session_tmux_window\" are the three that exist "
                           "today)" % key, field=key)
    agent_name = current["agent_name"]
    if "agent_name" in patch:
        agent_name = clean_agent_name(patch["agent_name"])
    tmux_window = current["session_tmux_window"]
    if "session_tmux_window" in patch:
        tmux_window = clean_tmux_window(patch["session_tmux_window"])
    worker_patch = patch.get("worker", {})
    if not isinstance(worker_patch, dict):
        raise _bad("worker", "worker must be an object")
    for key in worker_patch:
        if key not in SETTINGS_KEYS:
            raise ApiError(400, "unknown_key",
                           "worker.%s is not a setting (allowed: %s)"
                           % (key, ", ".join(SETTINGS_KEYS)),
                           field="worker.%s" % key)
    worker = dict(current["worker"])

    if "model_policy" in worker_patch:
        value = worker_patch["model_policy"]
        if value not in MODEL_POLICIES:
            raise _bad("worker.model_policy",
                       "model_policy must be one of %s" % ", ".join(MODEL_POLICIES))
        worker["model_policy"] = value

    if "executors" in worker_patch:
        execs = worker_patch["executors"]
        if not isinstance(execs, dict):
            raise _bad("worker.executors", "executors must be an object of name -> definition")
        clean = {}
        for name, spec in execs.items():
            clean_name = clean_executor_name(name, "worker.executors key")
            reject_reserved_executor_name(clean_name)
            clean[clean_name] = validate_executor(name, spec)
        worker["executors"] = clean

    if "concurrency" in worker_patch:
        value = worker_patch["concurrency"]
        if isinstance(value, bool) or not isinstance(value, int):
            raise _bad("worker.concurrency", "concurrency must be a whole number")
        if value < 1 or value > MAX_CONCURRENCY:
            raise _bad("worker.concurrency",
                       "concurrency must be between 1 and %d" % MAX_CONCURRENCY)
        worker["concurrency"] = value

    if "default_executor" in worker_patch:
        worker["default_executor"] = clean_executor_name(
            worker_patch["default_executor"], "worker.default_executor")

    # Last, so it is checked against the executors this same request defined:
    # a default pointing at an executor nobody declared is a dispatch that
    # fails at 2am, not a settings file.
    default = worker["default_executor"]
    if default != BUILTIN_EXECUTOR and default not in worker["executors"]:
        raise _bad("worker.default_executor",
                   "default_executor \"%s\" is not in worker.executors "
                   "(known: %s)" % (default, ", ".join(
                       sorted(list(worker["executors"].keys()) + [BUILTIN_EXECUTOR]))))
    return {"worker": worker, "agent_name": agent_name,
            "session_tmux_window": tmux_window}


def normalize_settings(raw) -> dict:
    """Whatever is on disk, made whole. Unknown/broken content falls back to the
    default for that key rather than 500-ing the board -- a hand-edited file
    must never be able to take the sprint down."""
    out = {"worker": dict(DEFAULT_SETTINGS["worker"]),
           "agent_name": DEFAULT_SETTINGS["agent_name"],
           "session_tmux_window": DEFAULT_SETTINGS["session_tmux_window"]}
    out["worker"]["executors"] = {
        k: dict(v) for k, v in DEFAULT_SETTINGS["worker"]["executors"].items()}
    if not isinstance(raw, dict):
        return out
    try:
        out["agent_name"] = clean_agent_name(raw.get("agent_name"))
    except ApiError:
        # A hand-edited name that is too long or not a string is a nameless
        # session, not a dead board.
        out["agent_name"] = ""
    try:
        out["session_tmux_window"] = clean_tmux_window(
            raw.get("session_tmux_window"))
    except ApiError:
        # A hand-edited window that is not a legal tmux target is NO window.
        # Falling back to a broken address would mean the hub types a wake-up
        # brief at whatever that string happens to hit.
        out["session_tmux_window"] = ""
    worker = raw.get("worker")
    if not isinstance(worker, dict):
        return out
    if worker.get("model_policy") in MODEL_POLICIES:
        out["worker"]["model_policy"] = worker["model_policy"]
    if isinstance(worker.get("concurrency"), int) and \
            not isinstance(worker.get("concurrency"), bool) and \
            1 <= worker["concurrency"] <= MAX_CONCURRENCY:
        out["worker"]["concurrency"] = worker["concurrency"]
    execs = worker.get("executors")
    if isinstance(execs, dict):
        clean = {}
        for name, spec in execs.items():
            try:
                clean_name = clean_executor_name(name)
                reject_reserved_executor_name(clean_name)
                clean[clean_name] = validate_executor(name, spec)
            except ApiError:
                continue
        if clean:
            out["worker"]["executors"] = clean
    default = worker.get("default_executor")
    if isinstance(default, str) and (
            default == BUILTIN_EXECUTOR or default in out["worker"]["executors"]):
        out["worker"]["default_executor"] = default
    return out


def resolve_dispatch(settings: dict, executor=None, model=None) -> dict:
    """What a card actually gets at dispatch: {executor, kind, model, command,
    session, source}. `source` says whether the choice came from the card or
    from the board's defaults -- the card face uses it to decide whether this
    is worth a tag."""
    worker = normalize_settings(settings)["worker"]
    name = executor or worker["default_executor"]
    spec = worker["executors"].get(name)
    if spec is None:
        spec = {"kind": "subagent"} if name == BUILTIN_EXECUTOR else {"kind": "subagent"}
    out = {
        "executor": name,
        "kind": spec.get("kind", "subagent"),
        "command": spec.get("command"),
        "session": spec.get("session"),
        "model": model or spec.get("model") or POLICY_MODEL.get(
            worker["model_policy"], "sonnet"),
        "source": "card" if (executor or model) else "settings",
    }
    return out


# --------------------------------------------------------------------------
# App: all state, no decisions
# --------------------------------------------------------------------------


class App:
    def __init__(self, project_root: str, data_dir: str = None, token: str = None,
                 silence_seconds: float = None, silence_tick: float = None,
                 session_offline_seconds: float = None,
                 waiter_online_seconds: float = None,
                 waiter_gone_seconds: float = None,
                 waiter_persist_seconds: float = None,
                 sse_heartbeat: float = None, max_upload: int = None,
                 sweep_tick: float = None, sweep_thresholds: dict = None,
                 sweep_backoff=None, sweep_max_reminders: int = None,
                 worker_gone_seconds: float = None,
                 worker_dead_seconds: float = None,
                 worker_longrun_factor: float = None,
                 default_model: str = None,
                 code_path: str = None,
                 session_dead_seconds: float = None,
                 revive_min_interval: float = None,
                 revive_max_burst: int = None,
                 revive_burst_window: float = None,
                 revive_grace_seconds: float = None,
                 log=None):
        self.project_root = os.path.realpath(project_root)
        self.data_dir = os.path.realpath(data_dir or os.path.join(self.project_root, DATA_DIRNAME))
        self.attach_dir = os.path.join(self.data_dir, ATTACH_DIRNAME)
        os.makedirs(self.attach_dir, exist_ok=True)
        self.db_path = os.path.join(self.data_dir, DB_FILENAME)
        # Per-project settings (model policy, executors, concurrency). A file
        # beside the DB, deliberately: hand-editable, survives `stop`, diffable.
        self.config_path = os.path.join(self.data_dir, CONFIG_FILENAME)
        self._settings_lock = threading.Lock()
        self._settings_cache = None
        self.started_at = now()
        # One id per server PROCESS. An open tab that sees this change knows the
        # backend it was talking to is gone -- its SSE stream, its in-flight
        # POSTs and (if the token was rotated) its credentials all died with it.
        # The tab re-syncs from its cursor instead of sitting there silently
        # believing a connection that no longer exists.
        self.generation = "%d-%s" % (int(self.started_at * 1000), secrets.token_hex(4))
        self.token = token or secrets.token_urlsafe(24)

        self.silence_seconds = (
            silence_seconds if silence_seconds is not None
            else env_float("SPRINT_SILENCE_SECONDS", DEFAULT_SILENCE_SECONDS))
        self.silence_tick = (
            silence_tick if silence_tick is not None
            else env_float("SPRINT_SILENCE_TICK", DEFAULT_SILENCE_TICK))
        self.session_offline_seconds = (
            session_offline_seconds if session_offline_seconds is not None
            else env_float("SPRINT_SESSION_OFFLINE_SECONDS", DEFAULT_SESSION_OFFLINE_SECONDS))
        self.waiter_online_seconds = (
            waiter_online_seconds if waiter_online_seconds is not None
            else env_float("SPRINT_WAITER_ONLINE_SECONDS", DEFAULT_WAITER_ONLINE_SECONDS))
        self.waiter_gone_seconds = (
            waiter_gone_seconds if waiter_gone_seconds is not None
            else env_float("SPRINT_WAITER_GONE_SECONDS", DEFAULT_WAITER_GONE_SECONDS))
        self.waiter_persist_seconds = (
            waiter_persist_seconds if waiter_persist_seconds is not None
            else env_float("SPRINT_WAITER_PERSIST_SECONDS", DEFAULT_WAITER_PERSIST_SECONDS))
        self.sse_heartbeat = (
            sse_heartbeat if sse_heartbeat is not None
            else env_float("SPRINT_SSE_HEARTBEAT", DEFAULT_SSE_HEARTBEAT))
        self.max_upload = (
            max_upload if max_upload is not None
            else env_int("SPRINT_MAX_UPLOAD", DEFAULT_MAX_UPLOAD))

        # Staleness sweep. Every threshold is env-tunable by design: the only
        # honest way to test a ten-minute rule is to make it ten seconds.
        self.sweep_tick = (
            sweep_tick if sweep_tick is not None
            else env_float("SPRINT_SWEEP_TICK", DEFAULT_SWEEP_TICK))
        overrides = dict(sweep_thresholds or {})
        self.sweep_thresholds = {}
        for state, envname, default in STUCK_RULES:
            self.sweep_thresholds[state] = (
                float(overrides[state]) if state in overrides
                else env_float(envname, default))
        self.sweep_backoff = tuple(
            float(x) for x in (sweep_backoff if sweep_backoff is not None
                               else DEFAULT_SWEEP_BACKOFF))
        self.sweep_max_reminders = (
            int(sweep_max_reminders) if sweep_max_reminders is not None
            else env_int("SPRINT_SWEEP_MAX_REMINDERS", DEFAULT_SWEEP_MAX_REMINDERS))

        # Killed-agent detection. Same reasoning as the sweep thresholds: a
        # twenty-minute rule is only testable if twenty minutes can be two
        # seconds.
        self.worker_gone_seconds = (
            worker_gone_seconds if worker_gone_seconds is not None
            else env_float("SPRINT_WORKER_GONE_SECONDS", DEFAULT_WORKER_GONE_SECONDS))
        self.worker_dead_seconds = (
            worker_dead_seconds if worker_dead_seconds is not None
            else env_float("SPRINT_WORKER_DEAD_SECONDS", DEFAULT_WORKER_DEAD_SECONDS))
        self.worker_longrun_factor = (
            worker_longrun_factor if worker_longrun_factor is not None
            else env_float("SPRINT_WORKER_LONGRUN_FACTOR", DEFAULT_WORKER_LONGRUN_FACTOR))
        self.default_model = clean_model(
            default_model if default_model is not None
            else os.environ.get("SPRINT_DEFAULT_MODEL", DEFAULT_MODEL)) or DEFAULT_MODEL

        # Dead-session autoheal. Same reasoning as every other clock in here:
        # a twenty-minute rule that cannot be made two seconds cannot be tested.
        self.session_dead_seconds = (
            session_dead_seconds if session_dead_seconds is not None
            else env_float("SPRINT_SESSION_DEAD_SECONDS", DEFAULT_SESSION_DEAD_SECONDS))
        self.revive_min_interval = (
            revive_min_interval if revive_min_interval is not None
            else env_float("SPRINT_REVIVE_MIN_INTERVAL", DEFAULT_REVIVE_MIN_INTERVAL))
        self.revive_max_burst = (
            int(revive_max_burst) if revive_max_burst is not None
            else env_int("SPRINT_REVIVE_MAX_BURST", DEFAULT_REVIVE_MAX_BURST))
        self.revive_burst_window = (
            revive_burst_window if revive_burst_window is not None
            else env_float("SPRINT_REVIVE_BURST_WINDOW", DEFAULT_REVIVE_BURST_WINDOW))
        self.revive_grace_seconds = (
            revive_grace_seconds if revive_grace_seconds is not None
            else env_float("SPRINT_REVIVE_GRACE_SECONDS", DEFAULT_REVIVE_GRACE_SECONDS))

        self._log = log
        self.lock = threading.RLock()
        self.cond = threading.Condition()
        self.stopping = threading.Event()
        self.conn = sqlite3.connect(self.db_path, check_same_thread=False,
                                    timeout=30.0, isolation_level=None)
        self.conn.row_factory = sqlite3.Row
        with self.lock:
            self.conn.executescript(SCHEMA)
            self._add_missing_columns()
        self._silence_thread = None
        self._sweep_thread = None
        # Waiter proof-of-life. In memory for the hot path (every poll), flushed
        # to the `cursors` table at most every waiter_persist_seconds so a server
        # restart doesn't forget that the session was attached a moment ago.
        row = self.q1("SELECT * FROM cursors WHERE name=?", (WAITER_CURSOR,))
        self._waiter_seen_at = float(row["updated_at"]) if row else None
        self._waiter_persisted_at = self._waiter_seen_at or 0.0
        # Machine-wide context for `/api/siblings` (the title dropdown): which
        # other sprints are up on this box. `port`/`hosts` are stamped by
        # `cmd_start` once the socket is really bound; `registry` is the
        # `--registry` / $SPRINT_REGISTRY override, so a test never reads the
        # real ~/.sprint. The snapshot is cached because a dozen browser tabs
        # must not turn into a dozen health-check sweeps.
        self.registry = None
        self.port = None
        self.hosts = []
        self.siblings_ttl = env_float("SPRINT_SIBLINGS_TTL", DEFAULT_SIBLINGS_TTL)
        self._siblings_lock = threading.Lock()
        self._siblings_snap = None

        # -- self-restart --------------------------------------------------
        #
        # Which file this process is running, and what it looked like when we
        # loaded it. Everything downstream compares against this snapshot, so a
        # board only ever restarts for code that is genuinely different from the
        # code it is executing -- not for a touch, and not for its own restart.
        self.code_path = os.path.realpath(code_path or SPRINTD_PATH)
        snap = code_digest(self.code_path)
        self.code_sha = snap["sha"] if snap else None
        self.selfrestart_path = os.path.join(self.data_dir, SELFRESTART_FILENAME)
        self.code_watch_tick = env_float("SPRINT_CODE_WATCH_TICK",
                                         DEFAULT_CODE_WATCH_TICK)
        self.code_settle_seconds = env_float("SPRINT_CODE_SETTLE_SECONDS",
                                             DEFAULT_CODE_SETTLE_SECONDS)
        self.selfrestart_min_interval = env_float(
            "SPRINT_SELFRESTART_MIN_INTERVAL", DEFAULT_SELFRESTART_MIN_INTERVAL)
        self.selfrestart_max_burst = env_int("SPRINT_SELFRESTART_MAX_BURST",
                                             DEFAULT_SELFRESTART_MAX_BURST)
        self.selfrestart_burst_window = env_float(
            "SPRINT_SELFRESTART_BURST_WINDOW", DEFAULT_SELFRESTART_BURST_WINDOW)
        self.restart_drain_seconds = env_float("SPRINT_RESTART_DRAIN_SECONDS",
                                               DEFAULT_RESTART_DRAIN_SECONDS)
        # Only a real `sprintd start` may re-exec itself: an App built by a test
        # or imported by a helper has no argv worth exec'ing and no servers to
        # drain. `cmd_start` turns both of these on once it is really serving.
        self.watch_code = False
        self.restart_argv = None
        self.servers = []
        self.resume_serving = None
        self._execv = os.execv                  # seam: tests swap it, nothing else
        self._code_thread = None
        self._code_seen = None                  # a changed sha waiting to settle
        self._code_told = set()                 # shas we have already spoken about
        # In-flight, non-streaming requests. A restart waits for this to reach
        # zero so nobody's POST dies in the middle of a write.
        self._inflight = 0
        self._inflight_cond = threading.Condition()

    # -- infra ------------------------------------------------------------

    # `CREATE TABLE IF NOT EXISTS` does nothing to a table that already exists,
    # so a board that has been running since before a column landed would 500 on
    # every read of it. One idempotent ALTER pass at open, driven off the live
    # column list -- no version counter to keep in step with anything.
    ADDED_COLUMNS = (
        ("cards", "external_agent", "INTEGER NOT NULL DEFAULT 0"),
        ("cards", "work_kind", "TEXT NOT NULL DEFAULT 'code'"),
        # the per-card dispatch choice: NULL means "the board's defaults"
        ("cards", "executor", "TEXT"),
        # Which model the agent on this card was dispatched on. NULL means
        # "the sprint default" -- the face only ever shows the exception.
        ("cards", "model", "TEXT"),
        # What SHAPE of card this is: `work` (everything the board has ever
        # had) or `conversation` (an ongoing thread that never becomes work).
        # Defaulting to 'work' is what makes this migration free: every row
        # that already exists is, by definition, the kind that already existed.
        ("cards", "kind", "TEXT NOT NULL DEFAULT 'work'"),
        # What a DECISION REQUEST hands over with its question: a live URL,
        # screenshots, and a short note. NULL for a plain question, which is
        # every question a board created before this landed.
        ("questions", "artifacts", "TEXT"),
        # WHY it is on that model, in the session's words ("fable limited until
        # 23:50"). Without this, "downgraded because of a limit" is not a fact
        # anyone can query when the window ends -- it is a thing the session
        # would have to remember across a restart, which is exactly what it
        # failed to do the night this card was written.
        ("cards", "model_reason", "TEXT"),
        # The card this one is waiting on, and why. NULL on every card a board
        # created before the link was structural (it used to live in prose).
        ("cards", "blocked_by", "INTEGER"),
        ("cards", "blocked_reason", "TEXT"),
        # Account-wide windows landed after the first limits table shipped, so
        # a board that ran the earlier version has a `limits` table without it.
        ("limits", "kind", "TEXT NOT NULL DEFAULT 'model'"),
    )

    def _add_missing_columns(self):
        """MUST be called with self.lock held."""
        seen = {}
        for table, column, decl in self.ADDED_COLUMNS:
            if table not in seen:
                seen[table] = {r["name"] for r in
                               self.conn.execute("PRAGMA table_info(%s)" % table)}
            if column in seen[table]:
                continue
            self.conn.execute("ALTER TABLE %s ADD COLUMN %s %s" % (table, column, decl))
            seen[table].add(column)
        # Anything cached from before the ALTERs is now a lie.
        self._columns = {}

    def columns(self, table: str = "cards") -> set:
        """What this database's table actually has, cached.

        Read by anything that must cope with a column it did not create --
        `external_agent` lands from another change, and a rule that guards on
        it has to degrade to "no such flag" rather than crash on an older DB.
        """
        cached = getattr(self, "_columns", None)
        if cached is None:
            cached = self._columns = {}
        if table not in cached:
            cached[table] = {r["name"] for r in
                             self.q("PRAGMA table_info(%s)" % table)}
        return cached[table]

    def card_flag(self, row, name: str) -> bool:
        """A boolean column that may not exist in this database yet."""
        if name not in self.columns("cards"):
            return False
        try:
            return bool(row[name])
        except (IndexError, KeyError):
            return False

    def card_kind(self, row) -> str:
        """`work` or `conversation`, tolerant of a database from before kinds.

        An old DB has no `kind` column at all, and every card in it predates
        conversations -- so "I don't know" and "work" are the same answer, and
        this degrades to it rather than raising.
        """
        if row is None or "kind" not in self.columns("cards"):
            return "work"
        try:
            val = row["kind"]
        except (IndexError, KeyError):
            return "work"
        return val if val in CARD_KINDS else "work"

    def is_conversation(self, row) -> bool:
        return self.card_kind(row) == "conversation"

    def log(self, msg: str):
        line = "%s sprintd %s" % (time.strftime("%Y-%m-%dT%H:%M:%S"), msg)
        if self._log:
            try:
                self._log.write(line + "\n")
                self._log.flush()
            except (OSError, ValueError):
                pass
        else:
            sys.stderr.write(line + "\n")

    # -- settings ---------------------------------------------------------

    def settings(self) -> dict:
        """Whole, valid settings -- defaults where the file is silent.

        Read from disk (so `$EDITOR .sprint/config.json` is a first-class way
        to change it) but cached on the file's mtime+size, because every card
        on every board fetch asks what the defaults are. The cache holds the
        RAW json and normalizes per call, so no caller can mutate a shared
        dict out from under the next one.
        """
        try:
            st = os.stat(self.config_path)
            stamp = (st.st_mtime_ns, st.st_size)
        except OSError:
            stamp = None
        cached = getattr(self, "_settings_cache", None)
        if cached is not None and cached[0] == stamp:
            return normalize_settings(cached[1])
        raw = None
        if stamp is not None:
            try:
                with open(self.config_path, "r", encoding="utf-8") as fh:
                    raw = json.load(fh)
            except (OSError, ValueError) as err:
                # A hand-edited file with a stray comma must not take the board
                # down; it falls back to defaults and says so in the log.
                self.log("config.json unreadable (%s) -- using defaults" % err)
                raw = None
        self._settings_cache = (stamp, raw)
        return normalize_settings(raw)

    def save_settings(self, patch, actor: str = "user") -> dict:
        """Validate a patch against what is on disk and write the whole file.

        Atomic (tmp + rename) so a crash mid-write can never leave the board
        with half a config. Writes a sprint-level `note` event too -- as
        `actor: "server"`, like the sweep, so it rides the session's tail
        (a policy change the session never hears about takes effect
        invisibly) without ever pretending a human is waiting for a reply.
        """
        with self._settings_lock:
            current = self.settings()
            merged = validate_settings(patch, current)
            if merged == current:
                return merged
            tmp = self.config_path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(jdump(merged) + "\n")
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, self.config_path)
            changed = [k for k in SETTINGS_KEYS
                       if merged["worker"].get(k) != current["worker"].get(k)]
            w = merged["worker"]
            # Naming yourself is not a dispatch policy change, and saying so in
            # the same sentence would be a lie. It gets its own line, in the
            # session's own voice, because it is an introduction.
            if merged["agent_name"] != current["agent_name"]:
                was, now = current["agent_name"], merged["agent_name"]
                if not now:
                    text = "the session dropped the name “%s”" % was
                elif not was:
                    text = "the session is called “%s”" % now
                else:
                    text = "the session renamed itself “%s” → “%s”" % (was, now)
                with self.lock:
                    self._append_event(None, "server", "note", {
                        "text": text, "agent_name": now, "was": was or None,
                        "by": actor if actor in ACTORS else "user",
                    })
            # Registering a wake channel is neither a policy change nor an
            # introduction: it is the session telling the board where it can be
            # reached if it dies. One quiet line, so the fact is in the log the
            # hub's revive attempts will later refer to.
            if merged["session_tmux_window"] != current["session_tmux_window"]:
                was, win = current["session_tmux_window"], merged["session_tmux_window"]
                if not win:
                    text = "the session is no longer reachable in tmux"
                elif not was:
                    text = "the session can be woken in tmux window “%s”" % win
                else:
                    text = ("the session moved to tmux window “%s” (was “%s”)"
                            % (win, was))
                with self.lock:
                    self._append_event(None, "server", "note", {
                        "text": text, "session_tmux_window": win or None,
                        "was": was or None,
                        "by": actor if actor in ACTORS else "user",
                    })
            if not changed:
                self.notify()
                return merged
            with self.lock:
                self._append_event(None, "server", "note", {
                    "text": "settings changed: %s — in effect for the next dispatch"
                            % (", ".join(changed) or "worker"),
                    "settings": merged,
                    "changed": changed,
                    "by": actor if actor in ACTORS else "user",
                    "detail": "model policy %s · default executor %s · concurrency %d"
                              % (w["model_policy"], w["default_executor"], w["concurrency"]),
                })
            self.notify()
            return merged

    def close(self):
        self.stopping.set()
        with self.cond:
            self.cond.notify_all()
        if self._silence_thread is not None:
            self._silence_thread.join(timeout=5)
        if self._sweep_thread is not None:
            self._sweep_thread.join(timeout=5)
        with self.lock:
            try:
                self.conn.close()
            except sqlite3.Error:
                pass

    def start_background(self):
        if self._silence_thread is None:
            t = threading.Thread(target=self._silence_loop, name="silence",
                                 daemon=True)
            self._silence_thread = t
            t.start()
        if self._sweep_thread is None:
            t = threading.Thread(target=self._sweep_loop, name="sweep",
                                 daemon=True)
            self._sweep_thread = t
            t.start()
        if self.watch_code and self._code_thread is None:
            t = threading.Thread(target=self._code_loop, name="code", daemon=True)
            self._code_thread = t
            t.start()

    # -- picking up new code ----------------------------------------------
    #
    # User ruling, verbatim: "don't show me this notice" -- about a banner that
    # read "this board needs a restart to pick up new features — run `sprintd
    # stop` then `sprintd start` in its project". Restarting a server is not
    # work for a human. So the board watches the file it is running and, when
    # that file becomes different code, re-execs ITSELF.
    #
    # `os.execv` and not a fork: exec replaces this process image in place, so
    # the pid in server.json, the launchd job, the log fd and the terminal that
    # started it all survive. Everything that makes the board what it is --
    # port, token, data dir, registry row -- is already on disk and is re-read
    # by the new image, so the URL in the user's browser keeps working and the
    # tab re-syncs off `generation` exactly as it does after a manual restart.
    #
    # Four gates stand between "the file changed" and "exec", and each one
    # exists because of a way this could take a sprint down:
    #   1. CONTENT, not mtime -- a checkout that rewrites the same bytes is not
    #      new code (`code_digest`).
    #   2. SETTLED -- a file written in the last couple of seconds is probably
    #      still being written; and the same sha has to be seen twice.
    #   3. COMPILES -- we never exec into something python cannot even parse
    #      (`code_compiles`). This is the difference between "wait a beat" and
    #      "the board is gone".
    #   4. IDLE -- no in-flight request, and the DB write lock in hand, so
    #      nothing is half-written when the image is replaced.
    # Plus the crash-loop guard: a stamp on disk with a minimum interval and a
    # burst ceiling, so a file that keeps changing can never turn into a board
    # that keeps restarting. When the guard says no, the news goes to the event
    # log for the SESSION to read -- never to the user as a chore.

    def enter_request(self):
        with self._inflight_cond:
            self._inflight += 1

    def exit_request(self):
        with self._inflight_cond:
            self._inflight -= 1
            if self._inflight <= 0:
                self._inflight_cond.notify_all()

    def inflight(self) -> int:
        with self._inflight_cond:
            return self._inflight

    def wait_until_idle(self, timeout: float = None) -> bool:
        """Block until no ordinary request is being served. False on timeout.

        Streaming requests (SSE) deliberately do not count: they are held open
        for hours by design, and waiting for one to end would mean never
        restarting. A stream dies with the old image and the browser's
        EventSource reconnects to the new one on its own -- the same thing it
        already does across a manual restart.
        """
        deadline = now() + (self.restart_drain_seconds if timeout is None else timeout)
        with self._inflight_cond:
            while self._inflight > 0:
                left = deadline - now()
                if left <= 0:
                    return False
                self._inflight_cond.wait(left)
            return True

    def read_restart_stamp(self) -> dict:
        """The crash-loop stamp: when we last re-exec'd, and how often lately."""
        try:
            with open(self.selfrestart_path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            return {}
        return data if isinstance(data, dict) else {}

    def write_restart_stamp(self, sha: str, at: float = None) -> dict:
        """Record the restart BEFORE doing it.

        Before, because the whole point is to survive the case where the new
        image never comes back: a stamp written after the exec would never be
        written at all.
        """
        at = now() if at is None else at
        prev = self.read_restart_stamp()
        first = float(prev.get("burst_started_at") or 0)
        count = int(prev.get("burst_count") or 0)
        if not first or (at - first) > self.selfrestart_burst_window:
            first, count = at, 0
        stamp = {"at": at, "sha": sha, "pid": os.getpid(),
                 "burst_started_at": first, "burst_count": count + 1}
        tmp = self.selfrestart_path + ".tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(jdump(stamp) + "\n")
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, self.selfrestart_path)
        except OSError as exc:
            # No stamp means no crash-loop guard, and no guard means we must not
            # restart at all: an unwritable stamp is a reason to stay put.
            self.log("could not write the self-restart stamp %s (%s)"
                     % (self.selfrestart_path, exc))
            return {}
        return stamp

    def restart_hold_reason(self, at: float = None):
        """Why a restart must NOT happen right now, in the user's words, or None."""
        at = now() if at is None else at
        stamp = self.read_restart_stamp()
        last = float(stamp.get("at") or 0)
        if last and (at - last) < self.selfrestart_min_interval:
            return ("held off — this board restarted itself %s ago"
                    % human_span(at - last))
        first = float(stamp.get("burst_started_at") or 0)
        count = int(stamp.get("burst_count") or 0)
        if first and count >= self.selfrestart_max_burst and \
                (at - first) <= self.selfrestart_burst_window:
            return ("paused — %d self-restarts inside %s, so this one is not "
                    "automatic" % (count, human_span(self.selfrestart_burst_window)))
        return None

    def code_note(self, text: str, sha: str, kind: str, detail: str = None,
                  once: bool = True):
        """One quiet line in the event log, addressed to the session.

        `actor: "server"` keeps it out of the sidebar thread (which is user and
        session lines only), so this is a log entry and never a message telling
        the person at the keyboard to go do ops.
        """
        key = (kind, sha)
        if once:
            if key in self._code_told:
                return None
            self._code_told.add(key)
        payload = {"text": text, "code_update": True, "restart_kind": kind,
                   "code_sha": (sha or "")[:12]}
        if kind != "restarted":
            # What the session ACTS on: new code is on disk and the board could
            # not take it by itself.
            payload["restart_pending"] = True
        if detail:
            payload["detail"] = detail
        with self.lock:
            seq = self._append_event(None, "server", "note", payload)
        self.notify()
        return seq

    def check_code_update(self, at: float = None) -> str:
        """Look at our own source once. Returns what happened, for the tests.

        One of: "off", "unreadable", "unchanged", "settling", "broken",
        "held", "busy", "restarting", "failed".
        """
        at = now() if at is None else at
        if not self.code_sha:
            return "off"
        snap = code_digest(self.code_path)
        if snap is None:
            # A source file that vanished is not a reason to do anything: a
            # `git checkout` between two commits does this for a moment.
            return "unreadable"
        if snap["sha"] == self.code_sha:
            self._code_seen = None
            return "unchanged"
        if (at - snap["mtime"]) < self.code_settle_seconds:
            return "settling"
        if self._code_seen != snap["sha"]:
            # Seen once is not seen: two identical looks, a tick apart, is what
            # tells a finished write from a write in progress.
            self._code_seen = snap["sha"]
            return "settling"
        if not code_compiles(snap["source"], self.code_path):
            self.code_note(
                "new code on disk does not compile — still serving the old build",
                snap["sha"], "broken",
                detail="%s changed but python cannot parse it; the board will "
                       "pick it up as soon as it parses." % self.code_path)
            return "broken"
        hold = self.restart_hold_reason(at)
        if hold:
            self.code_note("new code on disk — self-restart %s" % hold,
                           snap["sha"], "held",
                           detail="%s changed. The board is still serving the "
                                  "build it started with." % self.code_path)
            return "held"
        if not self.wait_until_idle():
            # Somebody is mid-request. Nothing is wrong; look again next tick.
            return "busy"
        return "restarting" if self.self_restart(snap["sha"]) else "failed"

    def self_restart(self, sha: str) -> bool:
        """Re-exec this process with the new code. Returns False if it could not.

        Ordering is the safety design. The note and the stamp are written while
        the board is still whole; the listening sockets stop accepting but are
        NOT closed, so a failed exec can go straight back to serving; the DB
        write lock is held across the exec so no transaction can be open when
        the image is replaced. SQLite is in WAL mode, so even the ugliest
        version of this (a kill between the two) recovers on the next open.
        """
        argv = list(self.restart_argv or [])
        if not argv:
            self.log("self-restart wanted but no argv was recorded")
            return False
        self.code_note("restarted to pick up new code", sha, "restarted",
                       once=False)
        if not self.write_restart_stamp(sha):
            return False
        self.log("self-restart: exec %s" % " ".join(argv))
        for s in self.servers:
            try:
                s.shutdown()            # stop accepting; do NOT close the socket
            except Exception:
                pass
        self.wait_until_idle()
        try:
            with self.lock:             # no write may be open across the exec
                self._execv(argv[0], argv)
        except OSError as exc:
            # We are still whole: the sockets were never closed and the DB is
            # untouched. Go back to serving and tell the session why.
            self.log("self-restart failed to exec (%s) -- resuming" % exc)
            if self.resume_serving:
                try:
                    self.resume_serving()
                except Exception:
                    self.log("could not resume serving after a failed exec: %s"
                             % traceback.format_exc())
            self.code_note("could not restart into the new code (%s)" % exc,
                           sha, "failed",
                           detail="argv: %s" % " ".join(argv))
            return False
        return True                     # unreachable on a successful exec

    def _code_loop(self):
        while not self.stopping.wait(self.code_watch_tick):
            try:
                self.check_code_update()
            except Exception:           # never let the watcher kill the board
                self.log("code watch failed: %s" % traceback.format_exc())

    def q(self, sql, params=()):
        with self.lock:
            return self.conn.execute(sql, params).fetchall()

    def q1(self, sql, params=()):
        rows = self.q(sql, params)
        return rows[0] if rows else None

    def notify(self):
        with self.cond:
            self.cond.notify_all()

    # -- events -----------------------------------------------------------

    # ONE payload contract, so every reader (UI, session, tests) needs one field:
    #   text   -- the human one-liner, on EVERY event (the skim version)
    #   detail -- OPTIONAL expanded version: command output, reasoning, a log.
    #             Multi-line, rendered collapsed behind a "more" toggle. Never
    #             required to understand the line; `text` always stands alone.
    #   state events additionally carry from/to (+reason)
    #   attachment refs always carry a ready-to-use `url`
    TEXT_ALIASES = ("text", "message", "note", "summary", "claim",
                    "reason", "error")

    def normalize_payload(self, payload):
        if payload is None:
            return {}
        if not isinstance(payload, dict):
            return {"text": payload if isinstance(payload, str) else jdump(payload)}
        out = dict(payload)
        if "detail" in out:
            detail = out["detail"]
            if detail is None or (isinstance(detail, str) and not detail.strip()):
                out.pop("detail")          # nothing to expand: same as not sending it
            elif not isinstance(detail, str):
                raise ApiError(400, "bad_detail",
                               "detail must be a string (the expanded version of "
                               "text); got %s" % type(detail).__name__,
                               field="detail")
        if not (isinstance(out.get("text"), str) and out["text"].strip()):
            for key in self.TEXT_ALIASES:
                val = out.get(key)
                if isinstance(val, str) and val.strip():
                    out["text"] = val.strip()
                    break
            else:
                # detail-only: the skim line is its first line, never the blob.
                if isinstance(out.get("detail"), str):
                    out["text"] = one_line(out["detail"])
        for key in ("attachments", "images", "screenshots"):
            if isinstance(out.get(key), list) and out[key]:
                out[key] = self.ingest_refs(out[key])
        # `reports` on a worker event is a list of .md/.html paths, and it lands
        # in `attachments` beside any images so the thread has ONE list to read.
        if isinstance(out.get("reports"), list) and out["reports"]:
            docs = [d for d in self.ingest_report_refs(out.pop("reports"))
                    if isinstance(d, dict) and d.get("doc")]
            if docs:
                atts = out.get("attachments")
                out["attachments"] = (atts if isinstance(atts, list) else []) + docs
        return out

    @staticmethod
    def stamp_reply_to(card_num, actor: str, payload: dict) -> dict:
        """Where an answer to this event belongs, as a machine-readable string.

        Every user-originated event -- a card submission, card chat, an answer,
        a verdict, a sidebar line, a card action -- carries
        `payload.reply_to`: `"sidebar"` for sprint-level events, `"card:<num>"`
        for anything attached to a card. Any orchestrator (this session or a
        future one) routes its reply off that field alone; nothing has to be
        inferred from a doc, from the shape of the payload, or from which
        endpoint happened to be hit.

        Deliberately DUMB and TOTAL: it is the actor and the card number, and
        nothing else. It is also a biconditional -- the field is stamped on
        every `user` event and stripped from every worker/session/server event
        -- so `reply_to` present means "a human said this and is waiting", with
        no exceptions to remember.
        """
        out = dict(payload or {})
        if actor == "user":
            out["reply_to"] = "sidebar" if card_num is None else "card:%d" % int(card_num)
        else:
            out.pop("reply_to", None)
        return out

    def _append_event(self, card_num, actor: str, kind: str, payload: dict) -> int:
        """Append to the log. MUST be called with self.lock held."""
        if actor not in ACTORS:
            raise ApiError(400, "bad_actor", "actor must be one of %s" % (ACTORS,))
        if kind not in EVENT_KINDS:
            raise ApiError(400, "bad_kind", "kind must be one of %s" % (EVENT_KINDS,))
        payload = self.normalize_payload(payload)
        payload = self.stamp_reply_to(card_num, actor, payload)
        ts = now()
        cur = self.conn.execute(
            "INSERT INTO events(card_num, ts, actor, kind, payload) VALUES(?,?,?,?,?)",
            (card_num, ts, actor, kind, jdump(payload or {})))
        return int(cur.lastrowid)

    def event_row(self, seq: int) -> dict:
        row = self.q1("SELECT * FROM events WHERE seq=?", (seq,))
        return self.event_json(row) if row else None

    @staticmethod
    def event_json(row) -> dict:
        return {
            "seq": row["seq"],
            "card_num": row["card_num"],
            "ts": row["ts"],
            "actor": row["actor"],
            "kind": row["kind"],
            "payload": jload(row["payload"], {}),
        }

    def events_after(self, after: int, limit: int = 500, card_num=None) -> list:
        if card_num is None:
            rows = self.q("SELECT * FROM events WHERE seq>? ORDER BY seq LIMIT ?",
                          (after, limit))
        else:
            rows = self.q(
                "SELECT * FROM events WHERE seq>? AND card_num=? ORDER BY seq LIMIT ?",
                (after, card_num, limit))
        return [self.event_json(r) for r in rows]

    def max_seq(self) -> int:
        row = self.q1("SELECT COALESCE(MAX(seq),0) AS s FROM events")
        return int(row["s"])

    # -- sprints ----------------------------------------------------------

    def default_sprint_title(self) -> str:
        """What a sprint is called when nobody named it: the PROJECT.

        The board header used to read the literal string "sprint", which tells
        you nothing when three of them are open in three tmux windows. The
        project directory's basename is the name the human already uses for this
        work ("russ"), and it is the same string the machine-wide registry
        carries — the registry stays authoritative for the switcher's label, and
        this is only the fallback for the title of a sprint nobody titled.
        """
        return os.path.basename(self.project_root.rstrip(os.sep)) or "sprint"

    def name_untitled_sprint(self):
        """Rename a sprint still carrying the old literal default.

        "sprint" was never a name anybody chose — it was what the server wrote
        when it opened one unasked, and boards that were auto-opened before this
        change are all sitting under it. Anything else, including a title the
        session set, is left exactly alone.
        """
        row = self.q1("SELECT * FROM sprints WHERE closed_at IS NULL ORDER BY id DESC LIMIT 1")
        if row is None or (row["title"] or "").strip() != "sprint":
            return row
        title = self.default_sprint_title()
        if title == "sprint":
            return row
        with self.lock:
            self.conn.execute("UPDATE sprints SET title=? WHERE id=?", (title, row["id"]))
        return self.q1("SELECT * FROM sprints WHERE id=?", (row["id"],))

    def open_sprint(self, create: bool = True, title: str = None):
        row = self.q1("SELECT * FROM sprints WHERE closed_at IS NULL ORDER BY id DESC LIMIT 1")
        if row is not None or not create:
            return row
        with self.lock:
            row = self.conn.execute(
                "SELECT * FROM sprints WHERE closed_at IS NULL ORDER BY id DESC LIMIT 1"
            ).fetchone()
            if row is not None:
                return row
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.conn.execute(
                    "INSERT INTO sprints(opened_at, closed_at, title, hold_mode) VALUES(?,NULL,?,0)",
                    (now(), title or self.default_sprint_title()))
                sid = int(cur.lastrowid)
                self._append_event(None, "server", "note",
                                   {"text": "sprint opened", "sprint_id": sid})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return self.q1("SELECT * FROM sprints WHERE id=?", (sid,))

    def sprint_name(self) -> str:
        """What this sprint is CALLED -- the one string the header, the switcher
        and the hub all show. The open sprint's title, or the project's
        directory name if nobody has named it."""
        row = self.q1("SELECT * FROM sprints WHERE closed_at IS NULL "
                      "ORDER BY id DESC LIMIT 1")
        name = (row["title"] or "").strip() if row is not None else ""
        return name or self.default_sprint_title()

    def agent_name(self) -> str:
        """What the session running this board calls ITSELF, or "".

        User ruling, verbatim: "I also meant that the session agent gave
        themselves a name. Like "Chuck"". Different from `sprint_name`: the
        board is named after the work, the session is named after nobody --
        it picks a first name at launch so a line in the sidebar reads like a
        colleague talking rather than like a system component.
        """
        return self.settings().get("agent_name") or ""

    def claim_agent_name(self, name, actor: str = "session") -> dict:
        """Take a name at launch -- but only if the session has not got one.

        A name that changes every time the board restarts is not a name. The
        rule ("keep it across restarts") is enforced HERE and not left to the
        caller, because the caller is a fresh session that does not remember
        the last one. So `sprintd start --agent-name` is first-write-wins: it
        introduces a session that has never introduced itself, and it is a
        no-op for one that has.

        Renaming on purpose is a different act with a different door: PUT
        /api/settings {"agent_name": ...}, which is what the settings panel
        uses and always applies.
        """
        wanted = clean_agent_name(name)
        current = self.agent_name()
        if current and wanted and current != wanted:
            return {"agent_name": current, "claimed": False, "wanted": wanted}
        if current == wanted:
            return {"agent_name": current, "claimed": False, "wanted": wanted}
        self.save_settings({"agent_name": wanted}, actor=actor)
        return {"agent_name": wanted, "claimed": True, "wanted": wanted}

    def rename_sprint(self, name, actor: str = "user") -> dict:
        """Name (or rename) the open sprint.

        User ruling, verbatim: "every session should name itself on launch". A
        board called after its directory tells you where it is, not what it is
        about, and three of those in a switcher are three rows that all read the
        same. So the session names it at launch (`sprintd start --name`), and
        anybody can change it later from settings; both land here.

        The name is the sprint's title in the database -- one source of truth --
        and it is pushed into the machine-wide registry so the switcher and the
        hub show it even when this board is the row somebody else is reading.
        """
        clean = clean_sprint_name(name)
        row = self.open_sprint(create=True)
        was = (row["title"] or "").strip()
        if was != clean:
            with self.lock:
                self.conn.execute("UPDATE sprints SET title=? WHERE id=?",
                                  (clean, row["id"]))
                self._append_event(None, "server", "note", {
                    "text": ("sprint named “%s”" % clean if not was
                             else "sprint renamed “%s” → “%s”" % (was, clean)),
                    "sprint_name": clean, "was": was or None,
                    "by": actor if actor in ACTORS else "user",
                })
            self.notify()
            # The snapshot the switcher polls carries the name too, and it is
            # cached for ten seconds -- long enough for a rename to look broken.
            with self._siblings_lock:
                self._siblings_snap = None
        try:
            registry_touch(self.project_root, {"name": clean}, self.registry)
        except OSError as exc:
            self.log("could not update the registry name (%s) -- the switcher "
                     "on other boards may lag" % exc)
        return self.sprint_json(self.q1("SELECT * FROM sprints WHERE id=?",
                                        (row["id"],)))

    @staticmethod
    def sprint_json(row) -> dict:
        if row is None:
            return None
        return {
            "id": row["id"], "opened_at": row["opened_at"],
            "closed_at": row["closed_at"], "title": row["title"],
            "hold_mode": bool(row["hold_mode"]),
        }

    # -- cards ------------------------------------------------------------

    def card_row(self, num: int):
        row = self.q1("SELECT * FROM cards WHERE num=?", (num,))
        if row is None:
            raise ApiError(404, "no_such_card", "card #%s does not exist" % num)
        return row

    def card_json(self, row, brief: bool = False) -> dict:
        num = row["num"]
        # A board that has been up since before either column landed gets them
        # ALTERed in on open, but read defensively anyway: a 500 on every card
        # read is not the way to find out the migration did not run.
        have = self.columns("cards")
        c_model = row["model"] if "model" in have else None
        c_executor = row["executor"] if "executor" in have else None
        out = {
            "num": num,
            "sprint_id": row["sprint_id"],
            "state": row["state"],
            "title": row["title"],
            "body": row["body"],
            "batch_id": row["batch_id"],
            "agent_name": row["agent_name"],
            "worktree": row["worktree"],
            "branch": row["branch"],
            "bounce_count": row["bounce_count"],
            "pinned": bool(row["pinned"]),
            "dup_of": row["dup_of"],
            # The card-to-card wall, structural rather than prose: which card
            # this one is waiting on and why. Both NULL on a card with nothing
            # in its way, which is most of them -- so the face only ever draws
            # a marker for the exception.
            "blocked_by": (row["blocked_by"] if "blocked_by" in have else None),
            "blocked_reason": (row["blocked_reason"] if "blocked_reason" in have else None),
            "long_running": bool(row["long_running"]),
            # Which model this card's agent was dispatched on, and whether that
            # is worth saying out loud. NULL model or the sprint default means
            # the face shows nothing: a badge on every card is decoration.
            "model": c_model,
            # Why it is on that model. Rides the board payload so the session
            # can find every card downgraded for a limit when the window ends,
            # without a filter endpoint nobody else would ever call.
            "model_reason": (row["model_reason"] if "model_reason" in have else None),
            "default_model": self.default_model,
            # An assignee that emits no worker telemetry (an ordinary background
            # agent, a human, a cron). The silence timer cannot watch it, so it
            # doesn't -- the session owns checking on it.
            "external_agent": bool(row["external_agent"]),
            "work_kind": row["work_kind"] or "code",
            # What SHAPE of card this is. `work` on every card the board has
            # ever had; `conversation` on an ongoing thread that never enters
            # the work lifecycle.
            "kind": self.card_kind(row),
            "created_at": row["created_at"],
            "updated_at": row["updated_at"],
            # Who ran this card and with what. NULL on both means "the board's
            # defaults" -- which is why the face only tags a card that differs.
            "executor": c_executor,
        }
        if out["kind"] == "conversation":
            out["conversation"] = self.conversation_json(num)
        # Resolved for the face: "grok · tmux" needs the executor's KIND, and
        # the card alone does not know it. `is_default` is the tag's whole
        # question -- a board where everything runs on the default should
        # carry no executor chrome at all.
        dispatch = resolve_dispatch(self.settings(), c_executor, c_model)
        dispatch["is_default"] = (c_executor is None and c_model is None)
        out["dispatch"] = dispatch
        last = self.q1(
            "SELECT * FROM events WHERE card_num=? ORDER BY seq DESC LIMIT 1", (num,))
        out["last_event"] = self.event_json(last) if last else None
        # The sweep's own reminders are NOT activity. Counting them would reset
        # the card's age to "just now" at the exact moment the board is trying
        # to say "this has been sitting here too long" -- the amber and the
        # number would contradict each other on the same line. (The browser's
        # reducer already ignores server events here; this makes the server
        # agree.)
        act = self.q1("SELECT ts FROM events WHERE card_num=? AND kind!='stuck' "
                      "ORDER BY seq DESC LIMIT 1", (num,))
        out["last_activity_at"] = act["ts"] if act else row["updated_at"]
        out["silent"] = self.card_is_silent(num, row)
        out["stuck"] = self.card_is_stuck(num, row)
        oq = self.q1(
            "SELECT * FROM questions WHERE card_num=? AND answered_at IS NULL "
            "ORDER BY id DESC LIMIT 1", (num,))
        q = self.question_json(oq) if oq else None
        out["open_question"] = q
        out["question"] = q          # the board face renders this inline
        out["column"] = COLUMN_OF.get(row["state"], "queued")
        # Everything the card FACE needs, on every payload: a blocked card's
        # machine-named reason, a failed card's last error, and the evidence a
        # ready card is asking the user to check.
        st = self.q1("SELECT * FROM events WHERE card_num=? AND kind='state' "
                     "ORDER BY seq DESC LIMIT 1", (num,))
        stp = jload(st["payload"], {}) if st else {}
        out["state_since"] = st["ts"] if st else row["updated_at"]
        out["reason"] = stp.get("reason") if stp.get("to") == row["state"] else None
        # What the agent says it is DOING right now, on its own clock. A card
        # face that shows the last thing said reads as broken the moment that
        # line is three minutes old; a phase reads as working.
        ph = self.card_phase(num, st["seq"] if st else 0)
        out["phase"] = ph["phase"] if ph else None
        out["phase_since"] = ph["since"] if ph else None
        out["phase_expected_seconds"] = ph["expected_seconds"] if ph else None
        err = self.q1("SELECT * FROM events WHERE card_num=? AND kind='error' "
                      "ORDER BY seq DESC LIMIT 1", (num,))
        out["error"] = (jload(err["payload"], {}) or {}).get("text") if err else None
        out["evidence"] = self.latest_evidence(num, card_row=row)
        if not brief:
            out["attachments"] = self.card_attachments(num)
        return out

    def card_attachments(self, num: int) -> list:
        seen, out = set(), []
        for row in self.q("SELECT payload FROM events WHERE card_num=? ORDER BY seq", (num,)):
            payload = jload(row["payload"], {}) or {}
            for att in (payload.get("attachments") or []):
                if isinstance(att, dict) and att.get("sha256") not in seen:
                    seen.add(att.get("sha256"))
                    out.append(att)
        return out

    def latest_evidence(self, num: int, card_row=None):
        row = self.q1(
            "SELECT * FROM evidence WHERE card_num=? ORDER BY created_at DESC, rowid DESC LIMIT 1",
            (num,))
        if row is None:
            # A batch posts ONE packet on whichever member ran the gate; every
            # member is asking the user for a verdict, so every member shows it.
            crow = card_row or self.q1("SELECT * FROM cards WHERE num=?", (num,))
            bid = crow["batch_id"] if crow is not None else None
            if bid:
                row = self.q1(
                    "SELECT e.* FROM evidence e JOIN cards c ON c.num = e.card_num "
                    "WHERE c.batch_id=? ORDER BY e.created_at DESC, e.rowid DESC LIMIT 1",
                    (bid,))
        if row is None:
            return None
        return {"card_num": row["card_num"], "packet": jload(row["packet"], {}),
                "created_at": row["created_at"],
                "shared": row["card_num"] != num}

    # -- conversations ----------------------------------------------------
    #
    # Three highlight states, and every one of them is DERIVED at read time:
    #
    #   unseen  something arrived from the session or a worker AFTER the last
    #           time you opened this card -> strong highlight
    #   seen    you have opened it since that message but have not replied
    #           -> dimmed highlight
    #   clear   your own message is the latest thing in the thread -> nothing
    #
    # The only thing stored is a read receipt -- `last_seen_seq`, one cursor per
    # conversation card, written when you open it. Everything else is read off
    # the append-only log. Deriving beats storing a flag because it SELF-HEALS:
    # an event that lands late, a receipt written twice, a reply sent from a
    # second tab -- none of them can leave a stale boolean behind, because there
    # is no boolean.

    @staticmethod
    def seen_cursor_name(num) -> str:
        return "seen:card:%d" % int(num)

    def last_seen_seq(self, num: int) -> int:
        return self.cursor_seq(self.seen_cursor_name(num))

    def mark_seen(self, num: int, seq=None) -> dict:
        """Record that the user has looked at this conversation.

        Monotonic on purpose: a receipt never walks backwards, so a stale tab
        posting an old seq cannot un-read a message you have already seen.
        """
        row = self.card_row(num)
        if not self.is_conversation(row):
            raise ApiError(409, "not_a_conversation",
                           "#%s is a work card -- read receipts are a "
                           "conversation thing" % num,
                           card_kind=self.card_kind(row))
        if seq is None:
            seq = self.max_seq()
        try:
            seq = int(seq)
        except (TypeError, ValueError):
            raise ApiError(400, "missing_field", "seq must be an integer",
                           field="seq")
        if seq < 0:
            raise ApiError(400, "missing_field", "seq must be an integer",
                           field="seq")
        name = self.seen_cursor_name(num)
        with self.lock:
            self.conn.execute(
                "INSERT INTO cursors(name, seq, updated_at) VALUES(?,?,?) "
                "ON CONFLICT(name) DO UPDATE SET seq=MAX(cursors.seq, excluded.seq), "
                "updated_at=excluded.updated_at",
                (name, seq, now()))
        return {"ok": True, "num": num, "last_seen_seq": self.last_seen_seq(num),
                "card": self.card_json(self.card_row(num), brief=True)}

    def conversation_json(self, num: int) -> dict:
        """The three-state highlight, derived from the log and one receipt."""
        seen = self.last_seen_seq(num)
        placeholders = ",".join("?" * len(CONV_MESSAGE_KINDS))

        def newest(actors):
            row = self.q1(
                "SELECT seq FROM events WHERE card_num=? AND kind IN (%s) "
                "AND actor IN (%s) ORDER BY seq DESC LIMIT 1"
                % (placeholders, ",".join("?" * len(actors))),
                (num,) + tuple(CONV_MESSAGE_KINDS) + tuple(actors))
            return int(row["seq"]) if row is not None else 0

        theirs = newest(CONV_THEM)
        yours = newest(CONV_YOU)
        if theirs > yours:
            state = "unseen" if theirs > seen else "seen"
        else:
            # You spoke last (or nobody has spoken at all): nothing is owed.
            state = "clear"
        return {
            "state": state,
            "last_seen_seq": seen,
            "latest_incoming_seq": theirs,
            "latest_user_seq": yours,
            # One word for "does this want your eyes", so a face never has to
            # re-derive the rule from three numbers.
            "unread": state != "clear",
        }

    @staticmethod
    def question_json(row) -> dict:
        keys = row.keys()
        return {
            "id": row["id"], "card_num": row["card_num"], "text": row["text"],
            "options": jload(row["options"], None),
            # A board whose questions table predates decision requests has no
            # such column; a question with nothing attached is the same shape.
            "artifacts": jload(row["artifacts"], None) if "artifacts" in keys else None,
            "answered_at": row["answered_at"], "created_at": row["created_at"],
        }

    def create_card(self, text: str, images: list, hold: bool, actor: str = "user",
                    reports: list = None, kind: str = "work") -> dict:
        text = (text or "").strip()
        images = images or []
        if not text and not images and not (reports or []):
            raise ApiError(400, "empty_submission",
                           "at least one of text or images is required")
        kind = (kind or "work").strip().lower()
        if kind not in CARD_KINDS:
            raise ApiError(400, "bad_kind",
                           "kind must be one of %s" % ", ".join(CARD_KINDS),
                           field="kind")
        sprint = self.open_sprint(create=True)
        hold_mode = bool(sprint["hold_mode"]) if sprint else False
        state = "held" if (hold or hold_mode) else "queued"
        if kind == "conversation":
            # Hold mode is a brake on DISPATCH, and a conversation is never
            # dispatched. Holding one would park a thread nobody is going to
            # release, so it opens as what it is.
            state = CONVERSATION_STATE

        # Attachments are content-addressed and written to disk BEFORE the
        # event that references them.
        attachments = self.store_images(images)
        docs = self.store_reports(reports)
        attachments = attachments + docs

        title = first_line_title(text) or \
            (docs[0]["title"] if docs else None) or "(image only)"
        ts = now()
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.conn.execute(
                    "INSERT INTO cards(sprint_id, state, title, body, kind, "
                    "created_at, updated_at) VALUES(?,?,?,?,?,?,?)",
                    (sprint["id"] if sprint else None, state, title, text, kind,
                     ts, ts))
                num = int(cur.lastrowid)
                self._append_event(num, actor, "submitted", {
                    "text": text or (report_line(len(docs)) if docs
                                     else image_line(len(attachments))),
                    "attachments": attachments,
                    "images_only": not text and not docs,
                    "kind": kind,
                    "hold": bool(hold or hold_mode) and kind == "work"})
                self._append_event(num, "server", "state", {
                    "from": None, "to": state,
                    "reason": ("a conversation, not a work item" if kind == "conversation"
                               else ("hold mode is on" if (hold or hold_mode) else None)),
                    "text": "new → %s" % state})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return self.card_json(self.card_row(num))

    def create_cards_bulk(self, items, hold=None, actor: str = "user") -> dict:
        """Import many cards in ONE transaction, held by default.

        User's live incident: importing a list of issues meant N POSTs, which
        meant a flooded board and 14 cards created against intent before there
        was any chance to say stop -- then 14 hand-written cancels to undo it.

        So a bulk import lands **held** unless the caller explicitly says
        otherwise: the cards exist, the board shows them as a pile waiting on a
        decision, and NOTHING is dispatched until the user releases them. Hold
        is the preview. And it is all-or-nothing: a half-landed import is the
        same flood-then-clean-up problem in a smaller size.
        """
        if not isinstance(items, list) or not items:
            raise ApiError(400, "missing_field",
                           "items must be a non-empty array of {text, images?}",
                           field="items")
        if len(items) > BULK_MAX:
            raise ApiError(413, "too_many",
                           "%d items is over the bulk cap of %d — split the import"
                           % (len(items), BULK_MAX),
                           count=len(items), max=BULK_MAX)

        sprint = self.open_sprint(create=True)
        hold_mode = bool(sprint["hold_mode"]) if sprint else False
        # The default is the whole point: silence means hold.
        held = hold_mode if hold is None else bool(hold)
        state = "held" if held else "queued"

        # Validate and store attachments for EVERY item before writing a single
        # row -- an ApiError from item 9 must not leave items 1-8 on the board.
        prepared = []
        for i, item in enumerate(items):
            if isinstance(item, str):
                item = {"text": item}
            if not isinstance(item, dict):
                raise ApiError(400, "bad_item",
                               "items[%d] must be an object or a string" % i,
                               index=i)
            text = (item.get("text") or "").strip()
            images = item.get("images") or []
            if not text and not images:
                raise ApiError(400, "empty_submission",
                               "items[%d] needs text or images" % i, index=i)
            prepared.append((text, self.store_images(images, "items[%d].images" % i)))

        nums = []
        ts = now()
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                for text, attachments in prepared:
                    cur = self.conn.execute(
                        "INSERT INTO cards(sprint_id, state, title, body, created_at, updated_at) "
                        "VALUES(?,?,?,?,?,?)",
                        (sprint["id"] if sprint else None, state,
                         first_line_title(text) or "(image only)", text, ts, ts))
                    num = int(cur.lastrowid)
                    self._append_event(num, actor, "submitted", {
                        "text": text or image_line(len(attachments)),
                        "attachments": attachments,
                        "images_only": not text,
                        "hold": held,
                        "bulk": len(prepared)})
                    self._append_event(num, "server", "state", {
                        "from": None, "to": state,
                        "reason": ("bulk import — held until you release it"
                                   if held else "bulk import"),
                        "text": "new → %s" % state})
                    nums.append(num)
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "count": len(nums), "hold": held, "state": state,
                "card_nums": nums,
                "cards": [self.card_json(self.card_row(n), brief=True) for n in nums]}

    # The verbs a pile of cards can be moved with in one call. Deliberately the
    # flood-control set and nothing else: undo an import (cancel), let it run
    # (release), or park it again (hold).
    BULK_ACTIONS = ("cancel", "release", "hold")

    def bulk_action(self, card_nums, action: str, body: dict,
                    actor: str = "user") -> dict:
        if action not in self.BULK_ACTIONS:
            raise ApiError(400, "bad_action",
                           "bulk action must be one of %s"
                           % ", ".join(self.BULK_ACTIONS))
        if not isinstance(card_nums, list) or not card_nums:
            raise ApiError(400, "missing_field",
                           "card_nums must be a non-empty array",
                           field="card_nums")
        if len(card_nums) > BULK_MAX:
            raise ApiError(413, "too_many",
                           "%d cards is over the bulk cap of %d"
                           % (len(card_nums), BULK_MAX),
                           count=len(card_nums), max=BULK_MAX)
        nums = []
        for n in card_nums:
            try:
                n = int(n)
            except (TypeError, ValueError):
                raise ApiError(400, "bad_card_num",
                               "card_nums must be integers, got %r" % (n,))
            if n not in nums:
                nums.append(n)
        # Every card has to EXIST before anything moves; a typo in the list is a
        # 404 for the whole call, not eleven cards canceled and one mystery.
        for n in nums:
            self.card_row(n)
        # Applying is per card and NOT all-or-nothing: a card already canceled
        # is not a reason to leave the other twelve running. Each outcome is
        # reported by number.
        applied, failed = [], []
        for n in nums:
            try:
                self.action(n, action, body, actor=actor)
                applied.append(n)
            except ApiError as e:
                failed.append({"card_num": n, "error": e.code, "message": e.message})
        return {"ok": not failed, "action": action,
                "applied": applied, "failed": failed,
                "count": len(applied)}

    @staticmethod
    def attach_url(sha: str, ext: str) -> str:
        """The ONE url shape the browser uses; the GET route parses exactly this."""
        return "/api/attachments/%s.%s" % (sha, "jpg" if ext in ("jpg", "jpeg") else ext)

    def store_blob(self, blob: bytes, name: str = None) -> dict:
        """Content-address one image blob to disk and return a ready-to-use ref."""
        if not blob:
            raise ApiError(400, "bad_image", "image is empty")
        if len(blob) > self.max_upload:
            raise ApiError(413, "too_large",
                           "attachment exceeds %d bytes" % self.max_upload)
        if blob[:8] == b"\x89PNG\r\n\x1a\n":
            ext, mime = "png", "image/png"
        elif blob[:3] == b"\xff\xd8\xff":
            ext, mime = "jpg", "image/jpeg"
        else:
            raise ApiError(400, "bad_image", "only png or jpeg attachments are supported")
        sha = hashlib.sha256(blob).hexdigest()
        path = os.path.join(self.attach_dir, "%s.%s" % (sha, ext))
        if not os.path.exists(path):
            tmp = path + ".part-%s" % secrets.token_hex(6)
            with open(tmp, "wb") as fh:
                fh.write(blob)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, path)
        return {"sha256": sha, "path": path, "mime": mime, "bytes": len(blob),
                "name": name, "url": self.attach_url(sha, ext)}

    def store_attachment(self, img) -> dict:
        """Accept `<base64>`, `data:image/png;base64,<...>` or {data|b64, name}."""
        if isinstance(img, dict):
            data_s = img.get("data") or img.get("b64") or ""
            name = img.get("name")
        else:
            data_s = img or ""
            name = None
        if not isinstance(data_s, str) or not data_s.strip():
            raise ApiError(400, "bad_image", "image entry is empty")
        if data_s.startswith("data:"):
            head, _, data_s = data_s.partition(",")
            if "base64" not in head:
                raise ApiError(400, "bad_image", "data: URLs must be base64")
        data_s = re.sub(r"\s+", "", data_s)
        try:
            blob = base64.b64decode(data_s, validate=True)
        except (binascii.Error, ValueError):
            raise ApiError(400, "bad_image", "image is not valid base64")
        return self.store_blob(blob, name)

    def store_images(self, images, field: str = "images") -> list:
        """Store a submitted `images` list -- the ONE path every surface uses.

        Card submission, card chat and the sidebar all take the same shape and
        get the same guarantees: magic-byte sniffing, content-addressed dedupe,
        the upload cap, and a ready-to-use `/api/attachments/...` url on the way
        back out. Anything that is not a png/jpeg is a 400, never a silent drop.
        """
        if images is None:
            return []
        if not isinstance(images, list):
            raise ApiError(400, "bad_image", "%s must be a list of images" % field,
                           field=field)
        return [self.store_attachment(img) for img in images]

    # -- reports: markdown / html documents --------------------------------

    def store_document(self, blob: bytes, name: str) -> dict:
        """Content-address one REPORT to disk and return a ready-to-use ref.

        Deliberately a separate door from `store_blob`: `images:` stays png/jpeg
        only, so nothing that ever worked starts accepting text. The sniff here
        is the honest one for a text format -- known extension, strict UTF-8, no
        NULs (a binary wearing a .md name fails all three)."""
        kind = report_kind_for_name(name)
        if not kind:
            raise ApiError(400, "bad_report",
                           "reports must be .md or .html (got %r)" % (name or ""))
        if not blob:
            raise ApiError(400, "bad_report", "report is empty")
        if len(blob) > REPORT_MAX_BYTES:
            raise ApiError(413, "too_large",
                           "a report may not exceed %d bytes" % REPORT_MAX_BYTES)
        # NUL is what "a binary wearing a .md" looks like. The rest of the C0
        # controls are rejected for the same reason AND for a second one: the
        # renderer uses \x00 and \x01 as its own internal placeholders, so a
        # document that could contain them could confuse it. Tab, newline and
        # carriage return are the only control characters a document may hold.
        if any(b < 0x09 or b in (0x0b, 0x0c) or 0x0e <= b <= 0x1f for b in blob):
            raise ApiError(400, "bad_report",
                           "report contains NUL or control bytes — that is not a text document")
        try:
            text = blob.decode("utf-8")
        except UnicodeDecodeError:
            raise ApiError(400, "bad_report", "report must be valid UTF-8 text")
        ext = REPORT_EXT_OF_KIND[kind]
        sha = hashlib.sha256(blob).hexdigest()
        path = os.path.join(self.attach_dir, "%s.%s" % (sha, ext))
        if not os.path.exists(path):
            tmp = path + ".part-%s" % secrets.token_hex(6)
            with open(tmp, "wb") as fh:
                fh.write(blob)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, path)
        return {"sha256": sha, "path": path, "mime": REPORT_MIME_OF_KIND[kind],
                "bytes": len(blob), "name": os.path.basename(str(name)),
                "kind": "report", "doc": kind,
                "title": report_title(kind, text, name),
                "url": self.attach_url(sha, ext),
                "view_url": "#/report/%s.%s" % (sha, ext)}

    def store_report(self, rep) -> dict:
        """Accept {name, text} | {name, data|b64 (base64)} | a data: URL string.

        A report is text, so `text` is the natural shape for an agent and
        `data` is the natural shape for a browser that just read a File."""
        name, text, data_s = None, None, ""
        if isinstance(rep, dict):
            name = rep.get("name") or rep.get("filename")
            text = rep.get("text") if isinstance(rep.get("text"), str) else None
            data_s = rep.get("data") or rep.get("b64") or ""
        elif isinstance(rep, str):
            data_s = rep
        else:
            raise ApiError(400, "bad_report", "each report must be an object or a data: URL")
        if text is not None:
            if not name:
                raise ApiError(400, "bad_report", "a report needs a name so we know .md from .html")
            return self.store_document(text.encode("utf-8"), name)
        if not isinstance(data_s, str) or not data_s.strip():
            raise ApiError(400, "bad_report", "report entry is empty")
        if data_s.startswith("data:"):
            head, _, data_s = data_s.partition(",")
            if "base64" not in head:
                raise ApiError(400, "bad_report", "data: URLs must be base64")
            if not name:
                m = re.match(r"^data:text/(markdown|html)", head, re.I)
                name = "report.md" if (m and m.group(1).lower() == "markdown") else \
                    ("report.html" if m else None)
        if not name:
            raise ApiError(400, "bad_report", "a report needs a name so we know .md from .html")
        try:
            blob = base64.b64decode(re.sub(r"\s+", "", data_s), validate=True)
        except (binascii.Error, ValueError):
            raise ApiError(400, "bad_report", "report is not valid base64")
        return self.store_document(blob, name)

    def store_reports(self, reports, field: str = "reports") -> list:
        if reports is None:
            return []
        if not isinstance(reports, list):
            raise ApiError(400, "bad_report", "%s must be a list of documents" % field,
                           field=field)
        return [self.store_report(r) for r in reports]

    def ingest_report_ref(self, ref):
        """A packet's `reports` entry -> a ref the board can open.

        Workers hand us absolute paths, exactly as they do for screenshots."""
        if isinstance(ref, dict):
            out = dict(ref)
            if isinstance(out.get("url"), str) and out["url"] and out.get("doc"):
                return out
            src = out.get("path") or out.get("file") or out.get("src")
            if isinstance(src, str) and src:
                merged = self.ingest_report_ref(src)
                if isinstance(merged, dict) and merged.get("doc"):
                    if out.get("name"):
                        merged["name"] = out["name"]
                    return merged
            return out
        if not isinstance(ref, str) or not ref.strip():
            return ref
        s = ref.strip()
        m = REPORT_URL_RE.match(s) or REPORT_NAME_RE.match(s)
        if m:
            return {"sha256": m.group(1), "name": os.path.basename(s),
                    "kind": "report", "doc": REPORT_KIND_BY_EXT[m.group(2)],
                    "url": self.attach_url(m.group(1), m.group(2)),
                    "view_url": "#/report/%s.%s" % (m.group(1), m.group(2))}
        try:
            if os.path.isfile(s) and os.path.getsize(s) <= REPORT_MAX_BYTES:
                with open(s, "rb") as fh:
                    blob = fh.read()
                stored = self.store_document(blob, os.path.basename(s))
                stored["source_path"] = os.path.realpath(s)
                return stored
        except (OSError, ApiError):
            pass
        return {"name": os.path.basename(s) or s}

    def ingest_report_refs(self, refs):
        if not isinstance(refs, list):
            return refs
        return [self.ingest_report_ref(r) for r in refs]

    @staticmethod
    def reports_in_payload(payload) -> list:
        """Every report ref a single event payload carries, wherever it sits.

        Reports ride in `attachments` (they are attachments), and a packet
        additionally carries its own `reports` list -- an evidence packet is a
        document envelope as much as a screenshot one."""
        out = []
        if not isinstance(payload, dict):
            return out
        buckets = [payload.get("attachments"), payload.get("reports")]
        packet = payload.get("packet")
        if isinstance(packet, dict):
            buckets.append(packet.get("reports"))
        for bucket in buckets:
            if not isinstance(bucket, list):
                continue
            for ref in bucket:
                if isinstance(ref, dict) and ref.get("doc") in ("md", "html") \
                        and re.match(r"^[0-9a-f]{64}$", str(ref.get("sha256") or "")):
                    out.append(ref)
        return out

    def reports_index(self, scope: str = "sprint") -> dict:
        """Every report document in this sprint (or, with scope=all, ever).

        User ruling, verbatim: "link should only appear once there's a report
        within the sprint" -- so the DEFAULT scope, and therefore the count the
        header link reads, is the open sprint and nothing else. History is
        still reachable, it is just never what decides whether the link is
        there."""
        sprint = self.open_sprint(create=False)
        sprint_id = sprint["id"] if sprint else None
        titles = {r["num"]: (r["title"] or "") for r in self.q("SELECT num, title FROM cards")}
        card_sprint = {r["num"]: r["sprint_id"] for r in self.q("SELECT num, sprint_id FROM cards")}
        opened = sprint["opened_at"] if sprint else None
        rows = self.q("SELECT seq, card_num, ts, actor, payload FROM events "
                      "WHERE payload LIKE '%\"doc\":%' ORDER BY seq")
        seen, out = set(), []
        for row in rows:
            payload = jload(row["payload"], {}) or {}
            num = row["card_num"]
            if scope != "all":
                if num is not None:
                    if sprint_id is None or card_sprint.get(num) != sprint_id:
                        continue
                else:
                    # a sidebar report belongs to whichever sprint was open when
                    # it was posted
                    if opened is None or row["ts"] < opened:
                        continue
            for ref in self.reports_in_payload(payload):
                sha = ref["sha256"]
                if sha in seen:
                    continue
                seen.add(sha)
                ext = REPORT_EXT_OF_KIND[ref["doc"]]
                out.append({
                    "sha256": sha,
                    "doc": ref["doc"],
                    "name": ref.get("name") or "%s.%s" % (sha[:8], ext),
                    "title": ref.get("title") or ref.get("name") or "report",
                    "bytes": ref.get("bytes"),
                    "card_num": num,
                    "card_title": titles.get(num) if num is not None else None,
                    "actor": row["actor"],
                    "ts": row["ts"],
                    "seq": row["seq"],
                    "url": self.attach_url(sha, ext),
                    "view_url": "#/report/%s.%s" % (sha, ext),
                })
        out.sort(key=lambda r: r["ts"], reverse=True)
        return {"reports": out, "count": len(out), "scope": scope,
                "sprint": self.sprint_json(sprint) if sprint else None,
                "generation": self.generation, "server_time": now()}

    def report_count(self) -> int:
        """How many reports this sprint has -- the header link's whole condition."""
        try:
            return self.reports_index("sprint")["count"]
        except Exception:                  # a count must never break the board
            return 0

    def report_detail(self, sha: str, ext: str) -> dict:
        """One report, rendered. Markdown comes back as HTML we generated
        ourselves; author HTML comes back as a URL to sandbox, never inlined."""
        kind = REPORT_KIND_BY_EXT.get(ext)
        if not kind:
            raise ApiError(404, "no_such_report", "unknown report type")
        path = os.path.join(self.attach_dir, "%s.%s" % (sha, REPORT_EXT_OF_KIND[kind]))
        if not os.path.isfile(path):
            raise ApiError(404, "no_such_report", "unknown report")
        with open(path, "rb") as fh:
            blob = fh.read()
        text = blob.decode("utf-8", "replace")
        meta = {}
        for entry in self.reports_index("all")["reports"]:
            if entry["sha256"] == sha:
                meta = entry
                break
        out = {
            "sha256": sha, "doc": kind, "bytes": len(blob),
            "name": meta.get("name") or "%s.%s" % (sha[:8], REPORT_EXT_OF_KIND[kind]),
            "title": meta.get("title") or report_title(kind, text, meta.get("name")),
            "card_num": meta.get("card_num"), "card_title": meta.get("card_title"),
            "actor": meta.get("actor"), "ts": meta.get("ts"),
            "url": self.attach_url(sha, REPORT_EXT_OF_KIND[kind]),
            "generation": self.generation,
        }
        if kind == "md":
            # Rendered HERE, by us, out of escaped text. Nothing the author
            # wrote is ever markup: see `esc` / `render_markdown`.
            out["html"] = render_markdown(text)
        else:
            # Author HTML is never inlined into the board's DOM. The browser
            # loads this URL into a sandboxed iframe; the response itself
            # carries `Content-Security-Policy: sandbox` too.
            out["raw_url"] = out["url"]
            out["sandboxed"] = True
        return out

    def ingest_ref(self, ref):
        """Turn any attachment/screenshot reference into one the browser can load.

        Workers hand us absolute file paths (`sprint-ready` packets); the board
        needs a URL. Accepts: an absolute/relative path on disk, a data: URL, a
        bare `<sha>.<ext>`, an `/api/attachments/...` url, an http(s) url, or an
        already-shaped dict. Anything unresolvable comes back untouched (as a
        name) rather than as a broken <img>.
        """
        if isinstance(ref, dict):
            out = dict(ref)
            sha, ext = out.get("sha256"), None
            if isinstance(out.get("url"), str) and out["url"]:
                return out
            if isinstance(sha, str) and re.match(r"^[0-9a-f]{64}$", sha):
                for cand in ("png", "jpg"):
                    if os.path.isfile(os.path.join(self.attach_dir, "%s.%s" % (sha, cand))):
                        ext = cand
                        break
                out["url"] = self.attach_url(sha, ext or "png")
                return out
            src = out.get("path") or out.get("file") or out.get("src")
            if isinstance(src, str) and src:
                merged = self.ingest_ref(src)
                if isinstance(merged, dict):
                    merged = dict(merged)
                    if out.get("caption"):
                        merged["caption"] = out["caption"]
                    if out.get("name"):
                        merged["name"] = out["name"]
                    return merged
            return out
        if not isinstance(ref, str) or not ref.strip():
            return ref
        s = ref.strip()
        m = ATTACH_URL_RE.match(s) or ATTACH_NAME_RE.match(s)
        if m:
            return {"sha256": m.group(1), "name": os.path.basename(s),
                    "url": self.attach_url(m.group(1), m.group(2))}
        if s.startswith("data:"):
            try:
                return self.store_attachment(s)
            except ApiError:
                return {"name": "attachment"}
        if re.match(r"^https?://", s):
            return {"url": s, "name": s}
        try:
            if os.path.isfile(s) and os.path.getsize(s) <= self.max_upload:
                with open(s, "rb") as fh:
                    blob = fh.read()
                stored = self.store_blob(blob, os.path.basename(s))
                stored["source_path"] = os.path.realpath(s)
                return stored
        except (OSError, ApiError):
            pass
        return {"name": os.path.basename(s) or s}

    def ingest_refs(self, refs):
        if not isinstance(refs, list):
            return refs
        return [self.ingest_ref(r) for r in refs]

    def ingest_packet(self, packet):
        """Rewrite every screenshot ref in an evidence packet into a URL ref."""
        if not isinstance(packet, dict):
            return packet
        out = dict(packet)
        if isinstance(out.get("screenshots"), list):
            out["screenshots"] = self.ingest_refs(out["screenshots"])
        # A packet may ship DOCUMENTS as well as pictures: `reports` is a list
        # of .md/.html paths the worker wrote, ingested exactly like screenshots
        # are, so the library and the packet both open the same stored copy.
        if isinstance(out.get("reports"), list):
            out["reports"] = self.ingest_report_refs(out["reports"])
        if isinstance(out.get("per_card"), list):
            per = []
            for entry in out["per_card"]:
                if isinstance(entry, dict):
                    entry = dict(entry)
                    if isinstance(entry.get("screenshots"), list):
                        entry["screenshots"] = self.ingest_refs(entry["screenshots"])
                per.append(entry)
            out["per_card"] = per
        return out

    # -- state machine ----------------------------------------------------

    def transition(self, num: int, to_state: str, actor: str, reason=None,
                   extra: dict = None, _conn_open: bool = False) -> dict:
        if to_state not in STATES:
            raise ApiError(400, "bad_state", "unknown state %r" % to_state)
        with self.lock:
            row = self.conn.execute("SELECT * FROM cards WHERE num=?", (num,)).fetchone()
            if row is None:
                raise ApiError(404, "no_such_card", "card #%s does not exist" % num)
            frm = row["state"]
            if frm == to_state:
                # Idempotent no-op; still surfaces as success.
                return self.card_json(row, brief=True)
            # The kind gate, ahead of the state gate: a conversation has no
            # work lifecycle to move through, and a work card cannot slip into
            # the conversation state by asking nicely. `canceled` is shared
            # ground -- both kinds close the same way -- so this is the one
            # place that says which of the two doors out of `canceled` is
            # yours.
            kind = self.card_kind(row)
            if kind == "conversation" and to_state not in (CONVERSATION_STATE, "canceled"):
                raise ApiError(
                    409, "not_a_work_card",
                    "#%s is a conversation, not a work card -- it has no "
                    "%s step. Cancel it when the discussion is done."
                    % (num, to_state),
                    from_state=frm, to_state=to_state, card_kind=kind,
                    allowed=[CONVERSATION_STATE, "canceled"])
            if kind != "conversation" and to_state == CONVERSATION_STATE:
                raise ApiError(
                    409, "not_a_conversation",
                    "#%s is a work card; use the make_conversation action to "
                    "turn it into one" % num,
                    from_state=frm, to_state=to_state, card_kind=kind)
            if to_state not in TRANSITIONS.get(frm, set()):
                raise ApiError(
                    409, "illegal_transition",
                    "cannot move #%s from %s to %s" % (num, frm, to_state),
                    from_state=frm, to_state=to_state,
                    allowed=sorted(TRANSITIONS.get(frm, set())))
            self._apply_transition(num, frm, to_state, actor, reason, extra)
        self.notify()
        return self.card_json(self.card_row(num), brief=True)

    def _apply_transition(self, num, frm, to_state, actor, reason, extra):
        """Transaction: state event + denormalized cards.state, together."""
        self.conn.execute("BEGIN IMMEDIATE")
        try:
            self._write_transition(num, frm, to_state, actor, reason, extra)
            self.conn.execute("COMMIT")
        except Exception:
            self.conn.execute("ROLLBACK")
            raise

    def _write_transition(self, num, frm, to_state, actor, reason, extra=None):
        """State event + denormalized cards.state. Caller owns the transaction,
        so a transition can ride along with other writes (see `assign`)."""
        # Every payload carries a human `text`; state also carries from/to.
        payload = {"from": frm, "to": to_state, "reason": reason,
                   "text": ("%s → %s — %s" % (frm or "new", to_state, reason))
                           if reason else ("%s → %s" % (frm or "new", to_state))}
        if extra:
            payload.update(extra)
        self._append_event(num, actor, "state", payload)
        self.conn.execute("UPDATE cards SET state=?, updated_at=? WHERE num=?",
                          (to_state, now(), num))
        # A card that just closed cannot be blocking anything any more. Clearing
        # it here -- inside the same transaction as the state change -- is what
        # makes "no longer blocked" a fact rather than a thing somebody has to
        # notice and go do. The session treats that event as a dispatch trigger.
        if to_state in TERMINAL_STATES:
            self._autoclear_blocked_by(num, to_state, actor)

    # -- phases -----------------------------------------------------------
    #
    # A worker declares a PHASE at every stretch of work — reading, coding,
    # testing, capturing evidence, assembling packet. It is not a status line
    # (which goes stale the second it is written) but a claim about what is
    # happening NOW, with its own clock and, optionally, how long it should
    # take. The user's ruling: "these states need to be better so it doesn't
    # look like everything is broken when it's not."
    #
    # It is a PROJECTION of the log, never a column: the latest phase-carrying
    # event since the card's last transition. Changing state ends the phase by
    # construction — a card that moved on is not still "testing".

    def card_phase(self, num: int, since_seq: int = None):
        """The card's live phase, or None. `since_seq` is the last `state`
        event's seq (card_json already has it; everyone else may pass None)."""
        if since_seq is None:
            st = self.q1("SELECT seq FROM events WHERE card_num=? AND kind='state' "
                         "ORDER BY seq DESC LIMIT 1", (num,))
            since_seq = int(st["seq"]) if st is not None else 0
        rows = self.q(
            "SELECT seq, ts, payload FROM events WHERE card_num=? AND seq>? "
            "AND payload LIKE '%\"phase\"%' ORDER BY seq DESC LIMIT 8", (num, since_seq))
        for row in rows:
            payload = jload(row["payload"], {}) or {}
            phase = payload.get("phase")
            if not isinstance(phase, str) or not phase.strip():
                continue
            exp = payload.get("expected_seconds")
            return {
                "phase": phase.strip(),
                "since": row["ts"],
                "expected_seconds": float(exp) if isinstance(exp, (int, float))
                                    and not isinstance(exp, bool) and exp > 0 else None,
            }
        return None

    def phase_shields(self, num: int, row=None) -> bool:
        """True while a declared phase is still inside the time it claimed.

        Declaring "testing, expect 10 minutes" IS an act of liveness: it says
        in advance that the next stretch is quiet on purpose, which is exactly
        what the five-minute timer cannot otherwise know. The shield lasts
        exactly as long as the claim — once the expected time is up with no new
        word, the card ambers on the normal rule. A phase with no `--expect`
        shields nothing; the default clock is the promise you didn't make.
        """
        ph = self.card_phase(num)
        if not ph or not ph["expected_seconds"]:
            return False
        return (now() - float(ph["since"])) < ph["expected_seconds"]

    # -- liveness ---------------------------------------------------------

    def card_baseline(self, num: int, row=None):
        """(ts, seq) of the last thing that counts as activity for this card.

        The clock keys on the AGENT, not the card. One agent can hold several
        cards — a batch, or a handful assigned to the same worker — and it is
        one process with one attention: while it is posting progress on card A
        it is demonstrably not dead on card B. Ambering B every five minutes
        for that was noise the user had to dismiss over and over.

        So: any worker event on ANY card belonging to this card's agent resets
        the baseline for all of them. `agent_silent` still fires per card (it
        carries a card_num and the user reads it on the card), but only once the
        agent itself has actually gone quiet. A card with no agent keeps the
        plain per-card clock.

        The SESSION counts too. When it posts on a card it has just looked at
        that work -- which is precisely what `agent_silent` asks it to do -- and
        re-ambering the card five minutes later would nag it about a check it
        already performed. (Server events never count: the sweep's own reminders
        must not reset the clock they are complaining about.)
        """
        row = row if row is not None else self.q1("SELECT * FROM cards WHERE num=?", (num,))
        agent = row["agent_name"] if row is not None else None
        if agent:
            hit = self.q1(
                "SELECT e.seq AS seq, e.ts AS ts FROM events e "
                "JOIN cards c ON c.num = e.card_num "
                "WHERE c.agent_name=? AND e.actor IN ('worker','session') "
                "ORDER BY e.seq DESC LIMIT 1", (agent,))
        else:
            hit = self.q1(
                "SELECT seq, ts FROM events WHERE card_num=? "
                "AND actor IN ('worker','session') "
                "ORDER BY seq DESC LIMIT 1", (num,))
        if hit is not None:
            return hit["ts"], hit["seq"]
        # Nothing from the agent yet: the clock starts when this card last moved.
        hit = self.q1(
            "SELECT seq, ts FROM events WHERE card_num=? AND kind='state' "
            "ORDER BY seq DESC LIMIT 1", (num,))
        if hit is not None:
            return hit["ts"], hit["seq"]
        return (row["updated_at"] if row is not None else now()), 0

    def silence_notified(self, num: int, baseline_seq: int) -> bool:
        row = self.q1(
            "SELECT seq FROM events WHERE card_num=? AND kind='agent_silent' "
            "ORDER BY seq DESC LIMIT 1", (num,))
        return row is not None and row["seq"] > baseline_seq

    def card_is_silent(self, num: int, row=None) -> bool:
        row = row or self.q1("SELECT * FROM cards WHERE num=?", (num,))
        if row is None or row["state"] != "in_progress" or row["long_running"] \
                or row["external_agent"]:
            return False
        ts, _seq = self.card_baseline(num)
        if (now() - ts) < self.silence_seconds:
            return False
        return not self.phase_shields(num, row)

    def _silence_loop(self):
        while not self.stopping.wait(self.silence_tick):
            try:
                self.sweep_silence()
            except Exception:  # never let the timer thread die
                self.log("silence sweep failed: %s" % traceback.format_exc())

    def sweep_silence(self) -> int:
        # `external_agent` is a permanent version of `long_running`: an assignee
        # that emits no worker telemetry can never satisfy this clock, so the
        # clock does not run. The session owns checking on it instead.
        rows = self.q("SELECT num FROM cards WHERE state='in_progress' "
                      "AND long_running=0 AND external_agent=0")
        fired = 0
        for row in rows:
            num = row["num"]
            ts, seq = self.card_baseline(num)
            elapsed = now() - ts
            if elapsed < self.silence_seconds:
                continue
            if self.silence_notified(num, seq):
                continue  # one event per silence episode
            # A phase that is still inside the time it claimed is not silence:
            # the agent told us in advance this stretch would be quiet.
            if self.phase_shields(num):
                continue
            with self.lock:
                # re-check under lock (a worker event may have just landed)
                ts2, seq2 = self.card_baseline(num)
                if (now() - ts2) < self.silence_seconds or self.silence_notified(num, seq2):
                    continue
                if self.phase_shields(num):
                    continue
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self._append_event(num, "server", "agent_silent", {
                        "card_num": num,
                        "silent_for_seconds": round(now() - ts2, 1),
                        "threshold_seconds": self.silence_seconds,
                        "last_activity_at": ts2,
                        "text": "no worker activity on #%s for %.0fs" % (num, now() - ts2),
                    })
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            fired += 1
        if fired:
            self.notify()
        return fired

    # -- staleness sweep --------------------------------------------------
    #
    # The silence timer above watches an agent that stopped talking. This
    # watches a card that stopped MOVING while somebody owed it an action --
    # a different failure with a different owner, so it gets its own clock,
    # its own event kind, and its own thread.

    def _last_state_seq(self, num: int) -> int:
        """The seq of the card's last transition. An episode of stuckness runs
        from there: moving the card is the one act that proves somebody dealt
        with it, so it is also the one thing that re-arms the reminders."""
        row = self.q1("SELECT seq FROM events WHERE card_num=? AND kind='state' "
                      "ORDER BY seq DESC LIMIT 1", (num,))
        return int(row["seq"]) if row is not None else 0

    def _episode_seq(self, num: int) -> int:
        """Where this card's current stuck episode starts.

        Normally the last transition -- moving a card is what proves somebody
        dealt with it. Being UNBLOCKED counts too: the card did not move, but
        the reason nobody could move it just went away, so the reminders that
        were pointless while it waited are worth having again.
        """
        seq = self._last_state_seq(num)
        # The LIKE is a cheap pre-filter on the JSON text; the payload is then
        # actually parsed, so a card whose body happens to contain the phrase
        # cannot fake one.
        for row in self.q("SELECT seq, payload FROM events WHERE card_num=? AND kind='note' "
                          "AND seq>? AND payload LIKE '%blocked_by_change%' "
                          "ORDER BY seq DESC LIMIT 5", (num, seq)):
            if (jload(row["payload"], {}) or {}).get("blocked_by_change"):
                return int(row["seq"])
        return seq

    def _stuck_events_since(self, num: int, seq: int) -> list:
        return self.q("SELECT seq, ts FROM events WHERE card_num=? AND kind='stuck' "
                      "AND seq>? ORDER BY seq", (num, seq))

    def stuck_baseline(self, num: int, row) -> float:
        """When this card's current parking started ticking.

        For four of the five states that is simply when it entered the state:
        a `ready` card does not become less unreviewed because its agent chats
        on it. `blocked` is the exception -- its threshold is a RE-CHECK
        interval, and a note on a blocked card is somebody re-checking, so any
        real activity restarts that clock. The sweep's own events never do:
        a reminder that reset the timer it is reminding about would only ever
        fire once.
        """
        st = self.q1("SELECT ts FROM events WHERE card_num=? AND kind='state' "
                     "ORDER BY seq DESC LIMIT 1", (num,))
        since = float(st["ts"]) if st is not None else float(row["updated_at"])
        if row["state"] == "blocked":
            hit = self.q1(
                "SELECT ts FROM events WHERE card_num=? "
                "AND kind NOT IN ('stuck','agent_silent') "
                "ORDER BY seq DESC LIMIT 1", (num,))
            if hit is not None and float(hit["ts"]) > since:
                since = float(hit["ts"])
        # The wall going up or coming down restarts the clock in every state.
        # A card unblocked at 3pm has not been "queued with nobody on it" since
        # this morning -- it has been dispatchable for a few minutes, and the
        # sweep should give the session those minutes before it ambers it again.
        ep = self.q1("SELECT ts, payload FROM events WHERE card_num=? AND kind='note' "
                     "AND payload LIKE '%blocked_by_change%' ORDER BY seq DESC LIMIT 1",
                     (num,))
        if ep is not None and (jload(ep["payload"], {}) or {}).get("blocked_by_change") \
                and float(ep["ts"]) > since:
            since = float(ep["ts"])
        return since

    def stuck_due(self, row):
        """The payload this card owes a `stuck` event right now, or None.

        Pure read: `sweep_stuck` calls it once loose and once again under the
        lock, because a card can move between the two.
        """
        num, state = row["num"], row["state"]
        threshold = self.sweep_thresholds.get(state)
        if threshold is None:
            return None
        # A queued card with an agent on it is mid-pickup, not abandoned.
        if state == "queued" and row["agent_name"]:
            return None
        since = self.stuck_baseline(num, row)
        elapsed = now() - since
        if elapsed < threshold:
            return None
        priors = self._stuck_events_since(num, self._episode_seq(num))
        # One opening notice plus at most `sweep_max_reminders` repeats, then
        # this episode goes quiet for good. Nagging a card the user has decided
        # to leave alone is how a signal turns back into noise. `needs_you` is
        # capped at zero repeats -- see NEEDS_YOU_MAX_REMINDERS above -- because
        # a repeat nag there has no one who can act on it.
        max_reminders = NEEDS_YOU_MAX_REMINDERS if state == "needs_you" else self.sweep_max_reminders
        if len(priors) > max_reminders:
            return None
        if priors:
            gap = self.sweep_backoff[min(len(priors) - 1, len(self.sweep_backoff) - 1)]
            if (now() - float(priors[-1]["ts"])) < gap:
                return None
        # What is this card actually waiting for? If the board knows -- because
        # somebody said so structurally rather than in a sentence -- the
        # reminder says that instead of asking a question nobody can act on.
        blocker = row["blocked_by"] if "blocked_by" in self.columns("cards") else None
        if blocker is not None and state in STUCK_TEXT_BLOCKED:
            text = STUCK_TEXT_BLOCKED[state] % (human_span(elapsed), blocker)
        else:
            text = STUCK_TEXT[state] % human_span(elapsed)
        return {
            "card_num": num,
            "state": state,
            "stuck_for_seconds": round(elapsed, 1),
            "threshold_seconds": threshold,
            "reminder": len(priors),      # 0 = the opening notice
            "since": since,
            "blocked_by": blocker,
            "text": text,
        }

    def card_is_stuck(self, num: int, row=None) -> bool:
        """Has the sweep flagged this card and it still hasn't moved? The board
        reads this to amber the card's age text."""
        row = row if row is not None else self.q1("SELECT * FROM cards WHERE num=?", (num,))
        if row is None:
            return False
        # Two rules write `stuck`: the parked-card sweep (five states somebody
        # owes an action on) and the dead-worker notice (three states an agent
        # is supposed to be working in). Both mean the same thing on the face --
        # this has been sitting here too long -- so both amber the age.
        if row["state"] not in STUCK_STATES and row["state"] not in WORKER_GONE_STATES:
            return False
        return bool(self._stuck_events_since(num, self._episode_seq(num)))

    def _sweep_loop(self):
        while not self.stopping.wait(self.sweep_tick):
            try:
                self.sweep_stuck()
            except Exception:  # never let the timer thread die
                self.log("staleness sweep failed: %s" % traceback.format_exc())
            try:
                self.sweep_worker_gone()
            except Exception:  # ...and one rule's bug must not silence the other
                self.log("worker-gone sweep failed: %s" % traceback.format_exc())
            try:
                self.sweep_limits()
            except Exception:
                self.log("limit sweep failed: %s" % traceback.format_exc())
            # An account limit somebody else declared, and its end: the sweep is
            # how a board with nobody looking at it stays in step.
            self.reconcile_account_limit()
            # ...and LAST, because it reads the answer that call just wrote: a
            # session silent under an account limit is parked, not dead, and
            # asking before reconciling would call it dead for one tick.
            try:
                self.sweep_session_dead()
            except Exception:
                self.log("dead-session sweep failed: %s" % traceback.format_exc())

    def sweep_stuck(self) -> int:
        placeholders = ",".join("?" * len(STUCK_STATES))
        rows = self.q("SELECT * FROM cards WHERE state IN (%s)" % placeholders,
                      STUCK_STATES)
        fired = 0
        for row in rows:
            num = row["num"]
            if self.stuck_due(row) is None:
                continue
            with self.lock:
                fresh = self.q1("SELECT * FROM cards WHERE num=?", (num,))
                if fresh is None:
                    continue
                payload = self.stuck_due(fresh)   # re-check: it may have moved
                if payload is None:
                    continue
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self._append_event(num, "server", "stuck", payload)
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            fired += 1
        if fired:
            self.notify()
        return fired

    # -- killed-agent detection -------------------------------------------
    #
    # `agent_silent` ambers a card at five minutes and then has nothing further
    # to say. That is the right volume for an agent that is merely quiet and the
    # wrong ending for one that is dead: three cards sat in In motion for hours
    # after their workers were killed by a provider usage limit, and the board
    # never escalated because "quiet" is all it knew how to be.
    #
    # This is the ending. One notice when the worker is probably gone, and one
    # transition to `failed` -- the state that carries a Retry -- when it has
    # been gone long enough that waiting is no longer the cautious choice.

    def worker_gone_exempt(self, row):
        """Why this card is NOT a candidate for the dead-worker rule, or None.

        Returns a short machine reason so the guards are testable one at a time
        and readable in one place. Declaring a live agent dead is the expensive
        mistake here, so every one of these is a bias toward waiting.
        """
        if row["state"] not in WORKER_GONE_STATES:
            return "state"
        if not row["agent_name"]:
            # Nothing to be dead. A card with no agent is a dispatch problem,
            # and the `queued` sweep rule already owns that.
            return "no_agent"
        if self.card_flag(row, "external_agent"):
            # Somebody else's process on somebody else's clock. The board has
            # no standing to call it dead and no way to restart it.
            return "external_agent"
        num = row["num"]
        if self.phase_shields(num, row):
            # It said in advance that this stretch would be quiet, and it is
            # still inside the time it claimed. That is a live claim, not
            # silence.
            return "phase"
        if row["state"] == "needs_you" and self.q1(
                "SELECT id FROM questions WHERE card_num=? AND answered_at IS NULL "
                "LIMIT 1", (num,)) is not None:
            # A worker parked on an open question is SUPPOSED to be silent --
            # it ended its turn and the user has the ball. That quiet says
            # nothing about whether the process is alive, and the `needs_you`
            # sweep rule is already nagging the right person about it.
            return "open_question"
        return None

    def worker_gone_window(self, row):
        """(notice, failed) seconds for this card. A `long_running` card
        promised the quiet in advance, so its window stretches by the factor
        rather than disappearing."""
        scale = self.worker_longrun_factor if row["long_running"] else 1.0
        return self.worker_gone_seconds * scale, self.worker_dead_seconds * scale

    def worker_gone_notified(self, num: int) -> bool:
        """Has this episode already had its opening notice? An episode runs from
        the card's last transition, so escalating to `failed` ends it."""
        for row in self._stuck_events_since(num, self._last_state_seq(num)):
            ev = self.q1("SELECT payload FROM events WHERE seq=?", (row["seq"],))
            if (jload(ev["payload"], {}) or {}).get("rule") == "worker_gone":
                return True
        return False

    def worker_gone_due(self, row):
        """What this card owes right now: a notice, an escalation, or nothing.

        Pure read — `sweep_worker_gone` calls it once loose and once under the
        lock, because a worker can come back to life between the two.
        """
        if self.worker_gone_exempt(row) is not None:
            return None
        num = row["num"]
        # Per AGENT, not per card: while it is posting on card A it is
        # demonstrably not dead on card B. `card_baseline` already knows this,
        # and falls back to the card's last transition for an agent that was
        # assigned and never said a word -- which is exactly what a worker
        # killed at dispatch looks like.
        ts, _seq = self.card_baseline(num, row)
        quiet = now() - ts
        notice_after, fail_after = self.worker_gone_window(row)
        payload = {
            "card_num": num,
            "state": row["state"],
            "rule": "worker_gone",
            "agent_name": row["agent_name"],
            "quiet_for_seconds": round(quiet, 1),
            "last_activity_at": ts,
            "notice_after_seconds": notice_after,
            "fail_after_seconds": fail_after,
        }
        if quiet >= fail_after:
            payload["stage"] = "failed"
            payload["reason"] = "worker gone: no events for %s" % human_span(quiet)
            return payload
        if quiet >= notice_after and not self.worker_gone_notified(num):
            payload["stage"] = "notice"
            payload["threshold_seconds"] = notice_after
            payload["stuck_for_seconds"] = round(quiet, 1)
            payload["text"] = (
                "%s has said nothing for %s — it may have been killed; "
                "check it, or the board fails this card at %s"
                % (row["agent_name"], human_span(quiet), human_span(fail_after)))
            return payload
        return None

    def sweep_worker_gone(self) -> int:
        placeholders = ",".join("?" * len(WORKER_GONE_STATES))
        rows = self.q("SELECT * FROM cards WHERE state IN (%s) AND agent_name IS NOT NULL"
                      % placeholders, WORKER_GONE_STATES)
        fired = 0
        for row in rows:
            num = row["num"]
            if self.worker_gone_due(row) is None:
                continue
            with self.lock:
                fresh = self.q1("SELECT * FROM cards WHERE num=?", (num,))
                if fresh is None:
                    continue
                payload = self.worker_gone_due(fresh)
                if payload is None:
                    continue
                if payload["stage"] == "notice":
                    self.conn.execute("BEGIN IMMEDIATE")
                    try:
                        self._append_event(num, "server", "stuck", payload)
                        self.conn.execute("COMMIT")
                    except Exception:
                        self.conn.execute("ROLLBACK")
                        raise
                else:
                    # `failed` keeps everything: the timeline, the evidence, the
                    # branch and the worktree all stay exactly where they are,
                    # because Retry re-dispatches a fresh agent with all of it
                    # as the brief. The only thing that changes is that the card
                    # stops pretending somebody is working on it.
                    reason = payload["reason"]
                    self.conn.execute("BEGIN IMMEDIATE")
                    try:
                        # The face reads `error` first for a failed card, so the
                        # machine reason goes there too -- otherwise an older,
                        # unrelated error would be what the user sees.
                        self._append_event(num, "server", "error", {
                            "text": reason, "rule": "worker_gone",
                            "agent_name": fresh["agent_name"],
                            "quiet_for_seconds": payload["quiet_for_seconds"]})
                        self._write_transition(
                            num, fresh["state"], "failed", "server", reason,
                            extra={"rule": "worker_gone",
                                   "agent_name": fresh["agent_name"]})
                        self.conn.execute("COMMIT")
                    except Exception:
                        self.conn.execute("ROLLBACK")
                        raise
            fired += 1
        if fired:
            self.notify()
        return fired

    # -- provider limit windows -------------------------------------------
    #
    # See the module-level note. Three moving parts and no more: declare one,
    # read them, and end one -- either because the clock got there or because
    # somebody said so early. The only rule that matters for correctness is
    # that ending a window emits `limit_cleared` EXACTLY once, because the
    # session's reaction to that event is to re-dispatch work: a duplicate
    # storm is not a duplicate line in a log, it is duplicate agents on the
    # same cards.

    def limit_json(self, row, at: float = None) -> dict:
        at = now() if at is None else at
        resets_at = float(row["resets_at"])
        cleared_at = row["cleared_at"]
        # Computed, never read off a column: a board that was down across the
        # reset time must come back up knowing the window is over.
        active = cleared_at is None and resets_at > at
        try:
            kind = row["kind"] or LIMIT_KIND_MODEL
        except (IndexError, KeyError):       # a row read before the ALTER ran
            kind = LIMIT_KIND_MODEL
        return {
            "id": row["id"],
            "kind": kind,
            # An account window is not about a model, and saying one would be a
            # lie the banner then has to repeat.
            "model": (row["model"] or None) if kind == LIMIT_KIND_ACCOUNT
                     else row["model"],
            "resets_at": resets_at,
            "resets_at_label": clock_label(resets_at),
            "resets_in_seconds": round(resets_at - at, 1),
            "declared_at": row["declared_at"],
            "cleared_at": cleared_at,
            "source": row["source"],
            "note": row["note"],
            "active": active,
        }

    def limit_row(self, limit_id: int):
        row = self.q1("SELECT * FROM limits WHERE id=?", (limit_id,))
        if row is None:
            raise ApiError(404, "no_such_limit", "no limit window #%s" % limit_id)
        return row

    def active_limits(self, at: float = None) -> list:
        at = now() if at is None else at
        rows = self.q("SELECT * FROM limits WHERE cleared_at IS NULL AND resets_at > ? "
                      "ORDER BY resets_at", (at,))
        return [self.limit_json(r, at) for r in rows]

    def limits_index(self) -> dict:
        self.reconcile_account_limit()
        at = now()
        recent = self.q(
            "SELECT * FROM limits WHERE cleared_at IS NOT NULL OR resets_at <= ? "
            "ORDER BY COALESCE(cleared_at, resets_at) DESC LIMIT ?",
            (at, LIMIT_RECENT_MAX))
        return {
            "active": self.active_limits(at),
            "recent": [self.limit_json(r, at) for r in recent],
            "server_time": at,
        }

    def declare_limit(self, model, resets_at, source=None, note=None,
                      kind=LIMIT_KIND_MODEL, mirror=False) -> dict:
        """Record that `model` (or, for an account window, everything) is
        unavailable until `resets_at`.

        One ACTIVE window per model, always — and exactly one active ACCOUNT
        window, keyed on the kind alone, because there is only one account.
        Re-declaring the same window (the session sees the same kill message on
        the second and third dead agent) updates the one that is already there
        instead of stacking three identical lines on the board, and a corrected
        reset time moves the window it corrects rather than opening a rival one.

        `mirror=True` is the reconciler's door in: it means this declaration
        CAME from the machine-wide file, so it must not be written back to it.
        """
        kind = clean_limit_kind(kind)
        account = kind == LIMIT_KIND_ACCOUNT
        model = clean_model(model)
        if account:
            # The account is not a model. Anything passed here would only end
            # up in a banner claiming one model is at fault when none is.
            model = ""
        elif not model:
            raise ApiError(400, "missing_field", "model is required", field="model")
        if resets_at is None:
            raise ApiError(400, "missing_field", "resets_at is required",
                           field="resets_at")
        at = now()
        resets = parse_reset_time(resets_at, ref=at)
        source = clean_short_text(source, "source", LIMIT_SOURCE_MAX)
        note = clean_short_text(note, "note", LIMIT_NOTE_MAX)
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                if account:
                    row = self.conn.execute(
                        "SELECT * FROM limits WHERE kind='account' "
                        "AND cleared_at IS NULL AND resets_at > ? "
                        "ORDER BY id DESC LIMIT 1", (at,)).fetchone()
                else:
                    row = self.conn.execute(
                        "SELECT * FROM limits WHERE kind='model' AND model=? "
                        "AND cleared_at IS NULL AND resets_at > ? "
                        "ORDER BY id DESC LIMIT 1", (model, at)).fetchone()
                if row is not None:
                    changed = abs(float(row["resets_at"]) - resets) >= 1.0
                    self.conn.execute(
                        "UPDATE limits SET resets_at=?, source=COALESCE(?,source), "
                        "note=COALESCE(?,note) WHERE id=?",
                        (resets, source, note, row["id"]))
                    limit_id, created = row["id"], False
                else:
                    cur = self.conn.execute(
                        "INSERT INTO limits(kind, model, resets_at, declared_at,"
                        " cleared_at, source, note) VALUES(?,?,?,?,NULL,?,?)",
                        (kind, model, resets, at, source, note))
                    limit_id, created, changed = cur.lastrowid, True, True
                if created or changed:
                    self._append_event(None, "server", "limit_declared", {
                        "limit_id": limit_id, "kind": kind, "model": model or None,
                        "resets_at": resets, "source": source, "note": note,
                        "text": (ACCOUNT_LIMIT_HEADLINE + " until %s"
                                 % clock_label(resets)) if account
                                else "%s is rate-limited until %s"
                                     % (model, clock_label(resets))})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        if account and not mirror:
            # Everybody else on this machine is just as limited. Publishing is
            # best-effort by construction: a board that cannot write the shared
            # file is still right about ITSELF, and must not fail the declare.
            self.publish_account_limit(resets, at, source, note)
        self.notify()
        return {"ok": True, "created": created,
                "limit": self.limit_json(self.limit_row(limit_id))}

    def end_limit(self, limit_id: int, at: float = None, publish=True) -> bool:
        """End one window and emit `limit_cleared` — at most once, ever.

        The single-writer guarantee is the conditional UPDATE: whoever wins
        `cleared_at IS NULL` writes the event, and everybody else -- a second
        sweep tick, a manual clear racing the clock, another thread -- sees
        rowcount 0 and says nothing. Returns whether THIS call was the one.
        """
        at = now() if at is None else at
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                row = self.conn.execute("SELECT * FROM limits WHERE id=?",
                                        (limit_id,)).fetchone()
                if row is None:
                    self.conn.execute("ROLLBACK")
                    return False
                cur = self.conn.execute(
                    "UPDATE limits SET cleared_at=? WHERE id=? AND cleared_at IS NULL",
                    (at, limit_id))
                if cur.rowcount != 1:
                    self.conn.execute("ROLLBACK")
                    return False
                resets = float(row["resets_at"])
                passed = at >= resets
                try:
                    kind = row["kind"] or LIMIT_KIND_MODEL
                except (IndexError, KeyError):
                    kind = LIMIT_KIND_MODEL
                self._append_event(None, "server", "limit_cleared", {
                    "limit_id": limit_id, "kind": kind,
                    "model": (row["model"] or None)
                             if kind == LIMIT_KIND_ACCOUNT else row["model"],
                    "resets_at": resets, "declared_at": row["declared_at"],
                    "cleared_at": at,
                    "reason": "window_passed" if passed else "cleared_early",
                    "text": ("the account limit is over — re-dispatch everything "
                             "parked or killed while it was on")
                            if kind == LIMIT_KIND_ACCOUNT else
                            "%s's limit window is over — anything downgraded for "
                            "it can go back on %s" % (row["model"], row["model"])})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        if kind == LIMIT_KIND_ACCOUNT and publish:
            self.publish_account_cleared(float(row["declared_at"]), at)
        self.notify()
        return True

    def clear_limit(self, limit_id: int) -> dict:
        """`POST /api/limits/:id/clear` — the limit lifted early. Idempotent:
        clearing an already-finished window is a 200 and no second event."""
        self.limit_row(limit_id)
        cleared = self.end_limit(limit_id)
        return {"ok": True, "cleared": cleared,
                "limit": self.limit_json(self.limit_row(limit_id))}

    # -- the account limit, machine-wide -----------------------------------
    #
    # See the module note for WHY it is a file and not a push. Three calls:
    # publish (this board declared one), publish-cleared (somebody pressed
    # Resume here), and reconcile (pull the shared state into this board's own
    # limits table). Reconcile runs on the sweep tick AND on every read of the
    # board, so a board with no session attached — the only kind there is while
    # the account is out — converges on the next browser poll.

    def account_origin(self) -> dict:
        return {"project": self.default_sprint_title(),
                "project_root": self.project_root,
                "port": self.port}

    def publish_account_limit(self, resets_at: float, declared_at: float,
                              source=None, note=None):
        """Tell the rest of the machine. Best-effort, always: this board is
        already right about itself, and a shared-state write must never be able
        to fail a declare."""
        try:
            with _FileLock(account_limit_path(self.registry)):
                write_account_limit({
                    "resets_at": float(resets_at),
                    "declared_at": float(declared_at),
                    "cleared_at": None,
                    "source": source,
                    "note": note,
                    "origin": self.account_origin(),
                }, self.registry)
            return True
        except OSError:
            self.log("could not publish the account limit to %s"
                     % account_limit_path(self.registry))
            return False

    def publish_account_cleared(self, declared_at: float, cleared_at: float):
        """Resume was pressed (here, or the window simply passed). Siblings
        pick this up and end their own mirrored window on their next tick."""
        try:
            with _FileLock(account_limit_path(self.registry)):
                shared = read_account_limit(self.registry)
                state = dict(shared or {})
                state.setdefault("resets_at", cleared_at)
                state["declared_at"] = float(
                    state.get("declared_at") or declared_at)
                state["cleared_at"] = float(cleared_at)
                state["origin"] = state.get("origin") or self.account_origin()
                write_account_limit(state, self.registry)
            return True
        except OSError:
            self.log("could not publish the account clear to %s"
                     % account_limit_path(self.registry))
            return False

    def reconcile_account_limit(self) -> bool:
        """Pull machine-wide account state into this board's own window.

        Mirroring rather than rendering someone else's row is what keeps every
        guarantee local: this board's `limits` row is computed-active like any
        other, and it emits its OWN single `limit_cleared` — which is what its
        session needs, because it has its own parked cards to re-dispatch.

        Returns whether anything changed. Never raises: it runs inside a board
        read, and a machine-wide file must not be able to 500 a board.
        """
        try:
            shared = read_account_limit(self.registry)
            at = now()
            live = (shared is not None and shared["cleared_at"] is None
                    and shared["resets_at"] > at)
            row = self.q1(
                "SELECT * FROM limits WHERE kind='account' AND cleared_at IS NULL "
                "AND resets_at > ? ORDER BY id DESC LIMIT 1", (at,))
            if live:
                if row is not None and abs(float(row["resets_at"])
                                           - shared["resets_at"]) < 1.0:
                    return False
                origin = (shared.get("origin") or {}).get("project")
                self.declare_limit(
                    None, shared["resets_at"], kind=LIMIT_KIND_ACCOUNT,
                    source=shared.get("source")
                    or ("declared on %s" % origin if origin else None),
                    note=shared.get("note"), mirror=True)
                return True
            if row is not None:
                # The shared state says it is over (cleared, or its time came)
                # and this board still thinks it is on. `publish=False`: we are
                # following the file, not writing to it.
                return self.end_limit(row["id"], publish=False)
            return False
        except Exception:
            self.log("account-limit reconcile failed: %s" % traceback.format_exc())
            return False

    def account_limit_banner(self):
        """The banner data `/api/board` carries: the active account window plus
        the exact words. Composed here so the browser has nothing to invent —
        and so a board being read with no session attached still ships the full
        message and the id the Resume button posts to."""
        row = self.q1(
            "SELECT * FROM limits WHERE kind='account' AND cleared_at IS NULL "
            "AND resets_at > ? ORDER BY id DESC LIMIT 1", (now(),))
        if row is None:
            return None
        lim = self.limit_json(row)
        until = lim["resets_at_label"]
        lim.update({
            "headline": ACCOUNT_LIMIT_HEADLINE,
            "detail": "Every sprint board on this machine is stopped until %s."
                      % until,
            "action": ACCOUNT_LIMIT_ACTION,
            "resume_label": ACCOUNT_RESUME_LABEL,
            "resume_url": "/api/limits/%d/clear" % lim["id"],
        })
        return lim

    def sweep_limits(self) -> int:
        """Windows whose reset time has arrived. Runs on the sweep tick beside
        the other two rules; `end_limit` is what makes it safe to run often."""
        at = now()
        rows = self.q("SELECT id FROM limits WHERE cleared_at IS NULL AND resets_at <= ?",
                      (at,))
        return sum(1 for r in rows if self.end_limit(r["id"]))

    def cursor_seq(self, name: str = "orchestrator") -> int:
        """How far the session has actually drained. A user message with seq <= this
        has been read by the session -- that is what the UI's per-message status
        stands on, so it must never be estimated."""
        row = self.q1("SELECT * FROM cursors WHERE name=?", (name,))
        return int(row["seq"]) if row else 0

    def note_waiter_seen(self, at: float = None) -> float:
        """The session's waiter just polled us. That poll IS the session being
        attached -- it is the one signal that does not go quiet while the
        orchestrator is busy dispatching, which is exactly when the old
        cursor-only rule cried 'offline' at a perfectly healthy session.

        Hot path: in-memory. Disk write is throttled, and never blocks a poll.
        """
        ts = at if at is not None else now()
        if self._waiter_seen_at is None or ts > self._waiter_seen_at:
            self._waiter_seen_at = ts
        if ts - self._waiter_persisted_at >= self.waiter_persist_seconds:
            self._waiter_persisted_at = ts
            try:
                with self.lock:
                    self.conn.execute(
                        "INSERT INTO cursors(name, seq, updated_at) VALUES(?,?,?) "
                        "ON CONFLICT(name) DO UPDATE SET seq=excluded.seq, "
                        "updated_at=excluded.updated_at",
                        (WAITER_CURSOR, self.max_seq(), ts))
            except sqlite3.Error:
                pass        # liveness must never be able to fail a poll
        return ts

    def waiter_seen_at(self):
        """Last waiter sighting: memory first, disk as the cold-start fallback."""
        if self._waiter_seen_at is not None:
            return self._waiter_seen_at
        row = self.q1("SELECT * FROM cursors WHERE name=?", (WAITER_CURSOR,))
        return float(row["updated_at"]) if row else None

    def session_liveness(self) -> dict:
        """Three honest states, in the user's words:

        - online  -- caught up, or the cursor moved recently, or the waiter just polled
        - busy    -- the waiter is alive but the cursor is behind pending events
                     for more than session_offline_seconds ("on it -- catching up")
        - offline -- events are pending, the cursor is stale, AND the waiter itself
                     has been gone longer than waiter_gone_seconds

        Nothing here invents liveness: every branch is grounded in something the
        session actually did (moved its cursor, or polled for events).
        """
        row = self.q1("SELECT * FROM cursors WHERE name='orchestrator'")
        cursor_seq = int(row["seq"]) if row else 0
        last_seen = float(row["updated_at"]) if row else self.started_at
        head = self.max_seq()
        pending = max(0, head - cursor_seq)
        ts = now()
        stale_for = ts - last_seen
        waiter_at = self.waiter_seen_at()
        waiter_age = None if waiter_at is None else max(0.0, ts - waiter_at)
        waiter_fresh = waiter_age is not None and waiter_age <= self.waiter_online_seconds
        waiter_alive = waiter_age is not None and waiter_age <= self.waiter_gone_seconds
        cursor_lagging = stale_for > self.session_offline_seconds

        if pending <= 0 or not cursor_lagging:
            # Caught up, or the cursor moved inside the window: nothing is behind.
            status = "online"
        elif waiter_alive:
            # Behind, but the waiter is right there polling for the next event.
            # That is a busy session, not a dead one, and it gets no banner.
            status = "busy"
        else:
            status = "offline"

        note = {
            "online": None,
            "busy": "session is on it — catching up",
            "offline": "session offline — items will queue",
        }[status]
        return {
            "status": status,
            # `online` is what the UI keys its banner off: busy is NOT offline.
            "online": status != "offline",
            "note": note,
            "cursor": cursor_seq,
            "head": head,
            "pending": pending,
            "last_cursor_move_at": last_seen,
            "seconds_since_cursor_move": round(stale_for, 1),
            "offline_after_seconds": self.session_offline_seconds,
            "waiter_seen_at": waiter_at,
            "seconds_since_waiter": None if waiter_age is None else round(waiter_age, 1),
            # polling right now (fresh) vs merely seen recently enough to trust
            "waiter_polling": bool(waiter_fresh),
            "waiter_alive": bool(waiter_alive),
            "waiter_online_seconds": self.waiter_online_seconds,
            "waiter_gone_seconds": self.waiter_gone_seconds,
        }

    # -- dead-session autoheal --------------------------------------------
    #
    # See the module note for WHY. This half is DETECTION and BOOKKEEPING: the
    # board decides whether its own session is dead, writes the one event that
    # says so, builds the wake-up brief out of its own state, and owns the
    # crash-loop guard. It never runs a process -- the hub does that, because a
    # dead session's own board reaching for a keyboard is one more thing that
    # can go wrong at 2am with nobody watching.

    def session_tmux_window(self) -> str:
        """Where this board's session can be woken, or "" for nowhere."""
        return self.settings().get("session_tmux_window") or ""

    def claim_tmux_window(self, value, actor: str = "session") -> dict:
        """Register (or clear) the wake channel. LAST write wins, deliberately:
        a window is an address, not an identity, and a session that moved has
        to be able to correct it or the hub types into the wrong terminal."""
        wanted = clean_tmux_window(value)
        settings = self.save_settings({"session_tmux_window": wanted}, actor=actor)
        return {"ok": True, "session_tmux_window": settings["session_tmux_window"],
                "wanted": wanted}

    def session_last_seen(self):
        """The most recent thing the SESSION demonstrably did, and what it was.

        Three signals, all of them acts and none of them inferred:
          * `cursor`  -- it drained the event log (the strongest: it read).
          * `waiter`  -- its long-poll asked us for the next event.
          * `spoke`   -- it posted something as `actor: "session"`.

        Any one of them is proof of life; the latest wins. A `user` event is
        deliberately NOT on this list -- the russ outage had the user still
        typing into a board whose session had been dead for five hours -- and
        neither is a `server` event, or the sweep's own reminders would keep
        resurrecting the session they are complaining about.
        """
        row = self.q1("SELECT * FROM cursors WHERE name='orchestrator'")
        best = float(row["updated_at"]) if row else self.started_at
        how = "cursor" if row else "boot"
        waiter = self.waiter_seen_at()
        if waiter is not None and waiter > best:
            best, how = float(waiter), "waiter"
        spoke = self.q1("SELECT ts FROM events WHERE actor='session' "
                        "ORDER BY seq DESC LIMIT 1")
        if spoke is not None and float(spoke["ts"]) > best:
            best, how = float(spoke["ts"]), "spoke"
        return best, how

    def session_owed_cards(self) -> dict:
        """The cards the session -- not the user -- owes an action on, by state."""
        owed = {}
        for state in SESSION_OWED_STATES:
            nums = [r["num"] for r in self.q(
                "SELECT num FROM cards WHERE state=? ORDER BY num", (state,))]
            if nums:
                owed[state] = nums
        return owed

    def account_limit_active(self, at: float = None) -> bool:
        at = now() if at is None else at
        return self.q1("SELECT id FROM limits WHERE kind='account' "
                       "AND cleared_at IS NULL AND resets_at > ? LIMIT 1",
                       (at,)) is not None

    def session_dead_state(self, at: float = None) -> dict:
        """Is this board's session dead, and everything the answer stands on.

        Pure read. Three conditions, and the reason it is NOT dead is returned
        by name so each guard is testable one at a time:

          * `account_limited` -- a machine-wide account window is open. A
            silent session under an account limit is PARKED, not dead: nothing
            it could be woken to do would run. #47's Resume flow re-arms it,
            and this rule stays out of the way. Checked first because it is the
            strongest: it is true no matter how quiet or how loaded the board.
          * `alive` -- something the session did is inside the window.
          * `no_work` -- nothing is owed to the session. A board whose cards are
            all `needs_you`/`ready`/`blocked` is waiting on a HUMAN, and waking
            a session to look at it would achieve nothing.
        """
        at = now() if at is None else at
        seen_at, seen_by = self.session_last_seen()
        quiet = max(0.0, at - seen_at)
        owed = self.session_owed_cards()
        owed_count = sum(len(v) for v in owed.values())
        limited = self.account_limit_active(at)
        cursor = self.cursor_seq()
        head = self.max_seq()
        if limited:
            reason = "account_limited"
        elif quiet < self.session_dead_seconds:
            reason = "alive"
        elif not owed_count:
            reason = "no_work"
        else:
            reason = None
        return {
            "dead": reason is None,
            "reason": reason,
            "last_seen_at": seen_at,
            "last_seen_by": seen_by,
            "quiet_for_seconds": round(quiet, 1),
            "dead_after_seconds": self.session_dead_seconds,
            "cursor": cursor,
            "head": head,
            "pending": max(0, head - cursor),
            "owed": owed,
            "owed_count": owed_count,
            "account_limited": limited,
            "tmux_window": self.session_tmux_window(),
        }

    def _sprint_events(self, kind: str, since_ts: float = None) -> list:
        """Sprint-level (card_num IS NULL) events of one kind, oldest first."""
        if since_ts is None:
            return self.q("SELECT seq, ts, payload FROM events WHERE card_num IS NULL "
                          "AND kind=? ORDER BY seq", (kind,))
        return self.q("SELECT seq, ts, payload FROM events WHERE card_num IS NULL "
                      "AND kind=? AND ts>? ORDER BY seq", (kind, since_ts))

    def revive_state(self, at: float = None, dead=None) -> dict:
        """The crash-loop guard's whole answer, mirrored from self-restart (#62).

        Three questions, in the same order and with the same bias toward doing
        nothing: how recently did we wake this board, how many times lately,
        and did the last wake-up actually WORK.

        That last one is the lesson from the second outage of the day. The
        session's process was alive with a `/status` dialog open in its
        terminal; tmux-send delivered and verified the message and the session
        never processed a thing, because an undismissed modal blocks it. So a
        delivered message proves delivery and nothing else: an attempt counts
        as having worked only if the session showed proof of life inside
        `revive_grace_seconds`, and one that did not is a failed attempt that
        spends its slot like any other.
        """
        at = now() if at is None else at
        ds = dead if dead is not None else self.session_dead_state(at)
        window = ds["tmux_window"]
        episode = self._sprint_events("revive_attempted", ds["last_seen_at"])
        recent = self._sprint_events("revive_attempted", at - self.revive_burst_window)
        last = recent[-1] if recent else (episode[-1] if episode else None)
        last_at = float(last["ts"]) if last is not None else None
        # Did it stir? Any proof of life recorded AFTER the poke. An episode
        # that ended is an episode whose wake-up worked.
        stirred = last_at is not None and ds["last_seen_at"] > last_at
        delivered = None
        if last is not None:
            result = self.revive_result_for(int(last["seq"]))
            delivered = None if result is None else bool(result.get("sent"))
        hold = None
        if last_at is not None and (at - last_at) < self.revive_min_interval:
            hold = ("held off — this board was woken %s ago"
                    % human_span(at - last_at))
        gave_up = (len(episode) >= self.revive_max_burst
                   or len(recent) >= self.revive_max_burst)
        if gave_up:
            hold = ("paused — %d wake-ups inside %s and the session never came "
                    "back" % (max(len(episode), len(recent)),
                              human_span(self.revive_burst_window)))
        return {
            "attempts_this_episode": len(episode),
            "attempts_this_hour": len(recent),
            "max_attempts": self.revive_max_burst,
            "burst_window_seconds": self.revive_burst_window,
            "min_interval_seconds": self.revive_min_interval,
            "grace_seconds": self.revive_grace_seconds,
            "last_attempt_at": last_at,
            "last_attempt_seq": int(last["seq"]) if last is not None else None,
            "last_attempt_label": clock_label(last_at) if last_at else None,
            "last_attempt_delivered": delivered,
            "stirred": bool(stirred),
            # A delivered wake-up past its grace window with no proof of life:
            # the message landed and the session did not process it.
            "delivered_but_silent": bool(
                last_at is not None and not stirred and delivered is not False
                and (at - last_at) >= self.revive_grace_seconds),
            "gave_up": bool(gave_up),
            "hold": hold,
            "wanted": bool(ds["dead"] and window and not hold),
        }

    def gave_up_text(self, rev: dict, window: str) -> str:
        """What the board says when autoheal stops trying, in words that name
        the next physical act. Two different failures need two different
        sentences: one is "the message never landed", the other is "the message
        landed and nothing happened", and only the second one means go look at
        the terminal."""
        if rev.get("last_attempt_delivered") is False:
            return ("autoheal gave up after %d tries — the wake-up could not be "
                    "delivered to tmux window “%s”. Check the window by hand."
                    % (rev["attempts_this_episode"] or rev["attempts_this_hour"],
                       window or "?"))
        return ("autoheal gave up after %d tries — the wake-up was delivered but "
                "the session never stirred; its terminal may be blocked by an "
                "open dialog. Check the window by hand."
                % (rev["attempts_this_episode"] or rev["attempts_this_hour"]))

    AUTOHEAL_CARD_LIST_MAX = 12

    @staticmethod
    def _card_list(nums, limit: int = 12) -> str:
        shown = ", ".join("#%d" % n for n in nums[:limit])
        if len(nums) > limit:
            shown += " (+%d more)" % (len(nums) - limit)
        return shown

    def board_self_url(self) -> str:
        host = (list(self.hosts or []) or ["127.0.0.1"])[0]
        port = self.port or 0
        return board_url(host, port, self.token) if port else ""

    def revive_brief(self, at: float = None, dead=None, attempt: int = 1) -> str:
        """The wake-up, built from this board's own state.

        Same shape as the one a human typed into the russ session by hand, for
        the reason that one worked: it opens with the verdict, gives the
        evidence, names the stranded cards by number, and then gives an ORDER
        of operations whose first instruction is "do not dispatch anything".

        The ownership header is there because of the other half of that
        incident: the wrong tmux window was guessed first, and a session that
        did not own that board started posting to it before it was retracted.
        Registration mostly kills the guessing; naming the project root in the
        message kills the rest, cheaply.
        """
        at = now() if at is None else at
        ds = dead if dead is not None else self.session_dead_state(at)
        owed = ds["owed"]
        lines = []
        lines.append("Your sprint board thinks this session died — nothing it "
                     "can see has moved for %s." % human_span(ds["quiet_for_seconds"]))
        lines.append("")
        lines.append("board: %s" % (self.sprint_name() or "sprint"))
        lines.append("project: %s (port %s)" % (self.project_root, self.port or "?"))
        url = self.board_self_url()
        if url:
            lines.append("url: %s" % url)
        lines.append("cursor: %d of %d — %d events you never read"
                     % (ds["cursor"], ds["head"], ds["pending"]))
        lines.append("")
        lines.append("FIRST, check this is your board. If %s is not the project "
                     "this session runs, reply “wrong session”, touch nothing, "
                     "and stop." % self.project_root)
        lines.append("")
        if ds["owed_count"]:
            lines.append("Stranded right now:")
            if owed.get("integrating"):
                lines.append("- approved by the user but never merged: %s"
                             % self._card_list(owed["integrating"],
                                               self.AUTOHEAL_CARD_LIST_MAX))
            if owed.get("in_progress"):
                lines.append("- in motion, agent probably dead: %s"
                             % self._card_list(owed["in_progress"],
                                               self.AUTOHEAL_CARD_LIST_MAX))
            if owed.get("queued"):
                lines.append("- queued and never dispatched: %d card%s (%s)"
                             % (len(owed["queued"]),
                                "" if len(owed["queued"]) == 1 else "s",
                                self._card_list(owed["queued"],
                                                self.AUTOHEAL_CARD_LIST_MAX)))
            lines.append("")
        lines.append("Then do these in order, and do NOT dispatch anything first:")
        lines.append("1. Read the event log from seq %d to the head and catch "
                     "your cursor up." % ds["cursor"])
        if owed.get("integrating"):
            lines.append("2. Land the approved branches one at a time, gating "
                         "each: %s." % self._card_list(
                             owed["integrating"], self.AUTOHEAL_CARD_LIST_MAX))
            lines.append("3. Re-dispatch what is in motion and what is queued, "
                         "reading each card's timeline for where it got to.")
        else:
            lines.append("2. Re-dispatch what is in motion and what is queued, "
                         "reading each card's timeline for where it got to.")
        lines.append("")
        lines.append("(sprint autoheal, attempt %d of %d — nobody typed this)"
                     % (attempt, self.revive_max_burst))
        return "\n".join(lines)

    def autoheal_json(self, at: float = None) -> dict:
        """What `/api/board` carries: enough for the hub to decide and for the
        banner to say one honest extra clause. Deliberately NOT the brief --
        composing it on every browser poll would be work nobody asked for."""
        at = now() if at is None else at
        ds = self.session_dead_state(at)
        rev = self.revive_state(at, dead=ds)
        declared = self.session_dead_declared(ds["last_seen_at"])
        return {
            # Is there a channel at all? No tmux window means this board is not
            # autohealable, and saying so is better than a silent no-op.
            "registered": bool(ds["tmux_window"]),
            "tmux_window": ds["tmux_window"] or None,
            "dead": ds["dead"],
            "reason": ds["reason"],
            "declared_at": float(declared["ts"]) if declared is not None else None,
            "quiet_for_seconds": ds["quiet_for_seconds"],
            "dead_after_seconds": ds["dead_after_seconds"],
            "owed": ds["owed"],
            "owed_count": ds["owed_count"],
            "cursor": ds["cursor"],
            "head": ds["head"],
            "account_limited": ds["account_limited"],
            "revive_wanted": rev["wanted"],
            "attempts": rev["attempts_this_episode"],
            "max_attempts": rev["max_attempts"],
            "last_attempt_at": rev["last_attempt_at"],
            "last_attempt_label": rev["last_attempt_label"],
            "delivered_but_silent": rev["delivered_but_silent"],
            "gave_up": rev["gave_up"],
            "gave_up_text": (self.gave_up_text(rev, ds["tmux_window"])
                             if rev["gave_up"] and ds["dead"] else None),
            "hold": rev["hold"],
        }

    def session_dead_declared(self, since_ts: float):
        """The `session_dead` event for the CURRENT death episode, or None.

        An episode runs from the session's last proof of life, exactly the way
        a card's stuck episode runs from its last transition (#67): coming back
        to life is the one act that re-arms the notice, and it re-arms it by
        moving `since_ts` past the event we already wrote.
        """
        row = self.q1("SELECT seq, ts, payload FROM events WHERE card_num IS NULL "
                      "AND kind='session_dead' ORDER BY seq DESC LIMIT 1")
        if row is None or float(row["ts"]) <= since_ts:
            return None
        return row

    def _gave_up_declared(self, since_ts: float):
        row = self.q1("SELECT seq, ts FROM events WHERE card_num IS NULL "
                      "AND kind='revive_gave_up' ORDER BY seq DESC LIMIT 1")
        if row is None or float(row["ts"]) <= since_ts:
            return None
        return row

    def sweep_session_dead(self) -> int:
        """One `session_dead` per death episode, and one `revive_gave_up` per
        episode after that. Runs on the sweep tick beside the other rules.

        Both writes re-check under the lock for the same reason every other
        sweep does: the session can come back between the loose read and the
        write, and an event that says the session is dead is worth exactly as
        much as the instant it was true.
        """
        fired = 0
        at = now()
        ds = self.session_dead_state(at)
        if not ds["dead"]:
            return 0
        if self.session_dead_declared(ds["last_seen_at"]) is None:
            with self.lock:
                fresh = self.session_dead_state()
                if fresh["dead"] and \
                        self.session_dead_declared(fresh["last_seen_at"]) is None:
                    self.conn.execute("BEGIN IMMEDIATE")
                    try:
                        self._append_event(None, "server", "session_dead", {
                            "quiet_for_seconds": fresh["quiet_for_seconds"],
                            "dead_after_seconds": fresh["dead_after_seconds"],
                            "last_seen_at": fresh["last_seen_at"],
                            "last_seen_by": fresh["last_seen_by"],
                            "cursor": fresh["cursor"], "head": fresh["head"],
                            "pending": fresh["pending"],
                            "owed": fresh["owed"], "owed_count": fresh["owed_count"],
                            "tmux_window": fresh["tmux_window"] or None,
                            "text": "the session has not read this board for %s "
                                    "— %d card%s waiting on it"
                                    % (human_span(fresh["quiet_for_seconds"]),
                                       fresh["owed_count"],
                                       "" if fresh["owed_count"] == 1 else "s"),
                            "detail": "Last thing it did: %s. Cursor %d of %d. "
                                      "Autoheal %s."
                                      % (fresh["last_seen_by"], fresh["cursor"],
                                         fresh["head"],
                                         "will try tmux window “%s”"
                                         % fresh["tmux_window"]
                                         if fresh["tmux_window"]
                                         else "cannot reach it — no tmux window "
                                              "was registered at boot"),
                        })
                        self.conn.execute("COMMIT")
                    except Exception:
                        self.conn.execute("ROLLBACK")
                        raise
                    fired += 1
        # ...and the ending: autoheal tried its three and stopped. This is the
        # line the OTHER boards' user sees on the hub, so it has to say what to
        # physically do rather than that a counter hit a limit.
        rev = self.revive_state(at, dead=ds)
        if rev["gave_up"] and ds["tmux_window"] and \
                self._gave_up_declared(ds["last_seen_at"]) is None:
            with self.lock:
                fresh = self.session_dead_state()
                frev = self.revive_state(dead=fresh)
                if fresh["dead"] and frev["gave_up"] and \
                        self._gave_up_declared(fresh["last_seen_at"]) is None:
                    self.conn.execute("BEGIN IMMEDIATE")
                    try:
                        self._append_event(None, "server", "revive_gave_up", {
                            "attempts": frev["attempts_this_episode"],
                            "attempts_this_hour": frev["attempts_this_hour"],
                            "max_attempts": frev["max_attempts"],
                            "tmux_window": fresh["tmux_window"],
                            "delivered_but_silent": frev["delivered_but_silent"],
                            "text": self.gave_up_text(frev, fresh["tmux_window"]),
                        })
                        self.conn.execute("COMMIT")
                    except Exception:
                        self.conn.execute("ROLLBACK")
                        raise
                    fired += 1
        if fired:
            self.notify()
        return fired

    def claim_revive(self, by: str = "hub") -> dict:
        """`POST /api/autoheal/revive` — the hub asking permission to wake this
        board's session, and being told what to say.

        The claim is written BEFORE the message is sent, for exactly the reason
        the self-restart stamp is (#62): the case this guard exists for is the
        one where what happens next never comes back. A slot spent on an
        attempt that vanished is the safe direction; a slot handed out twice
        because two hub ticks raced is not, which is why the whole check-and-
        write happens once, under the lock.
        """
        with self.lock:
            at = now()
            ds = self.session_dead_state(at)
            rev = self.revive_state(at, dead=ds)
            if not ds["dead"]:
                return {"ok": False, "reason": ds["reason"], "autoheal": True,
                        "detail": "this board's session is not dead (%s)"
                                  % ds["reason"]}
            if not ds["tmux_window"]:
                return {"ok": False, "reason": "no_tmux_window",
                        "detail": "no tmux window is registered for this "
                                  "board's session, so there is nowhere to "
                                  "send a wake-up"}
            if rev["gave_up"]:
                return {"ok": False, "reason": "gave_up", "detail": rev["hold"]}
            if rev["hold"]:
                return {"ok": False, "reason": "held", "detail": rev["hold"]}
            attempt = rev["attempts_this_episode"] + 1
            brief = self.revive_brief(at, dead=ds, attempt=attempt)
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                seq = self._append_event(None, "server", "revive_attempted", {
                    "attempt": attempt, "max_attempts": rev["max_attempts"],
                    "tmux_window": ds["tmux_window"], "by": by,
                    "cursor": ds["cursor"], "head": ds["head"],
                    "quiet_for_seconds": ds["quiet_for_seconds"],
                    "owed": ds["owed"],
                    # Whether the message actually got out is a SEPARATE
                    # `revive_result` event keyed on this one's seq -- and
                    # "delivered" still is not "awake". See `revive_state`.
                    "text": "waking the session in tmux window “%s” (try %d of "
                            "%d)" % (ds["tmux_window"], attempt,
                                     rev["max_attempts"]),
                })
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "attempt": attempt, "attempt_seq": seq,
                "max_attempts": rev["max_attempts"],
                "tmux_window": ds["tmux_window"], "brief": brief,
                "grace_seconds": self.revive_grace_seconds,
                "project_root": self.project_root}

    def record_revive_result(self, attempt_seq: int, sent: bool,
                             detail: str = None) -> dict:
        """The sender reporting back on a claim it already made.

        This does NOT spend a slot and cannot create one -- it only writes down
        whether the message got out, which is what decides which of the two
        give-up sentences this board will eventually say. It is a NEW event
        rather than an edit of the attempt: the log is append-only, and a
        payload rewritten under a client that already streamed it is a fact
        that reads differently depending on when you looked.
        """
        row = self.q1("SELECT seq, payload FROM events WHERE seq=? "
                      "AND kind='revive_attempted'", (int(attempt_seq),))
        if row is None:
            raise ApiError(404, "no_such_attempt",
                           "no revive attempt #%s on this board" % attempt_seq)
        attempt = jload(row["payload"], {}) or {}
        window = attempt.get("tmux_window") or "?"
        with self.lock:
            self._append_event(None, "server", "revive_result", {
                "attempt_seq": int(attempt_seq), "sent": bool(sent),
                "tmux_window": attempt.get("tmux_window"),
                "detail": one_line(str(detail), 400) if detail else None,
                "text": ("wake-up delivered to tmux window “%s” — waiting to "
                         "see if the session actually stirs" % window) if sent
                        else "could not deliver the wake-up to tmux window “%s”"
                             % window,
            })
        self.notify()
        return {"ok": True, "attempt_seq": int(attempt_seq), "sent": bool(sent)}

    def revive_result_for(self, attempt_seq: int):
        """Did the sender ever report back on this attempt? Newest first, so a
        retry that reported twice is read as its latest word."""
        for row in self.q("SELECT payload FROM events WHERE card_num IS NULL "
                          "AND kind='revive_result' ORDER BY seq DESC LIMIT 50"):
            p = jload(row["payload"], {}) or {}
            if int(p.get("attempt_seq") or 0) == int(attempt_seq):
                return p
        return None

    # -- evidence gate ----------------------------------------------------

    def batch_members(self, batch_id) -> list:
        if not batch_id:
            return []
        return [r["num"] for r in
                self.q("SELECT num FROM cards WHERE batch_id=? ORDER BY num", (batch_id,))]

    @staticmethod
    def packet_work_kind(card_row, packet) -> str:
        """`ops` or `code` — the packet's own word wins, else the card's."""
        claimed = packet.get("work_kind") if isinstance(packet, dict) else None
        if isinstance(claimed, str) and claimed.strip().lower() in WORK_KINDS:
            return claimed.strip().lower()
        on_card = None
        try:
            on_card = card_row["work_kind"] if card_row is not None else None
        except (IndexError, KeyError):
            on_card = None
        return on_card if on_card in WORK_KINDS else "code"

    @staticmethod
    def readback_text(packet) -> str:
        """The observed evidence, as one blob. A list is joined; anything else
        is not a readback."""
        val = packet.get("readback") if isinstance(packet, dict) else None
        if isinstance(val, str):
            return val.strip()
        if isinstance(val, list):
            lines = [s for s in val if isinstance(s, str)]
            if len(lines) != len(val):
                return ""
            return "\n".join(lines).strip()
        return ""

    def validate_packet(self, card_row, packet) -> list:
        missing = []
        if not isinstance(packet, dict):
            return ["packet"]

        def blank(key):
            val = packet.get(key)
            return not (isinstance(val, str) and val.strip())

        # Non-code work proves itself differently. A mailbox reprocess has no
        # diff, no branch, no preview and often no test suite -- demanding them
        # made ops cards liars or second-class. What it DOES have is a readback:
        # the log excerpt or command output showing the thing actually
        # happened. So `ops` swaps the required set rather than relaxing it.
        kind = self.packet_work_kind(card_row, packet)
        if kind == "ops":
            if blank("claim"):
                missing.append("claim")
            if not self.readback_text(packet):
                missing.append("readback")
        else:
            for field in ("claim", "diffstat", "branch", "test_cmd", "test_result"):
                if blank(field):
                    missing.append(field)

        tr = packet.get("test_result")
        if isinstance(tr, str) and tr.strip() and "test_result" not in missing:
            if not (PASS_RE.search(tr) and FAIL_RE.search(tr)):
                missing.append("test_result")  # counts required, never "tests pass"

        # "we need to make sure there's a way for the human to easily validate
        # the fix without having to read the code" -- required, always.
        val = packet.get("validate")
        if isinstance(val, str):
            if not val.strip():
                missing.append("validate")
        elif isinstance(val, list):
            good = [s for s in val if isinstance(s, str) and s.strip()]
            if not good or len(good) != len(val):
                missing.append("validate")
        else:
            missing.append("validate")

        ui = packet.get("ui_change")
        # An ops card has no UI to have changed, so it need not answer the
        # question -- but if it volunteers `ui_change: true` it owes the same
        # screenshots anyone else would.
        if not isinstance(ui, bool):
            if kind != "ops":
                missing.append("ui_change")
        elif ui and not (packet.get("screenshots") or []):
            missing.append("screenshots")

        if not isinstance(ui, bool) and kind != "ops":
            diff = packet.get("diffstat")
            if isinstance(diff, str) and FRONTEND_HINT_RE.search(diff) and \
                    not (packet.get("screenshots") or []):
                if "screenshots" not in missing:
                    missing.append("screenshots")

        members = self.batch_members(card_row["batch_id"])
        if len(members) > 1:
            per = packet.get("per_card")
            if not isinstance(per, list) or not per:
                missing.append("per_card")
            else:
                seen = {}
                for entry in per:
                    if not isinstance(entry, dict):
                        missing.append("per_card")
                        break
                    cn = entry.get("card_num")
                    try:
                        cn = int(cn)
                    except (TypeError, ValueError):
                        missing.append("per_card[].card_num")
                        continue
                    seen[cn] = entry
                    claim = entry.get("claim")
                    if not (isinstance(claim, str) and claim.strip()):
                        missing.append("per_card[#%d].claim" % cn)
                for cn in members:
                    if cn not in seen:
                        missing.append("per_card[#%d]" % cn)
        # stable, de-duplicated
        out, seen_f = [], set()
        for f in missing:
            if f not in seen_f:
                seen_f.add(f)
                out.append(f)
        return out

    def card_ready(self, num: int, packet, actor: str = "worker") -> dict:
        row = self.card_row(num)
        # A conversation has nothing to prove and nobody to sign it off. This
        # fires BEFORE the packet is even looked at, so the answer is about the
        # card rather than about which field the packet forgot.
        if self.is_conversation(row):
            raise ApiError(409, "not_a_work_card",
                           "#%s is a conversation, not a work card -- there is "
                           "no evidence packet, no verdict and no merge on one"
                           % num,
                           card_kind="conversation", from_state=row["state"],
                           to_state="ready")
        missing = self.validate_packet(row, packet)
        if missing:
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self._append_event(num, "server", "evidence", {
                        "ok": False, "missing": missing,
                        "text": "evidence rejected: missing " + ", ".join(missing),
                    })
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
            raise ApiError(422, "evidence_incomplete",
                           "missing or invalid: " + ", ".join(missing),
                           missing=missing)

        # Screenshots arrive as absolute worktree paths; store them so the board
        # can actually show them (the whole point of the gate).
        packet = self.ingest_packet(packet)
        # A packet that declared itself ops says so about the CARD, not just
        # about this one submission -- a bounce and a second packet must be
        # judged by the same rules as the first.
        kind = self.packet_work_kind(row, packet)
        packet["work_kind"] = kind
        readback = self.readback_text(packet)
        if readback:
            packet["readback"] = readback
        if kind != (row["work_kind"] or "code"):
            with self.lock:
                self.conn.execute("UPDATE cards SET work_kind=?, updated_at=? WHERE num=?",
                                  (kind, now(), num))
            row = self.card_row(num)

        members = self.batch_members(row["batch_id"]) or [num]
        if num not in members:
            members.append(num)
        for cn in members:
            crow = self.card_row(cn)
            if "ready" not in TRANSITIONS.get(crow["state"], set()) and crow["state"] != "ready":
                raise ApiError(409, "illegal_transition",
                               "cannot move #%s from %s to ready" % (cn, crow["state"]),
                               from_state=crow["state"], to_state="ready")
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                self.conn.execute(
                    "INSERT INTO evidence(card_num, packet, created_at) VALUES(?,?,?)",
                    (num, jdump(packet), now()))
                claim = packet.get("claim") if isinstance(packet, dict) else None
                self._append_event(num, actor, "evidence", {
                    "ok": True, "packet": packet, "cards": members,
                    "text": ("evidence posted: %s" % claim) if claim
                            else "evidence posted"})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        flipped = []
        for cn in members:
            crow = self.card_row(cn)
            if crow["state"] == "ready":
                flipped.append(cn)
                continue
            with self.lock:
                self._apply_transition(cn, crow["state"], "ready", actor,
                                       "evidence accepted",
                                       {"evidence_card": num})
            flipped.append(cn)
        self.notify()
        return {"ok": True, "cards": flipped, "card": self.card_json(self.card_row(num))}

    # -- verdicts ---------------------------------------------------------

    def verdict(self, num: int, verdict: str, notes: str = "", scope: str = "card",
                actor: str = "user", images=None) -> dict:
        """A decision on one card (or a batch), optionally with screenshots.

        Card #66, user verbatim: "i need to be able to paste images into ANY
        text entry area-- I just tried to bounce a card with a screenshot
        showing the issue, it wouldn't let me paste an image in." The pictures
        ride the verdict EVENT, through the same content-addressed store every
        other surface uses, so the agent picking the card back up finds them on
        its own timeline next to the notes -- with an absolute path, no second
        fetch.
        """
        if verdict not in ("approve", "bounce", "reject"):
            raise ApiError(400, "bad_verdict",
                           "verdict must be approve, bounce or reject")
        row = self.card_row(num)      # 404 before we write anything to disk
        if self.is_conversation(row):
            raise ApiError(409, "not_a_work_card",
                           "#%s is a conversation -- there is nothing to "
                           "approve, bounce or reject on one" % num,
                           card_kind="conversation")
        targets = [num]
        if scope == "batch":
            members = self.batch_members(row["batch_id"])
            if not members:
                raise ApiError(400, "not_batched", "#%s is not in a batch" % num)
            if verdict == "bounce":
                raise ApiError(400, "bad_scope",
                               "bounce is per-card; bounced cards stay with the agent")
            targets = members
        elif scope != "card":
            raise ApiError(400, "bad_scope", "scope must be card or batch")

        # Validate every target BEFORE touching any of them: a batch verdict is
        # all-or-nothing, never half-applied.
        plan = []
        for cn in targets:
            crow = self.card_row(cn)
            if verdict == "approve":
                # approve hands the card to the session's git work; only
                # POST /integrated {ok:true} can mark it done.
                to_state, escalate, bounce = "integrating", False, crow["bounce_count"]
            elif verdict == "reject":
                to_state, escalate, bounce = "rejected", False, crow["bounce_count"]
            else:
                bounce = int(crow["bounce_count"]) + 1
                to_state, escalate = "in_progress", bounce >= 2
            if to_state not in TRANSITIONS.get(crow["state"], set()):
                raise ApiError(409, "illegal_transition",
                               "cannot %s #%s from %s" % (verdict, cn, crow["state"]),
                               from_state=crow["state"], to_state=to_state, card=cn)
            plan.append((cn, crow["state"], to_state, escalate, bounce))

        # Stored once, after every target is known to be legal and before a
        # single event is written: a verdict that 409s must not leave blobs
        # behind, and a whole unit sent back with the same picture is one file.
        attachments = self.store_images(images)

        results = []
        for cn, from_state, to_state, escalate, bounce in plan:
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    label = {"approve": "approved", "bounce": "bounced back",
                             "reject": "rejected"}[verdict]
                    payload = {"verdict": verdict, "notes": notes or "",
                               "scope": scope, "bounce_count": bounce,
                               "text": ("%s — %s" % (label, notes)) if notes else label}
                    if attachments:
                        payload["attachments"] = attachments
                        if not notes:
                            # Every event needs words: a bounce whose whole
                            # point is the picture still reads on the card face.
                            payload["text"] = "%s — with %s" % (
                                label,
                                "a screenshot" if len(attachments) == 1
                                else "%d screenshots" % len(attachments))
                    if escalate:
                        payload["escalate"] = True
                        payload["text"] = (
                            "%s (second bounce on #%s -- stop retrying, co-design "
                            "with the user)" % (payload["text"], cn))
                    self._append_event(cn, actor, "verdict", payload)
                    if verdict == "bounce":
                        self.conn.execute(
                            "UPDATE cards SET bounce_count=?, updated_at=? WHERE num=?",
                            (bounce, now(), cn))
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
                self._apply_transition(cn, from_state, to_state, actor,
                                       VERDICT_REASON[verdict], None)
            results.append({"num": cn, "state": to_state, "bounce_count": bounce,
                            "escalate": escalate})
        self.notify()
        return {"ok": True, "verdict": verdict, "cards": results}

    def integrated(self, num: int, ok: bool, reason: str = "", card_nums=None,
                   actor: str = "session") -> dict:
        """The session reports the outcome of the real git work.

        ok      -> completed (the branch actually landed)
        not ok  -> in_progress + an `error` event carrying the reason.
                   Integration failure is NOT a review bounce: bounce_count
                   is left alone.
        """
        if not isinstance(ok, bool):
            raise ApiError(400, "missing_field", "ok must be a bool", field="ok")
        reason = (reason or "").strip()
        if not ok and not reason:
            raise ApiError(400, "missing_field",
                           "a failed integration needs a reason", field="reason")

        targets = [num]
        if card_nums is not None:
            if not isinstance(card_nums, list) or not card_nums:
                raise ApiError(400, "bad_card_nums", "card_nums must be a non-empty list")
            targets = []
            for n in card_nums:
                try:
                    targets.append(int(n))
                except (TypeError, ValueError):
                    raise ApiError(400, "bad_card_num", "bad card number %r" % n)
            if num not in targets:
                targets.insert(0, num)

        to_state = "completed" if ok else "in_progress"
        plan = []
        for cn in targets:
            crow = self.card_row(cn)
            if crow["state"] != "integrating":
                raise ApiError(409, "not_integrating",
                               "#%s is %s, not integrating" % (cn, crow["state"]),
                               from_state=crow["state"], to_state=to_state, card=cn)
            plan.append((cn, crow["state"]))

        results = []
        for cn, from_state in plan:
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    if ok:
                        self._append_event(cn, actor, "note", {
                            "text": "branch landed", "integrated": True,
                            "reason": reason or None})
                    else:
                        self._append_event(cn, actor, "error", {
                            "text": "integration failed: %s" % reason,
                            "integrated": False, "reason": reason,
                            "bounce_count_unchanged": True})
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
                self._apply_transition(
                    cn, from_state, to_state, actor,
                    "integrated" if ok else "integration_failed",
                    {"integrated": ok, "reason": reason or None})
            row = self.card_row(cn)
            results.append({"num": cn, "state": row["state"],
                            "bounce_count": row["bounce_count"]})
        self.notify()
        return {"ok": True, "integrated": ok, "cards": results}

    # -- questions / answers ----------------------------------------------

    def normalize_artifacts(self, artifacts):
        """What a DECISION REQUEST hands over alongside its question.

        User's rule, verbatim: *"needs you is where we talk through things.
        review means the session genuinely thinks the card is 100% complete.
        needs you is that the card is waiting for my input before it can keep
        moving forward"*. An agent that has built three mockups and wants one
        picked is not finished -- it is waiting. So the question mechanism
        carries the things you need in order to answer: a live URL, pictures,
        and a short note, ingested exactly the way an evidence packet's
        screenshots are (absolute paths in, stored refs with a `url` out).

        `{url?, attachments?: [ref], notes?}` -- every field optional, but an
        artifacts payload with nothing in it is a mistake worth naming.
        """
        if artifacts is None:
            return None
        if not isinstance(artifacts, dict):
            raise ApiError(400, "bad_artifacts",
                           "artifacts must be an object with url/attachments/notes",
                           field="artifacts")
        out = {}
        url = artifacts.get("url")
        if url is not None:
            if not isinstance(url, str) or not url.strip():
                raise ApiError(400, "bad_artifacts", "artifacts.url must be a non-empty string",
                               field="artifacts.url")
            if not re.match(r"^https?://", url.strip()):
                raise ApiError(400, "bad_artifacts",
                               "artifacts.url must be an http(s) URL the user can open",
                               field="artifacts.url")
            out["url"] = url.strip()
        notes = artifacts.get("notes")
        if notes is not None:
            if not isinstance(notes, str):
                raise ApiError(400, "bad_artifacts", "artifacts.notes must be a string",
                               field="artifacts.notes")
            if notes.strip():
                out["notes"] = notes.strip()
        atts = artifacts.get("attachments")
        if atts is not None:
            if not isinstance(atts, list):
                raise ApiError(400, "bad_artifacts",
                               "artifacts.attachments must be a list of paths or refs",
                               field="artifacts.attachments")
            if atts:
                out["attachments"] = self.ingest_refs(atts)
        if not out:
            raise ApiError(400, "bad_artifacts",
                           "artifacts carries nothing -- give it a url, attachments or notes, "
                           "or omit it and ask a plain question",
                           field="artifacts")
        return out

    def ask(self, num: int, text: str, options=None, actor: str = "worker",
            artifacts=None) -> dict:
        text = (text or "").strip()
        if not text:
            raise ApiError(400, "missing_field", "question text is required", field="text")
        artifacts = self.normalize_artifacts(artifacts)
        row = self.card_row(num)
        if row["state"] in TERMINAL_STATES:
            raise ApiError(409, "terminal_card",
                           "#%s is %s; cannot ask" % (num, row["state"]))
        # On a conversation you just talk. A question panel exists to unblock a
        # working agent, and there is no agent here to unblock.
        if self.is_conversation(row):
            raise ApiError(409, "not_a_work_card",
                           "#%s is a conversation -- say it as a message, not "
                           "as a question that blocks the card" % num,
                           card_kind="conversation")
        if row["state"] != "needs_you" and \
                "needs_you" not in TRANSITIONS.get(row["state"], set()):
            raise ApiError(409, "illegal_transition",
                           "cannot move #%s from %s to needs_you" % (num, row["state"]),
                           from_state=row["state"], to_state="needs_you")
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.conn.execute(
                    "INSERT INTO questions"
                    "(card_num, text, options, artifacts, answered_at, created_at) "
                    "VALUES(?,?,?,?,NULL,?)",
                    (num, text, jdump(options) if options else None,
                     jdump(artifacts) if artifacts else None, now()))
                qid = int(cur.lastrowid)
                payload = {"question_id": qid, "text": text, "options": options}
                # The artifacts ride on the event too, so the thread can still
                # show what you were asked to look at after you have answered.
                if artifacts:
                    payload["artifacts"] = artifacts
                self._append_event(num, actor, "question", payload)
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        if row["state"] != "needs_you":
            self.transition(num, "needs_you", actor, reason="question asked")
        self.notify()
        qrow = self.q1("SELECT * FROM questions WHERE id=?", (qid,))
        return {"ok": True, "question": self.question_json(qrow),
                "card": self.card_json(self.card_row(num), brief=True)}

    def answer(self, num: int, question_id: int, text: str, actor: str = "user",
               images=None) -> dict:
        """Answer an open question -- in words, and optionally in pictures.

        Card #66: the answer box is a text entry area like any other, so a
        screenshot pasted into it rides the ANSWER event rather than a separate
        chat line before it. One event, so the agent reading the answer has the
        picture attached to the words it belongs to.
        """
        text = (text or "").strip()
        self.card_row(num)              # 404 before we write anything to disk
        attachments = self.store_images(images)
        if not text and not attachments:
            raise ApiError(400, "missing_field", "answer text is required", field="text")
        if not text:
            text = image_line(len(attachments))
        with self.lock:
            qrow = self.conn.execute(
                "SELECT * FROM questions WHERE id=?", (question_id,)).fetchone()
            if qrow is None or qrow["card_num"] != num:
                raise ApiError(404, "no_such_question",
                               "question %s not found on #%s" % (question_id, num))
            if qrow["answered_at"] is not None:
                raise ApiError(409, "already_answered",
                               "question %s was already answered" % question_id,
                               question_id=question_id,
                               answered_at=qrow["answered_at"])
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.conn.execute(
                    "UPDATE questions SET answered_at=? WHERE id=? AND answered_at IS NULL",
                    (now(), question_id))
                if cur.rowcount != 1:
                    self.conn.execute("ROLLBACK")
                    raise ApiError(409, "already_answered",
                                   "question %s was already answered" % question_id,
                                   question_id=question_id)
                apayload = {"question_id": question_id, "text": text}
                if attachments:
                    apayload["attachments"] = attachments
                self._append_event(num, actor, "answer", apayload)
                self.conn.execute("COMMIT")
            except ApiError:
                raise
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        row = self.card_row(num)
        if row["state"] == "needs_you":
            self.transition(num, "in_progress", actor, reason="answered")
        self.notify()
        return {"ok": True, "question_id": question_id,
                "card": self.card_json(self.card_row(num), brief=True)}

    # -- misc writes ------------------------------------------------------

    def card_event(self, num: int, kind: str, payload, actor: str = "worker",
                   long_running=None) -> dict:
        if kind not in ("progress", "chat", "note", "error"):
            raise ApiError(400, "bad_kind",
                           "worker events must be progress, chat, note or error")
        self.card_row(num)
        if not isinstance(payload, dict):
            payload = {"text": payload if isinstance(payload, str) else jdump(payload)}
        payload = clean_phase(payload)
        if long_running is None:
            long_running = payload.get("long_running")
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                if isinstance(long_running, bool):
                    payload = dict(payload)
                    payload["long_running"] = long_running
                    self.conn.execute(
                        "UPDATE cards SET long_running=?, updated_at=? WHERE num=?",
                        (1 if long_running else 0, now(), num))
                seq = self._append_event(num, actor, kind, payload)
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "event": self.event_row(seq),
                "card": self.card_json(self.card_row(num), brief=True)}

    def card_chat(self, num: int, text: str, images=None, actor: str = "user",
                  detail=None, reports=None) -> dict:
        """A line to one card's thread -- text, images, or both.

        Same deal as dropping work on the board: a screenshot with no words is a
        complete message. Attachments land on disk BEFORE the event that names
        them, and the refs go into the chat event's payload, so the timeline
        read (`GET /api/cards/:num`) hands both the browser a url and the agent
        an absolute path with no second fetch.
        """
        text = (text or "").strip()
        self.card_row(num)              # 404 before we write anything to disk
        attachments = self.store_images(images)
        docs = self.store_reports(reports)
        attachments = attachments + docs
        if not text and not attachments:
            raise ApiError(400, "empty_submission",
                           "at least one of text or images is required")
        payload = {"text": text or (docs[0]["title"] if len(docs) == 1 and not images
                                    else report_line(len(docs)) if docs
                                    else image_line(len(attachments)))}
        if attachments:
            payload["attachments"] = attachments
        if not text and not docs:
            # The line still needs words to be skimmable on the card face, but
            # the thread should show the picture, not a caption of the picture.
            payload["images_only"] = True
        if detail is not None:
            payload["detail"] = detail
        return self.card_event(num, "chat", payload, actor=actor)

    def sidebar_post(self, text: str, actor: str, detail=None, images=None,
                     reports=None) -> dict:
        text = (text or "").strip()
        if actor not in ("user", "session"):
            raise ApiError(400, "bad_actor", "sidebar actor must be user or session")
        attachments = self.store_images(images)
        docs = self.store_reports(reports)
        attachments = attachments + docs
        if not text and not attachments:
            raise ApiError(400, "missing_field", "text is required", field="text")
        # Same two-part shape as a card event: a line to skim, an optional
        # expanded version the session can park its working in.
        payload = {"text": text or (docs[0]["title"] if len(docs) == 1 and not images
                                    else report_line(len(docs)) if docs
                                    else image_line(len(attachments)))}
        if attachments:
            payload["attachments"] = attachments
        if not text and not docs:
            payload["images_only"] = True
        if detail is not None:
            payload["detail"] = detail
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                seq = self._append_event(None, actor, "chat", payload)
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "event": self.event_row(seq)}

    def sidebar_thread(self, after: int = 0, limit: int = 500) -> list:
        """Sprint-level user/session lines only -- never worker telemetry."""
        rows = self.q(
            "SELECT * FROM events WHERE card_num IS NULL AND kind IN ('chat','note','answer') "
            "AND actor IN ('user','session') AND seq>? ORDER BY seq LIMIT ?",
            (after, limit))
        return [self.event_json(r) for r in rows]

    # -- the session channel's own read receipt -----------------------------
    #
    # The title switcher has to answer "does that OTHER board want me", and one
    # of the two things that means is "the session said something over there
    # that nobody has read". That is not a client flag -- the tab that would
    # hold it is not open -- so it is the same shape as a conversation's
    # receipt: one cursor, and a count derived from the log against it.

    SIDEBAR_SEEN_CURSOR = "seen:sidebar"

    def mark_sidebar_seen(self, seq=None) -> dict:
        if seq is None:
            seq = self.max_seq()
        try:
            seq = int(seq)
        except (TypeError, ValueError):
            raise ApiError(400, "missing_field", "seq must be an integer", field="seq")
        if seq < 0:
            raise ApiError(400, "missing_field", "seq must be an integer", field="seq")
        with self.lock:
            self.conn.execute(
                "INSERT INTO cursors(name, seq, updated_at) VALUES(?,?,?) "
                "ON CONFLICT(name) DO UPDATE SET seq=MAX(cursors.seq, excluded.seq), "
                "updated_at=excluded.updated_at",
                (self.SIDEBAR_SEEN_CURSOR, seq, now()))
        return {"ok": True, "last_seen_seq": self.cursor_seq(self.SIDEBAR_SEEN_CURSOR),
                "chat_unread": self.sidebar_unread()}

    def sidebar_unread(self) -> int:
        """Lines the SESSION has said in the manager channel that nobody has
        opened. Your own messages are never unread to you."""
        seen = self.cursor_seq(self.SIDEBAR_SEEN_CURSOR)
        row = self.q1(
            "SELECT COUNT(*) AS n FROM events WHERE card_num IS NULL "
            "AND kind IN ('chat','note') AND actor='session' AND seq>?", (seen,))
        return int(row["n"]) if row is not None else 0

    def make_batch(self, card_nums, agent_name, branch, worktree=None,
                   actor: str = "session") -> dict:
        if not isinstance(card_nums, list) or not card_nums:
            raise ApiError(400, "missing_field", "card_nums is required", field="card_nums")
        nums = []
        for n in card_nums:
            try:
                nums.append(int(n))
            except (TypeError, ValueError):
                raise ApiError(400, "bad_card_num", "bad card number %r" % n)
        for n in nums:
            self.card_row(n)
        sprint = self.open_sprint(create=True)
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                cur = self.conn.execute(
                    "INSERT INTO batches(sprint_id, agent_name, worktree, branch, created_at) "
                    "VALUES(?,?,?,?,?)",
                    (sprint["id"] if sprint else None, agent_name, worktree, branch, now()))
                bid = int(cur.lastrowid)
                name = agent_name or ("sprint-batch-%d" % bid)
                self.conn.execute("UPDATE batches SET agent_name=? WHERE id=?", (name, bid))
                for n in nums:
                    self.conn.execute(
                        "UPDATE cards SET batch_id=?, agent_name=?, branch=COALESCE(?,branch), "
                        "worktree=COALESCE(?,worktree), updated_at=? WHERE num=?",
                        (bid, name, branch, worktree, now(), n))
                    self._append_event(n, actor, "note", {
                        "text": "batched into #b%d with %s" % (bid, name),
                        "batch_id": bid, "agent_name": name, "branch": branch,
                        "worktree": worktree})
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "batch": self.batch_json(bid), "cards": nums}

    def batch_json(self, bid) -> dict:
        row = self.q1("SELECT * FROM batches WHERE id=?", (bid,))
        if row is None:
            return None
        return {"id": row["id"], "sprint_id": row["sprint_id"],
                "agent_name": row["agent_name"], "worktree": row["worktree"],
                "branch": row["branch"], "created_at": row["created_at"],
                "cards": self.batch_members(row["id"])}

    def _write_title(self, num, title: str, actor: str):
        """Retitle the card face. Caller owns the transaction. cards.body --
        what the user actually typed -- is never touched; the note event keeps
        the rename itself append-only and visible in the timeline."""
        row = self.q1("SELECT title FROM cards WHERE num=?", (num,))
        if row is not None and row["title"] == title:
            return title          # idempotent: no event for a no-op rename
        self.conn.execute("UPDATE cards SET title=?, updated_at=? WHERE num=?",
                          (title, now(), num))
        self._append_event(num, actor, "note",
                           {"text": "titled: " + title, "title": title})
        return title

    def set_title(self, num: int, title, actor: str = "worker") -> str:
        self.card_row(num)
        title = clean_title(title)
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                self._write_title(num, title, actor)
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return title

    def dispatch_label(self, executor, model) -> str:
        """" — grok · tmux · sonnet" when a card names its own executor, and
        " on opus" when the only thing that changed is the model. Nothing at
        all when the card is running on the board's defaults: the timeline is
        for reading the exception off, not the norm. It is a suffix on the
        assign note, so it says how a card was dispatched, not just to whom."""
        if not executor and not model:
            return ""
        d = resolve_dispatch(self.settings(), executor, model)
        if not executor:
            # A re-dispatch onto a different model is the whole point of
            # recording it: "this one is on opus because fable ran out" has to
            # be readable off the timeline, not inferred.
            return (" on %s" % model) if model != self.default_model else ""
        bits = [d["executor"]]
        if d["kind"] != "subagent":
            bits.append(d["kind"])
        if model:
            bits.append(d["model"])
        return " — " + " · ".join(bits)

    def assign(self, num: int, agent_name, worktree, branch,
               title=None, executor=None, model=None,
               actor: str = "session", work_kind=None,
               external_agent=None, model_reason=None) -> dict:
        self.card_row(num)
        title = clean_title(title) if title is not None else None
        # NOTE: the model is validated further down, strictly, alongside the
        # executor -- a blank or an over-long model on an explicit dispatch is a
        # named 400, not something quietly recorded as "no model". (The lenient
        # `clean_model` still normalizes the board-wide default, where the input
        # is an env var and there is nobody to hand a 400 to.)
        #
        # "" is how the session says "this is no longer a downgrade" when it
        # puts the card back on its original model, so it is not the same as
        # leaving the field out.
        model_reason = clean_model_reason(model_reason)
        # Ops work has no worktree and no branch to give -- assigning it means
        # naming who is doing it and saying what shape of evidence to expect.
        if work_kind is not None:
            if not (isinstance(work_kind, str)
                    and work_kind.strip().lower() in WORK_KINDS):
                raise ApiError(400, "bad_work_kind",
                               "work_kind must be one of %s" % ", ".join(WORK_KINDS),
                               field="work_kind")
            work_kind = work_kind.strip().lower()
        if external_agent is not None and not isinstance(external_agent, bool):
            raise ApiError(400, "bad_external_agent",
                           "external_agent must be true or false",
                           field="external_agent")
        # Which executor and model this card is being dispatched with. Both are
        # optional; unset means "the board's defaults at dispatch time". An
        # executor nobody declared is refused here rather than at 2am in a
        # tmux window that never opens.
        if executor is not None:
            executor = clean_executor_name(executor, "executor")
            known = self.settings()["worker"]["executors"]
            if executor != BUILTIN_EXECUTOR and executor not in known:
                raise _bad("executor",
                           "executor \"%s\" is not in worker.executors "
                           "(known: %s)" % (executor, ", ".join(
                               sorted(list(known.keys()) + [BUILTIN_EXECUTOR]))))
        if model is not None:
            model = clean_model_name(model, "model")
        with self.lock:
            self.conn.execute("BEGIN IMMEDIATE")
            try:
                self.conn.execute(
                    "UPDATE cards SET agent_name=COALESCE(?,agent_name), "
                    "worktree=COALESCE(?,worktree), branch=COALESCE(?,branch), "
                    "model_reason=CASE WHEN ? IS NULL THEN model_reason "
                    "                  WHEN ?='' THEN NULL ELSE ? END, "
                    "work_kind=COALESCE(?,work_kind), "
                    "external_agent=COALESCE(?,external_agent), "
                    "executor=COALESCE(?,executor), model=COALESCE(?,model), "
                    "updated_at=? WHERE num=?",
                    (agent_name, worktree, branch,
                     model_reason, model_reason, model_reason, work_kind,
                     None if external_agent is None else (1 if external_agent else 0),
                     executor, model, now(), num))
                how = self.dispatch_label(executor, model)
                note = {
                    "text": "assigned to %s%s" % (agent_name or "(unchanged)", how),
                    "agent_name": agent_name, "worktree": worktree, "branch": branch,
                    "work_kind": work_kind, "external_agent": external_agent,
                    "executor": executor}
                if model:
                    note["model"] = model
                # ...and the reason says WHICH fable ran out, so the line reads
                # as a sentence: "assigned to sprint-card-42 on opus — fable
                # limited until 11:50pm".
                if model_reason:
                    note["text"] += " — %s" % model_reason
                if model_reason is not None:
                    note["model_reason"] = model_reason
                self._append_event(num, actor, "note", note)
                if title is not None:
                    self._write_title(num, title, actor)
                # Handing a card to an agent IS the start of work, so a queued
                # card flips to triaging in the same breath -- the board never
                # shows an assigned card sitting in Queued. Any other state
                # stays put: assignment must never regress a moving card.
                frm = self.q1("SELECT state FROM cards WHERE num=?", (num,))["state"]
                if frm == "queued":
                    self._write_transition(
                        num, frm, "triaging", actor,
                        "assigned to %s — picking it up"
                        % (agent_name or "an agent"))
                self.conn.execute("COMMIT")
            except Exception:
                self.conn.execute("ROLLBACK")
                raise
        self.notify()
        return {"ok": True, "card": self.card_json(self.card_row(num), brief=True)}

    # A conversation has no queue and no agent, so the verbs that push work
    # around are meaningless on one. What is left is the two things you can
    # honestly do to a thread: keep it at the top, and end it.
    CONVERSATION_ACTIONS = ("pin", "unpin", "cancel", "reopen")
    # -- blocked by -------------------------------------------------------
    #
    # User, verbatim: "when one card is blocked by another, show that in the
    # card details." It used to be free text -- a card said "blocked" and the
    # card it was waiting on lived in somebody's sentence. Nothing could read
    # that: not the board (no link to click), not the sweep (which nagged
    # "dispatch it or say why not" at a card nobody could dispatch), and not
    # the session (which had to re-read the thread to find out what landed).
    #
    # So the link is a column. Set it, clear it, and the server does the two
    # things a structural link makes possible: it refuses a loop, and it clears
    # itself the moment the blocker is closed.

    def blocked_by_of(self, num: int):
        """The card `num` is waiting on, or None. Copes with a database that
        predates the column."""
        if "blocked_by" not in self.columns("cards"):
            return None
        row = self.q1("SELECT blocked_by FROM cards WHERE num=?", (num,))
        if row is None:
            return None
        return row["blocked_by"]

    def _blocked_chain(self, start: int) -> list:
        """`start` and everything it is (transitively) waiting on, in order.

        Stops at `BLOCKED_CHAIN_MAX` so a loop already in the database -- a
        hand-edited row, a chain written before this check existed -- costs a
        bounded walk instead of hanging the request that found it.
        """
        chain, seen, at = [], set(), start
        while at is not None and at not in seen and len(chain) < BLOCKED_CHAIN_MAX:
            chain.append(at)
            seen.add(at)
            at = self.blocked_by_of(at)
        return chain

    def set_blocked_by(self, num: int, target, reason=None,
                       actor: str = "user") -> dict:
        """Point a card at the card it is waiting on, or clear it (target None).

        Three refusals, each named, because every one of them is a link that
        would read as true on the board and never come untrue by itself.
        """
        row = self.card_row(num)
        if "blocked_by" not in self.columns("cards"):
            raise ApiError(500, "no_blocked_by_column",
                           "this board's database has no blocked_by column")
        reason = clean_short_text(reason, "reason", BLOCKED_REASON_MAX)
        was = row["blocked_by"]

        if target is None:
            if was is None:
                # Idempotent: clearing a card that is not blocked is a no-op,
                # not an error, and it must not write an event that says
                # something changed.
                return {"ok": True, "card": self.card_json(row, brief=True)}
            text = "no longer blocked — the wall on #%s was cleared by hand" % was
            with self.lock:
                self._write_blocked_by(num, None, None, actor, text, cleared_from=was)
            self.notify()
            return {"ok": True, "card": self.card_json(self.card_row(num), brief=True)}

        try:
            target = int(target)
        except (TypeError, ValueError):
            raise ApiError(400, "missing_field",
                           "blocked_by needs target: a card number, or null to clear",
                           field="target")
        if target == num:
            raise ApiError(400, "self_block",
                           "#%s cannot be blocked by itself" % num, field="target")
        other = self.card_row(target)        # 404 no_such_card if it isn't real
        if other["state"] in TERMINAL_STATES:
            # A closed blocker never lands, so the auto-clear that makes this
            # link safe would never fire: the card would sit there saying it is
            # waiting on something that already finished, forever.
            raise ApiError(409, "blocker_closed",
                           "#%s is already %s — nothing is coming from it"
                           % (target, other["state"]),
                           field="target", blocker_state=other["state"])
        chain = self._blocked_chain(target)
        if num in chain:
            # A -> B -> A is a wall with nothing on the other side of it: both
            # cards wait for each other and neither can ever be unblocked.
            loop = " → ".join("#%s" % c for c in ([num] + chain[:chain.index(num) + 1]))
            raise ApiError(400, "blocked_cycle",
                           "that would make a loop: %s — nothing in it could ever "
                           "unblock" % loop,
                           field="target", chain=[num] + chain[:chain.index(num) + 1])

        text = "blocked by #%s%s" % (target, (" — %s" % reason) if reason else "")
        with self.lock:
            self._write_blocked_by(num, target, reason, actor, text)
        self.notify()
        return {"ok": True, "card": self.card_json(self.card_row(num), brief=True)}

    def _write_blocked_by(self, num, target, reason, actor, text,
                          cleared_from=None, _conn_open: bool = False):
        """The column and the event, together. `_conn_open` lets the auto-clear
        ride inside the blocker's own transition transaction."""
        payload = {"text": text, "blocked_by": target,
                   "blocked_reason": reason,
                   # What the sweep reads to know this card's clock restarted:
                   # being unblocked is the card becoming dispatchable again,
                   # which re-arms the reminders that were pointless while it
                   # was waiting.
                   "blocked_by_change": True}
        if cleared_from is not None:
            payload["was_blocked_by"] = cleared_from
        if not _conn_open:
            self.conn.execute("BEGIN IMMEDIATE")
        try:
            self.conn.execute(
                "UPDATE cards SET blocked_by=?, blocked_reason=?, updated_at=? "
                "WHERE num=?", (target, reason, now(), num))
            self._append_event(num, actor, "note", payload)
            if not _conn_open:
                self.conn.execute("COMMIT")
        except Exception:
            if not _conn_open:
                self.conn.execute("ROLLBACK")
            raise

    def _autoclear_blocked_by(self, blocker: int, to_state: str, actor: str) -> list:
        """Everything waiting on `blocker` stops waiting. Caller owns the
        transaction, so the unblock lands with the blocker's own state change or
        not at all.

        Fires exactly once per blocked card because it is the same write that
        clears the column: a card closed twice (completed, then reopened and
        canceled) finds nobody pointing at it the second time.
        """
        if "blocked_by" not in self.columns("cards"):
            return []
        rows = self.conn.execute(
            "SELECT num FROM cards WHERE blocked_by=?", (blocker,)).fetchall()
        landed = "landed" if to_state == "completed" else to_state
        freed = []
        for row in rows:
            self._write_blocked_by(
                row["num"], None, None, "server",
                "no longer blocked — #%s %s" % (blocker, landed),
                cleared_from=blocker, _conn_open=True)
            freed.append(row["num"])
        return freed

    def action(self, num: int, action: str, body: dict, actor: str = "user",
               from_browser: bool = False) -> dict:
        row = self.card_row(num)
        if self.is_conversation(row) and action not in self.CONVERSATION_ACTIONS:
            raise ApiError(409, "not_a_work_card",
                           "#%s is a conversation -- %s is a work verb. You can "
                           "%s one." % (num, action,
                                        ", ".join(self.CONVERSATION_ACTIONS)),
                           card_kind="conversation",
                           allowed=list(self.CONVERSATION_ACTIONS))
        if action == "make_conversation":
            # Promote a work card into a thread. The card, its number, its body
            # and its whole timeline stay exactly where they are -- the only
            # thing that changes is what the board expects of it.
            if row["state"] in TERMINAL_STATES:
                raise ApiError(409, "illegal_transition",
                               "#%s is %s; reopen it before making it a "
                               "conversation" % (num, row["state"]),
                               from_state=row["state"],
                               to_state=CONVERSATION_STATE)
            # Kind and state change together or not at all: a card that was one
            # and not the other is a card no rule in this file describes.
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self._write_transition(
                        num, row["state"], CONVERSATION_STATE, actor,
                        "made a conversation -- a thread now, not a work item",
                        extra={"card_kind": "conversation"})
                    self.conn.execute(
                        "UPDATE cards SET kind='conversation', updated_at=? "
                        "WHERE num=?", (now(), num))
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
        elif action in ("long_running", "external_agent"):
            # Both of these turn the silence timer OFF for a card, so they are
            # the session's to set, not a click in a browser: the user has no
            # way to know whether an agent is legitimately quiet. `long_running`
            # was worker-only, which is exactly the gap the user hit -- external
            # agents emit no worker telemetry, so nobody could set it at all.
            if from_browser:
                raise ApiError(403, "session_only",
                               "%s is set by the session over the API, not from "
                               "the board" % action)
            value = body.get("value")
            if value is None:
                value = True
            if not isinstance(value, bool):
                raise ApiError(400, "bad_value",
                               "%s takes value: true or false" % action,
                               field="value")
            note = body.get("note")
            if note is not None and not isinstance(note, str):
                raise ApiError(400, "bad_note", "note must be a string", field="note")
            note = (note or "").strip()
            if action == "long_running":
                text = ("long-running: %s" % note) if note else \
                    "marked long-running — the silence timer is off for this stretch"
            else:
                text = ("external agent: %s" % note) if note else \
                    ("marked as an external agent — it emits no worker telemetry, "
                     "so the session owns checking on it")
            if not value:
                text = "%s cleared" % action.replace("_", " ")
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self.conn.execute(
                        "UPDATE cards SET %s=?, updated_at=? WHERE num=?" % action,
                        (1 if value else 0, now(), num))
                    self._append_event(num, actor, "note", {
                        "text": text, action: bool(value),
                        "note": note or None})
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
        elif action in ("pin", "unpin"):
            value = body.get("value")
            if not isinstance(value, bool):
                value = body.get("pinned")
            if action == "unpin" and not isinstance(value, bool):
                value = False
            newval = (not row["pinned"]) if not isinstance(value, bool) else value
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self.conn.execute("UPDATE cards SET pinned=?, updated_at=? WHERE num=?",
                                      (1 if newval else 0, now(), num))
                    self._append_event(num, actor, "note", {
                        "text": "pinned" if newval else "unpinned", "pinned": bool(newval)})
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
        elif action == "cancel":
            self.transition(num, "canceled", actor, reason=body.get("reason"))
        elif action == "hold":
            self.transition(num, "held", actor, reason="hold")
        elif action == "release":
            self.transition(num, "queued", actor, reason="released — work can start")
        elif action == "duplicate_of":
            target = body.get("dup_of", body.get("card_num"))
            try:
                target = int(target)
            except (TypeError, ValueError):
                raise ApiError(400, "missing_field",
                               "duplicate_of needs dup_of", field="dup_of")
            if target == num:
                raise ApiError(400, "bad_dup", "a card cannot duplicate itself")
            self.card_row(target)
            with self.lock:
                self.conn.execute("UPDATE cards SET dup_of=?, updated_at=? WHERE num=?",
                                  (target, now(), num))
            self.transition(num, "duplicate", actor, reason="duplicate of #%d" % target,
                            extra={"dup_of": target})
        elif action == "blocked_by":
            # `{"action":"blocked_by","target":N,"reason":"..."}` to set it,
            # `{"action":"blocked_by","target":null}` to clear it. `target` is
            # required and explicit: a missing key would silently clear the
            # link, which is exactly the kind of quiet unblock this whole
            # change exists to stop.
            if "target" not in body and "blocked_by" not in body:
                raise ApiError(400, "missing_field",
                               "blocked_by needs target: a card number, or null "
                               "to clear", field="target")
            target = body.get("target", body.get("blocked_by"))
            return {"ok": True, "card": self.set_blocked_by(
                num, target, body.get("reason"), actor=actor)["card"]}
        elif action == "retry":
            # A dead agent's card goes back in the queue; the session picks it up
            # and dispatches a FRESH agent with the full timeline as its brief.
            if row["state"] not in ("failed", "stale"):
                raise ApiError(409, "not_retryable",
                               "#%s is %s; only failed or stale cards can be retried"
                               % (num, row["state"]),
                               from_state=row["state"], to_state="queued")
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self._append_event(num, actor, "note", {
                        "text": "retry requested -- dispatch a fresh agent for #%s with the "
                                "full timeline as its brief (say it is a new agent)" % num,
                        "retry": True, "from_state": row["state"],
                        "previous_agent": row["agent_name"]})
                    # Drop the dead agent so nobody SendMessages a pruned worktree.
                    self.conn.execute(
                        "UPDATE cards SET agent_name=NULL, worktree=NULL, long_running=0, "
                        "external_agent=0, updated_at=? WHERE num=?", (now(), num))
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.transition(num, "queued", actor, reason="retry with a fresh agent")
        elif action == "reopen":
            # Closing a card is the USER's call, and so is undoing it. A card
            # that got closed too early comes straight back to the queue --
            # nobody should ever have to edit the database to get work back.
            if row["state"] not in TERMINAL_STATES:
                raise ApiError(409, "not_reopenable",
                               "#%s is %s; only a closed card (%s) can be reopened"
                               % (num, row["state"], ", ".join(sorted(TERMINAL_STATES))),
                               from_state=row["state"], to_state="queued")
            # A reopened conversation goes back to being the conversation it
            # always was, never into the work queue.
            if self.is_conversation(row):
                self.transition(num, CONVERSATION_STATE, actor,
                                reason="reopened — the discussion is back on",
                                extra={"reopened_from": row["state"]})
            else:
                self.transition(num, "queued", actor,
                                reason="reopened — back in the queue",
                                extra={"reopened_from": row["state"]})
        else:
            raise ApiError(400, "bad_action",
                           "action must be pin, unpin, cancel, hold, release, "
                           "duplicate_of, blocked_by, retry, reopen, "
                           "make_conversation, "
                           "long_running or external_agent")
        return {"ok": True, "card": self.card_json(self.card_row(num), brief=True)}

    def set_cursor(self, name: str, seq: int) -> dict:
        with self.lock:
            self.conn.execute(
                "INSERT INTO cursors(name, seq, updated_at) VALUES(?,?,?) "
                "ON CONFLICT(name) DO UPDATE SET seq=excluded.seq, updated_at=excluded.updated_at",
                (name, int(seq), now()))
        # Wake the streams: a cursor move is what flips a user's message from
        # "landed" to "session is on it" in the browser. It appends no event --
        # the log stays the log -- so the SSE loop notices by comparing values.
        self.notify()
        return {"ok": True, "name": name, "seq": int(seq), "head": self.max_seq()}

    def sprint_action(self, action: str, body: dict, actor: str = "session") -> dict:
        if action == "open":
            row = self.q1("SELECT * FROM sprints WHERE closed_at IS NULL ORDER BY id DESC LIMIT 1")
            if row is not None:
                return {"ok": True, "sprint": self.sprint_json(row), "created": False}
            row = self.open_sprint(create=True, title=body.get("title"))
            if body.get("title"):
                with self.lock:
                    self.conn.execute("UPDATE sprints SET title=? WHERE id=?",
                                      (body["title"], row["id"]))
                row = self.q1("SELECT * FROM sprints WHERE id=?", (row["id"],))
            return {"ok": True, "sprint": self.sprint_json(row), "created": True}
        if action == "close":
            row = self.q1("SELECT * FROM sprints WHERE closed_at IS NULL ORDER BY id DESC LIMIT 1")
            if row is None:
                raise ApiError(409, "no_open_sprint", "no sprint is open")
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self.conn.execute("UPDATE sprints SET closed_at=? WHERE id=?",
                                      (now(), row["id"]))
                    self._append_event(None, actor, "note",
                                       {"text": "sprint closed", "sprint_id": row["id"]})
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
            return {"ok": True, "sprint": self.sprint_json(
                self.q1("SELECT * FROM sprints WHERE id=?", (row["id"],)))}
        if action == "set_hold_mode":
            val = body.get("hold_mode")
            if not isinstance(val, bool):
                val = body.get("value")
            if not isinstance(val, bool):
                val = body.get("on")
            if not isinstance(val, bool):
                raise ApiError(400, "missing_field", "hold_mode must be a bool",
                               field="hold_mode")
            row = self.open_sprint(create=True)
            with self.lock:
                self.conn.execute("BEGIN IMMEDIATE")
                try:
                    self.conn.execute("UPDATE sprints SET hold_mode=? WHERE id=?",
                                      (1 if val else 0, row["id"]))
                    self._append_event(None, actor, "note", {
                        "text": "hold mode on — new cards will wait" if val
                                else "hold mode off — new cards queue",
                        "hold_mode": val})
                    self.conn.execute("COMMIT")
                except Exception:
                    self.conn.execute("ROLLBACK")
                    raise
            self.notify()
            return {"ok": True, "sprint": self.sprint_json(
                self.q1("SELECT * FROM sprints WHERE id=?", (row["id"],)))}
        raise ApiError(400, "bad_action", "action must be open, close or set_hold_mode")

    # -- board ------------------------------------------------------------

    def board(self) -> dict:
        # An account limit declared on ANOTHER project's board has to reach
        # this one, and while it is on there is no session here to carry it:
        # the browser's own poll is the tick. Cheap — one small file read.
        self.reconcile_account_limit()
        sprint = self.open_sprint(create=True)
        rows = self.q("SELECT * FROM cards WHERE sprint_id=? ORDER BY num",
                      (sprint["id"],)) if sprint else []
        cards = [self.card_json(r, brief=True) for r in rows]
        pos, n = {}, 0
        for c in cards:
            if c["state"] == "queued":
                n += 1
                pos[c["num"]] = n
        for c in cards:
            c["queue_position"] = pos.get(c["num"])
        batch_ids = sorted({c["batch_id"] for c in cards if c["batch_id"]})
        counts = {}
        for c in cards:
            counts[c["state"]] = counts.get(c["state"], 0) + 1
        return {
            "sprint": self.sprint_json(sprint),
            # The sprint's name, hoisted: the header, the switcher's own row and
            # the hub all render this one string, and none of them should have
            # to know it is stored as the open sprint's title.
            "name": self.sprint_name(),
            # ...and who is running it. "" until the session introduces itself;
            # every label that would say "Session" says this instead. Note the
            # level: THIS is the session's own name ("Chuck"), while a card's
            # `agent_name` is the worker subagent working that card
            # ("sprint-card-118"). Different things, different objects.
            "agent_name": self.agent_name(),
            "hold_mode": bool(sprint["hold_mode"]) if sprint else False,
            "cards": cards,
            "counts": counts,
            # The sidebar thread ships with the board so the UI never has to
            # reconstruct it by scanning the whole event log.
            "sidebar": self.sidebar_thread(limit=200),
            # How many session lines in the manager channel nobody has opened.
            # The switcher's gold reads this the same way it reads needs_you --
            # a question you have not seen is a question either way.
            "chat_unread": self.sidebar_unread(),
            "chat_seen_seq": self.cursor_seq(self.SIDEBAR_SEEN_CURSOR),
            "batches": [self.batch_json(b) for b in batch_ids],
            # How many report documents THIS sprint has. The header's Reports
            # link exists only when this is > 0 -- user, verbatim: "link should
            # only appear once there's a report within the sprint".
            "reports": self.report_count(),
            "session": self.session_liveness(),
            # The board's own dispatch policy, so a card face can tell a
            # deliberate "grok · tmux" from whatever the defaults happen to be
            # without a second fetch.
            "settings": self.settings(),
            # Flat mirror of session.cursor: how far the session has drained.
            "cursor": self.cursor_seq(),
            "states": list(STATES),
            # What shapes of card this server knows about. `work` is everything
            # the board has ever had; `conversation` is a thread that never
            # enters the work lifecycle.
            "card_kinds": list(CARD_KINDS),
            # What "no badge" means on a card face.
            "default_model": self.default_model,
            # Provider limit windows that are open RIGHT NOW (computed off the
            # clock, so an expired one is simply not here). The board draws one
            # quiet line per window; `GET /api/limits` has the finished ones.
            "limits": self.active_limits(),
            # The account window, if one is on, with the words and the id the
            # Resume button posts to. Present in `limits` too (kind "account");
            # this is the same fact hoisted so the banner needs no filtering,
            # and it is what a board with NO session attached still serves.
            "account_limit": self.account_limit_banner(),
            # Dead-session autoheal: whether this board thinks its own session
            # died, and what has been done about it. The hub reads this to
            # decide whether to reach for tmux-send; the banner reads it for
            # one extra clause ("revival attempted 12:03").
            "autoheal": self.autoheal_json(),
            # `integrating` stays in the Ready column with a "merging…" note --
            # a card only reaches Done once its branch actually landed.
            "column_of": dict(COLUMN_OF),
            "seq": self.max_seq(),
            # Which server process answered. A tab compares it against the one
            # it booted on and re-syncs itself if it changed.
            "generation": self.generation,
            # What that process knows how to serve. A page built against a newer
            # server compares this to its own and says so out loud.
            "api_version": API_VERSION,
            "server_time": now(),
        }

    def siblings(self, max_age: float = None) -> dict:
        """Every live sprint on this machine, this one included (`self: true`).

        Cached for `siblings_ttl` (10s by default): the browser polls this every
        30s per tab, and each miss health-checks every registered board.
        """
        if max_age is None:
            max_age = self.siblings_ttl
        with self._siblings_lock:
            snap = self._siblings_snap
        if snap and (now() - snap["server_time"]) <= max_age:
            return snap
        snap = siblings_snapshot(self, self.registry)
        with self._siblings_lock:
            self._siblings_snap = snap
        return snap

    def queue_position(self, row) -> int:
        """Where this card sits in the queued pile — 1-based, or None if it is
        not queued.

        The board computes this for the whole list in one pass; a single card
        has to be able to answer it too. Without that, a client that re-reads
        one card (opening it, arrowing onto it) gets a card object with no
        queue position in it, overwrites the one it had, and the card drops to
        the bottom of the Queued pile in front of the user. Same number, same
        ordering (`ORDER BY num`) as `board()`, so the two can never disagree.
        """
        if row["state"] != "queued":
            return None
        rows = self.q("SELECT num FROM cards WHERE sprint_id=? AND state='queued' ORDER BY num",
                      (row["sprint_id"],))
        for i, r in enumerate(rows, start=1):
            if r["num"] == row["num"]:
                return i
        return None

    def card_detail(self, num: int) -> dict:
        """{card, timeline, evidence, attachments, ...} -- the drawer's whole payload."""
        row = self.card_row(num)
        card = self.card_json(row)
        card["queue_position"] = self.queue_position(row)
        timeline = self.events_after(0, limit=5000, card_num=num)
        return {
            "num": num,
            "card": card,
            "timeline": timeline,
            "events": timeline,               # alias: same list, one fetch
            "evidence": card.get("evidence"),
            "attachments": card.get("attachments") or [],
            "questions": [self.question_json(r) for r in
                          self.q("SELECT * FROM questions WHERE card_num=? ORDER BY id", (num,))],
            "evidence_history": [
                {"packet": jload(r["packet"], {}), "created_at": r["created_at"]}
                for r in self.q(
                    "SELECT * FROM evidence WHERE card_num=? ORDER BY created_at", (num,))],
            "batch": self.batch_json(row["batch_id"]) if row["batch_id"] else None,
            "column_of": dict(COLUMN_OF),
            "settings": self.settings(),
            # The drawer needs the drain cursor too: it is what tells the user
            # whether the message they just sent has been picked up yet.
            "session": self.session_liveness(),
            "cursor": self.cursor_seq(),
            "seq": self.max_seq(),
        }

    # -- idempotency ------------------------------------------------------

    def idem_get(self, key: str):
        row = self.q1("SELECT * FROM idempotency WHERE key=?", (key,))
        if row is None:
            return None
        return int(row["status"]), row["body"]

    def idem_put(self, key: str, method: str, path: str, status: int, body: str):
        with self.lock:
            try:
                self.conn.execute(
                    "INSERT OR IGNORE INTO idempotency(key, method, path, status, body, created_at) "
                    "VALUES(?,?,?,?,?,?)", (key, method, path, status, body, now()))
            except sqlite3.Error:
                pass


# --------------------------------------------------------------------------
# HTTP layer
# --------------------------------------------------------------------------


def make_handler(app: App):

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "sprintd/1.0"

        # -- plumbing ---------------------------------------------------

        def log_message(self, fmt, *args):  # noqa: A003
            app.log("%s %s" % (self.address_string(), fmt % args))

        def _send(self, status: int, body: bytes, ctype: str, extra_headers=None):
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            for k, v in (extra_headers or []):
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                try:
                    self.wfile.write(body)
                except (BrokenPipeError, ConnectionResetError):
                    pass

        def json_out(self, status: int, obj, extra_headers=None):
            body = jdump(obj).encode("utf-8")
            self._send(status, body, "application/json; charset=utf-8", extra_headers)

        def fail(self, err: ApiError):
            self.json_out(err.status, err.body())

        def read_body(self) -> bytes:
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                raise ApiError(400, "bad_length", "invalid Content-Length")
            if length > app.max_upload:
                # Drain (bounded) so the client sees a clean 413 instead of a
                # broken pipe mid-upload.
                remaining, budget = length, 512 * 1024 * 1024
                while remaining > 0 and budget > 0:
                    chunk = self.rfile.read(min(262144, remaining))
                    if not chunk:
                        break
                    remaining -= len(chunk)
                    budget -= len(chunk)
                if remaining > 0:
                    self.close_connection = True
                raise ApiError(413, "too_large",
                               "request body exceeds %d bytes" % app.max_upload)
            if length <= 0:
                return b""
            chunks, remaining = [], length
            while remaining > 0:
                chunk = self.rfile.read(min(65536, remaining))
                if not chunk:
                    break
                remaining -= len(chunk)
                chunks.append(chunk)
            return b"".join(chunks)

        def drain_body(self):
            """Discard an unread request body so keep-alive stays coherent."""
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                self.close_connection = True
                return
            if length <= 0:
                return
            if length > app.max_upload:
                self.close_connection = True
                return
            remaining = length
            while remaining > 0:
                chunk = self.rfile.read(min(65536, remaining))
                if not chunk:
                    break
                remaining -= len(chunk)

        def json_body(self) -> dict:
            raw = self.read_body()
            if not raw:
                return {}
            try:
                obj = json.loads(raw.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                raise ApiError(400, "bad_json", "body is not valid JSON")
            if not isinstance(obj, dict):
                raise ApiError(400, "bad_json", "body must be a JSON object")
            return obj

        @property
        def cookie_name(self) -> str:
            return board_cookie_name(self.server.server_address[1])

        def cookies(self, name: str):
            raw = self.headers.get("Cookie") or ""
            out = []
            for part in raw.split(";"):
                key, _, val = part.strip().partition("=")
                if key == name:
                    out.append(urllib.parse.unquote(val))
            return out

        def cookie_token(self):
            for name in (self.cookie_name, COOKIE_NAME):
                for val in self.cookies(name):
                    if val:
                        return val
            return None

        def authed(self, query) -> bool:
            """Every credential the request carries, in order of how deliberate
            it is -- and ANY match authenticates.

            `?t=` outranks the cookie on purpose. Clicking a link that carries a
            token is someone deliberately signing in to THIS board; the cookie
            is ambient, and on a machine running several boards it is very often
            a different board's. Preferring the cookie meant a valid hub link
            landed on `{"error":"unauthorized"}` -- reported from the hub, and
            reproduced against the live board on 8377.
            """
            candidates = []
            auth = self.headers.get("Authorization") or ""
            if auth.lower().startswith("bearer "):
                candidates.append(auth[7:].strip())
            qt = query.get("t")
            if qt:
                candidates.append(qt[0])
            # legacy `sprint_token` included, so browsers signed in before the
            # per-port cookie landed are not logged out by the upgrade
            for name in (self.cookie_name, COOKIE_NAME):
                candidates.extend(self.cookies(name))
            for given in candidates:
                if given and secrets.compare_digest(str(given), app.token):
                    return True
            return False

        def unauthorized(self, path, method):
            """JSON for the API; a readable page for a person who clicked."""
            if not wants_html(self.headers, path, method):
                return self.json_out(401, {"error": "unauthorized",
                                           "message": "bearer token required"})
            return self._send(401, signin_page(
                "This board needs its link",
                ["Open the board from the URL your Claude Code session printed "
                 "when it started the sprint &mdash; the one ending in "
                 "<code>/?t=&hellip;</code>.",
                 "Running several sprints on this machine? <code>sprintd hub</code> "
                 "lists them all on one page and every link there signs you in.",
                 "If the token was rotated (<code>sprintd start --new-token</code>), "
                 "the old link stops working on purpose &mdash; use the new one."],
                title="sprint — sign in"), "text/html; charset=utf-8")

        def from_browser(self) -> bool:
            """Did a BROWSER send this, rather than a script holding the token?

            Answered off headers page JavaScript is forbidden to set or remove
            on `fetch` -- Cookie, Origin, Sec-Fetch-*. The board's own SPA
            carries them on every call it makes and cannot strip them, so this
            is an enforcement seam and not a guess. (The Authorization header
            alone cannot answer it: the SPA reads `?t=` and sends a bearer token
            exactly like a worker does.)
            """
            for name in BROWSER_HEADERS:
                if (self.headers.get(name) or "").strip():
                    return True
            return False

        def actor_or(self, body, default: str) -> str:
            """Who this request is allowed to SAY it is.

            The user's report: cards created by the session over the API showed
            their `submitted` events as the user's -- so `reply_to` said "a
            human is waiting" about the session's own writing. An actor claim is
            therefore honoured only when it is explicit, in the client-settable
            set, and coming from something that is not a browser.

            Fails CLOSED in both directions: no claim means the route's own
            default (never an upgrade), and a browser's claim is dropped
            silently in favour of `user` -- the person at the keyboard is the
            user whatever their tab puts in the body.
            """
            claimed = body.get("actor") if isinstance(body, dict) else None
            if not isinstance(claimed, str) or claimed not in CLIENT_ACTORS:
                return default
            if self.from_browser():
                return "user"
            return claimed

        def is_waiter(self, query) -> bool:
            """Is this authenticated request the session's own waiter/drain?

            Only something that says so counts. A browser polling /api/events is
            not the session, and treating its polling as session liveness would
            be exactly the fake green this card is about.
            """
            if (self.headers.get(WAITER_HEADER) or "").strip():
                return True
            val = (query.get("waiter") or [""])[0]
            return str(val).strip().lower() in ("1", "true", "yes", "waiter")

        # -- routing ----------------------------------------------------

        def do_GET(self):  # noqa: N802
            self._route("GET")

        def do_HEAD(self):  # noqa: N802
            self._route("GET")

        def do_POST(self):  # noqa: N802
            self._route("POST")

        def do_PUT(self):  # noqa: N802
            # Only /api/settings answers here: settings are a document you
            # replace, not an event you append.
            self._route("PUT")

        def release_inflight(self):
            """Stop counting as in-flight. Idempotent.

            A long-held stream calls this the moment its headers are out: it is
            "in flight" for hours by definition, and a self-restart that waited
            for it would wait forever.
            """
            if getattr(self, "_inflight_counted", False):
                self._inflight_counted = False
                app.exit_request()

        def _route(self, method: str):
            # A self-restart waits for this to hit zero, so every ordinary
            # request is counted for exactly as long as it is being served.
            self._inflight_counted = True
            app.enter_request()
            try:
                return self._route_inner(method)
            finally:
                self.release_inflight()

        def _route_inner(self, method: str):
            try:
                parsed = urllib.parse.urlsplit(self.path)
                path = urllib.parse.unquote(parsed.path)
                query = urllib.parse.parse_qs(parsed.query)

                if path == "/healthz":
                    return self.json_out(200, {
                        "ok": True, "pid": os.getpid(),
                        "project_root": app.project_root,
                        "data_dir": app.data_dir,
                        "started_at": app.started_at,
                        # The one field an open tab polls to tell "the server is
                        # slow" apart from "the server I knew is gone".
                        "generation": app.generation,
                        # Which build answered. Nothing asks a human to act on
                        # it -- a board that is behind its own code restarts
                        # itself -- but the log, the hub and `sprintd status`
                        # can still say which build this is.
                        "api_version": API_VERSION,
                        # What this sprint calls itself, so `sprintd start` can
                        # re-assert the registry row without flattening a name
                        # somebody set (and without holding a token).
                        "sprint_name": app.sprint_name(),
                        # ...and who is already running it, so a re-launch can
                        # see it already has a name and keep it.
                        "agent_name": app.agent_name(),
                        "seq": app.max_seq()})

                if not self.authed(query):
                    self.drain_body()
                    return self.unauthorized(path, method)

                # Cookie handshake: /?t=TOKEN
                if method == "GET" and path == "/" and query.get("t"):
                    cookie = "%s=%s; Path=/; SameSite=Lax; Max-Age=31536000; HttpOnly" % (
                        self.cookie_name, urllib.parse.quote(app.token))
                    # Keep every OTHER query param (?theme=, ?mock=) -- only the
                    # token is consumed here.
                    rest = [(k, v) for k, v in urllib.parse.parse_qsl(parsed.query)
                            if k != "t"]
                    location = "/" + ("?" + urllib.parse.urlencode(rest) if rest else "")
                    return self._send(302, b"", "text/plain",
                                      [("Set-Cookie", cookie), ("Location", location)])

                if method == "PUT":
                    return self._put(path, query)
                if method == "POST":
                    return self._post(path, query)
                return self._get(path, query)

            except ApiError as err:
                return self.fail(err)
            except (BrokenPipeError, ConnectionResetError):
                return
            except Exception:
                app.log("unhandled: %s" % traceback.format_exc())
                try:
                    return self.json_out(500, {"error": "internal",
                                               "message": "internal error"})
                except Exception:
                    return

        # -- GET --------------------------------------------------------

        def _get(self, path, query):
            if path == "/api/board":
                return self.json_out(200, app.board())
            if path == "/api/events":
                after = int((query.get("after") or ["0"])[0] or 0)
                limit = max(1, min(2000, int((query.get("limit") or ["500"])[0] or 500)))
                # The session's waiter drains here; its poll is proof it is attached.
                if self.is_waiter(query):
                    app.note_waiter_seen()
                events = app.events_after(after, limit)
                return self.json_out(200, {"events": events, "after": after,
                                           "head": app.max_seq(),
                                           # so a polling browser learns cursor
                                           # moves without a second round trip
                                           "cursor": app.cursor_seq(),
                                           # ...and learns about a restart on
                                           # the polling path too, not just SSE
                                           "generation": app.generation,
                                           "next": events[-1]["seq"] if events else after})
            if path == "/api/stream":
                return self._stream(query)
            if path == "/api/sidebar":
                after = int((query.get("after") or ["0"])[0] or 0)
                return self.json_out(200, {"events": app.sidebar_thread(after)})
            if path == "/api/siblings":
                # The title dropdown: every live sprint on this machine, this
                # one flagged `self`. `?fresh=1` skips the 10s cache (tests).
                fresh = (query.get("fresh") or ["0"])[0] in ("1", "true", "yes")
                return self.json_out(200, app.siblings(max_age=0 if fresh else None))
            if path == "/api/limits":
                # Active windows plus the recently finished ones. Active is a
                # computation, not a column: nothing here depends on a sweep
                # having run.
                return self.json_out(200, app.limits_index())
            if path == "/api/autoheal":
                # Dead-session autoheal, whole: the verdict, what it stands on,
                # and the crash-loop guard's state. `?brief=1` also composes the
                # wake-up the hub would send -- which is how a human reads the
                # message before trusting a machine to type it.
                out = dict(app.autoheal_json())
                if (query.get("brief") or ["0"])[0] in ("1", "true", "yes"):
                    dead = app.session_dead_state()
                    out["brief"] = app.revive_brief(
                        dead=dead,
                        attempt=app.revive_state(dead=dead)["attempts_this_episode"] + 1)
                return self.json_out(200, out)
            if path == "/api/sprints":
                rows = app.q("SELECT * FROM sprints ORDER BY id DESC")
                return self.json_out(200, {"sprints": [app.sprint_json(r) for r in rows]})
            if path == "/api/settings":
                # `defaults` ships alongside so a UI can say "this is the
                # out-of-the-box value" without hardcoding it, and `choices`
                # so the panel's dropdowns come from the server, not from a
                # list in JS that drifts.
                return self.json_out(200, {
                    "settings": app.settings(),
                    # The sprint's NAME rides with settings because that is
                    # where a rename belongs: it is the user's call, it is not
                    # dispatch policy, and it is the one field here that is not
                    # in config.json (the open sprint's title is the truth).
                    "name": app.sprint_name(),
                    "name_max": SPRINT_NAME_MAX,
                    "name_default": app.default_sprint_title(),
                    # The session's own name is IN settings (config.json), but
                    # it is hoisted here too so a panel never has to know that.
                    "agent_name": app.agent_name(),
                    "agent_name_max": AGENT_NAME_MAX,
                    # ...and WHERE that session is, for the same reason: a
                    # panel should be able to show "reachable in tmux window
                    # russ-machine" without knowing which file it came from.
                    "session_tmux_window": app.session_tmux_window(),
                    "session_tmux_window_max": TMUX_WINDOW_MAX,
                    "defaults": DEFAULT_SETTINGS,
                    "choices": {
                        "model_policy": list(MODEL_POLICIES),
                        "executor_kind": list(EXECUTOR_KINDS),
                        "policy_model": dict(POLICY_MODEL),
                        "builtin_executor": BUILTIN_EXECUTOR,
                        "max_concurrency": MAX_CONCURRENCY,
                    }})

            if path == "/api/cursors/orchestrator":
                row = app.q1("SELECT * FROM cursors WHERE name='orchestrator'")
                return self.json_out(200, {
                    "name": "orchestrator",
                    "seq": int(row["seq"]) if row else 0,
                    "updated_at": row["updated_at"] if row else None})

            m = re.match(r"^/api/cards/(\d+)$", path)
            if m:
                return self.json_out(200, app.card_detail(int(m.group(1))))

            m = re.match(r"^/api/attachments/([0-9a-f]{64})\.(png|jpg|jpeg)$", path)
            if m:
                fname = "%s.%s" % (m.group(1), m.group(2))
                fpath = os.path.join(app.attach_dir, fname)
                if not os.path.isfile(fpath):
                    raise ApiError(404, "no_such_attachment", "unknown attachment")
                with open(fpath, "rb") as fh:
                    blob = fh.read()
                mime = "image/png" if m.group(2) == "png" else "image/jpeg"
                return self._send(200, blob, mime)

            # The raw bytes of a report. Markdown is inert to a browser, so it
            # goes back as text/markdown. Author HTML goes back under
            # `Content-Security-Policy: sandbox` -- a unique opaque origin with
            # scripts off -- so even a direct navigation to this URL cannot read
            # a cookie, reach the board's DOM, or call the API. The iframe that
            # normally displays it carries a restrictive sandbox attribute too.
            m = re.match(r"^/api/attachments/([0-9a-f]{64})\.(md|html)$", path)
            if m:
                sha, ext = m.group(1), m.group(2)
                fpath = os.path.join(app.attach_dir, "%s.%s" % (sha, ext))
                if not os.path.isfile(fpath):
                    raise ApiError(404, "no_such_attachment", "unknown attachment")
                with open(fpath, "rb") as fh:
                    blob = fh.read()
                extra = [("Content-Disposition", 'inline; filename="%s.%s"' % (sha[:12], ext))]
                if ext == "html":
                    extra.append(("Content-Security-Policy",
                                  "sandbox; default-src 'none'; style-src 'unsafe-inline'; "
                                  "img-src data:; base-uri 'none'; form-action 'none'"))
                    extra.append(("Referrer-Policy", "no-referrer"))
                return self._send(200, blob, REPORT_MIME_OF_KIND[
                    REPORT_KIND_BY_EXT[ext]], extra)

            if path == "/api/reports":
                scope = (query.get("scope") or ["sprint"])[0]
                return self.json_out(200, app.reports_index(
                    "all" if scope == "all" else "sprint"))

            m = re.match(r"^/api/reports/([0-9a-f]{64})\.(md|html)$", path)
            if m:
                return self.json_out(200, app.report_detail(m.group(1), m.group(2)))

            if path.startswith("/api/"):
                raise ApiError(404, "no_such_route", "no route for %s" % path)
            return self._static(path)

        def _static(self, path):
            root = web_dir()
            rel = path.lstrip("/") or "index.html"
            if not os.path.isdir(root):
                if rel in ("index.html", ""):
                    return self._send(200, PLACEHOLDER_HTML.encode("utf-8"),
                                      "text/html; charset=utf-8")
                raise ApiError(404, "no_web_dir", "web/ is not installed")
            target = os.path.realpath(os.path.join(root, rel))
            if target != os.path.realpath(root) and \
                    not target.startswith(os.path.realpath(root) + os.sep):
                raise ApiError(403, "forbidden", "path escapes web/")
            if os.path.isdir(target):
                target = os.path.join(target, "index.html")
            if not os.path.isfile(target):
                index = os.path.join(root, "index.html")
                if os.path.isfile(index):
                    target = index
                else:
                    return self._send(200, PLACEHOLDER_HTML.encode("utf-8"),
                                      "text/html; charset=utf-8")
            ctype = mimetypes.guess_type(target)[0] or "application/octet-stream"
            if ctype.startswith("text/") or ctype in ("application/javascript",
                                                      "application/json"):
                ctype += "; charset=utf-8"
            with open(target, "rb") as fh:
                return self._send(200, fh.read(), ctype)

        def _stream(self, query):
            # `sprintd tail` holds this stream open as the session's ingress.
            # A held-open stream is proof of attachment exactly like the
            # waiter's polling is -- but only if it says so (a browser's
            # EventSource cannot send the header, and must never count).
            waiter = self.is_waiter(query)
            after = 0
            lei = self.headers.get("Last-Event-ID")
            if lei and str(lei).strip().isdigit():
                after = int(str(lei).strip())
            elif query.get("after"):
                try:
                    after = int(query["after"][0])
                except ValueError:
                    after = 0
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.send_header("X-Accel-Buffering", "no")
            self.end_headers()
            self.close_connection = True
            # Held open on purpose from here on, so it stops counting as an
            # in-flight request (see `release_inflight`).
            self.release_inflight()

            def cursor_frame(cur):
                # A named `cursor` frame, deliberately WITHOUT an `id:` line:
                # the drain cursor is not an event, so it must never become the
                # browser's Last-Event-ID. The browser listens for it to flip a
                # sent message from "landed" to "session is on it".
                # `generation` rides along on every cursor frame too: the cursor
                # is the most frequent thing on the wire, so a tab that somehow
                # missed the hello still learns within a second that it is
                # talking to a different server than the one it connected to.
                return ("event: cursor\ndata: %s\n\n"
                        % jdump({"cursor": cur, "head": app.max_seq(),
                                 "generation": app.generation})).encode("utf-8")

            def hello_frame():
                # The first frame of every stream, named so it can never be
                # mistaken for an event (no `id:` -- it must not become the
                # browser's Last-Event-ID). It says which server this is and
                # where the log currently ends.
                return ("event: hello\ndata: %s\n\n"
                        % jdump({"generation": app.generation,
                                 "started_at": app.started_at,
                                 "cursor": app.cursor_seq(),
                                 "head": app.max_seq(),
                                 "after": after})).encode("utf-8")

            try:
                if waiter:
                    app.note_waiter_seen()
                self.wfile.write(b": connected\n\nretry: 2000\n\n")
                self.wfile.write(hello_frame())
                cursor = app.cursor_seq()
                self.wfile.write(cursor_frame(cursor))
                self.wfile.flush()
                last_beat = now()
                while not app.stopping.is_set():
                    # Sitting here IS the heartbeat: refresh the sighting every
                    # tick (~1s) so a session that is quietly listening never
                    # reads as offline. In-memory; the disk write is throttled.
                    if waiter:
                        app.note_waiter_seen()
                    # Hold cond across the read so a concurrent write cannot
                    # slip its notify() between the query and the wait.
                    with app.cond:
                        events = app.events_after(after, 200)
                        if not events:
                            app.cond.wait(timeout=min(app.sse_heartbeat, 1.0))
                    moved = app.cursor_seq()
                    if moved != cursor:
                        cursor = moved
                        self.wfile.write(cursor_frame(cursor))
                        self.wfile.flush()
                    if events:
                        buf = []
                        for ev in events:
                            # One frame per event: `id:` is the seq (Last-Event-ID
                            # resume), `data:` is the whole event JSON. No `event:`
                            # line -- everything lands on the default message
                            # handler, which is what the browser listens on.
                            buf.append("id: %d\ndata: %s\n\n" % (ev["seq"], jdump(ev)))
                            after = ev["seq"]
                        self.wfile.write("".join(buf).encode("utf-8"))
                        self.wfile.flush()
                        continue
                    if now() - last_beat >= app.sse_heartbeat:
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                        last_beat = now()
            except (BrokenPipeError, ConnectionResetError, ValueError, OSError):
                return

        # -- POST -------------------------------------------------------

        def _post(self, path, query):
            key = self.headers.get("Idempotency-Key")
            if key:
                hit = app.idem_get(key)
                if hit:
                    status, body = hit
                    self.drain_body()
                    return self._send(status, body.encode("utf-8"),
                                      "application/json; charset=utf-8",
                                      [("Idempotent-Replay", "true")])
            status, obj = self._dispatch_post(path, query)
            body = jdump(obj)
            if key:
                app.idem_put(key, "POST", path, status, body)
            return self._send(status, body.encode("utf-8"),
                              "application/json; charset=utf-8")

        # -- PUT --------------------------------------------------------

        def settings_write(self, body):
            """PUT and POST /api/settings are the same write. One place."""
            actor = self.actor_or(body, "user")
            patch = body.get("settings", body)
            name = body.get("name")
            if isinstance(patch, dict):
                if name is None:
                    name = patch.get("name")
                patch = {k: v for k, v in patch.items()
                         if k not in ("actor", "name")}
            if name is not None:
                # Renaming is the whole request when it is the only field, and
                # a `{}` patch is a no-op write, so both shapes work.
                app.rename_sprint(name, actor=actor)
            settings = app.save_settings(patch, actor=actor)
            return 200, {"ok": True, "settings": settings,
                         "name": app.sprint_name(),
                         "name_max": SPRINT_NAME_MAX,
                         "agent_name": settings.get("agent_name") or "",
                         "agent_name_max": AGENT_NAME_MAX,
                         "session_tmux_window":
                             settings.get("session_tmux_window") or "",
                         "session_tmux_window_max": TMUX_WINDOW_MAX,
                         "sprint": app.sprint_json(app.open_sprint(create=True)),
                         "defaults": DEFAULT_SETTINGS}

        def _put(self, path, query):
            if path != "/api/settings":
                self.drain_body()
                raise ApiError(404, "no_such_route", "no route for PUT %s" % path)
            status, obj = self.settings_write(self.json_body())
            return self.json_out(status, obj)

        def _dispatch_post(self, path, query):
            body = self.json_body()

            if path == "/api/settings":
                # POST is the same write as PUT. curl-from-a-worker and the
                # browser's own retry path both reach for POST; refusing it
                # buys nothing but a confused 404 at 2am.
                return self.settings_write(body)

            if path == "/api/cards":
                card = app.create_card(body.get("text"), posted_images(body) or [],
                                       bool(body.get("hold")),
                                       actor=self.actor_or(body, "user"),
                                       reports=body.get("reports"),
                                       kind=body.get("kind") or "work")
                return 201, card

            if path == "/api/cards/bulk":
                # `hold` defaults to TRUE here and only here: an import that
                # dispatches before the user has looked at it is the bug.
                hold = body.get("hold")
                return 201, app.create_cards_bulk(
                    body.get("items"),
                    hold=True if hold is None else bool(hold),
                    actor=self.actor_or(body, "user"))

            if path == "/api/cards/bulk-action":
                return 200, app.bulk_action(body.get("card_nums"),
                                            body.get("action"), body,
                                            actor=self.actor_or(body, "user"))

            if path == "/api/sidebar/seen":
                # "I have read the manager channel up to here." The switcher's
                # gold on OTHER boards is derived against this.
                return 200, app.mark_sidebar_seen(body.get("seq"))

            if path == "/api/sidebar":
                # The sidebar is the user and the session talking; a worker has
                # no voice here (that is what card telemetry is for).
                side = self.actor_or(body, "user")
                return 201, app.sidebar_post(body.get("text"),
                                             side if side == "session" else "user",
                                             detail=body.get("detail"),
                                             images=posted_images(body),
                                             reports=body.get("reports"))

            if path == "/api/batches":
                return 201, app.make_batch(body.get("card_nums"), body.get("agent_name"),
                                           body.get("branch"), body.get("worktree"))

            # A provider said when it would let us back in. Session surface:
            # `bin/sprint-limit declare --model fable --resets 11:50pm`.
            if path == "/api/limits":
                # `kind: "account"` is the whole-account one: no model, banner
                # on every board on the machine, cleared by the Resume button.
                out = app.declare_limit(body.get("model"), body.get("resets_at"),
                                        source=body.get("source"),
                                        note=body.get("note"),
                                        kind=body.get("kind"))
                return (201 if out.get("created") else 200), out

            m = re.match(r"^/api/limits/(\d+)/clear$", path)
            if m:
                return 200, app.clear_limit(int(m.group(1)))

            # Dead-session autoheal. The hub calls this; nothing else should.
            # Two shapes on one path: with `attempt_seq` it is the sender
            # reporting back on a claim it already holds, without it is a new
            # claim. Keeping them together keeps the guard in one place.
            if path == "/api/autoheal/revive":
                if body.get("attempt_seq") is not None:
                    try:
                        seq = int(body["attempt_seq"])
                    except (TypeError, ValueError):
                        raise ApiError(400, "bad_value",
                                       "attempt_seq must be a whole number",
                                       field="attempt_seq")
                    return 200, app.record_revive_result(
                        seq, bool(body.get("sent")), detail=body.get("detail"))
                by = body.get("by")
                out = app.claim_revive(
                    by=clean_short_text(by, "by", 40) if by else "hub")
                # 409, not 400: nothing is wrong with the request -- the board
                # is simply not in a state where a wake-up is the right act,
                # and the reason names which guard said so.
                return (200 if out.get("ok") else 409), out

            if path == "/api/sprint":
                return 200, app.sprint_action(body.get("action"), body)

            if path == "/api/cursors/orchestrator":
                seq = body.get("seq")
                try:
                    seq = int(seq)
                except (TypeError, ValueError):
                    raise ApiError(400, "missing_field", "seq is required", field="seq")
                # Only the session posts its own drain cursor -- that is a
                # sighting of the session by definition.
                app.note_waiter_seen()
                return 200, app.set_cursor("orchestrator", seq)

            m = re.match(r"^/api/cards/(\d+)/([a-z_]+)$", path)
            if not m:
                raise ApiError(404, "no_such_route", "no route for %s" % path)
            num, verb = int(m.group(1)), m.group(2)

            if verb == "chat":
                return 201, app.card_chat(num, body.get("text"),
                                          images=posted_images(body),
                                          detail=body.get("detail"),
                                          reports=body.get("reports"),
                                          actor=self.actor_or(body, "user"))
            if verb == "answer":
                qid = body.get("question_id")
                if qid is None:
                    row = app.q1("SELECT id FROM questions WHERE card_num=? AND "
                                 "answered_at IS NULL ORDER BY id DESC LIMIT 1", (num,))
                    if row is None:
                        raise ApiError(400, "missing_field",
                                       "question_id is required", field="question_id")
                    qid = row["id"]
                try:
                    qid = int(qid)
                except (TypeError, ValueError):
                    raise ApiError(400, "missing_field",
                                   "question_id must be an integer", field="question_id")
                return 200, app.answer(num, qid, body.get("text"),
                                       actor=self.actor_or(body, "user"),
                                       images=posted_images(body))
            if verb == "seen":
                # The read receipt the conversation highlight is derived from.
                # `seq` is what the tab had actually rendered when it looked;
                # omitting it means "everything on the board right now".
                return 200, app.mark_seen(num, body.get("seq"))
            if verb == "action":
                return 200, app.action(num, body.get("action"), body,
                                       actor=self.actor_or(body, "user"),
                                       from_browser=self.from_browser())
            if verb == "verdict":
                return 200, app.verdict(num, body.get("verdict"), body.get("notes") or "",
                                        body.get("scope") or "card",
                                        actor=self.actor_or(body, "user"),
                                        images=posted_images(body))
            if verb == "events":
                kind = body.get("kind")
                payload = body.get("payload")
                if payload is None:
                    payload = {k: v for k, v in body.items()
                               if k not in ("kind", "actor")}
                return 201, app.card_event(num, kind, payload,
                                           actor=self.actor_or(body, "worker"),
                                           long_running=body.get("long_running"))
            if verb == "question":
                return 201, app.ask(num, body.get("text"), body.get("options"),
                                    actor=self.actor_or(body, "worker"),
                                    artifacts=body.get("artifacts"))
            if verb == "ready":
                packet = body.get("packet", body)
                return 200, app.card_ready(num, packet,
                                           actor=self.actor_or(body, "worker"))
            if verb == "state":
                state = body.get("state")
                actor = self.actor_or(body, "worker")
                if state == "ready":
                    raise ApiError(422, "evidence_required",
                                   "ready is only reachable via POST /api/cards/%d/ready"
                                   % num, missing=["packet"])
                # Workers report their own progress. Only the session -- the brain
                # that actually knows an agent died or a sprint gap happened --
                # may declare a card failed or stale.
                allowed = ["triaging", "in_progress", "blocked"]
                if actor == "session":
                    allowed += ["failed", "stale", "queued", "needs_you"]
                if state not in allowed:
                    raise ApiError(400, "bad_state",
                                   "state must be one of %s" % ", ".join(allowed))
                reason = body.get("reason")
                if state in ("blocked", "failed") and \
                        not (isinstance(reason, str) and reason.strip()):
                    raise ApiError(400, "missing_field",
                                   "%s requires a machine-named reason" % state,
                                   field="reason")
                # Optional condensed title: the worker's triage restatement is
                # where a raw first-line title becomes something readable.
                # Validate it BEFORE the transition so a bad title can't leave
                # the card half-moved.
                title = body.get("title")
                if title is not None:
                    clean_title(title)
                card = app.transition(num, state, actor, reason)
                if title is not None:
                    app.set_title(num, title, actor)
                    card = app.card_json(app.card_row(num), brief=True)
                return 200, {"ok": True, "card": card}
            if verb == "integrated":
                return 200, app.integrated(
                    num, body.get("ok"), body.get("reason") or "",
                    body.get("card_nums"),
                    actor=self.actor_or(body, "session"))
            if verb == "assign":
                # worktree/branch are optional on purpose: ops work has neither.
                return 200, app.assign(num, body.get("agent_name"), body.get("worktree"),
                                       body.get("branch"), title=body.get("title"),
                                       model_reason=body.get("model_reason"),
                                       work_kind=body.get("work_kind"),
                                       external_agent=body.get("external_agent"),
                                       executor=body.get("executor"),
                                       model=body.get("model"))
            raise ApiError(404, "no_such_route", "no route for %s" % path)

    return Handler


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 64


def make_server(app: App, host: str, port: int) -> Server:
    handler = make_handler(app)
    return Server((host, port), handler)


# --------------------------------------------------------------------------
# Server lifecycle (CLI)
# --------------------------------------------------------------------------


def paths_for(project_root: str, data_dir: str = None) -> dict:
    data = os.path.realpath(data_dir or os.path.join(project_root, DATA_DIRNAME))
    return {
        "data_dir": data,
        "server_json": os.path.join(data, SERVER_JSON),
        "token": os.path.join(data, TOKEN_FILENAME),
        "port": os.path.join(data, PORT_FILENAME),
        "log": os.path.join(data, SERVER_LOG),
        "db": os.path.join(data, DB_FILENAME),
    }


def read_token_file(path: str):
    """The bearer token, kept OUTSIDE server.json so it survives `stop`.

    server.json is a liveness record and is deleted when the server exits; the
    token is an identity and must not be. Minting a new one on every restart
    logs every open browser out and invalidates the printed URL.
    """
    try:
        with open(path, "r", encoding="utf-8") as fh:
            tok = fh.read().strip()
    except OSError:
        return None
    return tok or None


def write_token_file(path: str, token: str):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(token + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def read_port_file(path: str):
    """Which port this board answers on, kept OUTSIDE server.json — same reason
    the token is.

    `stop` deletes server.json, so before this file existed a restart had no
    memory of the port it had been serving on for weeks and silently fell back
    to the compiled default. Live failure: the russ board had been running on
    8378 for a month; `sprintd start` after a restart tried 8377, found another
    project's board sitting on it, and died with "cannot bind 127.0.0.1:8377".
    The port is in every URL anybody bookmarked — it is identity, not liveness.
    """
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read().strip()
    except OSError:
        return None
    try:
        port = int(raw)
    except (TypeError, ValueError):
        return None
    return port if 1 <= port <= 65535 else None


def write_port_file(path: str, port: int):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("%d\n" % int(port))
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def port_is_free(port: int, host: str = "127.0.0.1") -> bool:
    """Can we actually bind it right now? The only question that matters."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind((host, int(port)))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def port_owner(port: int, timeout: float = 1.5):
    """Whose board is on this port, if it is a board at all.

    Returns the `project_root` of the sprintd answering there, "" if something
    is listening but it is not a sprintd, or None if the port is free.
    """
    if port_is_free(port):
        return None
    try:
        status, raw = http_get("127.0.0.1", int(port), "/healthz", timeout=timeout)
    except OSError:
        return ""
    if status != 200:
        return ""
    try:
        info = json.loads(raw)
    except (TypeError, ValueError):
        return ""
    return info.get("project_root") or ""


def choose_port(preferred: int, project_root: str, explicit: bool = False,
                limit: int = PORT_SCAN_LIMIT, say=None):
    """The port to bind, and the reason, when the preferred one is taken.

    `explicit` (the user typed `--port`) is obeyed literally and fails loudly if
    it cannot be had — that is what asking for a specific port means. Otherwise a
    port held by a DIFFERENT project is not this board's problem to die over: we
    walk up to the next free one and say which, so `sprintd start` in a new
    project never needs `--port` and a restart never needs it either.
    """
    preferred = int(preferred)
    if explicit or port_is_free(preferred):
        return preferred
    owner = port_owner(preferred)
    if owner and os.path.realpath(owner) == os.path.realpath(project_root):
        # Our own board, already up — the caller's health check deals with it.
        return preferred
    for port in range(preferred + 1, preferred + 1 + int(limit)):
        if port_is_free(port):
            if say:
                who = ("another project's board (%s)" % owner) if owner \
                    else "another process"
                say("port %d is held by %s -- using %d instead" % (preferred, who, port))
            return port
    return preferred


def read_server_json(path: str):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def write_server_json(path: str, info: dict):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(info, fh, indent=2, sort_keys=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


# --------------------------------------------------------------------------
# Machine-wide registry (which boards are running on this computer)
# --------------------------------------------------------------------------
#
# One Claude session == one sprint == one project root, and several run at once
# in different tmux windows. The registry is a single JSON file keyed by
# project_root, so a restart of the same board updates its row instead of
# adding a second one. Entries are ADVISORY: the hub health-checks every row
# and never trusts the file about what is alive.


def registry_path(override: str = None) -> str:
    """`--registry` > $SPRINT_REGISTRY > ~/.sprint/registry.json.

    The env override exists so tests (and a second machine-wide hub) can point
    the whole thing at a temp dir and never touch the real ~/.sprint.
    """
    raw = override or os.environ.get("SPRINT_REGISTRY") or os.path.join(
        os.path.expanduser("~"), HUB_DIRNAME, REGISTRY_FILENAME)
    return os.path.abspath(os.path.expanduser(raw))


def hub_dir(registry: str = None) -> str:
    """The hub's own state dir: wherever the registry lives.

    Keeping hub-token/hub.json beside the registry means one override moves
    the entire machine-wide state, so a test hub cannot read or clobber the
    real one's token.
    """
    return os.path.dirname(registry_path(registry))


def hub_token_path(registry: str = None) -> str:
    return os.path.join(hub_dir(registry), HUB_TOKEN_FILENAME)


def hub_json_path(registry: str = None) -> str:
    return os.path.join(hub_dir(registry), HUB_JSON)


class _FileLock:
    """Best-effort cross-process lock so two boards starting at once cannot
    lose each other's registry row. Degrades to a no-op where flock is absent."""

    def __init__(self, path: str):
        self.path = path + ".lock"
        self.fh = None

    def __enter__(self):
        try:
            import fcntl
        except ImportError:
            return self
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            self.fh = open(self.path, "a+")
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX)
        except OSError:
            if self.fh is not None:
                try:
                    self.fh.close()
                except OSError:
                    pass
                self.fh = None
        return self

    def __exit__(self, *exc):
        if self.fh is None:
            return False
        try:
            import fcntl
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
        except (ImportError, OSError):
            pass
        try:
            self.fh.close()
        except OSError:
            pass
        self.fh = None
        return False


def account_limit_path(registry: str = None) -> str:
    """The one file every board on this machine reads to learn that the whole
    account is out. Beside the registry, so a single `--registry`/$SPRINT_REGISTRY
    override moves ALL machine-wide state — a test can never touch the real one."""
    return os.path.join(hub_dir(registry), ACCOUNT_LIMIT_FILENAME)


def read_account_limit(registry: str = None):
    """-> the shared account-limit state, or None.

    Anything unreadable, corrupt or shaped wrong is None: a board must never
    fail to serve because another board's write got interrupted, and "I cannot
    read the file" has to mean "no account limit", never a banner nobody can
    dismiss.
    """
    try:
        with open(account_limit_path(registry), "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    try:
        resets_at = float(data.get("resets_at"))
        declared_at = float(data.get("declared_at"))
    except (TypeError, ValueError):
        return None
    cleared_at = data.get("cleared_at")
    try:
        cleared_at = None if cleared_at is None else float(cleared_at)
    except (TypeError, ValueError):
        cleared_at = None
    return {
        "resets_at": resets_at,
        "declared_at": declared_at,
        "cleared_at": cleared_at,
        "source": data.get("source") or None,
        "note": data.get("note") or None,
        "origin": data.get("origin") if isinstance(data.get("origin"), dict) else None,
    }


def write_account_limit(state: dict, registry: str = None):
    """Atomic whole-file replace (tmp + fsync + rename), 0600 — same shape as
    the registry write, for the same reason: a half-written file here would be
    read by every board on the machine."""
    path = account_limit_path(registry)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp.%d" % os.getpid()
    payload = dict(state)
    payload["version"] = 1
    payload["updated_at"] = now()
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2, sort_keys=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def read_registry(registry: str = None) -> dict:
    """-> {project_root: entry}. A missing or corrupt file is an empty registry;
    the hub must never fail to render because one write got interrupted."""
    path = registry_path(registry)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    sprints = data.get("sprints") if isinstance(data, dict) else None
    if not isinstance(sprints, dict):
        return {}
    return {k: v for k, v in sprints.items() if isinstance(v, dict)}


def write_registry(entries: dict, registry: str = None):
    """Atomic whole-file replace (tmp + fsync + rename), 0600."""
    path = registry_path(registry)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp.%d" % os.getpid()
    payload = {"version": 1, "updated_at": now(), "sprints": entries}
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2, sort_keys=True)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def registry_entry(project_root: str, port: int, host: str, hosts=None,
                   data_dir: str = None, pid: int = None,
                   started_at: float = None, name: str = None) -> dict:
    root = os.path.realpath(project_root)
    return {
        "project_root": root,
        # What this sprint calls itself, if it has been named; the directory
        # name is only the fallback. This is the label the switcher and the hub
        # render, so it follows a rename (see `App.rename_sprint`).
        "name": (name or "").strip() or os.path.basename(root.rstrip("/")) or root,
        "host": host,
        "hosts": list(hosts or [host]),
        "port": int(port),
        "pid": int(pid if pid is not None else os.getpid()),
        "data_dir": data_dir or os.path.join(root, DATA_DIRNAME),
        "started_at": float(started_at if started_at is not None else now()),
        # Deliberately no "ordinal": that number belongs to the registry, which
        # hands one out the first time it sees this project and never again.
        # If a fresh entry carried one, every restart would overwrite the place
        # the board already has (see `registry_register`).
    }


# ---- where a board sits in a numbered list ---------------------------------
#
# Card #57, user verbatim: "the order of sprints should stay the same in the
# list, so I can count on .1 always going to session a, .2 always going to
# session b, etc, and not have to reassess the list each time."
#
# So position is a property of the BOARD, not of how much it currently wants
# your attention. The registry stamps each project with an `ordinal` the first
# time it registers; that number never changes again, restarts included, and a
# board that appears later gets a bigger one. Every numbered listing sorts by
# it, so all of them agree and none of them move under the user's fingers.
# Attention is still shown -- the dot and the counts on each row -- it just
# stopped being allowed to REORDER anything.


def entry_ordinal(entry: dict):
    """The row's place in line, or None for a row written before ordinals."""
    try:
        ordinal = int(entry.get("ordinal"))
    except (TypeError, ValueError):
        return None
    return ordinal if ordinal >= 0 else None


def entry_started_at(entry: dict) -> float:
    """`started_at` as a number, and 0.0 for anything unreadable -- a garbled
    field must never crash the read path that draws the switcher."""
    try:
        return float(entry.get("started_at"))
    except (TypeError, ValueError):
        return 0.0


def next_ordinal(entries: dict) -> int:
    """One past the highest ordinal in the registry: the end of the line.

    Never reuses the number of a board that unregistered. Reuse is how a new
    sprint would silently inherit somebody else's muscle memory.
    """
    seen = [n for n in (entry_ordinal(e) for e in entries.values())
            if n is not None]
    return (max(seen) + 1) if seen else 0


def registry_backfill_ordinals(entries: dict) -> dict:
    """Number any rows that predate ordinals. Mutates and returns `entries`.

    Runs once, inside the register lock. Oldest board first, ties broken on
    project_root, so it is a pure function of the registry's contents: two
    boards doing this one after the other reach the same answer, and the order
    it produces is the same one `registry_order_key` was already reporting for
    un-numbered rows -- nobody gets renumbered by the upgrade itself.
    """
    missing = [k for k, e in entries.items() if entry_ordinal(e) is None]
    if not missing:
        return entries
    missing.sort(key=lambda k: (entry_started_at(entries[k]), k))
    n = next_ordinal(entries)
    for k in missing:
        entries[k] = dict(entries[k], ordinal=n)
        n += 1
    return entries


def registry_order_key(key: str, entry: dict):
    """Sort key for every numbered listing of boards: first-seen order.

    A row with no ordinal yet sorts by when it started, behind everything
    numbered -- exactly where the backfill above is about to put it -- and
    ties break on project_root so two readers can never disagree.
    """
    ordinal = entry_ordinal(entry)
    if ordinal is None:
        return (1, entry_started_at(entry), key)
    return (0, ordinal, key)


def registry_register(entry: dict, registry: str = None) -> dict:
    """Add/replace this project's row. Keyed by project_root, so restarting the
    same board never produces a second row for it.

    The row also earns its `ordinal` here, the first time this project is ever
    seen, and keeps it for good: a restart re-registers the same project_root,
    finds the number already sitting there, and drops back into the same slot
    in the switcher instead of jumping to the end of it.
    """
    path = registry_path(registry)
    with _FileLock(path):
        entries = registry_backfill_ordinals(read_registry(registry))
        key = os.path.realpath(entry["project_root"])
        prev = entries.get(key) or {}
        merged = dict(prev)
        merged.update(entry)               # `entry` carries no ordinal of its own
        merged.pop("last_seen", None)      # a fresh start re-earns its liveness
        if entry_ordinal(merged) is None:
            merged["ordinal"] = next_ordinal(entries)
        entries[key] = merged
        write_registry(entries, registry)
    return entries[key]


def registry_unregister(project_root: str, registry: str = None,
                        pid: int = None) -> bool:
    """Drop this project's row. If `pid` is given, only drop the row when it
    still belongs to that pid -- otherwise a slow shutdown could delete the row
    a NEWER server just wrote for the same project."""
    path = registry_path(registry)
    key = os.path.realpath(project_root)
    with _FileLock(path):
        entries = read_registry(registry)
        row = entries.get(key)
        if row is None:
            return False
        if pid is not None and row.get("pid") not in (None, pid):
            return False
        entries.pop(key, None)
        write_registry(entries, registry)
    return True


def registry_touch(project_root: str, fields: dict, registry: str = None):
    """Merge a few fields into one row (the hub stamping `last_seen`)."""
    path = registry_path(registry)
    key = os.path.realpath(project_root)
    with _FileLock(path):
        entries = read_registry(registry)
        if key not in entries:
            return
        entries[key].update(fields)
        write_registry(entries, registry)


def http_get(host: str, port: int, path: str, token: str = None, timeout: float = 3.0,
             extra_headers: dict = None):
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        headers = {"Accept": "application/json"}
        if token:
            headers["Authorization"] = "Bearer " + token
        if extra_headers:
            headers.update(extra_headers)
        conn.request("GET", path, headers=headers)
        resp = conn.getresponse()
        raw = resp.read()
        return resp.status, raw
    finally:
        try:
            conn.close()
        except Exception:
            pass


def http_send_json(method: str, host: str, port: int, path: str, token: str, obj,
                   timeout: float = 5.0):
    """Send one small JSON document to a board and read the answer back."""
    conn = http.client.HTTPConnection(host, port, timeout=timeout)
    try:
        headers = {"Accept": "application/json",
                   "Content-Type": "application/json",
                   "Idempotency-Key": secrets.token_hex(8)}
        if token:
            headers["Authorization"] = "Bearer " + token
        conn.request(method, path, body=jdump(obj).encode("utf-8"), headers=headers)
        resp = conn.getresponse()
        return resp.status, resp.read()
    finally:
        try:
            conn.close()
        except Exception:
            pass


def http_put_json(host: str, port: int, path: str, token: str, obj,
                  timeout: float = 5.0):
    """PUT one small JSON document. Used by `sprintd start --name` to name a
    board that is ALREADY running: the live process owns the database, so the
    name has to go through it and not around it."""
    return http_send_json("PUT", host, port, path, token, obj, timeout)


def http_post_json(host: str, port: int, path: str, token: str, obj,
                   timeout: float = 5.0):
    """POST one small JSON document. Used by the hub's reviver, which is the
    one thing on this machine that writes to a board it does not own."""
    return http_send_json("POST", host, port, path, token, obj, timeout)


def probe_server(info: dict, timeout: float = 3.0):
    """-> (state, detail). state in: dead | healthy | foreign | wrong_token"""
    if not info:
        return "dead", None
    port = info.get("port") or DEFAULT_PORT
    try:
        status, raw = http_get("127.0.0.1", port, "/healthz", timeout=timeout)
    except (OSError, http.client.HTTPException):
        return "dead", None
    if status != 200:
        return "foreign", None
    health = jload(raw.decode("utf-8", "replace"), {}) or {}
    if os.path.realpath(health.get("project_root") or "") != \
            os.path.realpath(info.get("project_root") or ""):
        return "foreign", health
    try:
        status, _ = http_get("127.0.0.1", port, "/api/board", info.get("token"),
                             timeout=timeout)
    except (OSError, http.client.HTTPException):
        return "dead", health
    if status == 200:
        return "healthy", health
    return "wrong_token", health


def board_url(host: str, port: int, token: str) -> str:
    return "http://%s:%d/?t=%s" % (host, port, urllib.parse.quote(token))


def daemonize(logpath: str) -> int:
    """Double-fork into the background.

    Returns a write fd in the grandchild; the original process blocks until the
    grandchild reports readiness, so `sprintd start` never exits 0 on a server
    that failed to bind.
    """
    import select

    read_fd, write_fd = os.pipe()
    if os.fork() > 0:
        os.close(write_fd)
        buf = b""
        deadline = time.time() + 30.0
        while time.time() < deadline:
            ready, _, _ = select.select([read_fd], [], [], deadline - time.time())
            if not ready:
                break
            chunk = os.read(read_fd, 4096)
            if not chunk:
                break
            buf += chunk
            if b"\n" in buf:
                break
        os.close(read_fd)
        msg = jload(buf.decode("utf-8", "replace").strip(), None)
        if not msg:
            sys.stderr.write("sprintd: background server did not report readiness; "
                             "see %s\n" % logpath)
            os._exit(1)
        if not msg.get("ok"):
            sys.stderr.write("sprintd: %s\n" % msg.get("error", "failed to start"))
            os._exit(1)
        for url in msg.get("urls", []):
            sys.stdout.write(url + "\n")
        sys.stdout.flush()
        os._exit(0)
    os.close(read_fd)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    sys.stdout.flush()
    sys.stderr.flush()
    fd_null = os.open(os.devnull, os.O_RDONLY)
    os.dup2(fd_null, 0)
    os.close(fd_null)
    fd_log = os.open(logpath, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.dup2(fd_log, 1)
    os.dup2(fd_log, 2)
    os.close(fd_log)
    return write_fd


def cmd_start(args) -> int:
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    os.makedirs(p["data_dir"], exist_ok=True)
    info = read_server_json(p["server_json"])

    if info:
        state, health = probe_server(info)
        if state == "healthy":
            # `sprintd start --name "..."` on a board that is already up is a
            # RENAME, not a no-op: the session says what this sprint is about
            # on every boot, and a resumed board must end up wearing the same
            # name a fresh one would.
            live_name = (health or {}).get("sprint_name")
            if getattr(args, "name", None):
                try:
                    st, raw = http_put_json(
                        "127.0.0.1", info.get("port"), "/api/settings",
                        info.get("token"), {"name": args.name})
                    body = jload(raw.decode("utf-8", "replace"), {}) or {}
                    if st == 200:
                        live_name = body.get("name") or args.name
                    else:
                        print("notice: could not name this sprint (%s)"
                              % (body.get("message") or "HTTP %s" % st),
                              file=sys.stderr)
                except (OSError, http.client.HTTPException) as exc:
                    print("notice: could not name this sprint (%s)" % exc,
                          file=sys.stderr)
            # `--agent-name` on a board that is already up is the opposite of a
            # rename: whoever is running this board already introduced
            # themselves, and a session that comes back after a restart keeps
            # the name it had. So it is only sent when nobody has one.
            live_agent = (health or {}).get("agent_name") or ""
            if getattr(args, "agent_name", None):
                if live_agent:
                    if live_agent != " ".join(args.agent_name.split()):
                        print("notice: this session is already called “%s” — "
                              "keeping it (a name does not change on restart)"
                              % live_agent, file=sys.stderr)
                else:
                    try:
                        st, raw = http_put_json(
                            "127.0.0.1", info.get("port"), "/api/settings",
                            info.get("token"), {"agent_name": args.agent_name,
                                                "actor": "session"})
                        body = jload(raw.decode("utf-8", "replace"), {}) or {}
                        if st == 200:
                            live_agent = body.get("agent_name") or args.agent_name
                        else:
                            print("notice: could not set the session's name (%s)"
                                  % (body.get("message") or "HTTP %s" % st),
                                  file=sys.stderr)
                    except (OSError, http.client.HTTPException) as exc:
                        print("notice: could not set the session's name (%s)" % exc,
                              file=sys.stderr)
            # `--tmux-window` on a board that is already up is the OPPOSITE of
            # `--agent-name`: last write wins. The window is where this session
            # can be woken right now, and a resumed session in a new window
            # must be able to correct it or the hub types into the old one.
            if getattr(args, "tmux_window", None) is not None:
                try:
                    st, raw = http_put_json(
                        "127.0.0.1", info.get("port"), "/api/settings",
                        info.get("token"),
                        {"session_tmux_window": args.tmux_window,
                         "actor": "session"})
                    body = jload(raw.decode("utf-8", "replace"), {}) or {}
                    if st != 200:
                        print("notice: could not register the session's tmux "
                              "window (%s)" % (body.get("message") or "HTTP %s" % st),
                              file=sys.stderr)
                except (OSError, http.client.HTTPException) as exc:
                    print("notice: could not register the session's tmux window "
                          "(%s)" % exc, file=sys.stderr)
            # Idempotent reuse -- and re-assert the registry row, so a board
            # that was already up before the hub existed still shows up on it.
            try:
                registry_register(registry_entry(
                    project_root, info.get("port"), info.get("host") or "127.0.0.1",
                    hosts=info.get("hosts"), data_dir=info.get("data_dir") or p["data_dir"],
                    pid=info.get("pid"), started_at=info.get("started_at"),
                    name=live_name),
                    getattr(args, "registry", None))
            except OSError:
                pass
            print("sprintd already running (pid %s) -> %s"
                  % (info.get("pid"), board_url(info.get("host") or "127.0.0.1",
                                                info.get("port"), info["token"])))
            return 0
        if state == "wrong_token":
            print("error: something is listening on port %s for this project but the token "
                  "in %s does not match. Run: sprintd stop" % (info.get("port"), p["server_json"]),
                  file=sys.stderr)
            return 1
        if state == "foreign":
            print("error: port %s is held by another process (not this project's sprintd). "
                  "Free it or start with --port." % info.get("port"), file=sys.stderr)
            return 1
        pid = info.get("pid")
        if isinstance(pid, int) and pid_is_sprintd(pid) and pid != os.getpid():
            print("warning: stale sprintd pid %s is alive but not serving; killing it" % pid,
                  file=sys.stderr)
            try:
                os.kill(pid, signal.SIGTERM)
                time.sleep(0.5)
            except OSError:
                pass
        # stale pidfile (power loss / PID recycling): clean up and continue
        try:
            os.remove(p["server_json"])
        except OSError:
            pass

    # Which port do we WANT? In order: what was asked for, what this data dir
    # was last serving on (server.json while it lives, the port file after it is
    # gone), then the compiled default. A restart must never need `--port`.
    preferred = (args.port if args.port is not None
                 else ((info or {}).get("port")
                       or read_port_file(p["port"])
                       or DEFAULT_PORT))
    # ...and if we cannot have it because a DIFFERENT project is sitting there,
    # take the next free one rather than refusing to start. Only an explicit
    # --port is worth dying for.
    port = choose_port(preferred, project_root, explicit=args.port is not None,
                       say=lambda msg: print("notice: " + msg, file=sys.stderr))
    # Token identity survives stop/start: the printed URL keeps working and every
    # logged-in browser stays logged in. --new-token is the explicit rotate.
    if args.token:
        token = args.token                       # an explicit value always wins
    elif args.new_token:
        token = secrets.token_urlsafe(24)        # deliberate rotation
    else:
        token = ((info or {}).get("token")
                 or read_token_file(p["token"]) or secrets.token_urlsafe(24))

    ts_ip = "" if args.no_tailscale else tailscale_ip()
    if not ts_ip:
        print("NOTICE: no tailscale IPv4 address found -- binding 127.0.0.1 ONLY. "
              "The board will not be reachable from your phone/tablet until tailscale is up. "
              "(never binding 0.0.0.0 or a LAN interface)", file=sys.stderr)

    ready_fd = None
    if not args.foreground:
        ready_fd = daemonize(p["log"])

    def report(ok: bool, **kw):
        if ready_fd is None:
            return
        try:
            os.write(ready_fd, (jdump(dict(ok=ok, **kw)) + "\n").encode("utf-8"))
            os.close(ready_fd)
        except OSError:
            pass

    logfh = open(p["log"], "a", encoding="utf-8")
    app = App(project_root, data_dir=p["data_dir"], token=token, log=logfh,
              silence_seconds=args.silence_seconds)

    # Loopback is mandatory; the tailnet address is best-effort so a flapping
    # tailscale can never keep the board down on this machine.
    servers, hosts = [], []
    try:
        loop = make_server(app, "127.0.0.1", port)
    except OSError as exc:
        msg = "cannot bind 127.0.0.1:%s (%s)" % (port, exc)
        app.log(msg)
        report(False, error=msg)
        print("error: " + msg, file=sys.stderr)
        app.close()
        return 1
    servers.append(loop)
    hosts.append("127.0.0.1")
    actual_port = loop.server_address[1]
    if ts_ip:
        try:
            servers.insert(0, make_server(app, ts_ip, actual_port))
            hosts.insert(0, ts_ip)
        except OSError as exc:
            app.log("could not bind tailnet ip %s:%s (%s) -- loopback only"
                    % (ts_ip, actual_port, exc))

    # Where we actually ended up listening, so `/api/siblings` can put this
    # board in its own list with a working signed URL.
    app.registry = getattr(args, "registry", None)
    app.port = actual_port
    app.hosts = list(hosts)

    app.open_sprint(create=True)
    # Boards opened before sprints were named after their project are all
    # sitting under the literal "sprint"; give them the project's name once.
    app.name_untitled_sprint()
    # `--name` is how a session names its sprint at launch (card #63). It wins
    # over both the stored title and the directory-name default.
    if getattr(args, "name", None):
        try:
            app.rename_sprint(args.name, actor="session")
        except ApiError as exc:
            print("error: %s" % exc.message, file=sys.stderr)
            report(False, error=exc.message)
            app.close()
            return 1
    # `--agent-name` is how the session introduces ITSELF (card #63). First
    # write wins: a board whose session already has a name keeps it, so a
    # restart is the same colleague coming back rather than a new hire.
    if getattr(args, "agent_name", None):
        try:
            claim = app.claim_agent_name(args.agent_name, actor="session")
            if not claim["claimed"] and claim["agent_name"] != claim["wanted"]:
                print("notice: this session is already called “%s” — keeping it "
                      "(a name does not change on restart)" % claim["agent_name"],
                      file=sys.stderr)
        except ApiError as exc:
            print("error: %s" % exc.message, file=sys.stderr)
            report(False, error=exc.message)
            app.close()
            return 1
    # `--tmux-window` is how the session registers its wake channel at boot
    # (card #68). Last write wins: an address, not an identity.
    if getattr(args, "tmux_window", None) is not None:
        try:
            app.claim_tmux_window(args.tmux_window, actor="session")
        except ApiError as exc:
            print("error: %s" % exc.message, file=sys.stderr)
            report(False, error=exc.message)
            app.close()
            return 1
    # Everything the board needs to replace itself when its code changes
    # (card #62). `--foreground` is added because this process is ALREADY the
    # daemon: exec keeps the pid, the log fds and the launchd job, and
    # daemonizing a second time would throw all three away. `--name` is dropped
    # because it is a LAUNCH act: the name is in the database by now, and
    # replaying the flag would undo a rename the user made since.
    # `--agent-name` goes with it, for the stronger version of the same reason:
    # the session's name is in config.json by now, and it must survive a
    # restart untouched.
    exec_argv = [sys.executable, app.code_path] + strip_flag(
        strip_flag(sys.argv[1:], "--name"), "--agent-name")
    if "--foreground" not in exec_argv:
        exec_argv.append("--foreground")
    app.restart_argv = exec_argv

    def start_serving():
        spawned = []
        for srv in servers:
            t = threading.Thread(target=srv.serve_forever,
                                 kwargs={"poll_interval": 0.2}, daemon=True)
            t.start()
            spawned.append(t)
        return spawned

    app.servers = servers
    app.resume_serving = start_serving
    app.watch_code = True
    app.start_background()
    write_server_json(p["server_json"], {
        "pid": os.getpid(), "port": actual_port, "host": hosts[0],
        "hosts": hosts, "token": token, "project_root": project_root,
        "started_at": app.started_at, "data_dir": p["data_dir"],
    })
    try:
        write_token_file(p["token"], token)
    except OSError as exc:
        app.log("could not persist token file %s (%s) -- the token will not "
                "survive a stop/start" % (p["token"], exc))
    # The port outlives server.json for the same reason the token does: it is
    # in every URL anyone saved, and a restart that forgets it is a restart that
    # moves the board.
    try:
        write_port_file(p["port"], actual_port)
    except OSError as exc:
        app.log("could not persist port file %s (%s) -- a restart may not reuse "
                "port %d" % (p["port"], exc, actual_port))
    # Announce this board machine-wide so `sprintd hub` can list it. Advisory
    # only: the hub health-checks every row and never trusts this file.
    try:
        registry_register(registry_entry(
            project_root, actual_port, hosts[0], hosts=hosts,
            data_dir=p["data_dir"], started_at=app.started_at,
            name=app.sprint_name()),
            getattr(args, "registry", None))
    except OSError as exc:
        app.log("could not write the sprint registry (%s) -- this board will "
                "not appear on the hub page" % exc)

    urls = [board_url(h, actual_port, token) for h in hosts]
    app.log("listening on %s (project %s)" % (
        ", ".join("%s:%d" % (h, actual_port) for h in hosts), project_root))
    report(True, urls=urls, pid=os.getpid(), port=actual_port)
    if ready_fd is None:
        for u in urls:
            print(u)
        sys.stdout.flush()

    stop = threading.Event()

    def handle_sig(_signo, _frame):
        stop.set()

    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, handle_sig)
        except (ValueError, OSError):
            pass

    threads = start_serving()
    try:
        while not stop.is_set():
            stop.wait(0.5)
    finally:
        for s in servers:
            s.shutdown()
            s.server_close()
        app.close()
        try:
            cur = read_server_json(p["server_json"])
            if cur and cur.get("pid") == os.getpid():
                os.remove(p["server_json"])
        except OSError:
            pass
        try:
            registry_unregister(project_root, getattr(args, "registry", None),
                                pid=os.getpid())
        except OSError:
            pass
        try:
            logfh.close()
        except OSError:
            pass
    return 0


def cmd_stop(args) -> int:
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    info = read_server_json(p["server_json"])
    reg = getattr(args, "registry", None)
    if not info:
        print("sprintd is not running (no %s)" % p["server_json"])
        try:
            registry_unregister(project_root, reg)
        except OSError:
            pass
        return 0
    pid = info.get("pid")
    if not isinstance(pid, int) or not pid_is_sprintd(pid):
        print("stale server.json (pid %s is gone or recycled); cleaning up" % pid)
        try:
            os.remove(p["server_json"])
        except OSError:
            pass
        try:
            registry_unregister(project_root, reg)
        except OSError:
            pass
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as exc:
        print("error: could not signal pid %s: %s" % (pid, exc), file=sys.stderr)
        return 1
    for _ in range(60):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    if pid_alive(pid):
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    try:
        os.remove(p["server_json"])
    except OSError:
        pass
    # The server unregisters itself on a clean SIGTERM; do it again here so a
    # SIGKILLed board still leaves the hub's registry honest.
    try:
        registry_unregister(project_root, reg, pid=pid)
    except OSError:
        pass
    print("stopped sprintd (pid %s)" % pid)
    return 0


def cmd_status(args) -> int:
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    info = read_server_json(p["server_json"])
    state, _health = probe_server(info) if info else ("dead", None)
    out = {"running": state == "healthy", "state": state,
           "project_root": project_root, "data_dir": p["data_dir"]}
    if info:
        out.update({"pid": info.get("pid"), "port": info.get("port"),
                    "host": info.get("host"), "hosts": info.get("hosts"),
                    "started_at": info.get("started_at")})
        if state == "healthy":
            out["url"] = board_url(info.get("host") or "127.0.0.1", info["port"],
                                   info["token"])
            try:
                status, raw = http_get("127.0.0.1", info["port"], "/api/board",
                                       info.get("token"))
                if status == 200:
                    board = jload(raw.decode("utf-8", "replace"), {}) or {}
                    out["seq"] = board.get("seq")
                    out["session"] = board.get("session")
                    out["counts"] = board.get("counts")
            except (OSError, http.client.HTTPException):
                pass
    if args.json:
        print(jdump(out))
    else:
        if state == "healthy":
            print("running  pid=%s  %s" % (out.get("pid"), out.get("url")))
            if out.get("session"):
                sess = out["session"]
                line = "session: %s (cursor %s of %s" % (
                    sess.get("status"), sess.get("cursor"), sess.get("head"))
                since = sess.get("seconds_since_waiter")
                line += ", waiter %s)" % (
                    "never seen" if since is None else "seen %ss ago" % since)
                print(line)
        else:
            print("not running (%s)" % state)
    return 0 if state == "healthy" else 1


def cmd_wait(args) -> int:
    """exit 0 = events waiting, 2 = timeout, 3 = server unreachable."""
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    info = read_server_json(p["server_json"])
    if not info:
        print("sprintd is not running (no %s)" % p["server_json"], file=sys.stderr)
        return 3
    port = args.port or info.get("port") or DEFAULT_PORT
    token = args.token or info.get("token")
    after = args.after
    deadline = now() + float(args.timeout)
    poll = max(0.05, float(args.poll))
    while True:
        try:
            status, raw = http_get("127.0.0.1", port,
                                   "/api/events?after=%d&limit=1" % after, token,
                                   timeout=5.0,
                                   # every poll is a heartbeat: this is the
                                   # session sitting here waiting for work
                                   extra_headers={WAITER_HEADER: "sprintd-wait"})
        except (OSError, http.client.HTTPException) as exc:
            print("sprintd unreachable on 127.0.0.1:%s (%s)" % (port, exc), file=sys.stderr)
            return 3
        if status == 401:
            print("sprintd rejected the token", file=sys.stderr)
            return 3
        if status != 200:
            print("sprintd returned HTTP %s" % status, file=sys.stderr)
            return 3
        data = jload(raw.decode("utf-8", "replace"), {}) or {}
        events = data.get("events") or []
        if events:
            print(jdump({"after": after, "next": data.get("next"),
                         "head": data.get("head"), "count": len(events)}))
            return 0
        remaining = deadline - now()
        if remaining <= 0:
            print(jdump({"after": after, "head": data.get("head"), "timeout": True}))
            return 2
        time.sleep(min(poll, remaining))


def tail_line(ev: dict, limit: int = TAIL_TEXT_MAX) -> dict:
    """One event -> the one compact line a monitor reads.

    Fixed key set, fixed order, every key always present: whatever is
    watching this stream should be able to read a field without first
    checking whether it exists. `reply_to` is the whole point of the line
    for the session -- present means a human said this and is waiting.
    """
    payload = ev.get("payload")
    if not isinstance(payload, dict):
        payload = {}
    reply_to = payload.get("reply_to")
    return {
        "seq": ev.get("seq"),
        "card": ev.get("card_num"),
        "actor": ev.get("actor"),
        "kind": ev.get("kind"),
        "reply_to": reply_to if isinstance(reply_to, str) else None,
        "text": one_line(payload.get("text") or "", limit),
    }


def sse_frames(resp):
    """Yield (event_name_or_None, data_text) per SSE frame off a live response.

    Comments (`: heartbeat`), `retry:` and `id:` lines are structure, not
    content -- they are consumed and never yielded, because waking a monitor
    on a heartbeat is exactly what this command exists to avoid.
    """
    name, data = None, []
    while True:
        try:
            raw = resp.fp.readline()
        except (AttributeError, ValueError):
            return
        if not raw:
            return
        line = raw.decode("utf-8", "replace").rstrip("\r\n")
        if line == "":
            if data:
                yield name, "\n".join(data)
            name, data = None, []
            continue
        if line.startswith(":"):
            continue
        field, _, value = line.partition(":")
        value = value[1:] if value.startswith(" ") else value
        if field == "event":
            name = value.strip()
        elif field == "data":
            data.append(value)


def cmd_tail(args) -> int:
    """Follow the board's event log, one compact JSON line per event.

    This is the session's quiet ingress: it lives under a streaming monitor,
    so it must wake that monitor exactly once per real event and never for
    anything else -- no heartbeats, no cursor moves, no reconnect chatter.
    It never exits on its own; a server that is gone is a thing to report
    once and keep retrying, not a reason to die.
    """
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    after = max(0, int(args.after or 0))
    user_only = bool(args.user_only)
    # The session's own posts come back down its own ingress and wake it for
    # nothing -- it is being told what it just said. Dropped by DEFAULT for the
    # same reason heartbeats and cursor frames are: a wakeup should mean
    # somebody else moved. `--include-self` is the way back to the raw log.
    include_self = bool(getattr(args, "include_self", False))
    unreachable_after = float(args.unreachable_after)
    read_timeout = float(args.read_timeout)

    generation = None
    port = args.port
    token = args.token
    down_since = None
    said_unreachable = False
    backoff = TAIL_BACKOFF_MIN

    def emit(obj):
        sys.stdout.write(jdump(obj) + "\n")
        sys.stdout.flush()

    while True:
        info = read_server_json(p["server_json"]) or {}
        # Last known port/token wins over the built-in default: mid-restart
        # there is no server.json, and guessing DEFAULT_PORT there would
        # attach us to whatever else happens to own 8377.
        port = args.port or info.get("port") or port or DEFAULT_PORT
        token = args.token or info.get("token") or token
        conn = None
        try:
            conn = http.client.HTTPConnection("127.0.0.1", port,
                                              timeout=read_timeout)
            headers = {"Accept": "text/event-stream",
                       # the session is listening here; this stream is its
                       # proof of life exactly as the waiter's polling is
                       WAITER_HEADER: "sprintd-tail"}
            if token:
                headers["Authorization"] = "Bearer " + token
            conn.request("GET", "/api/stream?after=%d" % after, headers=headers)
            resp = conn.getresponse()
            if resp.status != 200:
                raise ConnectionError("HTTP %s" % resp.status)
            down_since = None
            said_unreachable = False
            backoff = TAIL_BACKOFF_MIN
            for name, data in sse_frames(resp):
                obj = jload(data, None)
                if not isinstance(obj, dict):
                    continue
                if name in ("hello", "cursor"):
                    gen = obj.get("generation")
                    if gen:
                        if generation is not None and gen != generation:
                            # A different process is answering on this port:
                            # whatever is watching needs to know its backend
                            # restarted, and this is the only frame that says so.
                            emit({"restart": True, "generation": gen,
                                  "after": after, "head": obj.get("head")})
                        generation = gen
                    continue
                if name:
                    continue          # some future named frame; not an event
                seq = obj.get("seq")
                if not isinstance(seq, int):
                    continue
                if seq <= after:
                    continue          # resume overlap: at-least-once on the
                                      # wire, exactly once on stdout
                after = seq
                if user_only and obj.get("actor") != "user":
                    continue
                if not include_self and obj.get("actor") == "session":
                    continue          # the session's own echo; it already knows
                emit(tail_line(obj))
        except (OSError, http.client.HTTPException, ValueError):
            pass
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    pass
        if down_since is None:
            down_since = now()
        if not said_unreachable and now() - down_since >= unreachable_after:
            emit({"error": "unreachable"})
            said_unreachable = True
        time.sleep(backoff)
        backoff = min(TAIL_BACKOFF_MAX, backoff * 2)


def cmd_doctor(args) -> int:
    project_root = os.path.realpath(args.project_root or find_project_root())
    p = paths_for(project_root, args.data_dir)
    problems = 0

    def ok(msg):
        print("ok    %s" % msg)

    def bad(msg):
        nonlocal problems
        problems += 1
        print("FIX   %s" % msg)

    def note(msg):
        print("note  %s" % msg)

    if sys.version_info >= (3, 9):
        ok("python %d.%d.%d" % sys.version_info[:3])
    else:
        bad("python is %d.%d -- sprintd needs 3.9+. Install a newer python3."
            % sys.version_info[:2])

    if shutil.which("git"):
        ok("git found")
    else:
        bad("git not found on PATH -- worktree dispatch will fail. Install git.")

    ip = tailscale_ip()
    if ip:
        ok("tailscale ip %s" % ip)
    else:
        note("no tailscale IPv4 -- the board will bind 127.0.0.1 only "
             "(reachable on this Mac, not from your phone). Start tailscale to fix.")

    try:
        os.makedirs(p["data_dir"], exist_ok=True)
        probe = os.path.join(p["data_dir"], ".writeprobe")
        with open(probe, "w", encoding="utf-8") as fh:
            fh.write("ok")
        os.remove(probe)
        ok("data dir writable: %s" % p["data_dir"])
    except OSError as exc:
        bad("cannot write %s (%s) -- fix permissions." % (p["data_dir"], exc))

    git_dir = os.path.join(project_root, ".git")
    if os.path.isdir(git_dir):
        exclude = os.path.join(git_dir, "info", "exclude")
        try:
            os.makedirs(os.path.dirname(exclude), exist_ok=True)
            existing = ""
            if os.path.isfile(exclude):
                with open(exclude, "r", encoding="utf-8") as fh:
                    existing = fh.read()
            if not re.search(r"^\.sprint/?\s*$", existing, re.M):
                with open(exclude, "a", encoding="utf-8") as fh:
                    if existing and not existing.endswith("\n"):
                        fh.write("\n")
                    fh.write(".sprint/\n")
                ok("added .sprint/ to .git/info/exclude")
            else:
                ok(".sprint/ already in .git/info/exclude")
        except OSError as exc:
            bad("could not update .git/info/exclude (%s)" % exc)
    elif os.path.isfile(git_dir):
        note("%s is a worktree/submodule gitfile -- skipping info/exclude" % git_dir)
    else:
        note("%s is not a git repo -- nothing to exclude" % project_root)

    info = read_server_json(p["server_json"])
    if info:
        state, _ = probe_server(info)
        if state == "healthy":
            ok("server running: %s" % board_url(info.get("host") or "127.0.0.1",
                                                info["port"], info["token"]))
        elif state == "dead":
            note("stale %s (server not responding) -- `sprintd start` will clean it up"
                 % p["server_json"])
        else:
            bad("port %s is %s -- run `sprintd stop`" % (info.get("port"), state))
    else:
        note("server not started yet -- run `sprintd start`")

    registered = read_registry(args.registry)
    hinfo = read_server_json(hub_json_path(args.registry))
    if hinfo and probe_hub(hinfo, registry_path(args.registry)) == "healthy":
        ok("hub running (%d board%s registered): %s"
           % (len(registered), "" if len(registered) == 1 else "s",
              hub_url(hinfo.get("host") or "127.0.0.1", hinfo["port"], hinfo["token"])))
    else:
        note("hub not running -- `sprintd hub` serves one page listing every "
             "sprint on this machine (%d registered right now)" % len(registered))

    if args.install_launchd:
        rc = install_launchd(project_root, p, args)
        problems += rc
    return 1 if problems else 0


def install_launchd(project_root: str, p: dict, args) -> int:
    if sys.platform != "darwin":
        print("note  --install-launchd is macOS only; skipping on %s" % sys.platform)
        return 0
    digest = hashlib.sha256(project_root.encode("utf-8")).hexdigest()[:12]
    label = "com.sprint.%s" % digest
    agents = os.path.expanduser("~/Library/LaunchAgents")
    plist_path = os.path.join(agents, "%s.plist" % label)
    script = os.path.realpath(__file__)
    argv = [sys.executable, script, "start", "--foreground",
            "--project-root", project_root]
    if args.port:
        argv += ["--port", str(args.port)]

    def xml_escape(s):
        return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))

    args_xml = "\n".join("      <string>%s</string>" % xml_escape(a) for a in argv)
    plist = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key><string>%s</string>
    <key>ProgramArguments</key>
    <array>
%s
    </array>
    <key>WorkingDirectory</key><string>%s</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>%s</string>
    <key>StandardErrorPath</key><string>%s</string>
  </dict>
</plist>
""" % (label, args_xml, xml_escape(project_root), xml_escape(p["log"]),
       xml_escape(p["log"]))
    try:
        os.makedirs(agents, exist_ok=True)
        with open(plist_path, "w", encoding="utf-8") as fh:
            fh.write(plist)
    except OSError as exc:
        print("FIX   could not write %s (%s)" % (plist_path, exc))
        return 1
    print("ok    wrote %s (KeepAlive)" % plist_path)
    uid = os.getuid()
    loaded = False
    try:
        r = subprocess.run(["launchctl", "bootstrap", "gui/%d" % uid, plist_path],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
        loaded = r.returncode == 0
        if not loaded:
            r = subprocess.run(["launchctl", "load", "-w", plist_path],
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
            loaded = r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        loaded = False
    if loaded:
        print("ok    launchd job %s loaded (survives reboots/power loss)" % label)
    else:
        print("note  load it yourself: launchctl bootstrap gui/%d %s" % (uid, plist_path))
    return 0


# --------------------------------------------------------------------------
# Hub: one landing page for every sprint running on this machine
# --------------------------------------------------------------------------


def board_token_for(entry: dict):
    """The board's own bearer token, read off disk.

    Same user, same machine, mode-0600 files -- the hub is effectively a
    keyring, which is exactly why the hub page itself is token-guarded.
    """
    data_dir = entry.get("data_dir") or os.path.join(
        entry.get("project_root") or "", DATA_DIRNAME)
    tok = read_token_file(os.path.join(data_dir, TOKEN_FILENAME))
    if tok:
        return tok
    info = read_server_json(os.path.join(data_dir, SERVER_JSON)) or {}
    return info.get("token")


def board_rollup(board: dict) -> dict:
    """Reduce one `/api/board` payload to the numbers a listing row shows.

    Shared by the hub (which fetches that payload over HTTP from every
    registered board) and by a board's own `/api/siblings` (which rolls ITSELF
    up straight from `app.board()`, no round trip). One counter, two callers:
    the dropdown and the hub can never drift apart on what "2 need you" means.
    """
    cards = board.get("cards") or []
    column_of = board.get("column_of") or COLUMN_OF
    ts = now()
    counts = {}
    last_at, last_text, stuck_at, stuck_card = None, None, None, None
    for c in cards:
        col = column_of.get(c.get("state"), "queued")
        counts[col] = counts.get(col, 0) + 1
        at = c.get("last_activity_at")
        if isinstance(at, (int, float)) and (last_at is None or at > last_at):
            last_at = at
            ev = c.get("last_event") or {}
            text = (ev.get("payload") or {}).get("text") or ev.get("kind") or ""
            last_text = "#%s %s" % (c.get("num"), one_line(str(text), 70)) if text \
                else "#%s" % c.get("num")
        if col == "needs_you":
            q = c.get("question") or c.get("open_question") or {}
            asked = q.get("created_at") or c.get("state_since") or c.get("updated_at")
            if isinstance(asked, (int, float)) and (stuck_at is None or asked < stuck_at):
                stuck_at, stuck_card = asked, c.get("num")
    sprint = board.get("sprint") or {}
    return {
        "needs_you": counts.get("needs_you", 0),
        "ready": counts.get("ready", 0),
        # Session lines in that board's manager channel that nobody opened.
        # A board older than this field simply reports none, which is the
        # honest degrade: no claim rather than a wrong one.
        "chat_unread": int(board.get("chat_unread") or 0),
        "in_motion": counts.get("in_progress", 0),
        "queued": counts.get("queued", 0) + counts.get("held", 0),
        "blocked": counts.get("blocked", 0),
        "done": counts.get("done", 0),
        "total": len(cards),
        "session": (board.get("session") or {}).get("status"),
        "sprint_title": sprint.get("title"),
        "last_activity_at": last_at,
        "last_activity": last_text,
        "stuck_seconds": None if stuck_at is None else max(0.0, ts - stuck_at),
        "stuck_card": stuck_card,
    }


def hub_summarize(entry: dict, timeout: float = 2.5) -> dict:
    """Poll one registered board and reduce it to a row on the landing page.

    Never raises: an unreachable board is a greyed row, not a broken hub.
    """
    root = entry.get("project_root") or ""
    port = int(entry.get("port") or 0)
    hosts = entry.get("hosts") or [entry.get("host") or "127.0.0.1"]
    row = {
        "project_root": root,
        "name": entry.get("name") or os.path.basename(root.rstrip("/")) or root,
        "port": port,
        "host": hosts[0],
        "pid": entry.get("pid"),
        "started_at": entry.get("started_at"),
        "last_seen": entry.get("last_seen") or entry.get("started_at"),
        "pid_alive": bool(isinstance(entry.get("pid"), int)
                          and pid_alive(entry["pid"])),
        "reachable": False,
        "status": "unreachable",
        "needs_you": 0, "ready": 0, "in_motion": 0, "queued": 0, "blocked": 0,
        "done": 0, "total": 0,
        "session": None,
        "sprint_title": None,
        "last_activity_at": None,
        "last_activity": None,
        "stuck_seconds": None,
        "stuck_card": None,
        # Dead-session autoheal, straight off that board's own `/api/board`.
        # None means the board is answering older code and simply has no
        # opinion -- which the reviver reads as "do nothing", never as "dead".
        "autoheal": None,
        "url": None,
        "detail": None,
    }
    if not port:
        row["detail"] = "no port recorded"
        return row
    try:
        status, raw = http_get("127.0.0.1", port, "/healthz", timeout=timeout)
    except (OSError, http.client.HTTPException):
        return row
    if status != 200:
        row["detail"] = "port answered HTTP %s" % status
        return row
    health = jload(raw.decode("utf-8", "replace"), {}) or {}
    if health.get("hub"):
        row["detail"] = "that port is the hub itself"
        return row
    if os.path.realpath(health.get("project_root") or "") != os.path.realpath(root or "/"):
        # Something else grabbed the port after this board died.
        row["detail"] = "port taken by another project"
        return row

    token = board_token_for(entry)
    if not token:
        row.update(status="no_token",
                   detail="no token on disk for this project (.sprint/token)")
        return row
    try:
        status, raw = http_get("127.0.0.1", port, "/api/board", token, timeout=timeout)
    except (OSError, http.client.HTTPException):
        return row
    if status == 401:
        row.update(status="unauthorized", detail="the stored token was rejected")
        return row
    if status != 200:
        row["detail"] = "board returned HTTP %s" % status
        return row
    board = jload(raw.decode("utf-8", "replace"), {}) or {}
    row.update(board_rollup(board))
    auto = board.get("autoheal")
    row["autoheal"] = auto if isinstance(auto, dict) else None
    # A live board is the authority on its own name; the registry row is what we
    # fall back to when it is not answering. Without this, a sprint renamed on
    # one board would keep its old label on the hub until the registry caught up.
    live_name = (board.get("name") or (board.get("sprint") or {}).get("title") or "").strip()
    if live_name:
        row["name"] = live_name
    row.update({
        "reachable": True,
        "status": "live",
        "last_seen": now(),
        "url": board_url(hosts[0], port, token),
        "detail": None,
    })
    return row


def hub_sort_key(row: dict):
    """Anything waiting on the user floats to the top, longest wait first;
    unreachable boards sink to the bottom but never disappear."""
    if not row.get("reachable"):
        tier = 2
    elif row.get("needs_you"):
        tier = 0
    else:
        tier = 1
    return (tier, -(row.get("stuck_seconds") or 0), -(row.get("needs_you") or 0),
            (row.get("name") or "").lower())


# --------------------------------------------------------------------------
# Siblings: the other sprints on this machine, seen from INSIDE one board
# --------------------------------------------------------------------------
#
# The hub answers "what is running on this computer" from its own process, on
# its own port. `/api/siblings` answers the same question from inside a board,
# so the board's title can become a switcher without the user going out to the
# hub and back. Same registry, same health checks, same `board_rollup` counts --
# only the shape of the row is smaller, because a dropdown needs a name, a
# link and two numbers, not a whole landing page.
#
# Self is always in the list (flagged `self: true`) so the menu renders the
# full set with the current board marked, and rolled up straight from
# `app.board()` rather than by asking ourselves over HTTP.
#
# The one place the two lists differ is ORDER. The hub sorts by what is waiting
# on you (`hub_sort_key`): it is a landing page you arrive at cold, you read it
# top to bottom, and nothing on it is keyed to a number. The switcher does not:
# its rows are numbered, `.` then `2` is supposed to be a reflex, and a list
# that re-sorts itself between two glances makes that reflex a coin flip. So it
# renders in registry order and never moves (`registry_order_key`).

DEFAULT_SIBLINGS_TTL = 10.0     # server-side cache; the browser polls every 30s


def sibling_row(row: dict, is_self: bool = False) -> dict:
    """One hub row, narrowed to what a title dropdown actually renders."""
    return {
        "name": row.get("name"),
        "project_root": row.get("project_root"),
        "port": row.get("port"),
        "url": row.get("url"),
        "self": bool(is_self),
        "alive": bool(row.get("reachable")),
        "needs_you": int(row.get("needs_you") or 0),
        "ready": int(row.get("ready") or 0),
        # The switcher's square is gold for needs_you OR an unread session
        # line, green for ready, and split when both -- so the row carries
        # both halves and the tab decides how to draw them.
        "chat_unread": int(row.get("chat_unread") or 0),
        "in_motion": int(row.get("in_motion") or 0),
        "blocked": int(row.get("blocked") or 0),
        "queued": int(row.get("queued") or 0),
        "session": row.get("session"),
        "sprint_title": row.get("sprint_title"),
        "stuck_seconds": row.get("stuck_seconds"),
    }


def siblings_snapshot(app, registry: str = None, timeout: float = 1.5) -> dict:
    """Every LIVE board on this machine, including this one, in a STABLE order.

    Registry order -- when each board was first seen -- and nothing else. The
    numbers beside these rows are meant to become muscle memory, so what "2"
    points at has to be what it pointed at last time you looked. Nothing here
    re-sorts by who is waiting on you: attention is still on every row, in the
    dot and the counts beside it, it just no longer MOVES anybody.

    That holds for this board's own row too, which sits in its registry place
    rather than floating to the top. Otherwise "2" would mean a different
    sprint depending on which board you happened to be looking at, and the
    whole point is that it doesn't. The row is still marked `self`, and the
    menu still says "here" next to it.

    Dead/unreachable rows are dropped rather than greyed, and the survivors
    close the gap. Unlike the hub, whose job is to tell you a board died, this
    list exists to be clicked: a row you cannot navigate to is noise, and a
    number that goes nowhere is worse than one that shifted. The survivors keep
    their order among themselves, and a board that comes back gets its old
    place back, because the ordinal is stamped on the project and not on the
    run. The port-recycling guard is the hub's (`/healthz` + `project_root`
    match), so a registry row whose port was taken by some other project never
    shows up wearing that project's name.
    """
    self_root = os.path.realpath(app.project_root)
    ranked, saw_self = [], False
    for key, entry in read_registry(registry).items():
        entry = dict(entry)
        entry.setdefault("project_root", key)
        order = registry_order_key(key, entry)
        if os.path.realpath(entry.get("project_root") or key) == self_root:
            ranked.append((order, self_sibling_row(app, entry)))
            saw_self = True
            continue
        row = hub_summarize(entry, timeout=timeout)
        if not row.get("reachable"):
            continue
        ranked.append((order, sibling_row(row)))
    if not saw_self:
        # No registry row for us (the registry write failed, or this board
        # started before the registry existed). We are demonstrably alive --
        # we are answering this request -- so we list ourselves anyway, and at
        # the very end: a board with no number of its own must never land in
        # the middle and push everyone else's number along.
        ranked.append(((2, 0.0, self_root), self_sibling_row(app, None)))
    ranked.sort(key=lambda pair: pair[0])
    rows = [row for _, row in ranked]
    others = [r for r in rows if not r["self"]]
    return {
        "sprints": rows,
        "count": len(rows),
        # What the title's square reads, and it is only ever about ELSEWHERE:
        # this board's own piles are already on the page behind it. Two
        # numbers, because the square has two halves -- gold for a board that
        # wants an answer (a question, or a session line nobody opened), green
        # for a board that wants a verdict.
        #
        # The bug this fixes, in the user's own board: needs_you 0, ready 8 --
        # eight branches waiting on him and the switcher said nothing at all.
        "needs_you_elsewhere": sum(r["needs_you"] for r in others),
        "asking_elsewhere": sum(r["needs_you"] + r.get("chat_unread", 0)
                                for r in others),
        "review_elsewhere": sum(r["ready"] for r in others),
        "server_time": now(),
    }


def self_sibling_row(app, entry: dict = None) -> dict:
    """This board's own row -- counted from the live database, not over HTTP."""
    entry = entry or {}
    hosts = list(getattr(app, "hosts", None) or [])
    if not hosts:
        hosts = entry.get("hosts") or [entry.get("host") or "127.0.0.1"]
    port = int(getattr(app, "port", None) or entry.get("port") or 0)
    root = os.path.realpath(app.project_root)
    row = dict(board_rollup(app.board()))
    row.update({
        # Our own name comes from our own database, never from the registry
        # row: a rename must show up in this board's switcher immediately,
        # whether or not the registry write landed.
        "name": app.sprint_name() or entry.get("name")
                or os.path.basename(root.rstrip("/")) or root,
        "project_root": root,
        "port": port,
        "reachable": True,
        "url": board_url(hosts[0], port, app.token) if port else None,
    })
    return sibling_row(row, is_self=True)


class HubApp:
    """Reads the registry, polls every board, keeps one cached snapshot."""

    def __init__(self, registry: str = None, token: str = None, log=None,
                 poll_seconds: float = None, prune_seconds: float = None,
                 timeout: float = 2.5, tmux_send: str = None,
                 autoheal: bool = None):
        self.registry = registry
        self.registry_file = registry_path(registry)
        self.token = token or secrets.token_urlsafe(24)
        self.logfh = log
        self.poll_seconds = poll_seconds if poll_seconds is not None else env_float(
            "SPRINT_HUB_POLL_SECONDS", DEFAULT_HUB_POLL_SECONDS)
        self.prune_seconds = prune_seconds if prune_seconds is not None else env_float(
            "SPRINT_HUB_PRUNE_SECONDS", DEFAULT_HUB_PRUNE_SECONDS)
        self.timeout = timeout
        self.started_at = now()
        self.lock = threading.Lock()
        self.snapshot = None
        self.stop_event = threading.Event()
        self.thread = None
        # -- dead-session autoheal ----------------------------------------
        #
        # The hub is the reviver because it is the only process on this machine
        # that watches every board and is not itself one of the sessions that
        # can die. It does exactly one thing a board cannot: run a subprocess.
        # Every decision -- is it dead, may we try, what do we say -- belongs to
        # the board, which owns the event log the guard is written in.
        self.tmux_send = os.path.expanduser(
            tmux_send if tmux_send is not None
            else os.environ.get("SPRINT_TMUX_SEND", DEFAULT_TMUX_SEND))
        self.autoheal = (autoheal if autoheal is not None
                         else os.environ.get("SPRINT_AUTOHEAL", "1")
                         not in ("0", "no", "off", "false"))
        self.send_timeout = env_float("SPRINT_TMUX_SEND_TIMEOUT", 90.0)
        # Seam: the tests swap this for a recorder and nothing else touches it.
        # A test that really ran tmux-send would type a wake-up brief into
        # whatever window the developer happened to have open.
        self._run = subprocess.run
        self.revived = []               # what this hub has done, for the log

    def log(self, msg: str):
        if not self.logfh:
            return
        try:
            self.logfh.write("[%s] %s\n" % (
                time.strftime("%Y-%m-%d %H:%M:%S"), msg))
            self.logfh.flush()
        except (OSError, ValueError):
            pass

    def refresh(self) -> dict:
        entries = read_registry(self.registry)
        rows, pruned = [], []
        for key, entry in entries.items():
            entry = dict(entry)
            entry.setdefault("project_root", key)
            row = hub_summarize(entry, timeout=self.timeout)
            if not row["reachable"]:
                # Advisory file, health-checked truth: forget a row only once
                # the process is really gone AND it has been quiet a long time.
                seen = row.get("last_seen") or row.get("started_at") or 0
                if not row["pid_alive"] and (now() - float(seen or 0)) > self.prune_seconds:
                    pruned.append(key)
                    continue
            else:
                try:
                    registry_touch(key, {"last_seen": row["last_seen"]}, self.registry)
                except OSError:
                    pass
                # A board that says its own session died gets woken. Wrapped,
                # because the hub's whole job is to keep answering: a reviver
                # that throws must never be able to stop the landing page from
                # rendering the other nine boards.
                try:
                    self.maybe_revive(entry, row)
                except Exception:
                    self.log("revive check failed for %s: %s"
                             % (key, traceback.format_exc()))
            rows.append(row)
        for key in pruned:
            try:
                registry_unregister(key, self.registry)
                self.log("pruned dead registry entry %s" % key)
            except OSError:
                pass
        rows.sort(key=hub_sort_key)
        snap = {
            "sprints": rows,
            "count": len(rows),
            "needs_you_total": sum(r["needs_you"] for r in rows),
            "registry": self.registry_file,
            "server_time": now(),
            "poll_seconds": self.poll_seconds,
        }
        with self.lock:
            self.snapshot = snap
        return snap

    def tmux_send_ready(self) -> bool:
        """Is there a hand to reach with? Checked BEFORE claiming an attempt,
        deliberately: a claim spends one of three slots, and spending one on a
        machine that has no tmux-send installed would burn the board's whole
        budget on a wake-up nobody could ever have sent."""
        path = self.tmux_send
        return bool(path) and os.path.isfile(path) and os.access(path, os.X_OK)

    def maybe_revive(self, entry: dict, row: dict):
        """Wake one board's dead session, if its board says that is the right
        act right now. Returns a short machine reason, for the tests and the log.

        Nothing here decides anything about deadness. The board has already
        weighed the cursor, the owed cards, the account limit and the crash-loop
        guard; this reads one boolean, asks for a slot, and types.
        """
        if not self.autoheal:
            return "disabled"
        auto = row.get("autoheal") or {}
        if not auto.get("revive_wanted"):
            return "not_wanted"
        window = auto.get("tmux_window")
        if not window:
            # The board should not have asked, but a board is another program:
            # never take its word for the one field this turns into argv.
            return "no_window"
        if not self.tmux_send_ready():
            self.log("no tmux-send at %s — cannot wake %s (its session has been "
                     "gone %s)" % (self.tmux_send, row.get("name") or "a board",
                                   human_span(auto.get("quiet_for_seconds") or 0)))
            return "no_tmux_send"
        port = int(entry.get("port") or row.get("port") or 0)
        token = board_token_for(entry)
        if not port or not token:
            return "unreachable"
        try:
            status, raw = http_post_json("127.0.0.1", port, "/api/autoheal/revive",
                                         token, {"by": "hub"}, timeout=self.timeout)
        except (OSError, http.client.HTTPException) as exc:
            self.log("could not claim a wake-up on %s (%s)" % (row.get("name"), exc))
            return "claim_failed"
        claim = jload(raw.decode("utf-8", "replace"), {}) or {}
        if status != 200 or not claim.get("ok"):
            # 409 with a reason is the normal answer, not an error: the board
            # is holding us off, or it gave up, or it is not dead any more.
            return "refused:%s" % (claim.get("reason") or status)
        attempt_seq = claim.get("attempt_seq")
        brief = claim.get("brief") or ""
        sent, detail = False, None
        try:
            proc = self._run([self.tmux_send, str(window), brief],
                             capture_output=True, timeout=self.send_timeout)
            sent = getattr(proc, "returncode", 1) == 0
            if not sent:
                err = getattr(proc, "stderr", b"") or b""
                if isinstance(err, bytes):
                    err = err.decode("utf-8", "replace")
                detail = "tmux-send exited %s: %s" % (
                    getattr(proc, "returncode", "?"), " ".join(str(err).split())[:300])
        except Exception as exc:
            detail = "tmux-send could not run: %s" % exc
        self.log("wake-up %s for %s (window %s, try %s of %s)"
                 % ("sent" if sent else "FAILED", row.get("name") or entry.get("project_root"),
                    window, claim.get("attempt"), claim.get("max_attempts")))
        self.revived.append({"project_root": entry.get("project_root"),
                             "window": window, "attempt": claim.get("attempt"),
                             "sent": sent, "at": now()})
        try:
            http_post_json("127.0.0.1", port, "/api/autoheal/revive", token,
                           {"attempt_seq": attempt_seq, "sent": sent,
                            "detail": detail}, timeout=self.timeout)
        except (OSError, http.client.HTTPException) as exc:
            # The attempt happened whether or not we could write it down. The
            # board still counts it (the claim is what spends the slot), so the
            # cap holds either way -- only the give-up WORDING loses detail.
            self.log("could not report the wake-up result to %s (%s)"
                     % (row.get("name"), exc))
        return "sent" if sent else "send_failed"

    def get(self, max_age: float = None) -> dict:
        if max_age is None:
            max_age = self.poll_seconds
        with self.lock:
            snap = self.snapshot
        if snap and (now() - snap["server_time"]) <= max_age:
            return snap
        return self.refresh()

    def _loop(self):
        while not self.stop_event.is_set():
            try:
                self.refresh()
            except Exception:
                self.log("hub poll failed: %s" % traceback.format_exc())
            self.stop_event.wait(self.poll_seconds)

    def start_background(self):
        if self.thread is not None:
            return
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def close(self):
        self.stop_event.set()


HUB_HTML = """<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>sprint — boards on this machine</title>
<style>
  :root{
    --bg:#0e1116; --panel:#161b22; --panel-2:#1c222b; --line:#262d38;
    --ink:#e6edf3; --dim:#8b98a8; --faint:#5c6773;
    --amber:#e0a33e; --green:#3fb27f; --red:#e05252;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
       font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,
            "Helvetica Neue",Arial,sans-serif;
       -webkit-font-smoothing:antialiased}
  .wrap{max-width:880px;margin:0 auto;padding:32px 20px 64px}
  header{display:flex;align-items:baseline;justify-content:space-between;
         gap:16px;flex-wrap:wrap;margin-bottom:6px}
