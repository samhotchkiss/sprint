function age(sec){
  if(sec===null||sec===undefined) return "";
  sec=Math.max(0,Math.round(sec));
  if(sec<60) return sec+"s";
  if(sec<3600) return Math.round(sec/60)+"m";
  if(sec<86400) return (sec/3600).toFixed(1).replace(/\\.0$/,"")+"h";
  return Math.round(sec/86400)+"d";
}
function esc(s){var d=document.createElement("div");d.textContent=s==null?"":s;
  return d.innerHTML;}
function sessionLabel(s){
  if(s==="online") return "session live";
  if(s==="busy") return "session catching up";
  if(s==="offline") return "session offline";
  return "session unknown";
}
function render(data){
  var t=data.server_time, rows=data.sprints||[];
  var ul=document.getElementById("rows");
  var live=rows.filter(function(r){return r.reachable;}).length;
  var need=data.needs_you_total||0;
  document.getElementById("sub").textContent =
    rows.length===0 ? "" :
    (live+" running"+(rows.length>live?" · "+(rows.length-live)+" unreachable":"")+
     " · "+(need? need+" waiting on you" : "nothing waiting on you"));
  document.getElementById("updated").textContent="updated just now";
  if(!rows.length){
    ul.innerHTML='<div class="empty">No sprints are running on this machine.'+
      '<br>Start one by saying <code>start a sprint</code> in a Claude Code '+
      'session inside any project.</div>';
    return;
  }
  ul.innerHTML=rows.map(function(r){
    var cls=[]; if(!r.reachable) cls.push("dead"); else if(r.needs_you) cls.push("attn");
    var stuck = (r.needs_you && r.stuck_seconds!=null)
      ? '<span class="stuck">stuck '+age(r.stuck_seconds)+'</span>' : '';
    var counts = r.reachable
      ? '<span class="'+(r.needs_you?'hot':'')+'"><b>'+r.needs_you+'</b> need you</span>'+
        ' / <b>'+r.ready+'</b> ready / <b>'+r.in_motion+'</b> in motion'
      : 'unreachable — last seen '+
        age(t-(r.last_seen||r.started_at||t))+' ago';
    var actAge = r.last_activity_at!=null ? age(t-r.last_activity_at) : null;
    var meta = r.reachable
      ? (r.last_activity? esc(r.last_activity)+" · "+actAge+" ago"
                        : "no activity yet")
      : (r.detail? esc(r.detail) : "nothing answering on port "+r.port);
    var right = r.reachable && r.url
      ? '<a class="open" href="'+esc(r.url)+'">open board</a>' : '';
    return '<li class="'+cls.join(" ")+'" title="'+esc(r.project_root)+'">'+
      '<span class="left">'+
        '<span class="name"><span class="dot '+(r.reachable?esc(r.session||""):"")+
          '"></span>'+esc(r.name)+stuck+'</span>'+
        '<span class="counts">'+counts+'</span>'+
        '<span class="meta">'+meta+'</span>'+
      '</span>'+
      '<span class="right">'+right+
        '<span class="gone">'+(r.reachable? esc(sessionLabel(r.session))
                                          : 'board not running')+'</span>'+
      '</span></li>';
  }).join("");
}
var lastAt=0;
function tick(){
  fetch("/api/hub",{headers:{"Accept":"application/json"}})
    .then(function(res){
      if(res.status===401){throw new Error("unauthorized");}
      return res.json();})
    .then(function(d){lastAt=Date.now();render(d);})
    .catch(function(e){
      document.getElementById("updated").textContent =
        e.message==="unauthorized" ? "signed out — reopen your hub link"
                                   : "hub unreachable";
    });
}
setInterval(tick,10000);
setInterval(function(){
  if(!lastAt) return;
  var s=Math.round((Date.now()-lastAt)/1000);
  document.getElementById("updated").textContent =
    s<5? "updated just now" : "updated "+age(s)+" ago";
},1000);
tick();
</script>
</body></html>
"""


def make_hub_handler(hub: HubApp):

    class HubHandler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "sprintd-hub/1.0"

        def log_message(self, fmt, *args):  # noqa: A003
            hub.log("%s %s" % (self.address_string(), fmt % args))

        def _send(self, status, body: bytes, ctype: str, extra_headers=None):
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            for k, v in (extra_headers or []):
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                try:
                    self.wfile.write(body)
                except (BrokenPipeError, ConnectionResetError):
                    pass

        def json_out(self, status, obj, extra_headers=None):
            self._send(status, jdump(obj).encode("utf-8"),
                       "application/json; charset=utf-8", extra_headers)

        def cookie_token(self):
            raw = self.headers.get("Cookie") or ""
            for part in raw.split(";"):
                name, _, val = part.strip().partition("=")
                if name == HUB_COOKIE_NAME:
                    return urllib.parse.unquote(val)
            return None

        def authed(self, query) -> bool:
            given = None
            auth = self.headers.get("Authorization") or ""
            if auth.lower().startswith("bearer "):
                given = auth[7:].strip()
            if given is None:
                given = self.cookie_token()
            if given is None:
                qt = query.get("t")
                given = qt[0] if qt else None
            if not given:
                return False
            return secrets.compare_digest(str(given), hub.token)

        def do_GET(self):  # noqa: N802
            self._route()

        def do_HEAD(self):  # noqa: N802
            self._route()

        def _route(self):
            try:
                parsed = urllib.parse.urlsplit(self.path)
                path = urllib.parse.unquote(parsed.path)
                query = urllib.parse.parse_qs(parsed.query)

                if path == "/healthz":
                    return self.json_out(200, {
                        "ok": True, "hub": True, "pid": os.getpid(),
                        "registry": hub.registry_file,
                        "started_at": hub.started_at})

                if not self.authed(query):
                    return self.json_out(401, {
                        "error": "unauthorized",
                        "message": "the hub has its own token: see "
                                   "~/.sprint/hub-token, or run `sprintd hub` "
                                   "again to print the URL"})

                if path == "/" and query.get("t"):
                    cookie = "%s=%s; Path=/; SameSite=Lax; Max-Age=31536000; HttpOnly" % (
                        HUB_COOKIE_NAME, urllib.parse.quote(hub.token))
                    rest = [(k, v) for k, v in urllib.parse.parse_qsl(parsed.query)
                            if k != "t"]
                    location = "/" + ("?" + urllib.parse.urlencode(rest) if rest else "")
                    return self._send(302, b"", "text/plain",
                                      [("Set-Cookie", cookie), ("Location", location)])

                if path in ("/", "/index.html"):
                    return self._send(200, HUB_HTML.encode("utf-8"),
                                      "text/html; charset=utf-8")
                if path == "/api/hub":
                    fresh = (query.get("fresh") or ["0"])[0] in ("1", "true", "yes")
                    return self.json_out(200, hub.get(max_age=0 if fresh else None))
                return self.json_out(404, {"error": "not_found", "message": path})
            except (BrokenPipeError, ConnectionResetError):
                return
            except Exception:
                hub.log("unhandled: %s" % traceback.format_exc())
                try:
                    return self.json_out(500, {"error": "internal",
                                               "message": "internal error"})
                except Exception:
                    return

    return HubHandler


class HubServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def make_hub_server(hub: HubApp, host: str, port: int) -> HubServer:
    return HubServer((host, port), make_hub_handler(hub))


def hub_url(host: str, port: int, token: str) -> str:
    return "http://%s:%d/?t=%s" % (host, port, urllib.parse.quote(token))


def probe_hub(info: dict, registry_file: str, timeout: float = 3.0) -> str:
    """-> healthy | dead | foreign (someone else owns the port)."""
    if not info:
        return "dead"
    port = info.get("port") or DEFAULT_HUB_PORT
    try:
        status, raw = http_get("127.0.0.1", port, "/healthz", timeout=timeout)
    except (OSError, http.client.HTTPException):
        return "dead"
    if status != 200:
        return "foreign"
    health = jload(raw.decode("utf-8", "replace"), {}) or {}
    if not health.get("hub"):
        return "foreign"
    if os.path.realpath(health.get("registry") or "") != os.path.realpath(registry_file):
        return "foreign"
    return "healthy"


def cmd_hub(args) -> int:
    reg_file = registry_path(args.registry)
    d = hub_dir(args.registry)
    try:
        os.makedirs(d, exist_ok=True)
    except OSError as exc:
        print("error: cannot create %s (%s)" % (d, exc), file=sys.stderr)
        return 1
    hj = hub_json_path(args.registry)
    info = read_server_json(hj)

    if args.stop:
        if not info:
            print("hub is not running (no %s)" % hj)
            return 0
        pid = info.get("pid")
        if isinstance(pid, int) and pid_is_sprintd(pid):
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError as exc:
                print("error: could not signal pid %s: %s" % (pid, exc), file=sys.stderr)
                return 1
            for _ in range(60):
                if not pid_alive(pid):
                    break
                time.sleep(0.1)
            if pid_alive(pid):
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            print("stopped hub (pid %s)" % pid)
        else:
            print("stale %s (pid %s is gone); cleaning up" % (hj, pid))
        try:
            os.remove(hj)
        except OSError:
            pass
        return 0

    if info:
        state = probe_hub(info, reg_file)
        if state == "healthy":
            print("hub already running (pid %s) -> %s"
                  % (info.get("pid"), hub_url(info.get("host") or "127.0.0.1",
                                              info.get("port"), info["token"])))
            return 0
        if state == "foreign":
            print("error: port %s is held by something else (not this hub). "
                  "Free it or use --port." % info.get("port"), file=sys.stderr)
            return 1
        pid = info.get("pid")
        if isinstance(pid, int) and pid_is_sprintd(pid) and pid != os.getpid():
            try:
                os.kill(pid, signal.SIGTERM)
                time.sleep(0.5)
            except OSError:
                pass
        try:
            os.remove(hj)
        except OSError:
            pass

    port = args.port if args.port is not None else (
        (info or {}).get("port") or DEFAULT_HUB_PORT)
    tok_path = hub_token_path(args.registry)
    if args.token:
        token = args.token
    elif args.new_token:
        token = secrets.token_urlsafe(24)
    else:
        token = ((info or {}).get("token") or read_token_file(tok_path)
                 or secrets.token_urlsafe(24))

    ts_ip = "" if args.no_tailscale else tailscale_ip()
    if not ts_ip:
        print("NOTICE: no tailscale IPv4 address found -- binding 127.0.0.1 ONLY.",
              file=sys.stderr)

    logpath = os.path.join(d, HUB_LOG)
    ready_fd = None
    if not args.foreground:
        ready_fd = daemonize(logpath)

    def report(ok: bool, **kw):
        if ready_fd is None:
            return
        try:
            os.write(ready_fd, (jdump(dict(ok=ok, **kw)) + "\n").encode("utf-8"))
            os.close(ready_fd)
        except OSError:
            pass

    logfh = open(logpath, "a", encoding="utf-8")
    hub = HubApp(registry=args.registry, token=token, log=logfh,
                 poll_seconds=args.poll_seconds)

    servers, hosts = [], []
    try:
        loop = make_hub_server(hub, "127.0.0.1", port)
    except OSError as exc:
        msg = "cannot bind 127.0.0.1:%s (%s)" % (port, exc)
        hub.log(msg)
        report(False, error=msg)
        print("error: " + msg, file=sys.stderr)
        return 1
    servers.append(loop)
    hosts.append("127.0.0.1")
    actual_port = loop.server_address[1]
    if ts_ip:
        try:
            servers.insert(0, make_hub_server(hub, ts_ip, actual_port))
            hosts.insert(0, ts_ip)
        except OSError as exc:
            hub.log("could not bind tailnet ip %s:%s (%s) -- loopback only"
                    % (ts_ip, actual_port, exc))

    try:
        write_token_file(tok_path, token)
    except OSError as exc:
        hub.log("could not persist %s (%s)" % (tok_path, exc))
    write_server_json(hj, {
        "pid": os.getpid(), "port": actual_port, "host": hosts[0], "hosts": hosts,
        "token": token, "registry": reg_file, "started_at": hub.started_at,
    })
    hub.start_background()

    urls = [hub_url(h, actual_port, token) for h in hosts]
    hub.log("hub listening on %s (registry %s)" % (
        ", ".join("%s:%d" % (h, actual_port) for h in hosts), reg_file))
    report(True, urls=urls, pid=os.getpid(), port=actual_port)
    if ready_fd is None:
        for u in urls:
            print(u)
        sys.stdout.flush()

    stop = threading.Event()

    def handle_sig(_signo, _frame):
        stop.set()

    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, handle_sig)
        except (ValueError, OSError):
            pass

    for s in servers:
        threading.Thread(target=s.serve_forever, kwargs={"poll_interval": 0.2},
                         daemon=True).start()
    try:
        while not stop.is_set():
            stop.wait(0.5)
    finally:
        for s in servers:
            s.shutdown()
            s.server_close()
        hub.close()
        try:
            cur = read_server_json(hj)
            if cur and cur.get("pid") == os.getpid():
                os.remove(hj)
        except OSError:
            pass
        try:
            logfh.close()
        except OSError:
            pass
    return 0


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="sprintd", description=__doc__.splitlines()[0])
    ap.add_argument("--project-root", default=None,
                    help="project root (default: git toplevel of cwd)")
    ap.add_argument("--data-dir", default=None,
                    help="state dir (default: <project-root>/.sprint)")
    ap.add_argument("--registry", default=None,
                    help="machine-wide registry file (default: $SPRINT_REGISTRY or "
                         "~/.sprint/registry.json); the hub's token and pidfile live "
                         "beside it")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("start", help="start the board server (idempotent)")
    s.add_argument("--port", type=int, default=None,
                   help="port (default %d, reused across restarts)" % DEFAULT_PORT)
    s.add_argument("--token", default=None, help="force a bearer token")
    s.add_argument("--new-token", action="store_true",
                   help="mint a fresh token (default: reuse the existing one so "
                        "the printed URL and every logged-in browser survive a restart)")
    s.add_argument("--foreground", action="store_true", help="do not daemonize")
    s.add_argument("--no-tailscale", action="store_true",
                   help="skip tailscale lookup; bind loopback only")
    s.add_argument("--silence-seconds", type=float, default=None,
                   help="agent_silent threshold (default %d)" % DEFAULT_SILENCE_SECONDS)
    s.set_defaults(func=cmd_start)

    s = sub.add_parser("stop", help="stop the board server")
    s.set_defaults(func=cmd_stop)

    s = sub.add_parser("status", help="is it running, and where")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("wait", help="block until events exist past --after")
    s.add_argument("--after", type=int, required=True)
    s.add_argument("--timeout", type=float, default=60.0)
    s.add_argument("--poll", type=float, default=0.5)
    s.add_argument("--port", type=int, default=None)
    s.add_argument("--token", default=None)
    s.set_defaults(func=cmd_wait)

    s = sub.add_parser("doctor", help="check the environment; fix what is safe to fix")
    s.add_argument("--install-launchd", action="store_true",
                   help="write + load a KeepAlive LaunchAgent (macOS)")
    s.add_argument("--port", type=int, default=None)
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("hub", help="one landing page for every sprint on this machine")
    s.add_argument("--port", type=int, default=None,
                   help="port (default %d)" % DEFAULT_HUB_PORT)
    s.add_argument("--stop", action="store_true", help="stop the running hub")
    s.add_argument("--token", default=None, help="force the hub's bearer token")
    s.add_argument("--new-token", action="store_true",
                   help="mint a fresh hub token (default: reuse ~/.sprint/hub-token)")
    s.add_argument("--foreground", action="store_true", help="do not daemonize")
    s.add_argument("--no-tailscale", action="store_true",
                   help="skip tailscale lookup; bind loopback only")
    s.add_argument("--poll-seconds", type=float, default=None,
                   help="how often to re-poll every board (default %d)"
                        % DEFAULT_HUB_POLL_SECONDS)
    s.set_defaults(func=cmd_hub)
    return ap


def main(argv=None) -> int:
    ap = build_parser()
    args = ap.parse_args(argv)
    if not getattr(args, "cmd", None):
        ap.print_help()
        return 1
    try:
        return int(args.func(args) or 0)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
